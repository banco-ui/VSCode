    def get_due_schedules(
        self,
        current_time: Optional[datetime] = None,
        missed_policy: str = "skip",
    ) -> list[ScheduleDefinition]:
        """Get all enabled schedules that are due for execution.
        
        Phase 10D: Missed Schedule Policy
        - "skip": Skip missed executions (default, prevents backlog)
        - "latest": Execute latest missed (catch-up)
        - "all": Execute all missed (can cause backlog)
        
        Args:
            current_time: Time to check against (defaults to now).
            missed_policy: Policy for missed schedules.
            
        Returns:
            List of due schedules.
        """
        current = current_time or datetime.now(timezone.utc)
        current_str = current.isoformat()
        
        cursor = self.conn.execute(
            """
            SELECT * FROM schedule_definitions
            WHERE enabled = 1
              AND (next_run_at IS NULL OR next_run_at <= ?)
            """,
            (current_str,),
        )
        
        import json
        schedules = []
        
        for row in cursor.fetchall():
            schedule = ScheduleDefinition(
                schedule_id=row["schedule_id"],
                name=row["name"],
                server_ids=json.loads(row["server_ids_json"]),
                enabled=bool(row["enabled"]),
                cron_expression=row["cron_expression"],
                interval_seconds=row["interval_seconds"],
                last_run_at=row["last_run_at"],
                next_run_at=row["next_run_at"],
                created_at=row["created_at"],
                updated_at=row["updated_at"],
                metadata=json.loads(row["metadata_json"]),
            )
            
            # Apply missed schedule policy
            if schedule.is_due(current_time, missed_policy):
                schedules.append(schedule)
        
        return schedules
    
    def update_schedule_after_execution(
        self,
        schedule_id: str,
        success: bool,
        next_run_at: str,
    ) -> None:
        """Update schedule after execution (last_run_at, next_run_at)."""
        sql = """
        UPDATE schedule_definitions
        SET last_run_at = ?,
            next_run_at = ?,
            updated_at = ?
        WHERE schedule_id = ?
        """
        
        now = datetime.now(timezone.utc).isoformat()
        self._execute_with_retry(sql, (
            now if success else None,
            next_run_at,
            now,
            schedule_id,
        ))
        self.conn.commit()
    
    # ── ScheduleExecution (atomic claim) ──────────────────────────────
    
    def claim_execution(
        self,
        schedule: ScheduleDefinition,
        server_id: str,
    ) -> Optional[ScheduleExecution]:
        """Atomically claim a schedule execution.
        
        This prevents duplicate execution by using INSERT OR IGNORE
        with a unique execution_id.
        
        Args:
            schedule: The schedule to execute.
            server_id: Target server for this execution.
            
        Returns:
            ScheduleExecution if claim succeeded, None if already claimed.
        """
        import uuid
        
        execution_id = f"exec-{uuid.uuid4().hex[:12]}"
        now = datetime.now(timezone.utc).isoformat()
        
        sql = """
        INSERT OR IGNORE INTO schedule_executions
            (execution_id, schedule_id, server_id, status, claimed_at, recovery_count)
        VALUES (?, ?, ?, 'CLAIMED', ?, 0)
        """
        
        try:
            cursor = self._execute_with_retry(sql, (
                execution_id,
                schedule.schedule_id,
                server_id,
                now,
            ))
            self.conn.commit()
            
            if cursor.rowcount == 0:
                # INSERT was ignored (duplicate claim)
                logger.debug(
                    "Duplicate claim prevented for schedule=%s server=%s",
                    schedule.schedule_id,
                    server_id,
                )
                return None
            
            return ScheduleExecution(
                execution_id=execution_id,
                schedule_id=schedule.schedule_id,
                server_id=server_id,
                status="CLAIMED",
                claimed_at=now,
                recovery_count=0,
            )
            
        except sqlite3.IntegrityError:
            # Unique constraint violation (concurrent claim)
            logger.debug(
                "Concurrent claim detected for schedule=%s server=%s",
                schedule.schedule_id,
                server_id,
            )
            return None
    
    def start_execution(self, execution: ScheduleExecution, run_id: str) -> None:
        """Mark execution as started with run_id."""
        sql = """
        UPDATE schedule_executions
        SET status = 'RUNNING',
            run_id = ?,
            started_at = ?
        WHERE execution_id = ?
        """
        
        now = datetime.now(timezone.utc).isoformat()
        self._execute_with_retry(sql, (run_id, now, execution.execution_id))
        self.conn.commit()
    
    def complete_execution(
        self,
        execution_id: str,
        success: bool,
        error_message: Optional[str] = None,
    ) -> None:
        """Mark execution as completed."""
        sql = """
        UPDATE schedule_executions
        SET status = ?,
            completed_at = ?,
            error_message = ?
        WHERE execution_id = ?
        """
        
        now = datetime.now(timezone.utc).isoformat()
        status = "SUCCESS" if success else "FAILED"
        
        self._execute_with_retry(sql, (status, now, error_message, execution_id))
        self.conn.commit()
    
    def get_stale_executions(
        self,
        stale_timeout_seconds: int = 300,
    ) -> list[ScheduleExecution]:
        """Get executions that are stale (RUNNING for too long).
        
        Phase 10D: Crash Recovery - detects executions that have been
        RUNNING longer than the timeout threshold, indicating a crash.
        
        Args:
            stale_timeout_seconds: Time threshold in seconds (default: 300 = 5 minutes).
            
        Returns:
            List of stale execution records.
        """
        from datetime import timedelta
        
        threshold = (datetime.now(timezone.utc) - timedelta(seconds=stale_timeout_seconds)).isoformat()
        
        cursor = self.conn.execute(
            """
            SELECT * FROM schedule_executions
            WHERE status = 'RUNNING'
              AND started_at IS NOT NULL
              AND started_at < ?
            """,
            (threshold,),
        )
        
        executions = []
        for row in cursor.fetchall():
            executions.append(ScheduleExecution(
                execution_id=row["execution_id"],
                schedule_id=row["schedule_id"],
                server_id=row["server_id"],
                run_id=row["run_id"],
                status=row["status"],
                claimed_at=row["claimed_at"],
                started_at=row["started_at"],
                completed_at=row["completed_at"],
                error_message=row["error_message"],
                recovery_id=row["recovery_id"],
                recovery_count=row["recovery_count"],
            ))
        
        return executions
    
    def recover_execution(
        self,
        execution_id: str,
        recovery_id: str,
    ) -> bool:
        """Mark an execution as recovered from crash.
        
        Phase 10D: Crash Recovery - atomically marks a stale execution
        as RECOVERED and increments recovery_count.
        
        Uses conditional UPDATE to ensure idempotency:
        - Only affects executions still in RUNNING state
        - Returns False if execution was already recovered
        
        Args:
            execution_id: The execution to recover.
            recovery_id: Unique identifier for this recovery operation.
            
        Returns:
            True if recovery succeeded, False if already recovered.
        """
        now = datetime.now(timezone.utc).isoformat()
        
        # Atomic conditional update for idempotency
        sql = """
        UPDATE schedule_executions
        SET status = 'RECOVERED',
            recovery_id = ?,
            recovery_count = recovery_count + 1,
            completed_at = ?,
            error_message = COALESCE(error_message, 'Recovered from crash')
        WHERE execution_id = ?
          AND status = 'RUNNING'
        """
        
        cursor = self._execute_with_retry(sql, (recovery_id, now, execution_id))
        self.conn.commit()
        
        # Check if update affected any rows
        return cursor.rowcount > 0
    
