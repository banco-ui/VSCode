"""SchedulerStore — SQLite persistence for schedules — Phase 10B.

Atomic claim, duplicate prevention, lock retry.
"""
from __future__ import annotations

import logging
import sqlite3
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional

from .models import ScheduleDefinition, ScheduleExecution, ScheduleStatus

logger = logging.getLogger(__name__)

SCHEDULER_SCHEMA_SQL = """
-- Schedule definitions
CREATE TABLE IF NOT EXISTS schedule_definitions (
    schedule_id        TEXT PRIMARY KEY,
    name               TEXT NOT NULL,
    server_ids_json    TEXT NOT NULL DEFAULT '[]',
    enabled            INTEGER NOT NULL DEFAULT 1,
    cron_expression    TEXT,
    interval_seconds   INTEGER,
    last_run_at        TEXT,
    next_run_at        TEXT,
    created_at         TEXT NOT NULL,
    updated_at         TEXT NOT NULL,
    metadata_json      TEXT NOT NULL DEFAULT '{}'
);

-- Schedule executions (atomic claim tracking)
CREATE TABLE IF NOT EXISTS schedule_executions (
    execution_id       TEXT PRIMARY KEY,
    schedule_id        TEXT NOT NULL,
    server_id          TEXT NOT NULL,
    run_id             TEXT,
    status             TEXT NOT NULL DEFAULT 'PENDING',
    claimed_at         TEXT NOT NULL,
    started_at         TEXT,
    completed_at       TEXT,
    error_message      TEXT,
    recovery_id        TEXT,
    recovery_count     INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (schedule_id) REFERENCES schedule_definitions(schedule_id)
);

-- Index for due schedule lookup
CREATE INDEX IF NOT EXISTS idx_schedules_enabled ON schedule_definitions(enabled);
CREATE INDEX IF NOT EXISTS idx_schedules_next_run ON schedule_definitions(next_run_at);
CREATE INDEX IF NOT EXISTS idx_executions_schedule ON schedule_executions(schedule_id);
CREATE INDEX IF NOT EXISTS idx_executions_status ON schedule_executions(status);
CREATE INDEX IF NOT EXISTS idx_executions_started ON schedule_executions(started_at);
"""

# SQLite lock retry configuration
DEFAULT_LOCK_RETRY_COUNT = 3
DEFAULT_LOCK_RETRY_BACKOFF = 0.1  # seconds


class SchedulerStore:
    """SQLite-backed scheduler persistence store.
    
    Provides atomic claim, duplicate prevention, and lock retry.
    """
    
    def __init__(
        self,
        db_path: str | Path = ":memory:",
        lock_retry_count: int = DEFAULT_LOCK_RETRY_COUNT,
        lock_retry_backoff: float = DEFAULT_LOCK_RETRY_BACKOFF,
    ) -> None:
        self.db_path = str(db_path)
        self._conn: Optional[sqlite3.Connection] = None
        self._lock_retry_count = lock_retry_count
        self._lock_retry_backoff = lock_retry_backoff
        self.init()
    
    def init(self) -> None:
        """Initialize database connection and create tables."""
        self._conn = sqlite3.connect(self.db_path)
        self._conn.row_factory = sqlite3.Row
        self._conn.executescript(SCHEDULER_SCHEMA_SQL)
        self._conn.commit()
    
    def close(self) -> None:
        """Close the database connection."""
        if self._conn:
            self._conn.close()
            self._conn = None
    
    @property
    def conn(self) -> sqlite3.Connection:
        if self._conn is None:
            raise RuntimeError("Database not initialized. Call init() first.")
        return self._conn
    
    def _is_lock_error(self, e: Exception) -> bool:
        """Check if exception is a SQLite lock error."""
        if not isinstance(e, sqlite3.OperationalError):
            return False
        msg = str(e).lower()
        return "locked" in msg or "database is locked" in msg
    
    def _execute_with_retry(self, sql: str, params: tuple = ()) -> sqlite3.Cursor:
        """Execute SQL with retry on lock error."""
        last_error: Optional[Exception] = None
        
        for attempt in range(self._lock_retry_count):
            try:
                cursor = self.conn.execute(sql, params)
                return cursor
            except sqlite3.OperationalError as e:
                last_error = e
                if self._is_lock_error(e) and attempt < self._lock_retry_count - 1:
                    logger.warning(
                        "SQLite lock detected, retrying in %.2fs (attempt %d/%d)",
                        self._lock_retry_backoff * (attempt + 1),
                        attempt + 1,
                        self._lock_retry_count,
                    )
                    time.sleep(self._lock_retry_backoff * (attempt + 1))
                else:
                    raise
        
        if last_error:
            raise last_error
        raise RuntimeError("Unexpected retry loop exit")
    
    # ── ScheduleDefinition persistence ─────────────────────────────────
    
    def save_schedule(self, schedule: ScheduleDefinition) -> None:
        """Save or update a schedule definition."""
        import json
        
        sql = """
        INSERT OR REPLACE INTO schedule_definitions
            (schedule_id, name, server_ids_json, enabled, cron_expression,
             interval_seconds, last_run_at, next_run_at, created_at,
             updated_at, metadata_json)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """
        
        self._execute_with_retry(sql, (
            schedule.schedule_id,
            schedule.name,
            json.dumps(schedule.server_ids),
            1 if schedule.enabled else 0,
            schedule.cron_expression,
            schedule.interval_seconds,
            schedule.last_run_at,
            schedule.next_run_at,
            schedule.created_at,
            schedule.updated_at,
            json.dumps(schedule.metadata),
        ))
        self.conn.commit()
    
    def get_schedule(self, schedule_id: str) -> Optional[ScheduleDefinition]:
        """Get a schedule definition by ID."""
        import json
        
        cursor = self.conn.execute(
            "SELECT * FROM schedule_definitions WHERE schedule_id = ?",
            (schedule_id,),
        )
        row = cursor.fetchone()
        
        if row is None:
            return None
        
        return ScheduleDefinition(
            schedule_id=row["schedule_id"],
            name=row["name"],
