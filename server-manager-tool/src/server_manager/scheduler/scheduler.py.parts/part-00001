        """Add or update a schedule definition."""
        self.store.save_schedule(schedule)
        logger.info("Schedule added/updated: %s", schedule.schedule_id)
    
    def remove_schedule(self, schedule_id: str) -> None:
        """Remove a schedule definition."""
