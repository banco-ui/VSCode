    def enable_schedule(self, schedule_id: str) -> None:
        """Enable a schedule."""
        schedule = self.store.get_schedule(schedule_id)
        if schedule is None:
            logger.warning("Schedule not found: %s", schedule_id)
            return
        
        schedule.enabled = True
        schedule.updated_at = datetime.now(timezone.utc).isoformat()
        self.store.save_schedule(schedule)
        logger.info("Schedule enabled: %s", schedule_id)
    
    def disable_schedule(self, schedule_id: str) -> None:
        """Disable a schedule."""
        schedule = self.store.get_schedule(schedule_id)
        if schedule is None:
            logger.warning("Schedule not found: %s", schedule_id)
            return
        
        schedule.enabled = False
        schedule.updated_at = datetime.now(timezone.utc).isoformat()
        self.store.save_schedule(schedule)
        logger.info("Schedule disabled: %s", schedule_id)
    
    def get_schedules(self) -> list[ScheduleDefinition]:
        """Get all schedule definitions."""
        return self.store.get_all_schedules()
    
    def get_schedule(self, schedule_id: str) -> Optional[ScheduleDefinition]:
        """Get a schedule definition by ID."""
        return self.store.get_schedule(schedule_id)
    
    def trigger_manual(
        self,
        schedule_id: str,
        server_id: Optional[str] = None,
    ) -> list[ScheduleExecution]:
        """Manually trigger a schedule execution.
        
        Args:
            schedule_id: The schedule to trigger.
            server_id: Optional specific server (defaults to all servers in schedule).
            
        Returns:
            List of claimed executions.
        """
        schedule = self.store.get_schedule(schedule_id)
        if schedule is None:
            logger.warning("Schedule not found: %s", schedule_id)
            return []
        
        server_ids = [server_id] if server_id else schedule.server_ids
        executions = []
        
        for sid in server_ids:
            execution = self.store.claim_execution(schedule, sid)
            if execution is not None:
                # Submit to executor
                future = self._executor.submit(
                    self._execute_collection,
                    schedule,
                    sid,
                    execution,
                ) if self._executor else None
                
                if future:
                    self._active_futures.append(future)
                    executions.append(execution)
        
        return executions

    def _perform_recovery_scan(self) -> int:
        """Perform recovery scan for stale executions.
        
        Phase 10D: Crash Recovery - Find and recover stale executions on startup.
        
        Returns:
            Number of executions recovered.
        """
        logger.info("Recovery scan started")
        
        stale_timeout = self.config.stale_timeout_seconds
        stale_executions = self.store.get_stale_executions(stale_timeout)
        
        if not stale_executions:
            logger.info("Recovery scan completed: no stale executions found")
            return 0
        
        recovered_count = 0
        for execution in stale_executions:
            try:
                recovery_id = str(uuid.uuid4())
                rowcount = self.store.recover_execution(execution.execution_id, recovery_id)
                
                if rowcount == 1:
                    logger.info(
                        "Execution recovery succeeded: %s (schedule=%s, server=%s, recovery_id=%s)",
                        execution.execution_id,
                        execution.schedule_id,
                        execution.server_id,
                        recovery_id,
                    )
                    recovered_count += 1
                else:
                    logger.debug(
                        "Execution recovery skipped (already recovered): %s",
                        execution.execution_id,
                    )
            except Exception as e:
                logger.error(
                    "Execution recovery failed: %s (schedule=%s, server=%s, error=%s)",
                    execution.execution_id,
                    execution.schedule_id,
                    execution.server_id,
                    str(e),
                )
        
        logger.info("Recovery scan completed: %d executions recovered", recovered_count)
        return recovered_count

    def start(self) -> None:
        """Start the scheduler main loop.
        
        Phase 10D: Crash Recovery - Perform recovery scan before normal polling.
        """
        if not self.config.enabled:
            logger.warning("Scheduler is disabled (config.enabled=False)")
            return
        
        if self._loop_thread is not None:
            logger.warning("Scheduler is already running")
            return
        
        # Initialize executor
        self._executor = ThreadPoolExecutor(max_workers=self.config.worker_limit)
        
        # Phase 10D: Perform recovery scan BEFORE normal polling
        logger.info("Performing startup recovery scan...")
        self._perform_recovery_scan()
        
        # Start main polling loop
        self._stop_event.clear()
        self._loop_thread = threading.Thread(target=self._run_loop, daemon=True)
        self._loop_thread.start()
        
        logger.info("Scheduler started")
    
    def _run_loop(self) -> None:
        """Main scheduler polling loop."""
        while not self._stop_event.is_set():
            try:
                self._poll_and_execute()
            except Exception as e:
                logger.error("Scheduler loop error: %s", str(e))
            
            self._stop_event.wait(self.config.poll_interval)
    
