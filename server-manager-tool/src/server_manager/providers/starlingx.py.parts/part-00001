class StarlingXProviderAdapter(ProviderAdapter):
    """StarlingX native management API provider adapter.

    Composes StarlingXAPICollector + StarlingXCLICollector.
    Two input modes: fixture (for testing) or live (injected collectors).

    Identity: provider_type=WRCP, provider_id=system UUID or constructor arg.
    Capabilities: PLATFORM, CLUSTER, NODE, HEALTH, EVENTS.
    NOT declared: PHYSICAL (bm_type=none), OS, EE, WORKLOAD, NETWORK,
    STORAGE, ACCELERATOR (no evidence from confirmed API/CLI).

    Safety: GET-only REST, CLI allow-list, no write operations.
    """

    def __init__(
        self,
        platform_ip: str = "",
        *,
        provider_id: Optional[str] = None,
        api_collector: Optional[StarlingXAPICollector] = None,
        cli_collector: Optional[StarlingXCLICollector] = None,
        fixture: Optional[dict[str, Any]] = None,
    ) -> None:
        super().__init__(ProviderType.WRCP, provider_id)
        self._platform_ip = platform_ip
        self._api_collector = api_collector
        self._cli_collector = cli_collector
        self._fixture = fixture

    @property
    def capabilities(self) -> list[AdapterCapability]:
        return list(_STLINGX_CAPABILITIES)

    def collect(self, **kwargs: Any) -> RawProviderSnapshot:
        """Collect raw data from StarlingX (fixture or live mode)."""
        snapshot_id = f"snap-{_uuid.uuid4().hex[:12]}"
        collected_at = datetime.now(timezone.utc).isoformat()

        fixture = kwargs.get("fixture") or self._fixture
        if fixture is not None:
            return self._collect_from_fixture(fixture, snapshot_id, collected_at)

        api_c = kwargs.get("api_collector") or self._api_collector
        cli_c = kwargs.get("cli_collector") or self._cli_collector
        if api_c is not None or cli_c is not None:
            return self._collect_from_live(api_c, cli_c, snapshot_id, collected_at)

        return RawProviderSnapshot(
            snapshot_id=snapshot_id,
            provider_type=ProviderType.WRCP,
            provider_id=self.provider_id,
            collection_status=OrchestrationStatus.FAILED,
            errors=["[WRCP] No fixture or collectors provided."],
        )

    # ── Fixture mode ────────────────────────────────────────────────────

    def _collect_from_fixture(
        self,
        fixture: dict[str, Any],
        snapshot_id: str,
        collected_at: str,
    ) -> RawProviderSnapshot:
        """Build snapshot from fixture dict."""
        fixture_errors = fixture.get("errors", {})
        merged_alarms = self._merge_alarm_data(
            fixture.get("fm_alarms", []),
            fixture.get("fm_alarm_detail", {}),
        )
        payload: dict[str, Any] = {
            "sysinv_isystems": fixture.get("sysinv_isystems", []),
            "sysinv_ihosts": fixture.get("sysinv_ihosts", []),
            "sysinv_imemorys": fixture.get("sysinv_imemorys", {}),
            "fm_alarms": merged_alarms,
            "fm_event_log": fixture.get("fm_event_log", []),
            "smapi_nodes": fixture.get("smapi_nodes", []),
            "system_health": fixture.get("system_health", {}),
            "software_list": fixture.get("software_list", []),
        }

        provider_id = self._derive_provider_id(payload)
        cap_results = self._build_capability_results(payload, fixture_errors)
        rel_evidence = self._extract_relationship_evidence(payload)
        errors_list = [f"[{k}] {v}" for k, v in fixture_errors.items()]
        status = self._determine_status(cap_results, errors_list)
        source_ev = self._make_source_evidence(provider_id, collected_at, snapshot_id)

        return RawProviderSnapshot(
            snapshot_id=snapshot_id,
            provider_type=ProviderType.WRCP,
            provider_id=provider_id,
            collected_at=collected_at,
            collection_status=status,
            declared_capabilities=list(_STLINGX_CAPABILITIES),
            capability_results=cap_results,
            payload=payload,
            relationship_evidence=rel_evidence,
            source_evidence=source_ev,
            errors=errors_list,
            warnings=[],
        )

    # ── Live mode ───────────────────────────────────────────────────────

    def _collect_from_live(
        self,
        api_c: Optional[StarlingXAPICollector],
        cli_c: Optional[StarlingXCLICollector],
        snapshot_id: str,
        collected_at: str,
    ) -> RawProviderSnapshot:
        """Build snapshot from live API + CLI collectors."""
        api_payload: dict[str, Any] = {}
        api_errors: dict[str, str] = {}
        cli_payload: dict[str, Any] = {}
        cli_errors: dict[str, str] = {}

        if api_c is not None:
            api_payload, api_errors = api_c.collect()
        if cli_c is not None:
            alarm_uuids = [
                a["uuid"] for a in api_payload.get("fm_alarms", [])
                if isinstance(a, dict) and a.get("uuid")
            ]
            cli_payload, cli_errors = cli_c.collect(alarm_uuids)

        merged_alarms = self._merge_alarm_data(
            api_payload.get("fm_alarms", []),
            cli_payload.get("fm_alarm_detail", {}),
        )
        payload: dict[str, Any] = {
            "sysinv_isystems": api_payload.get("sysinv_isystems", []),
            "sysinv_ihosts": api_payload.get("sysinv_ihosts", []),
            "sysinv_imemorys": api_payload.get("sysinv_imemorys", {}),
            "fm_alarms": merged_alarms,
            "fm_event_log": api_payload.get("fm_event_log", []),
            "smapi_nodes": api_payload.get("smapi_nodes", []),
            "system_health": cli_payload.get("system_health", {}),
            "software_list": cli_payload.get("software_list", []),
        }

        all_errors = {**api_errors, **cli_errors}
        provider_id = self._derive_provider_id(payload)
        cap_results = self._build_capability_results(payload, all_errors)
        rel_evidence = self._extract_relationship_evidence(payload)
        errors_list = [f"[{k}] {v}" for k, v in all_errors.items()]
        status = self._determine_status(cap_results, errors_list)
        source_ev = self._make_source_evidence(provider_id, collected_at, snapshot_id)

        return RawProviderSnapshot(
            snapshot_id=snapshot_id,
            provider_type=ProviderType.WRCP,
            provider_id=provider_id,
            collected_at=collected_at,
            collection_status=status,
            declared_capabilities=list(_STLINGX_CAPABILITIES),
            capability_results=cap_results,
            payload=payload,
            relationship_evidence=rel_evidence,
            source_evidence=source_ev,
            errors=errors_list,
            warnings=[],
        )

    # ── Alarm deduplication (REST + CLI merge) ───────────────────────────

    @staticmethod
    def _merge_alarm_data(
        rest_alarms: list[dict[str, Any]],
        cli_detail: dict[str, dict[str, Any]],
    ) -> list[dict[str, Any]]:
        """Merge REST and CLI alarm data by UUID.

        REST: 9 fields. CLI: 16 fields (7 CLI-only).
        If UUID in both → merge dicts (CLI supplements REST), record sources.
        """
        merged: list[dict[str, Any]] = []
        cli_used: set[str] = set()
        for alarm in rest_alarms:
            if not isinstance(alarm, dict):
                continue
            alarm_uuid = alarm.get("uuid", "")
            merged_alarm = dict(alarm)
            if alarm_uuid and alarm_uuid in cli_detail:
                cli_data = cli_detail[alarm_uuid]
                if isinstance(cli_data, dict):
                    for key, value in cli_data.items():
                        if key not in merged_alarm:
                            merged_alarm[key] = value
                    merged_alarm["_sources"] = ["rest", "cli"]
                    cli_used.add(alarm_uuid)
                else:
                    merged_alarm["_sources"] = ["rest"]
            else:
                merged_alarm["_sources"] = ["rest"]
            merged.append(merged_alarm)
        for alarm_uuid, cli_data in cli_detail.items():
            if alarm_uuid in cli_used:
                continue
            if isinstance(cli_data,