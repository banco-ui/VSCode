class StarlingXAPIError(Exception):
    """StarlingX API error with category classification."""

    def __init__(
        self,
        message: str,
        error_category: ErrorCategory = ErrorCategory.UNKNOWN_ERROR,
    ) -> None:
        super().__init__(message)
        self.error_category = error_category


class StarlingXAPICollector:
    """StarlingX REST API collector — 6 confirmed endpoints.

    GET-only. Keystone token authentication via X-Auth-Token header.

    Handles: token auth, multi-service REST calls (sysinv/fm/smapi),
    sub-resource URL pattern for host-scoped resources (imemorys),
    per-endpoint error handling (partial collection),
    auth expiry (401), not found (404), rate limit (429), timeout.
    """

    def __init__(
        self,
        platform_ip: str,
        http_session: Optional[_HttpSession] = None,
        token_provider: Optional[Callable[[], str]] = None,
        timeout: int = DEFAULT_TIMEOUT,
    ) -> None:
        self._platform_ip = platform_ip
        self._session = http_session
        self._token_provider = token_provider
        self._timeout = timeout

    def collect(self) -> tuple[dict[str, Any], dict[str, str]]:
        """Collect all 6 confirmed REST endpoints.

        Returns:
            (payload, errors) — payload has endpoint keys, errors maps key→msg.
        """
        if self._session is None:
            raise RuntimeError(
                "StarlingXAPICollector: no http_session injected. "
                "Pass a fixture to StarlingXProviderAdapter instead."
            )

        payload: dict[str, Any] = {}
        errors: dict[str, str] = {}
        token = self._token_provider() if self._token_provider else None

        for key, service, path in _CONFIRMED_ENDPOINTS:
            try:
                payload[key] = self._get(service, path, token)
            except Exception as exc:
                errors[key] = _sanitize_error_message(exc)
                logger.warning("StarlingX API %s failed: %s", key, _sanitize_error_message(exc))

        # Collect imemorys per host (sub-resource pattern)
        host_list = payload.get("sysinv_ihosts")
        if isinstance(host_list, list):
            imemorys: dict[str, list] = {}
            for host in host_list:
                if not isinstance(host, dict):
                    continue
                host_uuid = host.get("uuid")
                if not host_uuid:
                    continue
                try:
                    mem = self._get(
                        "sysinv", f"/v1/ihosts/{host_uuid}/imemorys", token
                    )
                    imemorys[host_uuid] = mem if isinstance(mem, list) else []
                except Exception as exc:
                    errors[f"sysinv_imemorys/{host_uuid}"] = _sanitize_error_message(exc)
                    logger.warning("imemorys for %s failed: %s", host_uuid, _sanitize_error_message(exc))
            payload["sysinv_imemorys"] = imemorys

        return payload, errors

    def _get(self, service: str, path: str, token: Optional[str]) -> Any:
        """Execute a single GET request to a StarlingX API endpoint."""
        port = _SERVICE_PORTS[service]
        url = f"http://{self._platform_ip}:{port}{path}"
        headers: dict[str, str] = {"Accept": "application/json"}
        if token:
            headers["X-Auth-Token"] = token  # never logged

        # Phase 0.2: Default to verify=True for TLS security
        # For self-signed certs, inject a custom session with verify=False
        response = self._session.get(
            url, headers=headers, timeout=self._timeout, verify=True
        )

        if response.status_code == 401:
            raise StarlingXAPIError(
                f"Auth expired (401) for {path}",
                error_category=ErrorCategory.AUTHENTICATION_ERROR,
            )
        if response.status_code == 404:
            raise StarlingXAPIError(
                f"Endpoint not found (404): {path}",
                error_category=ErrorCategory.PROTOCOL_ERROR,
            )
        if response.status_code == 429:
            raise StarlingXAPIError(
                f"Rate limited (429) for {path}",
                error_category=ErrorCategory.PROTOCOL_ERROR,
            )
        if response.status_code >= 400:
            raise StarlingXAPIError(
                f"HTTP {response.status_code} for {path}",
                error_category=ErrorCategory.UNKNOWN_ERROR,
            )

        data = response.json()
        return self._unwrap(data)

    @staticmethod
    def _unwrap(data: Any) -> Any:
        """Extract list from response wrapper.

        sysinv: {"isystems": [...], "ihosts": [...], "imemorys": [...]}
        fm: {"alarms": [...], "event_log": [...]}
        smapi: [...] (bare list)
        """
        if isinstance(data, list):
            return data
        if isinstance(data, dict):
            list_values = [v for v in data.values() if isinstance(v, list)]
            if len(list_values) == 1:
                return list_values[0]
            return data
        return data


class StarlingXCLIError(Exception):
    """StarlingX CLI execution error."""


class StarlingXCLICollector:
    """StarlingX CLI collector — 3 confirmed commands.

    Allow-list only — no arbitrary command execution.
    Each command: timeout, exit code check, stdout/stderr separation,
    secret masking. CLI failure ≠ data absence.
    """

    def __init__(
        self,
        ssh_client: Optional[_SSHClient] = None,
        timeout: int = DEFAULT_TIMEOUT,
    ) -> None:
        self._ssh = ssh_client
        self._timeout = timeout

    def collect(
        self, alarm_uuids: Optional[list[str]] = None,
    ) -> tuple[dict[str, Any], dict[str, str]]:
        """Collect all 3 confirmed CLI commands."""
        if self._ssh is None:
            raise RuntimeError(
                "StarlingXCLICollector: no ssh_client injected."
            )

        payload: dict[str, Any] = {}
        errors: dict[str, str] = {}

        if alarm_uuids:
            alarm_detail: dict[str, Any] = {}
            for alarm_uuid in alarm_uuids:
                try:
                    alarm_detail[alarm_uuid] = self._exec_fm_alarm_show(alarm_uuid)
                except Exception as exc:
                    errors[f"fm_alarm_show/{alarm_uuid}"] = _sanitize_error_message(exc)
            payload["fm_alarm_detail"] = alarm_detail

        try:
            payload["system_health"] = self._exec_system_health_query()
        except Exception as exc:
            errors["system_health_query"] = _sanitize_error_message(exc)

        try:
            payload["software_list"] = self._exec_software_list()
        except Exception as exc:
            errors["software_list"] = _sanitize_error_message(exc)

        return payload, errors

    def _exec_fm_alarm_show(self, alarm_uuid: str) -> dict[str, Any]:
        exit_code, stdout, stderr = self._exec(f"fm alarm-show {alarm_uuid}")
        if exit_code != 0:
            raise StarlingXCLIError(
                f"fm alarm-show {alarm_uuid} exited {exit_code}: "
                f"{_mask_secrets(stderr.strip())}"
            )
        return _parse_fm_alarm_show(_mask_secrets(stdout))

    def _exec_system_health_query(self) -> dict[str, Any]:
        exit_code, stdout, stderr = self._exec("system health-query")
        if exit_code != 0:
            raise StarlingXCLIError(
                f"system health-query exited {exit_code}: "
                f"{_mask_secrets(stderr.strip())}"
            )
        return _parse_system_health(_mask_secrets(stdout))

    def _exec_software_list(self) -> list[dict[str, Any]]:
        exit_code, stdout, stderr = self._exec("software list")
        if exit_code != 0:
            raise StarlingXCLIError(
                f"software list exited {exit_code}: "
                f"{_mask_secrets(stderr.strip())}"
            )
        return _parse_software_list(_mask_secrets(stdout))

    def _exec(self, command: str) -> tuple[int, str, str]:
        """Execute a CLI command with allow-list validation."""
        if not self._is_allowed(command):
            raise StarlingXCLIError(
                f"Command not in allow-list: {' '.join(command.split()[:2])}"
            )
        return self._ssh.exec_command(command, timeout=self._timeout)

    @staticmethod
    def _is_allowed(command: str) -> bool:
        for allowed in _CONFIRMED_CLI_COMMANDS:
            if command.startswith(allowed):
                return True
        return False


