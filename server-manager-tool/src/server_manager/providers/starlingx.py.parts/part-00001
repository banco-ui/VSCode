#  CLI OUTPUT PARSERS
# ════════════════════════════════════════════════════════════════════════


def _parse_fm_alarm_show(stdout: str) -> dict[str, Any]:
    """Parse fm alarm-show output (16-field key-value table)."""
    result: dict[str, Any] = {}
    for line in stdout.strip().splitlines():
        line = line.strip()
        if line.startswith("|") and line.endswith("|"):
            parts = [p.strip() for p in line.split("|")]
            parts = [p for p in parts if p]
            if len(parts) >= 2:
                result[parts[0]] = parts[1]
    return result


def _parse_system_health(stdout: str) -> dict[str, Any]:
    """Parse 'system health-query' output into a dict."""
    result: dict[str, Any] = {}
    for line in stdout.strip().splitlines():
        line = line.strip()
        if ":" in line:
            key, _, value = line.partition(":")
            result[key.strip()] = value.strip()
    if not result:
        result["raw"] = stdout.strip()
    return result


def _parse_software_list(stdout: str) -> list[dict[str, Any]]:
    """Parse 'software list' output into a list of release dicts."""
    releases: list[dict[str, Any]] = []
    lines = stdout.strip().splitlines()
    if not lines:
        return releases

    header_line = None
    headers: list[str] = []
    for line in lines:
        lower = line.lower()
        if "release" in lower or "state" in lower:
            header_line = line
            break

    if header_line:
        headers = [h.strip() for h in header_line.split("|") if h.strip()]
        header_idx = lines.index(header_line)
        for line in lines[header_idx + 1:]:
            line = line.strip()
            if not line or line.startswith("+") or line.startswith("-"):
                continue
            parts = [p.strip() for p in line.split("|")]
            parts = [p for p in parts if p != ""]
            if len(parts) >= len(headers):
                release: dict[str, Any] = {}
                for i, h in enumerate(headers):
                    release[h] = parts[i]
                releases.append(release)

    return releases


