# ════════════════════════════════════════════════════════════════════════
#  STRICT TYPE CONVERSION HELPERS
# ════════════════════════════════════════════════════════════════════════


def strict_int(value: Any) -> tuple[Optional[int], Optional[str]]:
    """Convert to int. Returns (None, error_msg) on failure. None stays None."""
    if value is None:
        return None, None
    if isinstance(value, bool):
        return None, f"Boolean cannot be converted to int: {value}"
    try:
        return int(value), None
    except (ValueError, TypeError):
        return None, f"Cannot convert to int: '{value}'"


def strict_float(value: Any) -> tuple[Optional[float], Optional[str]]:
    """Convert to float. Returns (None, error_msg) on failure. None stays None."""
    if value is None:
        return None, None
    if isinstance(value, bool):
        return None, f"Boolean cannot be converted to float: {value}"
    try:
        return float(value), None
    except (ValueError, TypeError):
        return None, f"Cannot convert to float: '{value}'"


def strict_bool(value: Any) -> tuple[Optional[bool], Optional[str]]:
    """Convert to bool. Returns (None, error_msg) on failure. None stays None."""
    if value is None:
        return None, None
    if isinstance(value, bool):
        return value, None
    if isinstance(value, str):
        v = value.strip().lower()
        if v in ("true", "1", "yes", "on"):
            return True, None
        if v in ("false", "0", "no", "off"):
            return False, None
        return None, f"Cannot convert to bool: '{value}'"
    if isinstance(value, (int, float)):
        if value in (0, 0.0):
            return False, None
        if value in (1, 1.0):
            return True, None
        return None, f"Cannot convert to bool: {value}"
    return None, f"Cannot convert to bool: '{value}'"


def strict_str(value: Any) -> tuple[Optional[str], Optional[str]]:
    """Convert to str. Returns (None, error_msg) on failure. None stays None."""
    if value is None:
        return None, None
    if isinstance(value, str):
        return value.strip(), None
    return str(value), None


