#  GENERIC PROVIDER NORMALIZER (concrete implementation)
# ════════════════════════════════════════════════════════════════════════


class GenericProviderNormalizer(ProviderNormalizer):
    """Concrete normalizer for generic/synthetic provider payloads.

    Expects a structured payload dict with keys for each entity type:
        payload = {
            "physicals": [...],
            "os": [...],
            "platforms": [...],
            "clusters": [...],
            "nodes": [...],
            "execution_environments": [...],
            "workloads": [...],
            "networks": [...],
            "storages": [...],
            "accelerators": [...],
        }

    Each item is a dict with provider-side fields and refs.
    Refs are provider_id strings, resolved to canonical_ids
    in a second pass after all entities are created.
    """

    def normalize(self, snapshot: RawProviderSnapshot) -> NormalizationResult:
        """Normalize a raw snapshot into canonical entities.

        Process:
            1. Initialize result
            2. Normalize each entity type (first pass)
            3. Resolve provider_id refs to canonical_ids (second pass)
            4. Preserve relationship evidence from snapshot
            5. Determine overall status
        """
        result = NormalizationResult(
            snapshot_id=snapshot.snapshot_id,
            provider_type=snapshot.provider_type,
        )

        id_map: dict[str, str] = {}

        self._normalize_physicals(snapshot, result, id_map)
        self._normalize_os(snapshot, result, id_map)
        self._normalize_platforms(snapshot, result, id_map)
        self._normalize_clusters(snapshot, result, id_map)
        self._normalize_nodes(snapshot, result, id_map)
        self._normalize_execution_environments(snapshot, result, id_map)
        self._normalize_workloads(snapshot, result, id_map)
        self._normalize_networks(snapshot, result, id_map)
        self._normalize_storages(snapshot, result, id_map)
        self._normalize_accelerators(snapshot, result, id_map)

        self._resolve_all_refs(result, id_map)
        result.relationship_evidence = list(snapshot.relationship_evidence)
        self._determine_status(result)

        return result

    @staticmethod
    def _make_source_evidence(snapshot: RawProviderSnapshot) -> SourceEvidence:
        """Create SourceEvidence for a canonical entity from snapshot."""
        return SourceEvidence(
            provider_type=snapshot.provider_type,
            provider_id=snapshot.provider_id,
            collected_at=snapshot.collected_at,
            raw_data_ref=snapshot.snapshot_id,
            confidence=Confidence.HIGH,
            discovery_method=RelationshipEvidenceType.DIRECT,
        )

    @staticmethod
    def _map_enum(
        value: Any,
        enum_map: dict[str, Any],
        field_name: str,
    ) -> tuple[Any, Optional[str]]:
        """Map a provider string to a canonical enum value.

        Returns (enum_value, None) on success.
        Returns (None, None) if value is None (missing, not error).
        Returns (None, error_msg) if value is unknown.
        """
        if value is None:
            return None, None
        if isinstance(value, str) and value in enum_map:
            return enum_map[value], None
        return None, f"Unknown {field_name} value: '{value}'"

    @staticmethod
    def _missing_field_error(
        entity_type: str, field_name: str, provider_ref: Optional[str] = None
    ) -> NormalizationError:
        return NormalizationError(
            entity_type=entity_type,
            provider_ref=provider_ref,
            error_category=ErrorCategory.NORMALIZATION_ERROR,
            message=f"Missing required field: {field_name}",
            field=field_name,
        )

    @staticmethod
    def _determine_status(result: NormalizationResult) -> None:
        """Set result.status based on errors and entity count."""
        if result.errors:
            if result.entity_count > 0:
                result.status = OrchestrationStatus.PARTIAL
            else:
                result.status = OrchestrationStatus.FAILED
        else:
            result.status = OrchestrationStatus.SUCCESS

    # ── Entity: Physical ────────────────────────────────────────────

    def _normalize_physicals(
        self,
        snapshot: RawProviderSnapshot,
        result: NormalizationResult,
        id_map: dict[str, str],
    ) -> None:
        items = snapshot.payload.get("physicals", [])
        if not isinstance(items, list):
            result.errors.append(NormalizationError(
                entity_type="Physical",
                error_category=ErrorCategory.PARSING_ERROR,
                message="'physicals' must be a list",
            ))
            return
        for idx, item in enumerate(items):
            if not isinstance(item, dict):
                result.errors.append(NormalizationError(
                    entity_type="Physical",
                    error_category=ErrorCategory.PARSING_ERROR,
                    message=f"Physical item at index {idx} is not a dict",
                ))
                continue
            provider_id = item.get("provider_id")
            if not provider_id:
                result.errors.append(self._missing_field_error(
                    "Physical", "provider_id"))
                continue
            canonical_id = CanonicalIdentityGenerator.generate(
                snapshot.provider_type, "physical", provider_id, idx
            )
            id_map[provider_id] = canonical_id
            result.physicals.append(Physical(
                canonical_id=canonical_id,
                provider_id=provider_id,
                provider_type=snapshot.provider_type,
                source_evidence=self._make_source_evidence(snapshot),
                metadata=item.get("metadata", {}),
                os_refs=item.get("os_refs", []),
                node_refs=item.get("node_refs", []),
                execution_environment_refs=item.get("execution_environment_refs", []),
                network_refs=item.get("network_refs", []),
                storage_refs=item.get("storage_refs", []),
                accelerator_refs=item.get("accelerator_refs", []),
            ))

    # ── Entity: OS ──────────────────────────────────────────────────

    def _normalize_os(
        self,
        snapshot: RawProviderSnapshot,
        result: NormalizationResult,
        id_map: dict[str, str],
    ) -> None:
        items = snapshot.payload.get("os", [])
        if not isinstance(items, list):
            result.errors.append(NormalizationError(
                entity_type="OS",
                error_category=ErrorCategory.PARSING_ERROR,
                message="'os' must be a list",
            ))
            return
        for idx, item in enumerate(items):
            if not isinstance(item, dict):
                result.errors.append(NormalizationError(
                    entity_type="OS",
                    error_category=ErrorCategory.PARSING_ERROR,
                    message=f"OS item at index {idx} is not a dict",
                ))
                continue
            provider_id = item.get("provider_id")
            if not provider_id:
                result.errors.append(self._missing_field_error(
                    "OS", "provider_id"))
                continue
