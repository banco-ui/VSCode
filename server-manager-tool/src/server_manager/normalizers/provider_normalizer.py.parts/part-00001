class NormalizationError(BaseModel):
    """A single normalization error.

    Captures a specific normalization failure with enough context
    to identify which entity and field caused the error.

    Error categories reuse ErrorCategory from orchestrator.models:
      - NORMALIZATION_ERROR: field mapping/conversion failure
      - PARSING_ERROR: malformed payload structure
      - UNSUPPORTED: unknown provider representation
    """

    entity_type: str
    provider_ref: Optional[str] = None
    error_category: ErrorCategory = ErrorCategory.NORMALIZATION_ERROR
    message: str
    field: Optional[str] = None

    model_config = {"extra": "forbid"}


# ════════════════════════════════════════════════════════════════════════
#  NORMALIZATION RESULT
# ════════════════════════════════════════════════════════════════════════


class NormalizationResult(BaseModel):
    """Result of normalizing a RawProviderSnapshot into canonical entities.

    Entities are stored in typed lists per canonical entity type.
    This avoids untyped list[CanonicalEntity] which would lose
    subclass field validation due to extra="forbid" on CanonicalEntity.

    Status semantics:
        SUCCESS: all entities normalized without errors
        PARTIAL: some entities normalized, some errors occurred
        FAILED: no entities normalized, errors occurred
        Empty result with no errors = SUCCESS (empty is not failure)
    """

    snapshot_id: str = Field(min_length=1)
    provider_type: ProviderType
    status: OrchestrationStatus = OrchestrationStatus.SUCCESS

    # Canonical entities (typed per entity type)
    physicals: list[Physical] = Field(default_factory=list)
    os_entities: list[OS] = Field(default_factory=list)
    platforms: list[Platform] = Field(default_factory=list)
    clusters: list[Cluster] = Field(default_factory=list)
    nodes: list[Node] = Field(default_factory=list)
    execution_environments: list[ExecutionEnvironment] = Field(default_factory=list)
    workloads: list[Workload] = Field(default_factory=list)
    networks: list[Network] = Field(default_factory=list)
    storages: list[Storage] = Field(default_factory=list)
    accelerators: list[Accelerator] = Field(default_factory=list)

    # Preserved from snapshot (provider-side refs, not resolved)
    relationship_evidence: list[RawRelationshipEvidence] = Field(default_factory=list)

    # Errors and warnings
    errors: list[NormalizationError] = Field(default_factory=list)
    warnings: list[str] = Field(default_factory=list)

    normalized_at: str = Field(
        default_factory=lambda: datetime.now(timezone.utc).isoformat()
    )

    model_config = {"extra": "forbid"}

    @property
    def entity_count(self) -> int:
        """Total number of canonical entities produced."""
        return (
            len(self.physicals)
            + len(self.os_entities)
            + len(self.platforms)
            + len(self.clusters)
            + len(self.nodes)
            + len(self.execution_environments)
            + len(self.workloads)
            + len(self.networks)
            + len(self.storages)
            + len(self.accelerators)
        )

    @property
    def is_empty(self) -> bool:
        """True if no canonical entities were produced."""
        return self.entity_count == 0

    @property
    def is_partial(self) -> bool:
        """True if some entities were produced but errors occurred."""
        return self.status == OrchestrationStatus.PARTIAL

    @property
    def is_success(self) -> bool:
        """True if normalization completed without errors."""
        return self.status == OrchestrationStatus.SUCCESS


