#  CANONICAL IDENTITY GENERATOR
# ════════════════════════════════════════════════════════════════════════


class CanonicalIdentityGenerator:
    """Deterministic canonical ID generator.

    Generates namespace-qualified canonical IDs that are guaranteed
    to differ from provider_id.

    Format: canon-{provider_type}-{entity_kind}-{provider_ref}

    This is NOT a random ID strategy. It is deterministic and
    namespace-qualified, ensuring:
      - canonical_id != provider_id (always, due to "canon-" prefix)
      - Same provider_ref always produces same canonical_id
      - Different provider types produce different canonical_ids

    If provider_ref is missing, uses an index-based fallback.
    """

    @staticmethod
    def generate(
        provider_type: ProviderType,
        entity_kind: str,
        provider_ref: Optional[str],
        index: Optional[int] = None,
    ) -> str:
        """Generate a deterministic canonical ID.

        Args:
            provider_type: Provider type (KUBERNETES, WRCP, etc.)
            entity_kind: Entity kind (physical, os, node, etc.)
            provider_ref: Provider-side identifier (provider_id)
            index: Fallback index if provider_ref is None/empty

        Returns:
            Deterministic canonical ID string.
        """
        pt = provider_type.value.lower()
        kind = entity_kind.lower()
        if provider_ref and provider_ref.strip():
            ref = provider_ref.strip()
        elif index is not None:
            ref = f"idx-{index}"
        else:
            ref = "unidentified"
        return f"canon-{pt}-{kind}-{ref}"


