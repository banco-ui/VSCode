#  PROVIDER NORMALIZER ABC
# ════════════════════════════════════════════════════════════════════════


class ProviderNormalizer(ABC):
    """Abstract base for provider-to-canonical normalizers.

    Transforms RawProviderSnapshot -> Canonical Domain Model entities.

    Contract:
        normalize(snapshot) -> NormalizationResult
        normalize_safe(snapshot) -> NormalizationResult (never raises)

    The normalizer:
      - Extracts raw payload fields
      - Maps provider fields -> canonical fields
      - Performs deterministic type conversion
      - Maps provider enums -> canonical enums
      - Generates canonical IDs (deterministic, namespace-qualified)
      - Propagates provenance from snapshot to entities
      - Preserves DIRECT/DERIVED relationship evidence
      - Reports explicit errors for missing/invalid data

    The normalizer does NOT:
      - Connect to providers
      - Verify data semantics
      - Persist data
      - Orchestrate workflows
      - Infer/guess missing data
      - Create INFERRED/UNKNOWN relationships
      - Use LLM/heuristic/fuzzy matching
    """

    def __init__(self, provider_type: ProviderType) -> None:
        self._provider_type = provider_type

    @property
    def provider_type(self) -> ProviderType:
        return self._provider_type

    @abstractmethod
    def normalize(self, snapshot: RawProviderSnapshot) -> NormalizationResult:
        """Normalize a raw snapshot into canonical entities.

        Args:
            snapshot: Raw provider snapshot to normalize.

        Returns:
            NormalizationResult with canonical entities, errors, and warnings.

        Raises:
            This method should catch internal errors and report them
            in the result, not raise. Use normalize_safe() for a
            guaranteed non-raising wrapper.
        """
        ...

    def normalize_safe(self, snapshot: RawProviderSnapshot) -> NormalizationResult:
        """Normalize with error handling. Returns FAILED result on exception.

        This method wraps normalize() and catches any unhandled exception,
        converting it to a FAILED NormalizationResult.
        """
        try:
            return self.normalize(snapshot)
        except Exception as exc:
            logger.exception(
                "Unhandled exception during normalization: %s", exc
            )
            return NormalizationResult(
                snapshot_id=snapshot.snapshot_id,
                provider_type=snapshot.provider_type,
                status=OrchestrationStatus.FAILED,
                errors=[
                    NormalizationError(
                        entity_type="UNKNOWN",
                        provider_ref=None,
                        error_category=ErrorCategory.NORMALIZATION_ERROR,
                        message=f"Unhandled normalization exception: {exc}",
                    )
                ],
            )


