    # ── Second Pass: Resolve provider_id refs → canonical_ids ────────

    def _resolve_all_refs(
        self, result: NormalizationResult, id_map: dict[str, str],
    ) -> None:
        """Resolve provider_id refs to canonical_ids in all entities."""

        def resolve_list(refs: list[str]) -> list[str]:
            return [id_map.get(r, r) for r in refs]

        def resolve_single(ref: Optional[str]) -> Optional[str]:
            if ref is None:
                return None
            return id_map.get(ref, ref)

        for p in result.physicals:
            p.os_refs = resolve_list(p.os_refs)
            p.node_refs = resolve_list(p.node_refs)
            p.execution_environment_refs = resolve_list(p.execution_environment_refs)
            p.network_refs = resolve_list(p.network_refs)
            p.storage_refs = resolve_list(p.storage_refs)
            p.accelerator_refs = resolve_list(p.accelerator_refs)

        for o in result.os_entities:
            o.physical_ref = resolve_single(o.physical_ref)
            o.execution_environment_ref = resolve_single(o.execution_environment_ref)

        for pf in result.platforms:
            pf.cluster_refs = resolve_list(pf.cluster_refs)

        for c in result.clusters:
            c.platform_ref = resolve_single(c.platform_ref)
            c.node_refs = resolve_list(c.node_refs)

        for n in result.nodes:
            n.cluster_ref = resolve_single(n.cluster_ref)
            n.physical_ref = resolve_single(n.physical_ref)
            n.execution_environment_refs = resolve_list(n.execution_environment_refs)

        for ee in result.execution_environments:
            ee.physical_ref = resolve_single(ee.physical_ref)
            ee.node_ref = resolve_single(ee.node_ref)
            ee.os_ref = resolve_single(ee.os_ref)
            ee.workload_ref = resolve_single(ee.workload_ref)
            ee.accelerator_refs = resolve_list(ee.accelerator_refs)

        for w in result.workloads:
            w.execution_environment_refs = resolve_list(w.execution_environment_refs)
            w.network_refs = resolve_list(w.network_refs)
            w.storage_refs = resolve_list(w.storage_refs)

        for a in result.accelerators:
            a.physical_ref = resolve_single(a.physical_ref)
            a.execution_environment_ref = resolve_single(a.execution_environment_ref)

