"""Recovery / Remediation Service — Phase 18.

Provider-neutral recovery service for safely defining, evaluating,
and executing remediation actions on canonical entities with detected faults.

Pipeline:
    Fault (Phase 17)
        ↓
    RecoveryCandidate (proposed)
        ↓
    Safety Gate (PASS / BLOCKED)
        ↓
    Authorization (EXECUTE required for mutation)
        ↓
    Preview (dry-run, no mutation)
        ↓
    Execution (if execution_enabled=True)
        ↓
    Post-Action Verification
        ↓
    RecoveryExecutionResult

SAFETY PRINCIPLES:
    - AUTOMATIC_RECOVERY = DISABLED by default
    - No provider API calls unless execution_enabled=True AND safety PASS
    - No inference: fault evidence required
    - Pod != Workload (Phase 13E policy preserved)
    - No escalation on failure
    - Idempotency: same (fault_id, action_type, target_entity_id) → no duplicate
"""
from __future__ import annotations

from abc import ABC, abstractmethod
from datetime import datetime, timezone
from typing import Any, Optional

from server_manager.fault.models import Fault, FaultType
from server_manager.graph.service import GraphQuery
from server_manager.models.canonical import ProviderType

from .models import (
    AuthorizationLevel,
    RecoveryAction,
    RecoveryActionParameters,
    RecoveryActionType,
    RecoveryCandidate,
    RecoveryCandidateStatus,
    RecoveryExecutionResult,
    RecoveryExecutionStatus,
    RecoveryPreview,
    SafetyBlockReason,
    SafetyGateResult,
    SafetyResult,
)

# Fault types that may produce a recovery candidate.
_ACTIONABLE_FAULT_TYPES: set[FaultType] = {
    FaultType.HEALTH_FAILURE,
    FaultType.HEALTH_DEGRADED,
    FaultType.AVAILABILITY_FAILURE,
}

_DEFAULT_ACTION_TYPE: dict[FaultType, RecoveryActionType] = {
    FaultType.HEALTH_FAILURE: RecoveryActionType.RESTART_EXECUTION_ENVIRONMENT,
    FaultType.HEALTH_DEGRADED: RecoveryActionType.RESTART_EXECUTION_ENVIRONMENT,
    FaultType.AVAILABILITY_FAILURE: RecoveryActionType.RESTART_EXECUTION_ENVIRONMENT,
}



class RecoverySafetyGate:
    """Safety gate for recovery actions.

    Evaluates whether a recovery action may proceed to execution.
    Returns PASS only if ALL checks pass.

    Default: execution_enabled=False — everything is BLOCKED.

    Checks:
        1. Target exists (non-empty)
        2. Fault evidence exists (non-empty)
        3. Fault is actionable (not UNKNOWN, not ambiguous)
        4. Provider known (not UNKNOWN)
        5. Action supported by provider
        6. No duplicate recovery already active
        7. Execution explicitly enabled
        8. Authorization sufficient (EXECUTE for actual mutation)
    """

    def __init__(
        self,
        execution_enabled: bool = False,
        active_identity_keys: Optional[set[str]] = None,
    ) -> None:
        self._execution_enabled = execution_enabled
        self._active_identity_keys = active_identity_keys or set()

    def evaluate(
        self,
        action: RecoveryAction,
        fault: Fault,
        supported_actions: set[RecoveryActionType],
        authorization: AuthorizationLevel = AuthorizationLevel.READ_ONLY,
    ) -> SafetyGateResult:
        """Evaluate all safety checks. Returns PASS only if all pass."""
        checks_passed: list[str] = []
        checks_failed: list[str] = []

        # 1. Target exists
        if not action.target_entity_id or not action.target_entity_id.strip():
            checks_failed.append("target_exists")
            return SafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=SafetyBlockReason.INVALID_TARGET,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        checks_passed.append("target_exists")

        # 2. Fault evidence exists
        if not fault.evidence:
            checks_failed.append("fault_evidence")
            return SafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=SafetyBlockReason.MISSING_FAULT_EVIDENCE,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        checks_passed.append("fault_evidence")

        # 3. Fault is actionable
        if fault.fault_type not in _ACTIONABLE_FAULT_TYPES:
            checks_failed.append("fault_actionable")
            return SafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=SafetyBlockReason.FAULT_NOT_ACTIONABLE,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        checks_passed.append("fault_actionable")

        # 4. Provider known
        if action.provider_type == ProviderType.UNKNOWN:
            checks_failed.append("provider_known")
            return SafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=SafetyBlockReason.UNKNOWN_PROVIDER,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        checks_passed.append("provider_known")

        # 5. Action supported
        if action.action_type not in supported_actions:
            checks_failed.append("action_supported")
            return SafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=SafetyBlockReason.UNSUPPORTED_ACTION,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        checks_passed.append("action_supported")

        # 6. No duplicate recovery
        if action.identity_key in self._active_identity_keys:
            checks_failed.append("no_duplicate")
            return SafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=SafetyBlockReason.DUPLICATE_RECOVERY,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        checks_passed.append("no_duplicate")

        # 7. Execution explicitly enabled
        if not self._execution_enabled:
            checks_failed.append("execution_enabled")
            return SafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=SafetyBlockReason.EXECUTION_NOT_ENABLED,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        checks_passed.append("execution_enabled")

        # 8. Authorization sufficient
        if authorization < AuthorizationLevel.EXECUTE:
            checks_failed.append("authorization")
            return SafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=SafetyBlockReason.INSUFFICIENT_AUTHORIZATION,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        checks_passed.append("authorization")

        return SafetyGateResult(
            result=SafetyResult.PASS,
            checks_passed=checks_passed,
            checks_failed=checks_failed,
        )

