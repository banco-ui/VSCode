class RecoveryGraphContext:
    """Read-only graph context lookup for recovery.

    Uses Phase 16 GraphQuery to look up related entities for a fault target.
    Graph is used for CONTEXT ONLY — not for inferring causality or
    expanding recovery targets.

    Graph relationship != Recovery causality.
    """

    def __init__(self, graph_query: GraphQuery) -> None:
        self._query = graph_query

    def get_target_node(self, canonical_id: str) -> Optional[Any]:
        """Get the graph node for the recovery target."""
        return self._query.get_node(canonical_id)

    def get_related_entities(self, canonical_id: str) -> list[str]:
        """Get neighbor canonical_ids for context only.

        This does NOT infer causality or expand recovery targets.
        """
        return self._query.get_neighbors(canonical_id)

    def get_relationships(self, canonical_id: str) -> list[Any]:
        """Get relationships for context lookup."""
        return self._query.get_relationships(canonical_id)


