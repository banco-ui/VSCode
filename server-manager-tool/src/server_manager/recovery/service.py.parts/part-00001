#  MOCK RECOVERY EXECUTOR
# ════════════════════════════════════════════════════════════════════════


class MockRecoveryExecutor(RecoveryExecutor):
    """Mock recovery executor for testing.

    Simulates execution without any real provider mutation.
    Supports configurable success/failure/timeout behavior.

    This is the ONLY executor that can be used in tests.
    No real provider mutation is performed.
    """

    def __init__(
        self,
        simulate_failure: bool = False,
        simulate_timeout: bool = False,
    ) -> None:
        self._simulate_failure = simulate_failure
        self._simulate_timeout = simulate_timeout
        self._executed_actions: dict[str, RecoveryExecutionResult] = {}

    def preview(self, action: RecoveryAction) -> RecoveryPreview:
        """Generate a deterministic dry-run preview."""
        return RecoveryPreview(
            action=action,
            expected_effect=f"Mock preview: {action.action_type.value} on {action.target_entity_id}",
            safety_result=SafetyResult.PASS,
            supported=True,
        )

    def execute(self, action: RecoveryAction) -> RecoveryExecutionResult:
        """Simulate execution without real mutation."""
        now = datetime.now(timezone.utc).isoformat()

        if self._simulate_failure:
            result = RecoveryExecutionResult(
                action_id=action.action_id,
                status=RecoveryExecutionStatus.FAILED,
                started_at=now,
                completed_at=now,
                provider=action.provider_type,
                target=action.target_entity_id,
                error="Simulated execution failure",
            )
            self._executed_actions[action.action_id] = result
            return result

        if self._simulate_timeout:
            result = RecoveryExecutionResult(
                action_id=action.action_id,
                status=RecoveryExecutionStatus.FAILED,
                started_at=now,
                completed_at=now,
                provider=action.provider_type,
                target=action.target_entity_id,
                error="Simulated execution timeout",
            )
            self._executed_actions[action.action_id] = result
            return result

        result = RecoveryExecutionResult(
            action_id=action.action_id,
            status=RecoveryExecutionStatus.EXECUTED,
            started_at=now,
            completed_at=now,
            provider=action.provider_type,
            target=action.target_entity_id,
            evidence={"mock": True, "action_type": action.action_type.value},
        )
        self._executed_actions[action.action_id] = result
        return result

    def verify(
        self, action: RecoveryAction,
        post_health: Optional[Any] = None,
    ) -> RecoveryExecutionResult:
        """Verify post-action state using provided HealthResult.

        No post_health → VERIFICATION_FAILED.
        post_health with HEALTHY status → VERIFIED.
        post_health with non-HEALTHY status → VERIFICATION_FAILED.
        """
        now = datetime.now(timezone.utc).isoformat()

        if post_health is None:
            return RecoveryExecutionResult(
                action_id=action.action_id,
                status=RecoveryExecutionStatus.VERIFICATION_FAILED,
                completed_at=now,
                provider=action.provider_type,
                target=action.target_entity_id,
                error="No post-action health evidence provided",
            )

        health_status = getattr(post_health, "status", None)

        if health_status is not None and health_status.value == "HEALTHY":
            return RecoveryExecutionResult(
                action_id=action.action_id,
                status=RecoveryExecutionStatus.VERIFIED,
                completed_at=now,
                provider=action.provider_type,
                target=action.target_entity_id,
                evidence={
                    "verification_source": "post_action_health",
                    "health_status": "HEALTHY",
                },
            )

        return RecoveryExecutionResult(
            action_id=action.action_id,
            status=RecoveryExecutionStatus.VERIFICATION_FAILED,
            completed_at=now,
            provider=action.provider_type,
            target=action.target_entity_id,
            error=f"Post-action health status: {health_status}",
        )


