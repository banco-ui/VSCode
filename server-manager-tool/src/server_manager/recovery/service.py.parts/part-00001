class RecoveryService:
    """Provider-neutral recovery orchestration service.

    Coordinates the recovery pipeline:
        Fault → Candidate → Safety Gate → Preview → Execute → Verify

    SAFETY: execution_enabled defaults to False.
    No recovery is executed unless explicitly enabled.

    Idempotency: same (fault_id, action_type, target) → returns existing candidate.
    No escalation: failure does not auto-trigger other actions.
    """

    def __init__(
        self,
        executor: RecoveryExecutor,
        safety_gate: Optional[RecoverySafetyGate] = None,
        supported_actions: Optional[set[RecoveryActionType]] = None,
        execution_enabled: bool = False,
        authorization: AuthorizationLevel = AuthorizationLevel.READ_ONLY,
    ) -> None:
        self._executor = executor
        self._safety_gate = safety_gate or RecoverySafetyGate(
            execution_enabled=execution_enabled,
        )
        self._supported_actions = supported_actions or set()
        self._execution_enabled = execution_enabled
        self._authorization = authorization
        self._active_candidates: dict[str, RecoveryCandidate] = {}
        self._execution_results: dict[str, RecoveryExecutionResult] = {}

    @property
    def execution_enabled(self) -> bool:
        return self._execution_enabled

    def set_execution_enabled(self, enabled: bool) -> None:
        """Explicitly enable or disable execution."""
        self._execution_enabled = enabled
        self._safety_gate = RecoverySafetyGate(
            execution_enabled=enabled,
            active_identity_keys=set(self._active_candidates.keys()),
        )

    def set_authorization(self, auth: AuthorizationLevel) -> None:
        """Set the authorization level."""
        self._authorization = auth

    def propose_candidate(
        self,
        fault: Fault,
        action_type: Optional[RecoveryActionType] = None,
        target_entity_id: Optional[str] = None,
    ) -> Optional[RecoveryCandidate]:
        """Propose a recovery candidate from a fault.

        Returns None if fault type is not actionable.
        Does NOT execute anything — candidate is just a proposal.

        UNKNOWN faults, missing evidence, and non-actionable fault types
        produce no candidate.
        """
        if fault.fault_type not in _ACTIONABLE_FAULT_TYPES:
            return None

        if not fault.evidence:
            return None

        at = action_type or _DEFAULT_ACTION_TYPE.get(
            fault.fault_type, RecoveryActionType.RESTART,
        )
        target = target_entity_id or fault.entity_id

        action = RecoveryAction(
            action_id=f"ra-{fault.fault_id}-{at.value}",
            action_type=at,
            target_entity_id=target,
            provider_type=(
                fault.source.provider_type if fault.source
                else ProviderType.UNKNOWN
            ),
            fault_id=fault.fault_id,
            reason=f"Recovery candidate for {fault.fault_type.value}",
        )

        if action.identity_key in self._active_candidates:
            return self._active_candidates[action.identity_key]

        candidate = RecoveryCandidate(
            candidate_id=f"cand-{fault.fault_id}-{at.value}",
            fault=fault,
            action=action,
            evidence=dict(fault.evidence),
        )
        self._active_candidates[action.identity_key] = candidate
        return candidate


    def preview(self, candidate: RecoveryCandidate) -> RecoveryPreview:
        """Generate a dry-run preview without mutation."""
        safety = self._safety_gate.evaluate(
            action=candidate.action,
            fault=candidate.fault,
            supported_actions=self._supported_actions,
            authorization=self._authorization,
        )
        preview = self._executor.preview(candidate.action)
        preview.safety_result = safety.result
        preview.safety_reason = safety.reason
        return preview

    def execute(
        self, candidate: RecoveryCandidate,
    ) -> RecoveryExecutionResult:
        """Execute the recovery action if safety gate passes.

        Returns BLOCKED if safety gate blocks.
        Returns execution result otherwise.
        """
        safety = self._safety_gate.evaluate(
            action=candidate.action,
            fault=candidate.fault,
            supported_actions=self._supported_actions,
            authorization=self._authorization,
        )

        if safety.result == SafetyResult.BLOCKED:
            candidate.status = RecoveryCandidateStatus.BLOCKED
            candidate.block_reason = safety.reason
            reason_str = safety.reason.value if safety.reason else "unknown"
            result = RecoveryExecutionResult(
                action_id=candidate.action.action_id,
                status=RecoveryExecutionStatus.BLOCKED,
                provider=candidate.action.provider_type,
                target=candidate.action.target_entity_id,
                error=f"Blocked: {reason_str}",
            )
            self._execution_results[candidate.action.action_id] = result
            return result

        exec_result = self._executor.execute(candidate.action)
        self._execution_results[candidate.action.action_id] = exec_result

        if exec_result.status == RecoveryExecutionStatus.EXECUTED:
            candidate.status = RecoveryCandidateStatus.EXECUTED
        elif exec_result.status == RecoveryExecutionStatus.FAILED:
            candidate.status = RecoveryCandidateStatus.FAILED

        return exec_result

    def verify(
        self,
        candidate: RecoveryCandidate,
        post_health: Optional[Any] = None,
    ) -> RecoveryExecutionResult:
        """Verify post-action state.

        Requires explicit post-action HealthResult as evidence.
        No evidence → VERIFICATION_FAILED.
        """
        result = self._executor.verify(candidate.action, post_health)
        self._execution_results[candidate.action.action_id] = result

        if result.status == RecoveryExecutionStatus.VERIFIED:
            candidate.status = RecoveryCandidateStatus.VERIFIED
        elif result.status == RecoveryExecutionStatus.VERIFICATION_FAILED:
            candidate.status = RecoveryCandidateStatus.FAILED

        return result

    def get_execution_result(
        self, action_id: str,
    ) -> Optional[RecoveryExecutionResult]:
        """Get the execution result for an action (in-memory)."""
        return self._execution_results.get(action_id)

    def get_candidate(self, identity_key: str) -> Optional[RecoveryCandidate]:
        """Get an active candidate by identity key."""
        return self._active_candidates.get(identity_key)

