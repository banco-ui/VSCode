#  RECOVERY EXECUTOR (abstract)
# ════════════════════════════════════════════════════════════════════════


class RecoveryExecutor(ABC):
    """Provider-neutral recovery executor interface.

    The executor receives an already-validated RecoveryAction.
    It does NOT perform discovery, safety checks, or authorization —
    those are done by the safety gate and service before calling execute().

    Execution != Verification:
        execute()  → EXECUTED (action ran, not yet verified)
        verify()   → VERIFIED or VERIFICATION_FAILED
    """

    @abstractmethod
    def preview(self, action: RecoveryAction) -> RecoveryPreview:
        """Generate a dry-run preview without mutation."""
        ...

    @abstractmethod
    def execute(self, action: RecoveryAction) -> RecoveryExecutionResult:
        """Execute the recovery action.

        Returns EXECUTED (not VERIFIED) if the action ran.
        Verification is a separate step.
        """
        ...

    @abstractmethod
    def verify(
        self, action: RecoveryAction,
        post_health: Optional[Any] = None,
    ) -> RecoveryExecutionResult:
        """Verify post-action state.

        Verification requires evidence — a successful API call alone
        does NOT qualify as VERIFIED.
        """
        ...


