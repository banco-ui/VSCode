#  OPERATION SERVICE
# ════════════════════════════════════════════════════════════════════════


class OperationService:
    """Orchestrates the full cross-platform operation pipeline.

    Ties together target resolution, capability resolution, safety gate,
    preview, execution, and post-action verification.

    Usage::

        service = OperationService(
            target_resolver=resolver,
            capability_resolver=cap_resolver,
            executor=mock_executor,
        )
        preview = service.preview(request)
        result = service.execute(request)  # only if execution_enabled
    """

    def __init__(
        self,
        target_resolver: TargetResolver,
        capability_resolver: CapabilityResolver,
        executor: OperationExecutor,
        graph_context: Optional[OperationGraphContext] = None,
    ) -> None:
        self._target_resolver = target_resolver
        self._capability_resolver = capability_resolver
        self._executor = executor
        self._graph_context = graph_context
        self._active_keys: set[str] = set()
        self._completed_keys: set[str] = set()

    def preview(self, request: OperationRequest) -> OperationPreview:
        """Generate a deterministic preview without mutation.

        Preview performs no provider API calls and no mutations.
        """
        target = self._target_resolver.resolve(
            request.target_canonical_id,
            self._graph_context,
        )
        capability = self._capability_resolver.resolve(
            target.provider_type if target.resolved else request.provider_type,
            request.operation_type,
        )
        return self._executor.preview(request, target, capability)

    def evaluate_safety(
        self, request: OperationRequest,
    ) -> OperationSafetyGateResult:
        """Evaluate safety gate without executing."""
        target = self._target_resolver.resolve(
            request.target_canonical_id,
            self._graph_context,
        )
        capability = self._capability_resolver.resolve(
            target.provider_type if target.resolved else request.provider_type,
            request.operation_type,
        )
        gate = OperationSafetyGate(active_identity_keys=self._active_keys)
        return gate.evaluate(
            request=request,
            target_resolution=target,
            capability=capability,
            authorization=request.authorization,
        )

    def execute(self, request: OperationRequest) -> OperationResult:
        """Execute an operation through the full pipeline.

        Only executes if all safety gates pass and execution is enabled.
        """
        # 1. Target resolution
        target = self._target_resolver.resolve(
            request.target_canonical_id,
            self._graph_context,
        )

        # 2. Capability resolution
        capability = self._capability_resolver.resolve(
            target.provider_type if target.resolved else request.provider_type,
            request.operation_type,
        )

        # 3. Safety gate
        gate = OperationSafetyGate(
            active_identity_keys=self._active_keys | self._completed_keys
        )
        safety = gate.evaluate(
            request=request,
            target_resolution=target,
            capability=capability,
            authorization=request.authorization,
        )

        if safety.result != SafetyResult.PASS:
            return OperationResult(
                operation_id=request.operation_id,
                status=OperationStatus.BLOCKED,
                provider=target.provider_type,
                target=request.target_canonical_id,
                resolved_target=target if target.resolved else None,
                error=safety.reason.value if safety.reason else "BLOCKED",
            )

        # 4. Register active for idempotency
        self._active_keys.add(request.identity_key)

        # 5. Execute
        execution_result = self._executor.execute(request, target)

        # 6. Verify (only if execution succeeded)
        if execution_result.status == OperationStatus.EXECUTED:
            verified = self._executor.verify(request, target, execution_result)
            if verified.status == OperationStatus.VERIFIED:
                self._active_keys.discard(request.identity_key)
                self._completed_keys.add(request.identity_key)
            elif verified.status == OperationStatus.VERIFICATION_FAILED:
                self._active_keys.discard(request.identity_key)
            return verified

        # Execution failed — remove from active
        self._active_keys.discard(request.identity_key)
        return execution_result

