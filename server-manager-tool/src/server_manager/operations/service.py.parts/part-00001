# ════════════════════════════════════════════════════════════════════════
#  OPERATION GRAPH CONTEXT
# ════════════════════════════════════════════════════════════════════════


class OperationGraphContext:
    """Read-only graph context for operations.

    Uses Phase 16 GraphQuery for context lookup ONLY.
    Graph relationship ≠ Operation causality.
    No graph mutation, no inference.
    """

    def __init__(self, graph_query: Optional[GraphQuery] = None) -> None:
        self._query = graph_query

    def get_node(self, canonical_id: str) -> Optional[Any]:
        """Get graph node by canonical_id."""
        if self._query is None:
            return None
        return self._query.get_node(canonical_id)

    def get_neighbors(self, canonical_id: str) -> list[str]:
        """Get neighbor canonical_ids (read-only context)."""
        if self._query is None:
            return []
        return self._query.get_neighbors(canonical_id)

    def get_relationships(self, canonical_id: str) -> list[Any]:
        """Get relationships for a node (read-only context)."""
        if self._query is None:
            return []
        return self._query.get_relationships(canonical_id)



# ════════════════════════════════════════════════════════════════════════
#  CAPABILITY RESOLVER
# ════════════════════════════════════════════════════════════════════════


class CapabilityResolver:
    """Resolves whether a provider supports a given operation type.

    Provider capability must be explicitly registered.
    UNKNOWN → CapabilityDecision.UNKNOWN (NOT SUPPORTED).
    No inference: capability is not assumed from operation name existence.
    """

    def __init__(self) -> None:
        self._capabilities: dict[ProviderType, set[OperationType]] = {}

    def register(
        self,
        provider_type: ProviderType,
        operations: set[OperationType],
    ) -> None:
        """Explicitly register supported operations for a provider."""
        self._capabilities[provider_type] = set(operations)

    def resolve(
        self,
        provider_type: ProviderType,
        operation_type: OperationType,
    ) -> CapabilityDecision:
        """Resolve capability for a provider + operation."""
        if provider_type == ProviderType.UNKNOWN:
            return CapabilityDecision.UNKNOWN
        supported = self._capabilities.get(provider_type)
        if supported is None:
            return CapabilityDecision.UNKNOWN
        if operation_type in supported:
            return CapabilityDecision.SUPPORTED
        return CapabilityDecision.UNSUPPORTED


# ════════════════════════════════════════════════════════════════════════
#  TARGET RESOLVER
# ════════════════════════════════════════════════════════════════════════


class TargetResolver:
    """Resolves operation targets deterministically.

    Primary identity: canonical_id.
    No inference from hostname, naming conventions, or labels.
    If target cannot be resolved deterministically → TARGET_UNRESOLVED.
    """

    def __init__(self) -> None:
        self._targets: dict[str, TargetResolution] = {}

    def register_target(
        self,
        canonical_id: str,
        provider_type: ProviderType,
        provider_id: Optional[str] = None,
        entity_type: str = "",
        evidence: Optional[dict[str, Any]] = None,
    ) -> None:
        """Register a known target for resolution."""
        self._targets[canonical_id] = TargetResolution(
            resolved=True,
            canonical_id=canonical_id,
            provider_id=provider_id,
            provider_type=provider_type,
            entity_type=entity_type,
            evidence=evidence or {},
            ambiguous=False,
        )

    def resolve(
        self,
        canonical_id: str,
        graph_context: Optional[OperationGraphContext] = None,
    ) -> TargetResolution:
        """Resolve a target by canonical_id."""
        target = self._targets.get(canonical_id)
        if target is not None:
            return target
        if graph_context is not None:
            node = graph_context.get_node(canonical_id)
            if node is not None:
                return TargetResolution(
                    resolved=True,
                    canonical_id=canonical_id,
                    provider_type=node.provider_type,
                    entity_type=node.entity_type.value
                    if hasattr(node.entity_type, "value")
                    else str(node.entity_type),
                    evidence={"graph_node": True},
                    ambiguous=False,
                )
        return TargetResolution(
            resolved=False,
            canonical_id=canonical_id,
            ambiguous=False,
        )


# ════════════════════════════════════════════════════════════════════════
#  OPERATION SAFETY GATE
# ════════════════════════════════════════════════════════════════════════


class OperationSafetyGate:
    """Safety gate for cross-platform operations.

    Checks (all must pass for execution):
        1. target resolved and unambiguous
        2. provider known
        3. capability supported (NOT UNKNOWN)
        4. authorization sufficient
        5. execution explicitly enabled
        6. no duplicate/ongoing operation
        7. parameters valid
        8. evidence present (for mutating ops)

    Failure of any check → BLOCKED with explicit reason.
    """

    def __init__(
        self,
        active_identity_keys: Optional[set[str]] = None,
    ) -> None:
        self._active = active_identity_keys or set()

    def evaluate(
        self,
        request: OperationRequest,
        target_resolution: TargetResolution,
        capability: CapabilityDecision,
        authorization: AuthorizationLevel,
    ) -> OperationSafetyGateResult:
        """Evaluate all safety checks for an operation request."""
        checks_passed: list[str] = []
        checks_failed: list[str] = []

        # 1. Target resolved
        if not target_resolution.resolved:
            checks_failed.append("target_resolved")
            return OperationSafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=OperationBlockReason.TARGET_UNRESOLVED,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        if target_resolution.ambiguous:
            checks_failed.append("target_unambiguous")
            return OperationSafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=OperationBlockReason.AMBIGUOUS_TARGET,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        checks_passed.append("target_resolved")

        # 2. Provider known (check both request and resolved target)
        if request.provider_type == ProviderType.UNKNOWN:
            checks_failed.append("provider_known")
            return OperationSafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=OperationBlockReason.UNKNOWN_PROVIDER,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        if target_resolution.provider_type == ProviderType.UNKNOWN:
            checks_failed.append("provider_known")
            return OperationSafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=OperationBlockReason.UNKNOWN_PROVIDER,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        checks_passed.append("provider_known")

        # 3. Capability supported
        if not capability.is_supported:
            checks_failed.append("capability_supported")
            return OperationSafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=OperationBlockReason.UNSUPPORTED_ACTION,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        checks_passed.append("capability_supported")

        # 4. Authorization sufficient
        if request.operation_type.requires_execute_auth:
            if authorization < AuthorizationLevel.EXECUTE:
                checks_failed.append("authorization")
                return OperationSafetyGateResult(
                    result=SafetyResult.BLOCKED,
                    reason=OperationBlockReason.INSUFFICIENT_AUTHORIZATION,
                    checks_passed=checks_passed,
                    checks_failed=checks_failed,
                )
        else:
            # QUERY_STATUS requires at least READ_ONLY
            if authorization < AuthorizationLevel.READ_ONLY:
                checks_failed.append("authorization")
                return OperationSafetyGateResult(
                    result=SafetyResult.BLOCKED,
                    reason=OperationBlockReason.INSUFFICIENT_AUTHORIZATION,
                    checks_passed=checks_passed,
                    checks_failed=checks_failed,
                )
        checks_passed.append("authorization")

        # 5. Execution enabled
        if request.operation_type.is_mutating and not request.execution_enabled:
            checks_failed.append("execution_enabled")
            return OperationSafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=OperationBlockReason.EXECUTION_NOT_ENABLED,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        checks_passed.append("execution_enabled")

        # 6. Duplicate check
        if request.identity_key in self._active:
            checks_failed.append("duplicate")
            return OperationSafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=OperationBlockReason.DUPLICATE_OPERATION,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        checks_passed.append("not_duplicate")

        # 7. Parameters valid
        if request.parameters.replicas is not None and request.parameters.replicas < 0:
            checks_failed.append("parameters_valid")
            return OperationSafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=OperationBlockReason.INVALID_PARAMETERS,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        checks_passed.append("parameters_valid")

        # 8. Evidence (for mutating ops)
        if request.operation_type.is_mutating and not request.evidence:
            checks_failed.append("evidence")
            return OperationSafetyGateResult(
                result=SafetyResult.BLOCKED,
                reason=OperationBlockReason.MISSING_EVIDENCE,
                checks_passed=checks_passed,
                checks_failed=checks_failed,
            )
        checks_passed.append("evidence")

        return OperationSafetyGateResult(
            result=SafetyResult.PASS,
            checks_passed=checks_passed,
        )


# ════════════════════════════════════════════════════════════════════════
#  OPERATION EXECUTOR (ABC)
# ════════════════════════════════════════════════════════════════════════


class OperationExecutor(ABC):
    """Provider-neutral operation executor contract.

    Lifecycle: preview() → execute() → verify()
    Execution must never bypass target resolution, capability check,
    safety gate, or authorization gate.
    """

    @abstractmethod
    def preview(
        self,
        request: OperationRequest,
        target: TargetResolution,
        capability: CapabilityDecision,
    ) -> OperationPreview:
        """Generate a deterministic preview without mutation."""
        ...

    @abstractmethod
    def execute(
        self,
        request: OperationRequest,
        target: TargetResolution,
    ) -> OperationResult:
        """Execute the operation. Returns EXECUTED/FAILED status."""
        ...

    @abstractmethod
    def verify(
        self,
        request: OperationRequest,
        target: TargetResolution,
        execution_result: OperationResult,
    ) -> OperationResult:
        """Verify post-action state. Returns VERIFIED/VERIFICATION_FAILED."""
        ...


