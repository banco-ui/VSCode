#  MOCK OPERATION EXECUTOR
# ════════════════════════════════════════════════════════════════════════


class MockOperationExecutor(OperationExecutor):
    """Mock executor for testing operation semantics.

    Simulates success/failure/timeout without real provider calls.
    Configurable per-request behavior via simulate_failure flag.
    """

    def __init__(
        self,
        simulate_failure: bool = False,
        simulate_verification_failure: bool = False,
    ) -> None:
        self._simulate_failure = simulate_failure
        self._simulate_verification_failure = simulate_verification_failure
        self._mutation_count: int = 0

    @property
    def mutation_count(self) -> int:
        """Number of actual mutations performed (for safety tests)."""
        return self._mutation_count

    def reset(self) -> None:
        self._mutation_count = 0

    def preview(
        self,
        request: OperationRequest,
        target: TargetResolution,
        capability: CapabilityDecision,
    ) -> OperationPreview:
        """Generate a deterministic preview — NO mutation."""
        return OperationPreview(
            request=request,
            resolved_target=target,
            capability_decision=capability,
            expected_effect=f"Would {request.operation_type.value} "
            f"on {target.canonical_id}",
        )

    def execute(
        self,
        request: OperationRequest,
        target: TargetResolution,
    ) -> OperationResult:
        """Simulate execution — increments mutation counter."""
        self._mutation_count += 1
        if self._simulate_failure:
            return OperationResult(
                operation_id=request.operation_id,
                status=OperationStatus.FAILED,
                started_at=datetime.now(timezone.utc).isoformat(),
                completed_at=datetime.now(timezone.utc).isoformat(),
                provider=target.provider_type,
                target=target.canonical_id,
                resolved_target=target,
                error="Simulated execution failure",
            )
        return OperationResult(
            operation_id=request.operation_id,
            status=OperationStatus.EXECUTED,
            started_at=datetime.now(timezone.utc).isoformat(),
            completed_at=datetime.now(timezone.utc).isoformat(),
            provider=target.provider_type,
            target=target.canonical_id,
            resolved_target=target,
            evidence={"mock": True},
        )

    def verify(
        self,
        request: OperationRequest,
        target: TargetResolution,
        execution_result: OperationResult,
    ) -> OperationResult:
        """Simulate post-action verification."""
        if execution_result.status != OperationStatus.EXECUTED:
            return execution_result
        if self._simulate_verification_failure:
            return OperationResult(
                operation_id=request.operation_id,
                status=OperationStatus.VERIFICATION_FAILED,
                started_at=execution_result.started_at,
                completed_at=datetime.now(timezone.utc).isoformat(),
                provider=target.provider_type,
                target=target.canonical_id,
                resolved_target=target,
                evidence=execution_result.evidence,
                error="Simulated verification failure",
            )
        return OperationResult(
            operation_id=request.operation_id,
            status=OperationStatus.VERIFIED,
            started_at=execution_result.started_at,
            completed_at=datetime.now(timezone.utc).isoformat(),
            provider=target.provider_type,
            target=target.canonical_id,
            resolved_target=target,
            evidence={"verified": True, **execution_result.evidence},
        )


