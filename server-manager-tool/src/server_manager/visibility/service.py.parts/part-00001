"""Alert & Operational Visibility Service — Phase 20.

Two services:

1. AlertService — converts Phase 17 Faults to Alerts, manages alert lifecycle,
   prevents duplicate active alerts, propagates fault resolution.

2. OperationalVisibilityService — read-only aggregation of existing
   discovery, health, fault, alert, recovery, and operation data into
   a single operational summary.

    Fault (Phase 17)
        ↓
    AlertService.create_alert(fault)
        ↓
    Alert (OPEN)
        ↓
    acknowledge / resolve / close
        ↓
    OperationalVisibilityService.get_summary()
        ↓
    OperationalSummary (read-only)

SAFETY PRINCIPLES:
    - AlertService updates ONLY its own in-memory alert state
    - OperationalVisibilityService is 100% read-only
    - No provider API calls
    - No subprocess / shell / kubectl
    - No RecoveryExecutor.execute()
    - No OperationService.execute()
    - No graph mutation
    - No health mutation
    - No fault detection mutation
    - No inventory mutation
    - No persistent storage (in-memory only)
"""
from __future__ import annotations

import logging
from datetime import datetime, timezone
from typing import Any, Optional

from server_manager.discovery.models import CanonicalInventory
from server_manager.fault.models import Fault, FaultResult, FaultStatus, Severity
from server_manager.graph.service import GraphQuery
from server_manager.health.models import HealthReport, HealthResult, HealthStatus
from server_manager.models.canonical import ProviderType

from .models import (
    Alert,
    AlertCreationResult,
    AlertNotFoundError,
    AlertStatus,
    AlertTransitionError,
    EntityStatus,
    HealthSummary,
    InfrastructureSummary,
    OperationalSummary,
    ResourceSummary,
    _make_alert_id,
)

logger = logging.getLogger(__name__)


# ════════════════════════════════════════════════════════════════════════
#  VALID LIFECYCLE TRANSITIONS
# ════════════════════════════════════════════════════════════════════════

_VALID_TRANSITIONS: dict[AlertStatus, set[AlertStatus]] = {
    AlertStatus.OPEN: {AlertStatus.ACKNOWLEDGED, AlertStatus.RESOLVED},
    AlertStatus.ACKNOWLEDGED: {AlertStatus.RESOLVED},
    AlertStatus.RESOLVED: {AlertStatus.CLOSED},
    AlertStatus.CLOSED: set(),  # terminal state — no transitions out
}


# ════════════════════════════════════════════════════════════════════════
#  ALERT SERVICE
# ════════════════════════════════════════════════════════════════════════


class AlertService:
    """Alert service — Fault → Alert conversion and lifecycle management.

    In-memory only. No persistence. No external delivery.

    The service does NOT:
        ❌ Execute recovery or operations
        ❌ Call provider APIs
        ❌ Modify fault detection state
        ❌ Modify health state
        ❌ Modify inventory or graph
        ❌ Infer root cause or recovery actions
        ❌ Automatically trigger any action
    """

    def __init__(self) -> None:
        self._alerts: dict[str, Alert] = {}

    # ── Fault → Alert Conversion ──────────────────────────────────

    def create_alert(self, fault: Fault) -> AlertCreationResult:
        """Convert a detected Fault to an Alert.

        Rules:
            - Missing evidence → no alert
            - Duplicate active alert for same fault → no new alert
            - Fault severity preserved
            - Fault evidence preserved
            - Fault identity traceable via fault_id
        """
        # Missing evidence → no alert
        if not fault.evidence:
            return AlertCreationResult(
                alert=None,
                created=False,
                reason="Missing evidence — cannot create alert",
            )

        alert_id = _make_alert_id(fault.fault_id)

        # Duplicate active alert check
        existing = self._alerts.get(alert_id)
        if existing is not None and existing.is_active:
            return AlertCreationResult(
                alert=None,
                created=False,
                reason=(
                    f"Duplicate active alert for fault {fault.fault_id} "
                    f"— existing alert {alert_id} is {existing.status.value}"
                ),
            )

        # Build the alert from the fault
        now = datetime.now(timezone.utc).isoformat()
        provider_type = ProviderType.UNKNOWN
        if fault.source is not None:
            provider_type = getattr(
                fault.source, "provider_type", ProviderType.UNKNOWN
            )

        alert = Alert(
            alert_id=alert_id,
            fault_id=fault.fault_id,
            entity_id=fault.entity_id,
            fault_type=fault.fault_type,
            severity=fault.severity,
            status=AlertStatus.OPEN,
            provider_type=provider_type,
            canonical_entity_type=fault.evidence.get("entity_type", ""),
            summary=(
                f"{fault.fault_type.value} on {fault.entity_id} "
                f"({fault.severity.value})"
            ),
            details={
                "fault_status": fault.status.value,
                "detected_at": fault.detected_at,
            },
            evidence=dict(fault.evidence),
            source=fault.source,
            created_at=now,
            updated_at=now,
        )

        self._alerts[alert_id] = alert

        return AlertCreationResult(
            alert=alert,
            created=True,
            reason="Alert created from fault",
        )

    # ── Lifecycle Operations ──────────────────────────────────────

    def acknowledge(
        self,
        alert_id: str,
        acknowledged_by: str = "system",
        note: Optional[str] = None,
    ) -> Alert:
        """Transition an alert from OPEN to ACKNOWLEDGED."""
        alert = self._get_or_raise(alert_id)
        self._transition(alert, AlertStatus.ACKNOWLEDGED)
        now = datetime.now(timezone.utc).isoformat()
        alert.acknowledged_at = now
        alert.acknowledged_by = acknowledged_by
        if note:
            alert.details["acknowledge_note"] = note
        alert.updated_at = now
        return alert

    def resolve(
        self, alert_id: str, note: Optional[str] = None,
    ) -> Alert:
        """Transition an alert from OPEN or ACKNOWLEDGED to RESOLVED."""
        alert = self._get_or_raise(alert_id)
        self._transition(alert, AlertStatus.RESOLVED)
        now = datetime.now(timezone.utc).isoformat()
        alert.resolved_at = now
        if note:
            alert.details["resolution_note"] = note
        alert.updated_at = now
        return alert

    def close(self, alert_id: str) -> Alert:
        """Transition an alert from RESOLVED to CLOSED."""
        alert = self._get_or_raise(alert_id)
        self._transition(alert, AlertStatus.CLOSED)
        now = datetime.now(timezone.utc).isoformat()
        alert.closed_at = now
        alert.updated_at = now
        return alert

    # ── Fault Resolution Propagation ──────────────────────────────

    def on_fault_resolved(self, fault_id: str) -> Optional[Alert]:
        """Propagate fault resolution to the corresponding alert.

        If an active (OPEN or ACKNOWLEDGED) alert exists for the fault,
        transition it to RESOLVED. Preserves original alert identity.
        Returns the resolved alert, or None if no active alert exists.
        """
        alert_id = _make_alert_id(fault_id)
        alert = self._alerts.get(alert_id)
        if alert is None or not alert.is_active:
            return None
        self._transition(alert, AlertStatus.RESOLVED)
        now = datetime.now(timezone.utc).isoformat()
        alert.resolved_at = now
        alert.details["resolved_by_fault"] = True
        alert.updated_at = now
        return alert

    # ── Query Operations ──────────────────────────────────────────

    def get_alert(self, alert_id: str) -> Optional[Alert]:
        """Get a single alert by alert_id. Returns None if not found."""
        return self._alerts.get(alert_id)

    def get_alerts(
        self, status_filter: Optional[AlertStatus] = None,
    ) -> list[Alert]:
        """Get all alerts, optionally filtered by status."""
        if status_filter is None:
            return list(self._alerts.values())
        return [a for a in self._alerts.values() if a.status == status_filter]

    @property
    def alert_count(self) -> int:
        return len(self._alerts)

    @property
    def active_alert_count(self) -> int:
        return sum(1 for a in self._alerts.values() if a.is_active)

    # ── Internal Helpers ──────────────────────────────────────────

    def _get_or_raise(self, alert_id: str) -> Alert:
        alert = self._alerts.get(alert_id)
        if alert is None:
            raise AlertNotFoundError(alert_id)
        return alert

    def _transition(self, alert: Alert, to_status: AlertStatus) -> None:
        """Validate and perform a lifecycle transition."""
        allowed = _VALID_TRANSITIONS.get(alert.status, set())
        if to_status not in allowed:
            raise AlertTransitionError(
                alert_id=alert.alert_id,
                from_status=alert.status,
                to_status=to_status,
            )
        alert.status = to_status


