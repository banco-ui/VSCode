class OperationalVisibilityService:
    """Read-only operational visibility service.

    Aggregates existing discovery, health, fault, alert, recovery, and
    operation data into a single operational summary.

    This service is 100% READ-ONLY:
        ❌ No mutation of infrastructure
        ❌ No execution of kubectl / shell / provider APIs
        ❌ No RecoveryExecutor.execute()
        ❌ No OperationService.execute()
        ❌ No graph mutation
        ❌ No health mutation
        ❌ No fault detection mutation
        ❌ No inventory mutation

    All data comes from existing models/services passed in at construction
    or via update methods. No new data is inferred or invented.
    """

    def __init__(
        self,
        alert_service: Optional[AlertService] = None,
    ) -> None:
        self._alert_service = alert_service or AlertService()
        self._inventory: Optional[CanonicalInventory] = None
        self._health_report: Optional[HealthReport] = None
        self._fault_result: Optional[FaultResult] = None
        self._graph_query: Optional[GraphQuery] = None
        self._recovery_candidates: list[Any] = []
        self._recovery_results: list[Any] = []
        self._operation_results: list[Any] = []

    # ── Data Sources (read-only setters — no mutation of source) ──

    def set_inventory(self, inventory: Optional[CanonicalInventory]) -> None:
        """Set the canonical inventory for visibility queries."""
        self._inventory = inventory

    def set_health_report(
        self, report: Optional[HealthReport]
    ) -> None:
        """Set the health report for visibility queries."""
        self._health_report = report

    def set_fault_result(
        self, result: Optional[FaultResult]
    ) -> None:
        """Set the fault detection result for visibility queries."""
        self._fault_result = result

    def set_graph_query(self, query: Optional[GraphQuery]) -> None:
        """Set the graph query for read-only context lookup."""
        self._graph_query = query

    def set_recovery_candidates(
        self, candidates: list[Any]
    ) -> None:
        """Set recovery candidates for visibility queries."""
        self._recovery_candidates = candidates

    def set_recovery_results(
        self, results: list[Any]
    ) -> None:
        """Set recovery execution results for visibility queries."""
        self._recovery_results = results

    def set_operation_results(
        self, results: list[Any]
    ) -> None:
        """Set operation results for visibility queries."""
        self._operation_results = results

    @property
    def alert_service(self) -> AlertService:
        return self._alert_service

    # ── Read-Only Query Methods ───────────────────────────────────

    def get_summary(self) -> OperationalSummary:
        """Generate a read-only operational summary.

        All values come from existing models/services. No mutation.
        """
        return OperationalSummary(
            infrastructure=self._summarize_infrastructure(),
            health=self._summarize_health(),
            resources=self._summarize_resources(),
            faults=self._summarize_faults(),
            alerts=self._summarize_alerts(),
            operations=self._summarize_operations(),
        )

    def get_alerts(
        self, status_filter: Optional[AlertStatus] = None
    ) -> list[Alert]:
        """Get alerts (read-only query)."""
        return self._alert_service.get_alerts(status_filter)

    def get_alert(self, alert_id: str) -> Optional[Alert]:
        """Get a single alert by ID (read-only query)."""
        return self._alert_service.get_alert(alert_id)

    def get_faults(self) -> list[Fault]:
        """Get faults from the fault result (read-only query)."""
        if self._fault_result is None:
            return []
        return list(self._fault_result.faults)

    def get_entity_status(self, entity_id: str) -> EntityStatus:
        """Get read-only operational status for a single entity."""
        entity_type = ""
        health_status = "UNKNOWN"
        availability_status = "UNKNOWN"

        if self._health_report is not None:
            for result in self._health_report.results:
                if result.entity_id == entity_id:
                    entity_type = result.entity_type
                    health_status = result.status.value
                    availability_status = result.availability.value
                    break

        if self._graph_query is not None:
            node = self._graph_query.get_node(entity_id)
            if node is not None and not entity_type:
                entity_type = node.entity_type.value

        fault_ids: list[str] = []
        if self._fault_result is not None:
            for fault in self._fault_result.faults:
                if fault.entity_id == entity_id:
                    fault_ids.append(fault.fault_id)

        alert_ids: list[str] = []
        for alert in self._alert_service.get_alerts():
            if alert.entity_id == entity_id and alert.is_active:
                alert_ids.append(alert.alert_id)

        return EntityStatus(
            entity_id=entity_id,
            entity_type=entity_type,
            health_status=health_status,
            availability_status=availability_status,
            active_faults=len(fault_ids),
            active_alerts=len(alert_ids),
            alert_ids=alert_ids,
            fault_ids=fault_ids,
        )

    # ── Internal Summarizers ──────────────────────────────────────

    def _summarize_infrastructure(self) -> InfrastructureSummary:
        inv = self._inventory
        if inv is None:
            return InfrastructureSummary()
        return InfrastructureSummary(
            total_entities=inv.entity_count,
            platforms=len(inv.platforms),
            clusters=len(inv.clusters),
            nodes=len(inv.nodes),
            execution_environments=len(inv.execution_environments),
            workloads=len(inv.workloads),
            networks=len(inv.networks),
            storages=len(inv.storages),
            accelerators=len(inv.accelerators),
            physicals=len(inv.physicals),
            os_entities=len(inv.os_entities),
        )

    def _summarize_health(self) -> HealthSummary:
        if self._health_report is None:
            return HealthSummary()
        results = self._health_report.results
        counts = {
            HealthStatus.HEALTHY: 0,
            HealthStatus.DEGRADED: 0,
            HealthStatus.UNHEALTHY: 0,
            HealthStatus.UNKNOWN: 0,
        }
        for r in results:
            counts[r.status] = counts.get(r.status, 0) + 1
        return HealthSummary(
            total_assessed=len(results),
            healthy=counts[HealthStatus.HEALTHY],
            degraded=counts[HealthStatus.DEGRADED],
            unhealthy=counts[HealthStatus.UNHEALTHY],
            unknown=counts[HealthStatus.UNKNOWN],
        )

    def _summarize_resources(self) -> ResourceSummary:
        if self._health_report is None:
            return ResourceSummary()
        total_rs = 0
        total_ci = 0
        entities_with_res = 0
        for r in self._health_report.results:
            if r.resource_statuses or r.capacity_infos:
                entities_with_res += 1
            total_rs += len(r.resource_statuses)
            total_ci += len(r.capacity_infos)
        return ResourceSummary(
            entities_with_resources=entities_with_res,
            total_resource_statuses=total_rs,
            total_capacity_infos=total_ci,
        )

    def _summarize_faults(self):
        from .models import FaultSummary as _FS
        if self._fault_result is None:
            return _FS()
        fr = self._fault_result
        return _FS(
            total_faults=len(fr.faults),
            detected=len(fr.newly_detected),
            ongoing=len(fr.ongoing),
            resolved=len(fr.resolved_fault_ids),
        )

    def _summarize_alerts(self):
        from .models import AlertSummary as _AS
        alerts = self._alert_service.get_alerts()
        counts: dict[str, int] = {}
        for a in alerts:
            counts[a.status.value] = counts.get(a.status.value, 0) + 1
        return _AS(
            total_alerts=len(alerts),
            open=counts.get(AlertStatus.OPEN.value, 0),
            acknowledged=counts.get(AlertStatus.ACKNOWLEDGED.value, 0),
            resolved=counts.get(AlertStatus.RESOLVED.value, 0),
            closed=counts.get(AlertStatus.CLOSED.value, 0),
        )

    def _summarize_operations(self):
        from .models import OperationSummary as _OS
        total_candidates = len(self._recovery_candidates)
        rec_executed = sum(
            1 for r in self._recovery_results
            if _safe_status(r, "EXECUTED")
        )
        rec_verified = sum(
            1 for r in self._recovery_results
            if _safe_status(r, "VERIFIED")
        )
        rec_failed = sum(
            1 for r in self._recovery_results
            if _safe_status(r, "FAILED")
        )
        total_ops = len(self._operation_results)
        ops_executed = sum(
            1 for r in self._operation_results
            if _safe_status(r, "EXECUTED")
        )
        ops_verified = sum(
            1 for r in self._operation_results
            if _safe_status(r, "VERIFIED")
        )
        ops_failed = sum(
            1 for r in self._operation_results
            if _safe_status(r, "FAILED")
        )
        return _OS(
            total_recovery_candidates=total_candidates,
            recovery_executed=rec_executed,
            recovery_verified=rec_verified,
            recovery_failed=rec_failed,
            total_operation_results=total_ops,
            operations_executed=ops_executed,
            operations_verified=ops_verified,
            operations_failed=ops_failed,
        )


def _safe_status(obj: Any, status_value: str) -> bool:
    """Safely check if an object's status field matches a value."""
    status = getattr(obj, "status", None)
    if status is None:
        return False
    if hasattr(status, "value"):
        return status.value == status_value
    return str(status) == status_value




