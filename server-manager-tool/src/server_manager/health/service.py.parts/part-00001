def _find_condition(
    conditions: list[dict[str, Any]], cond_type: str
) -> Optional[dict[str, Any]]:
    """Find a specific condition by type from K8s conditions list."""
    for cond in conditions:
        if not isinstance(cond, dict):
            continue
        if cond.get("type") == cond_type:
            return cond
    return None


def _is_condition_true(cond: Optional[dict[str, Any]]) -> bool:
    """Check if a K8s condition status is True."""
    if cond is None:
        return False
    return str(cond.get("status", "")).lower() == "true"


def _is_condition_false(cond: Optional[dict[str, Any]]) -> bool:
    """Check if a K8s condition status is False."""
    if cond is None:
        return False
    return str(cond.get("status", "")).lower() == "false"


class KubernetesHealthExtractor(HealthExtractor):
    """Kubernetes-specific health extractor.

    Extracts health evidence from canonical entities that have
    K8s raw data preserved in metadata["kubernetes"]["raw"].

    K8s health evidence sources:
        Node:   status.conditions (Ready, MemoryPressure, DiskPressure,
                PIDPressure, NetworkUnavailable)
                status.capacity / status.allocatable (cpu, memory)
        Pod:    status.phase (Running, Pending, Succeeded, Failed, Unknown)
                status.conditions (Ready, Initialized, ContainersReady, PodScheduled)
        PV:     status.phase (Available, Bound, Released, Failed, Pending)
                spec.capacity.storage
        PVC:    status.phase (Bound, Pending, Lost)

    NOT extracted (no evidence from K8s list API):
        - used / utilization (requires metrics-server API — out of scope)
        - Network link speed → available bandwidth (inference prohibited)
        - GPU exists → capacity (inference prohibited)

    UNKNOWN is used when evidence is insufficient.
    """

    def extract_health(self, inventory: CanonicalInventory) -> list[HealthResult]:
        """Extract health from all K8s canonical entities."""
        results: list[HealthResult] = []

        for platform in inventory.platforms:
            results.append(self._assess_platform(platform))
        for cluster in inventory.clusters:
            results.append(self._assess_cluster(cluster))
        for node in inventory.nodes:
            results.append(self._assess_node(node))
        for ee in inventory.execution_environments:
            results.append(self._assess_execution_environment(ee))
        for network in inventory.networks:
            results.append(self._assess_network(network))
        for storage in inventory.storages:
            results.append(self._assess_storage(storage))

        return results

    # ── Node ──────────────────────────────────────────────────────

    def _assess_node(self, node: Node) -> HealthResult:
        """Assess K8s Node health from conditions and capacity."""
        raw = self._get_raw(node)
        status_data = raw.get("status", {}) if isinstance(raw, dict) else {}
        conditions = status_data.get("conditions", [])
        if not isinstance(conditions, list):
            conditions = []

        # ── Derive health from conditions ──────────────────────────
        ready = _find_condition(conditions, "Ready")
        mem_pressure = _find_condition(conditions, "MemoryPressure")
        disk_pressure = _find_condition(conditions, "DiskPressure")
        pid_pressure = _find_condition(conditions, "PIDPressure")
        net_unavailable = _find_condition(conditions, "NetworkUnavailable")

        status = HealthStatus.UNKNOWN
        availability = AvailabilityStatus.UNKNOWN

        if ready is not None:
            ready_status = str(ready.get("status", "")).lower()
            if ready_status == "true":
                # Check for pressure conditions
                has_pressure = any(
                    _is_condition_true(c) for c in
                    [mem_pressure, disk_pressure, pid_pressure, net_unavailable]
                    if c is not None
                )
                if has_pressure:
                    status = HealthStatus.DEGRADED
                else:
                    status = HealthStatus.HEALTHY
                availability = AvailabilityStatus.AVAILABLE
            elif ready_status == "false":
                status = HealthStatus.UNHEALTHY
                availability = AvailabilityStatus.UNAVAILABLE
            elif ready_status == "unknown":
                status = HealthStatus.DEGRADED
                availability = AvailabilityStatus.UNKNOWN
        # No Ready condition → UNKNOWN (not HEALTHY)

        # ── Extract capacity and resource status ───────────────────
        capacity = status_data.get("capacity", {})
        allocatable = status_data.get("allocatable", {})
        if not isinstance(capacity, dict):
            capacity = {}
        if not isinstance(allocatable, dict):
            allocatable = {}

        resource_statuses: list[ResourceStatus] = []
        capacity_infos: list[CapacityInfo] = []

        if "cpu" in capacity:
            cpu_cap = str(capacity.get("cpu", ""))
            cpu_alloc = str(allocatable.get("cpu", "")) if "cpu" in allocatable else None
            capacity_infos.append(CapacityInfo(
                resource_type=ResourceType.CPU,
                capacity=cpu_cap,
                allocatable=cpu_alloc,
                unit="cores",
                source_evidence=node.source_evidence,
            ))
            resource_statuses.append(ResourceStatus(
                resource_type=ResourceType.CPU,
                total=cpu_cap,
                used=None,
                available=cpu_alloc,
                utilization=None,
                unit="cores",
                source_evidence=node.source_evidence,
            ))

        if "memory" in capacity:
            mem_cap = str(capacity.get("memory", ""))
            mem_alloc = str(allocatable.get("memory", "")) if "memory" in allocatable else None
            capacity_infos.append(CapacityInfo(
                resource_type=ResourceType.MEMORY,
                capacity=mem_cap,
                allocatable=mem_alloc,
                unit="Ki",
                source_evidence=node.source_evidence,
            ))
            resource_statuses.append(ResourceStatus(
                resource_type=ResourceType.MEMORY,
                total=mem_cap,
                used=None,
                available=mem_alloc,
                utilization=None,
                unit="Ki",
                source_evidence=node.source_evidence,
            ))

        return HealthResult(
            entity_id=node.canonical_id,
            entity_type="NODE",
            status=status,
            availability=availability,
            source_evidence=node.source_evidence,
            resource_statuses=resource_statuses,
            capacity_infos=capacity_infos,
        )

    # ── ExecutionEnvironment (Pod) ────────────────────────────────

    def _assess_execution_environment(self, ee: ExecutionEnvironment) -> HealthResult:
        """Assess K8s Pod/Container health from status.phase."""
        raw = self._get_raw(ee)
        status_data = raw.get("status", {}) if isinstance(raw, dict) else {}

        phase = status_data.get("phase") if isinstance(status_data, dict) else None
        conditions = status_data.get("conditions", []) if isinstance(status_data, dict) else []
        if not isinstance(conditions, list):
            conditions = []

        status = HealthStatus.UNKNOWN
        availability = AvailabilityStatus.UNKNOWN

        if phase:
            phase_upper = str(phase).upper()
            if phase_upper == "RUNNING":
                ready_cond = _find_condition(conditions, "Ready")
                if ready_cond is not None:
                    if _is_condition_true(ready_cond):
                        status = HealthStatus.HEALTHY
                        availability = AvailabilityStatus.AVAILABLE
                    elif _is_condition_false(ready_cond):
                        status = HealthStatus.DEGRADED
                        availability = AvailabilityStatus.AVAILABLE
                    else:
                        status = HealthStatus.UNKNOWN
                        availability = AvailabilityStatus.UNKNOWN
                else:
                    # Running but no Ready condition → UNKNOWN
                    status = HealthStatus.UNKNOWN
                    availability = AvailabilityStatus.AVAILABLE
            elif phase_upper == "SUCCEEDED":
                status = HealthStatus.HEALTHY
                availability = AvailabilityStatus.AVAILABLE
            elif phase_upper == "FAILED":
                status = HealthStatus.UNHEALTHY
                availability = AvailabilityStatus.UNAVAILABLE
            elif phase_upper == "PENDING":
                status = HealthStatus.DEGRADED
                availability = AvailabilityStatus.UNKNOWN
            elif phase_upper == "UNKNOWN":
                status = HealthStatus.UNKNOWN
                availability = AvailabilityStatus.UNKNOWN
        # No phase → UNKNOWN

        return HealthResult(
            entity_id=ee.canonical_id,
            entity_type="EXECUTION_ENVIRONMENT",
            status=status,
            availability=availability,
            source_evidence=ee.source_evidence,
        )

    # ── Storage (PV/PVC) ──────────────────────────────────────────

    def _assess_storage(self, storage: Storage) -> HealthResult:
        """Assess K8s PV/PVC health from status.phase and capacity."""
        raw = self._get_raw(storage)
        status_data = raw.get("status", {}) if isinstance(raw, dict) else {}
        spec = raw.get("spec", {}) if isinstance(raw, dict) else {}

        phase = status_data.get("phase") if isinstance(status_data, dict) else None
        if not isinstance(phase, str):
            phase = None

        status = HealthStatus.UNKNOWN
        availability = AvailabilityStatus.UNKNOWN

        if phase:
            phase_upper = phase.upper()
            if phase_upper in ("BOUND", "AVAILABLE"):
                status = HealthStatus.HEALTHY
                availability = AvailabilityStatus.AVAILABLE
            elif phase_upper == "RELEASED":
                status = HealthStatus.DEGRADED
                availability = AvailabilityStatus.UNKNOWN
            elif phase_upper == "FAILED":
                status = HealthStatus.UNHEALTHY
                availability = AvailabilityStatus.UNAVAILABLE
            elif phase_upper == "PENDING":
                status = HealthStatus.DEGRADED
                availability = AvailabilityStatus.UNKNOWN
            elif phase_upper == "LOST":
                status = HealthStatus.UNHEALTHY
                availability = AvailabilityStatus.UNAVAILABLE
        # No phase → UNKNOWN

        # ── Extract storage capacity ───────────────────────────────
        resource_statuses: list[ResourceStatus] = []
        capacity_infos: list[CapacityInfo] = []

        if isinstance(spec, dict):
            spec_capacity = spec.get("capacity", {})
            if isinstance(spec_capacity, dict) and "storage" in spec_capacity:
                storage_cap = str(spec_capacity.get("storage", ""))
                capacity_infos.append(CapacityInfo(
                    resource_type=ResourceType.STORAGE,
                    capacity=storage_cap,
                    allocatable=None,
                    unit="source",
                    source_evidence=storage.source_evidence,
                ))
                resource_statuses.append(ResourceStatus(
                    resource_type=ResourceType.STORAGE,
                    total=storage_cap,
                    used=None,
                    available=None,
                    utilization=None,
                    unit="source",
                    source_evidence=storage.source_evidence,
                ))

        return HealthResult(
            entity_id=storage.canonical_id,
            entity_type="STORAGE",
            status=status,
            availability=availability,
            source_evidence=storage.source_evidence,
            resource_statuses=resource_statuses,
            capacity_infos=capacity_infos,
        )

    # ── Network (Service) ──────────────────────────────────────────

    def _assess_network(self, network: Network) -> HealthResult:
        """Assess K8s Service health.

        K8s Service API does not provide explicit health conditions.
        No health evidence -> UNKNOWN (not HEALTHY).
        """
        return HealthResult(
            entity_id=network.canonical_id,
            entity_type="NETWORK",
            status=HealthStatus.UNKNOWN,
            availability=AvailabilityStatus.UNKNOWN,
            source_evidence=network.source_evidence,
            warnings=["No explicit health evidence from K8s Service API"],
        )

    # ── Platform ──────────────────────────────────────────────────

    def _assess_platform(self, platform: Platform) -> HealthResult:
        """Assess platform health.

        Platform health is derived from API accessibility — the fact
        that discovery succeeded means the API was reachable.
        No explicit platform-level health condition in K8s API.
        """
        return HealthResult(
            entity_id=platform.canonical_id,
            entity_type="PLATFORM",
            status=HealthStatus.UNKNOWN,
            availability=AvailabilityStatus.AVAILABLE,
            source_evidence=platform.source_evidence,
            warnings=["Platform health derived from API accessibility"],
        )

    # ── Cluster ───────────────────────────────────────────────────

    def _assess_cluster(self, cluster: Cluster) -> HealthResult:
        """Assess cluster health.

        Similar to Platform — API accessibility implies availability,
        but no explicit cluster-level health condition exists.
        """
        return HealthResult(
            entity_id=cluster.canonical_id,
            entity_type="CLUSTER",
            status=HealthStatus.UNKNOWN,
            availability=AvailabilityStatus.AVAILABLE,
            source_evidence=cluster.source_evidence,
            warnings=["Cluster health derived from API accessibility"],
        )

    # ── Helper ────────────────────────────────────────────────────

    @staticmethod
    def _get_raw(entity: Any) -> dict[str, Any]:
        """Extract K8s raw data from canonical entity metadata.

        The normalizer preserves K8s raw objects in:
            metadata["kubernetes"]["raw"]
        """
        metadata = getattr(entity, "metadata", None)
        if not isinstance(metadata, dict):
            return {}
        k8s_meta = metadata.get("kubernetes", {})
        if not isinstance(k8s_meta, dict):
            return {}
        raw = k8s_meta.get("raw", {})
        if not isinstance(raw, dict):
            return {}
        return raw


