class HealthExtractor(ABC):
    """Abstract base for provider-specific health extraction.

    Transforms canonical entities (from Phase 14 inventory) into
    HealthResult objects by extracting health evidence from
    provider-specific metadata preserved in each entity.

    Contract:
        extract_health(inventory) -> list[HealthResult]

    The extractor does NOT:
        - Connect to providers (data is already in canonical entities)
        - Modify entities
        - Generate alerts
        - Perform recovery
        - Infer health without evidence
    """

    @abstractmethod
    def extract_health(self, inventory: CanonicalInventory) -> list[HealthResult]:
        """Extract health results from all entities in the inventory.

        Args:
            inventory: Canonical inventory from Phase 14 discovery.

        Returns:
            List of HealthResult, one per assessed entity.
        """
        ...


