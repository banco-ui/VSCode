    ctx: ManagementContext = Depends(get_management_context),
) -> SystemReadinessResponse:
    """Readiness probe — checks if pipeline services are configured."""
    components = {
        "discovery": ctx.discovery_result is not None,
        "inventory": ctx.inventory is not None,
        "health": ctx.health_report is not None,
        "graph": ctx.graph_query is not None,
        "monitoring": ctx.monitoring_report is not None,
        "faults": ctx.fault_result is not None,
