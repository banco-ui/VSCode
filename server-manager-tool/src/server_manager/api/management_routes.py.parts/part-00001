@router.get("/inventory", response_model=InventorySummaryResponse)
def get_inventory_summary(
    ctx: ManagementContext = Depends(get_management_context),
) -> InventorySummaryResponse:
    """Get a summary of the canonical inventory from the latest discovery run."""
    inventory = _require_inventory(ctx)
    return InventorySummaryResponse(
        provider_type=inventory.provider_type.value,
        provider_id=inventory.provider_id,
        snapshot_id=inventory.snapshot_id,
        discovered_at=inventory.discovered_at,
        identified_platform_type=inventory.identified_platform_type.value,
        total_entities=inventory.entity_count,
        entity_counts=_entity_counts(inventory),
    )


@router.get("/inventory/entities", response_model=EntityListResponse)
def list_entities(
    entity_type: Optional[str] = Query(None, description="Filter by entity type"),
    ctx: ManagementContext = Depends(get_management_context),
) -> EntityListResponse:
    """List all canonical entities, optionally filtered by type."""
    inventory = _require_inventory(ctx)
    items: list[dict[str, Any]] = []
    for attr_name, type_name in _ENTITY_LISTS:
        if entity_type and entity_type.upper() != type_name:
            continue
        for entity in getattr(inventory, attr_name, []):
            d = entity.model_dump()
            d["_entity_type"] = type_name
            items.append(d)
    return EntityListResponse(items=items, total=len(items))


@router.get("/inventory/entities/{canonical_id}", response_model=None)
def get_entity(
    canonical_id: str,
    ctx: ManagementContext = Depends(get_management_context),
):
    """Get a specific canonical entity by its canonical_id."""
    inventory = _require_inventory(ctx)
    entity, entity_type = _find_entity(inventory, canonical_id)
    if entity is None:
        raise HTTPException(
            status_code=404,
            detail={
                "code": "NOT_FOUND",
                "message": f"Entity '{canonical_id}' not found",
                "details": {},
            },
        )
    result = entity.model_dump()
    result["_entity_type"] = entity_type
    return result


