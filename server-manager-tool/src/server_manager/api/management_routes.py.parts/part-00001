router = APIRouter(prefix="/api/v1", tags=["management"])


# ── Helpers ───────────────────────────────────────────────────────────

_ENTITY_LISTS: list[tuple[str, str]] = [
    ("physicals", "PHYSICAL"),
    ("os_entities", "OS"),
    ("platforms", "PLATFORM"),
    ("clusters", "CLUSTER"),
    ("nodes", "NODE"),
    ("execution_environments", "EXECUTION_ENVIRONMENT"),
    ("workloads", "WORKLOAD"),
    ("networks", "NETWORK"),
    ("storages", "STORAGE"),
    ("accelerators", "ACCELERATOR"),
]


def _require_inventory(ctx: ManagementContext):
    """Return the CanonicalInventory or raise 503."""
    inventory = ctx.inventory
    if inventory is None:
        raise HTTPException(
            status_code=503,
            detail={
                "code": "SERVICE_UNAVAILABLE",
                "message": "No discovery pipeline result available. Run discovery first.",
                "details": {},
            },
        )
    return inventory


def _find_entity(inventory, canonical_id: str) -> tuple[Optional[Any], str]:
    """Search all entity lists by canonical_id."""
    for attr_name, type_name in _ENTITY_LISTS:
        entities = getattr(inventory, attr_name, [])
        for entity in entities:
            if entity.canonical_id == canonical_id:
                return entity, type_name
    return None, ""


def _entity_counts(inventory) -> dict[str, int]:
    """Return entity counts per type."""
    counts: dict[str, int] = {}
    for attr_name, type_name in _ENTITY_LISTS:
        entities = getattr(inventory, attr_name, [])
        counts[type_name] = len(entities)
    return counts


