@router.post("/operations/preview", response_model=OperationPreviewResponse)
def preview_operation(
    request: OperationPreviewRequest,
    ctx: ManagementContext = Depends(get_management_context),
) -> OperationPreviewResponse:
    """Preview an operation without mutation or execution.

    Generates a deterministic preview of what an operation would do.
    No provider API calls, no mutations, no execution.
    """
    svc = ctx.operation_service
    if svc is None:
        raise HTTPException(
            status_code=503,
            detail={
                "code": "SERVICE_UNAVAILABLE",
                "message": "No operation service available.",
                "details": {},
            },
        )

    from ..operations.models import OperationRequest, OperationType
    from ..models.canonical import ProviderType

    try:
        op_type = OperationType(request.operation_type)
    except ValueError:
        raise HTTPException(
            status_code=400,
            detail={
                "code": "INVALID_OPERATION_TYPE",
                "message": f"Invalid operation type: {request.operation_type}",
                "details": {},
            },
        )

    try:
        prov_type = ProviderType(request.pr