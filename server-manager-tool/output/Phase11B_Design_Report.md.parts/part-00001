## 21. AlertStore Schema (DESIGN)

### Table: alerts

```sql
CREATE TABLE alerts (
    -- Identity
    alert_id              TEXT PRIMARY KEY,
    fingerprint           TEXT NOT NULL,
    fingerprint_version   INTEGER NOT NULL DEFAULT 1,
    
    -- Server reference
    server_id             TEXT NOT NULL,
    
    -- Alert classification
    alert_type            TEXT NOT NULL,
    resource_type         TEXT NOT NULL,
    resource_id           TEXT,
    condition             TEXT NOT NULL,
    
    -- Severity
    severity              TEXT NOT NULL,  -- INFO, WARNING, CRITICAL
    
    -- Lifecycle
    status                TEXT NOT NULL,  -- OPEN, ACKNOWLEDGED, RESOLVED
    created_at            TEXT NOT NULL,
    updated_at            TEXT NOT NULL,
    acknowledged_at       TEXT,
    acknowledged_by       TEXT,
    acknowledge_note      TEXT,
    resolved_at           TEXT,
    resolution_note       TEXT,
    
    -- Threshold tracking
    consecutive_failure_count  INTEGER NOT NULL DEFAULT 0,
    consecutive_ok_count       INTEGER NOT NULL DEFAULT 0,
    
    -- References
    first_snapshot_id     TEXT,  -- First detection snapshot
    last_snapshot_id      TEXT,  -- Most recent detection snapshot
    
    -- Metadata
    recovery_count        INTEGER NOT NULL DEFAULT 0,
    metadata_json         TEXT NOT NULL DEFAULT '{}'
);
```

### Indexes

```sql
-- Fingerprint lookup (deduplication)
CREATE INDEX idx_alerts_fingerprint ON alerts(fingerprint);

-- Status filtering (active alerts)
CREATE INDEX idx_alerts_status ON alerts(status);

-- Server filtering
CREATE INDEX idx_alerts_server_id ON alerts(server_id);

-- Severity filtering
CREATE INDEX idx_alerts_severity ON alerts(severity);

-- Composite: active alerts by server
CREATE INDEX idx_alerts_status_server ON alerts(status, server_id);

-- Created timestamp (sorting, pagination)
CREATE INDEX idx_alerts_created_at ON alerts(created_at DESC);
```

