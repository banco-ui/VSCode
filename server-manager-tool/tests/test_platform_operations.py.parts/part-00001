def make_request(
    op_type=OperationType.RESTART,
    target="canon-k8s-node-01",
    provider=ProviderType.KUBERNETES,
    auth=AuthorizationLevel.EXECUTE,
    execution_enabled=True,
    evidence=None,
    params=None,
    operation_id="op-001",
):
    return OperationRequest(
        operation_id=operation_id,
        operation_type=op_type,
        target_canonical_id=target,
        provider_type=provider,
        authorization=auth,
        execution_enabled=execution_enabled,
        evidence=evidence if evidence is not None else {"reason": "test"},
        parameters=params or OperationParameters(),
    )


def make_resolved_target(
    canonical_id="canon-k8s-node-01",
    provider=ProviderType.KUBERNETES,
    entity_type="NODE",
):
    return TargetResolution(
        resolved=True,
        canonical_id=canonical_id,
        provider_type=provider,
        entity_type=entity_type,
        evidence={"source": "test"},
    )


def make_service(
    simulate_failure=False,
    simulate_verification_failure=False,
    register_target=True,
    register_capability=True,
):
    target_resolver = TargetResolver()
    if register_target:
        target_resolver.register_target(
            "canon-k8s-node-01",
            ProviderType.KUBERNETES,
            provider_id="k8s-node-01",
            entity_type="NODE",
        )
    cap_resolver = CapabilityResolver()
    if register_capability:
        cap_resolver.register(
            ProviderType.KUBERNETES,
            {OperationType.RESTART, OperationType.QUERY_STATUS, OperationType.REDEPLOY},
        )
    executor = MockOperationExecutor(
        simulate_failure=simulate_failure,
        simulate_verification_failure=simulate_verification_failure,
    )
    return OperationService(
        target_resolver=target_resolver,
        capability_resolver=cap_resolver,
        executor=executor,
    ), executor


