class TestCapabilityResolution:
    """Provider capability resolution."""

    def test_supported(self):
        resolver = CapabilityResolver()
        resolver.register(
            ProviderType.KUBERNETES,
            {OperationType.RESTART, OperationType.QUERY_STATUS},
        )
        result = resolver.resolve(ProviderType.KUBERNETES, OperationType.RESTART)
        assert result == CapabilityDecision.SUPPORTED
        assert result.is_supported is True

    def test_unsupported(self):
        resolver = CapabilityResolver()
        resolver.register(
            ProviderType.KUBERNETES, {OperationType.QUERY_STATUS},
        )
        result = resolver.resolve(ProviderType.KUBERNETES, OperationType.RESTART)
        assert result == CapabilityDecision.UNSUPPORTED
        assert result.is_supported is False

    def test_unknown_provider(self):
        resolver = CapabilityResolver()
        result = resolver.resolve(ProviderType.UNKNOWN, OperationType.RESTART)
        assert result == CapabilityDecision.UNKNOWN
        assert result.is_supported is False

    def test_unregistered_provider(self):
        """Provider not registered → UNKNOWN, not SUPPORTED."""
        resolver = CapabilityResolver()
        result = resolver.resolve(ProviderType.KUBERNETES, OperationType.RESTART)
        assert result == CapabilityDecision.UNKNOWN
        assert result.is_supported is False

    def test_unknown_not_treated_as_supported(self):
        """UNKNOWN is NOT SUPPORTED — no capability assumed from name."""
        resolver = CapabilityResolver()
        result = resolver.resolve(ProviderType.VMWARE, OperationType.RESTART)
        assert result == CapabilityDecision.UNKNOWN
        assert result.is_supported is False


