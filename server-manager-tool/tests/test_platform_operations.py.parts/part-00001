class TestAuthorization:
    """Authorization level handling."""

    def test_execute_auth_allows_mutating(self):
        service, executor = make_service()
        req = make_request(auth=AuthorizationLevel.EXECUTE)
        result = service.execute(req)
        assert result.was_executed

    def test_read_only_blocks_mutating(self):
        service, executor = make_service()
        req = make_request(auth=AuthorizationLevel.READ_ONLY)
        result = service.execute(req)
        assert result.status == OperationStatus.BLOCKED
        assert "INSUFFICIENT" in (result.error or "")

    def test_dry_run_does_not_mutate(self):
        service, executor = make_service()
        req = make_request(auth=AuthorizationLevel.DRY_RUN)
        result = service.execute(req)
        assert result.status == OperationStatus.BLOCKED
        assert executor.mutation_count == 0

    def test_discovery_blocks_mutating(self):
        service, executor = make_service()
        req = make_request(auth=AuthorizationLevel.DISCOVERY)
        result = service.execute(req)
        assert result.status == OperationStatus.BLOCKED
        assert executor.mutation_count == 0

    def test_query_status_allowed_read_only(self):
        """QUERY_STATUS is non-mutating, allowed at READ_ONLY."""
        service, executor = make_service()
        req = make_request(
            op_type=OperationType.QUERY_STATUS,
            auth=AuthorizationLevel.READ_ONLY,
            execution_enabled=False,
        )
        result = service.execute(req)
        # QUERY_STATUS doesn't require execution_enabled
        assert result.was_executed

    def test_query_status_blocked_discovery(self):
        """QUERY_STATUS requires at least READ_ONLY."""
        service, executor = make_service()
        req = make_request(
            op_type=OperationType.QUERY_STATUS,
            auth=AuthorizationLevel.DISCOVERY,
            execution_enabled=False,
        )
        result = service.execute(req)
        assert result.status == OperationStatus.BLOCKED


