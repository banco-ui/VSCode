class TestTargetResolution:
    """Target resolution via canonical_id."""

    def test_canonical_id_resolved(self):
        resolver = TargetResolver()
        resolver.register_target(
            "canon-k8s-node-01", ProviderType.KUBERNETES,
            provider_id="k8s-node-01", entity_type="NODE",
        )
        result = resolver.resolve("canon-k8s-node-01")
        assert result.resolved is True
        assert result.canonical_id == "canon-k8s-node-01"
        assert result.provider_type == ProviderType.KUBERNETES
        assert result.provider_id == "k8s-node-01"
        assert result.entity_type == "NODE"

    def test_provider_id_preserved_when_explicit(self):
        resolver = TargetResolver()
        resolver.register_target(
            "canon-wl-01", ProviderType.KUBERNETES,
            provider_id="k8s-wl-01", entity_type="WORKLOAD",
        )
        result = resolver.resolve("canon-wl-01")
        assert result.provider_id == "k8s-wl-01"

    def test_missing_target_unresolved(self):
        resolver = TargetResolver()
        result = resolver.resolve("canon-nonexistent")
        assert result.resolved is False
        assert result.ambiguous is False

    def test_ambiguous_target_flag(self):
        """An explicitly ambiguous target returns ambiguous=True."""
        resolver = TargetResolver()
        target = TargetResolution(
            resolved=True, canonical_id="canon-x",
            provider_type=ProviderType.KUBERNETES,
            ambiguous=True,
        )
        resolver._targets["canon-x"] = target
        result = resolver.resolve("canon-x")
        assert result.ambiguous is True

    def test_graph_context_resolution(self):
        """Target resolvable via graph context when not registered."""
        resolver = TargetResolver()
        from server_manager.graph import GraphReport, GraphNode
        from server_manager.graph.models import EntityType
        node = GraphNode(
            canonical_id="canon-graph-node-01",
            entity_type=EntityType.NODE,
            provider_type=ProviderType.KUBERNETES,
            source_evidence=SourceEvidence(
                provider_type=ProviderType.KUBERNETES,
                confidence=Confidence.HIGH,
            ),
        )
        report = GraphReport(nodes=[node], relationships=[])
        graph_ctx = OperationGraphContext(GraphQuery(report))
        result = resolver.resolve("canon-graph-node-01", graph_ctx)
        assert result.resolved is True
        assert result.provider_type == ProviderType.KUBERNETES

    def test_no_inference_from_hostname(self):
        """No inference from hostname patterns or naming conventions."""
        resolver = TargetResolver()
        # Unregistered target with hostname-like name → NOT resolved
        result = resolver.resolve("node-01.example.com")
        assert result.resolved is False

    def test_no_inference_from_naming(self):
        resolver = TargetResolver()
        result = resolver.resolve("k8s-prod-node-01")
        assert result.resolved is False


