class TestIdempotency:
    """Idempotency: same (target, op_type, params) → no duplicate execution."""

    def test_duplicate_request_blocked(self):
        """First execution succeeds; second identical request is blocked."""
        service, executor = make_service()
        req = make_request()
        r1 = service.execute(req)
        assert r1.status == OperationStatus.VERIFIED
        assert executor.mutation_count == 1
        r2 = service.execute(req)
        assert r2.status == OperationStatus.BLOCKED
        assert executor.mutation_count == 1  # no additional mutation

    def test_same_request_identity(self):
        """Same (target, op_type, params) → same identity_key."""
        r1 = make_request(operation_id="op-a")
        r2 = make_request(operation_id="op-b")
        assert r1.identity_key == r2.identity_key

    def test_different_target_different_identity(self):
        r1 = make_request(target="canon-a")
        r2 = make_request(target="canon-b")
        assert r1.identity_key != r2.identity_key

    def test_different_params_different_identity(self):
        r1 = make_request(params=OperationParameters(namespace="ns1"))
        r2 = make_request(params=OperationParameters(namespace="ns2"))
        assert r1.identity_key != r2.identity_key

    def test_failed_operation_allows_retry(self):
        """A FAILED operation removes from active set, allowing retry."""
        service_fail, executor_fail = make_service(simulate_failure=True)
        req = make_request()
        r1 = service_fail.execute(req)
        assert r1.status == OperationStatus.FAILED
        assert executor_fail.mutation_count == 1
        # Retry with non-failing executor
        service_ok, executor_ok = make_service()
        r2 = service_ok.execute(req)
        assert r2.status == OperationStatus.VERIFIED
        assert executor_ok.mutation_count == 1

    def test_no_auto_retry_on_failure(self):
        """Failure does not auto-trigger another operation."""
        service, executor = make_service(simulate_failure=True)
        req = make_request()
        result = service.execute(req)
        assert result.status == OperationStatus.FAILED
        # No escalation — mutation count stays at 1
        assert executor.mutation_count == 1


