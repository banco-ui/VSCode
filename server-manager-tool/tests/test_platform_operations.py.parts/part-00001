class TestExecution:
    """Mock execution and post-action verification tests."""

    def test_mock_successful_execution(self):
        service, executor = make_service()
        req = make_request()
        result = service.execute(req)
        assert result.status == OperationStatus.VERIFIED
        assert result.is_success
        assert executor.mutation_count == 1

    def test_mock_execution_failure(self):
        service, executor = make_service(simulate_failure=True)
        req = make_request()
        result = service.execute(req)
        assert result.status == OperationStatus.FAILED
        assert not result.is_success
        assert result.error is not None

    def test_verification_success(self):
        service, executor = make_service()
        req = make_request()
        result = service.execute(req)
        assert result.status == OperationStatus.VERIFIED
        assert "verified" in result.evidence

    def test_verification_failure(self):
        """Execution succeeded but verification failed."""
        service, executor = make_service(simulate_verification_failure=True)
        req = make_request()
        result = service.execute(req)
        assert result.status == OperationStatus.VERIFICATION_FAILED
        assert not result.is_success
        assert result.was_executed

    def test_executed_not_verified(self):
        """EXECUTED is not the same as VERIFIED — need post-action evidence."""
        service, executor = make_service()
        req = make_request()
        # Execute via service goes through verify(), so we test executor directly
        target = make_resolved_target()
        exec_result = executor.execute(req, target)
        assert exec_result.status == OperationStatus.EXECUTED
        assert not exec_result.is_success  # EXECUTED is not success yet

    def test_blocked_execution_no_mutation(self):
        """When safety gate blocks, executor must not be called."""
        service, executor = make_service()
        req = make_request(execution_enabled=False)
        result = service.execute(req)
        assert result.status == OperationStatus.BLOCKED
        assert executor.mutation_count == 0


