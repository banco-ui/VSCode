class TestSafetyGate:
    """Direct safety gate evaluation tests."""

    def test_valid_request_passes(self):
        gate = OperationSafetyGate(active_identity_keys=set())
        req = make_request()
        target = make_resolved_target()
        cap = CapabilityDecision.SUPPORTED
        result = gate.evaluate(req, target, cap, AuthorizationLevel.EXECUTE)
        assert result.result == SafetyResult.PASS

    def test_unresolved_target_blocked(self):
        gate = OperationSafetyGate()
        req = make_request()
        target = TargetResolution(resolved=False, canonical_id="")
        result = gate.evaluate(req, target, CapabilityDecision.SUPPORTED, AuthorizationLevel.EXECUTE)
        assert result.result == SafetyResult.BLOCKED
        assert result.reason == OperationBlockReason.TARGET_UNRESOLVED

    def test_ambiguous_target_blocked(self):
        gate = OperationSafetyGate()
        req = make_request()
        target = TargetResolution(resolved=True, canonical_id="canon-x", ambiguous=True, 