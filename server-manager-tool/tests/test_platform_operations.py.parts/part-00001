        assert req.operation_type == OperationType.RESTART
        assert req.target_canonical_id == "canon-k8s-node-01"

    def test_is_mutating_restart(self):
        req = make_request(op_type=OperationType.RESTART)
        assert req.is_mutating is True

    def test_is_not_mutating_query_status(self):
        req = make_request(op_type=OperationType.QUERY_STATUS)
        assert req.is_mutating is False

    def test_identity_key_deterministic(self):
        """Same (target, op_type, params) → same identity."""
        r1 = make_request()
        r2 = make_request(operation_id="op-002")
        assert r1.identity_key == r2.identity_key

    def test_identity_key_differs_different_target(self):
        r1 = make_request(target="canon-a")
