class TestIdentifierMismatch:
    """Verify different host_uuids produce different canonical_ids (no auto-merge)."""

    def test_different_uuids_different_canonical_ids(self):
        """Two hosts with different UUIDs must get different canonical IDs."""
        fixture_a = _make_fixture(host_uuid="uuid-aaa", hostname="ctrl-0")
        fixture_b = _make_fixture(host_uuid="uuid-bbb", hostname="ctrl-0")
        dr_a = _discover(fixture_a)
        dr_b = _discover(fixture_b)
        id_a = dr_a.inventory.nodes[0].canonical_id
        id_b = dr_b.inventory.nodes[0].canonical_id
        assert id_a != id_b

    def test_same_hostname_different_uuid_not_merged(self):
        """Same hostname but different UUID must NOT be treated as same asset."""
        fixture_a = _make_fixture(host_uuid="uuid-aaa", hostname="controller-0")
        fixture_b = _make_fixture(host_uuid="uuid-bbb", hostname="controller-0")
        dr_a = _discover(fixture_a)
        dr_b = _discover(fixture_b)
        node_a = dr_a.inventory.nodes[0]
        node_b = dr_b.inventory.nodes[0]
        assert node_a.canonical_id != node_b.canonical_id
        assert node_a.provider_id != node_b.provider_id

    def test_missing_uuid_no_entity(self):
        """Host with empty UUID should not produce a Node."""
        fixture = _make_fixture(host_uuid="")
        dr = _discover(fixture)
        assert len(dr.inventory.nodes) == 0

    def test_different_system_uuid_different_platform(self):
        """Different system UUIDs produce different platform canonical IDs."""
        fixture_a = _make_fixture()
        fixture_b = _make_fixture(host_uuid="uuid-x")
        fixture_b["sysinv_isystems"][0]["uuid"] = "sys-uuid-bbb"
        dr_a = _discover(fixture_a)
        dr_b = _discover(fixture_b)
        plat_a = dr_a.inventory.platforms[0]
        plat_b = dr_b.inventory.platforms[0]
        assert plat_a.canonical_id != plat_b.canonical_id

    def test_hostname_only_match_not_identity(self):
        """Same hostname + different UUID → NOT same asset (hostname is not identity)."""
        fixture = _make_fixture(host_uuid="uuid-aaa", hostname="compute-1")
        dr = _discover(fixture)
        node = dr.inventory.nodes[0]
        assert node.provider_id == "uuid-aaa"
        assert node.name == "compute-1"
        assert "compute-1" not in node.canonical_id

