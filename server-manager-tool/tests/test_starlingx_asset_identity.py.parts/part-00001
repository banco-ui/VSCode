class TestPhysicalEntitySemantics:
    """Verify bm_type=none does not trigger Physical entity creation."""

    def test_no_physical_from_bm_type_none(self):
        """StarlingX with bm_type=none must NOT create Physical entities."""
        fixture = _make_fixture(bm_type="none")
        dr = _discover(fixture)
        assert len(dr.inventory.physicals) == 0

    def test_node_has_no_physical_ref(self):
        """Node.physical_ref must be None when no Physical evidence."""
        fixture = _make_fixture(bm_type="none")
        dr = _discover(fixture)
        node = dr.inventory.nodes[0]
        assert node.physical_ref is None

    def test_node_not_treated_as_physical(self):
        """Node and Physical are distinct entity types."""
        fixture = _make_fixture(bm_type="none")
        dr = _discover(fixture)
        assert len(dr.inventory.nodes) == 1
        assert len(dr.inventory.physicals) == 0
        node = dr.inventory.nodes[0]
        assert node.canonical_id.startswith("canon-wrcp-node-")
        assert not node.canonical_id.startswith("canon-wrcp-physical-")

    def test_bm_type_ipmi_still_no_physical(self):
        """Even with bm_type=ipmi, no Physical from StarlingX normalizer."""
        fixture = _make_fixture(
            bm_type="ipmi", bm_ip="10.254.174.17",
            bm_hostname="bmc-ctrl-0",
        )
        dr = _discover(fixture)
        assert len(dr.inventory.physicals) == 0
        node = dr.inventory.nodes[0]
        assert node.metadata["starlingx"]["bm_ip"] == "10.254.174.17"
        assert node.physical_ref is None


