class TestFaultAlertSeparation:
    """Verify FM Critical and Redfish Critical are separate fault/alert."""

    def test_fm_critical_creates_independent_fault(self):
        """FM alarm 100.103 critical should create its own fault."""
        fixture = _make_fixture(
            fm_alarms=[_make_critical_alarm(alarm_id="100.103")],
        )
        dr = _discover(fixture)
        hp = HealthService().assess(dr)
        mon = MonitoringService().monitor(hp)
        fr = FaultDetectionService().detect(
            mon.observations, mon.state_changes)
        assert len(fr.faults) >= 1
        fault_entity_ids = {f.entity_id for f in fr.faults}
        node = dr.inventory.nodes[0]
        assert node.canonical_id in fault_entity_ids or any(
            node.canonical_id in eid for eid in fault_entity_ids
        )

    def test_fm_and_redfish_faults_have_different_entity_ids(self):
        """FM fault on Node and Redfish fault on Physical must have different entity_ids."""
        fixture = _make_fixture(
            fm_alarms=[_make_critical_alarm(alarm_id="100.103")],
        )
        dr = _discover(fixture)
        hp = HealthService().assess(dr)
        mon = MonitoringService().monitor(hp)
        fr = FaultDetectionService().detect(
            mon.observations, mon.state_changes)
        for fault in fr.faults:
            assert "canon-wrcp-" in fault.entity_id

    def test_software_fault_not_merged_with_hardware(self):
        """Software memory threshold (100.103) and hardware fault are separate."""
        fixture = _make_fixture(
            fm_alarms=[_make_critical_alarm(alarm_id="100.103")],
        )
        dr = _discover(fixture)
        hp = HealthService().assess(dr)
        mon = MonitoringService().monitor(hp)
        fr = FaultDetectionService().detect(
            mon.observations, mon.state_changes)
        fault_ids = {f.fault_id for f in fr.faults}
        assert len(fault_ids) == len(fr.faults)

    def test_alert_lifecycle_independent_per_fault(self):
        """Alerts from FM faults follow OPEN→RESOLVED lifecycle independently."""
        fixture = _make_fixture(
            fm_alarms=[_make_critical_alarm(alarm_id="100.103")],
        )
        dr = _discover(fixture)
        hp = HealthService().assess(dr)
        mon = MonitoringService().monitor(hp)
        fr = FaultDetectionService().detect(
            mon.observations, mon.state_changes)
        alert_svc = AlertService()
        for fault in fr.faults:
            result = alert_svc.create_alert(fault)
            assert result.created or result.reason == "duplicate_active"
        alerts = alert_svc.get_alerts()
        alert_ids = {a.alert_id for a in alerts}
        assert len(alert_ids) == len(alerts)


