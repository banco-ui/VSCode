def _make_fixture(
    *,
    host_uuid: str = HOST_UUID,
    hostname: str = "controller-0",
    bm_type: str = "none",
    bm_ip: Any = None,
    bm_hostname: Any = None,
    fm_alarms: list[dict[str, Any]] | None = None,
    host_availability: str = "available",
) -> dict[str, Any]:
    """Build a StarlingX fixture with configurable BMC/identity fields."""
    if fm_alarms is None:
        fm_alarms = []
    return {
        "sysinv_isystems": [{
            "uuid": SYSTEM_UUID, "name": "wrcp-ctrlr",
            "sw_version": "24.09", "system_mode": "simplex",
            "system_type": "All-in-one", "timezone": "UTC",
        }],
        "sysinv_ihosts": [{
            "uuid": host_uuid, "hostname": hostname,
            "personality": "controller", "administrative": "unlocked",
            "operational": "enabled",
            "availability": host_availability,
            "subfunctions": "controller,worker,lowlatency",
            "uptime": 15244220, "reboot_needed": False,
            "bm_type": bm_type,
            "bm_ip": bm_ip,
            "bm_hostname": bm_hostname,
            "capabilities": {},
            "location": {"locn": "samsung"},
        }],
        "sysinv_imemorys": {
            host_uuid: [{
                "platform_reserved_mib": 10000,
                "platform_total_mib": 16384,
                "platform_used_percent": 45.0,
            }],
        },
        "fm_alarms": fm_alarms,
        "fm_event_log": [],
        "smapi_nodes": [{
            "id": 1, "name": hostname,
            "administrative_state": "unlocked",
            "operational_state": "enabled",
            "availability_status": "available",
        }],
        "system_health": {"System Health": "OK"},
        "software_list": [{"release": "wrcp-24.09.0", "state": "deployed"}],
    }


def _make_critical_alarm(
    alarm_id: str = "100.103",
    entity: str = "host=controller-0",
    uuid: str = ALARM_UUID,
    severity: str = "critical",
) -> dict[str, Any]:
    return {
        "uuid": uuid, "alarm_id": alarm_id, "severity": severity,
        "entity_instance_id": entity,
        "reason_text": f"{alarm_id} threshold exceeded",
    }


def _discover(fixture: dict[str, Any]):
    """Run StarlingX discovery. Returns DiscoveryResult."""
    adapter = StarlingXProviderAdapter(fixture=fixture)
    normalizer = StarlingXProviderNormalizer()
    discovery = PlatformDiscovery()
    return discovery.discover(adapter, normalizer)


