class TestNoNameIpInference:
    """Verify no relationship inference from name or IP similarity."""

    def test_no_graph_edge_from_hostname(self):
        """No graph relationship should be created based on hostname alone."""
        fixture = _make_fixture(hostname="controller-0")
        dr = _discover(fixture)
        graph = GraphBuilder().build_from_inventory(dr.inventory)
        for rel in graph.relationships:
            assert rel.evidence_type.value in ("DIRECT", "DERIVED")

    def test_no_graph_edge_from_ip(self):
        """No graph relationship should be created based on IP alone."""
        fixture = _make_fixture(
            bm_type="ipmi", bm_ip="10.254.174.17",
            bm_hostname="controller-0-bmc",
        )
        dr = _discover(fixture)
        graph = GraphBuilder().build_from_inventory(dr.inventory)
        for rel in graph.relationships:
            if rel.raw_data:
                raw_str = str(rel.raw_data)
                # IP may appear in url_pattern but NOT as identity evidence
                assert "10.254.174.17" not in raw_str or "url_pattern" in raw_str

    def test_no_cross_provider_inference(self):
        """StarlingX Node canonical_id must NOT match any Redfish identity."""
        fixture = _make_fixture(hostname="controller-0")
        dr = _discover(fixture)
        node = dr.inventory.nodes[0]
        assert node.canonical_id.startswith("canon-wrcp-node-")
        assert node.provider_type == ProviderType.WRCP
        assert node.provider_type != ProviderType.KUBERNETES

    def test_no_inferred_relationship_evidence(self):
        """Relationship evidence must be DIRECT only (sub-resource URL pattern)."""
        fixture = _make_fixture()
        dr = _discover(fixture)
        for ev in dr.inventory.relationship_evidence:
            assert ev.evidence_type.value == "DIRECT"


