def make_node(name, uid=None, ready=True, memory_pressure=False,
              disk_pressure=False, pid_pressure=False, cpu_capacity="8",
              cpu_allocatable="7500m", memory_capacity="16256396Ki",
              memory_allocatable="15256396Ki", pod_capacity="110"):
    conditions = [
        {"type": "Ready", "status": "True" if ready else "False"},
        {"type": "MemoryPressure", "status": "True" if memory_pressure else "False"},
        {"type": "DiskPressure", "status": "True" if disk_pressure else "False"},
        {"type": "PIDPressure", "status": "True" if pid_pressure else "False"},
    ]
    return {
        "apiVersion": "v1", "kind": "Node",
        "metadata": {"name": name, "uid": uid or "uid-node-" + name,
                     "labels": {"kubernetes.io/hostname": name}},
        "spec": {}, "status": {
            "nodeInfo": {"kubeletVersion": "v1.28.0"}, "conditions": conditions,
            "capacity": {"cpu": cpu_capacity, "memory": memory_capacity, "pods": pod_capacity},
            "allocatable": {"cpu": cpu_allocatable, "memory": memory_allocatable, "pods": pod_capacity},
        },
    }

def make_container(name, image="nginx:1.21"):
    return {"name": name, "image": image, "resources": {}}

def make_pod(name, uid=None, namespace="default", node_name=None,
             phase="Running", ready=True, containers=None):
    spec = {}
    if node_name:
        spec["nodeName"] = node_name
    spec["containers"] = containers or [make_container("main")]
    conditions = []
    if phase == "Running":
        conditions = [
            {"type": "Ready", "status": "True" if ready else "False"},
            {"type": "ContainersReady", "status": "True" if ready else "False"},
            {"type": "Initialized", "status": "True"},
            {"type": "PodScheduled", "status": "True"},
        ]
    elif phase == "Pending":
        conditions = [
            {"type": "Initialized", "status": "True"},
            {"type": "PodScheduled", "status": "False"},
        ]
    elif phase == "Failed":
        conditions = [
            {"type": "Ready", "status": "False"},
            {"type": "ContainersReady", "status": "False"},
        ]
    return {
        "apiVersion": "v1", "kind": "Pod",
        "metadata": {"name": name, "uid": uid or "uid-pod-" + name, "namespace": namespace},
        "spec": spec, "status": {"phase": phase, "conditions": conditions},
    }

def make_service(name, uid=None, svc_type="ClusterIP"):
    return {
        "apiVersion": "v1", "kind": "Service",
        "metadata": {"name": name, "uid": uid or "uid-svc-" + name, "namespace": "default"},
        "spec": {"type": svc_type, "clusterIP": "10.96.0.1"},
    }

def make_pv(name, uid=None, phase="Bound"):
    return {
        "apiVersion": "v1", "kind": "PersistentVolume",
        "metadata": {"name": name, "uid": uid or "uid-pv-" + name},
        "spec": {"capacity": {"storage": "10Gi"}}, "status": {"phase": phase},
    }

def make_pvc(name, uid=None, phase="Bound"):
    return {
        "apiVersion": "v1", "kind": "PersistentVolumeClaim",
        "metadata": {"name": name, "uid": uid or "uid-pvc-" + name, "namespace": "default"},
        "spec": {"resources": {"requests": {"storage": "5Gi"}}}, "status": {"phase": phase},
    }

def make_namespace(name):
    return {"apiVersion": "v1", "kind": "Namespace", "metadata": {"name": name, "uid": "uid-ns-" + name}}

