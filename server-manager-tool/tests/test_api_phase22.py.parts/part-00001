# ── Pipeline + ManagementContext Builder ──────────────────────────────

def build_management_context(topology, provider_id="test-cluster"):
    """Run the full pipeline and build a ManagementContext."""
    mock_client = MockCoreV1Api(topology)
    normalizer = KubernetesProviderNormalizer()
    discovery = PlatformDiscovery()
    adapter = KubernetesProviderAdapter(provider_id=provider_id, client=MockCoreV1Api(topology))
    discovery_result = discovery.discover(adapter, normalizer)

    health_service = HealthService()
    health_report = health_service.assess(discovery_result)

    graph_builder = GraphBuilder()
    graph_report = graph_builder.build(discovery_result)
    graph_query = GraphQuery(graph_report)

    monitoring_service = MonitoringService()
    monitoring_report = monitoring_service.monitor(health_report)

    fault_service = FaultDetectionService()
    fault_result = fault_service.detect(
        monitoring_report.observations, monitoring_report.state_changes)

    alert_service = AlertService()
    for fault in fault_result.faults:
        alert_service.create_alert(fault)

    visibility = OperationalVisibilityService(alert_service=alert_service)
    visibility.set_inventory(discovery_result.inventory)
    visibility.set_health_report(health_report)
    visibility.set_fault_result(fault_result)
    visibility.set_graph_query(graph_query)

    target_resolver = TargetResolver()
    for node in discovery_result.inventory.nodes:
        target_resolver.register_target(
            canonical_id=node.canonical_id,
            provider_type=ProviderType.KUBERNETES,
            provider_id=provider_id, entity_type="Node")
    cap_resolver = CapabilityResolver()
    cap_resolver.register(ProviderType.KUBERNETES, {OperationType.RESTART, OperationType.QUERY_STATUS})
    operation_service = OperationService(
        target_resolver=target_resolver, capability_resolver=cap_resolver,
        executor=_NoOpOperationExecutor(),
        graph_context=OperationGraphContext(graph_query))

    recovery_service = RecoveryService(
        executor=_MockRecoveryExecutor(), execution_enabled=False,
        authorization=AuthorizationLevel.READ_ONLY)

    ctx = ManagementContext()
    ctx.discovery_result = discovery_result
    ctx.health_report = health_report
    ctx.graph_query = graph_query
    ctx.monitoring_service = monitoring_service
    ctx.monitoring_report = monitoring_report
    ctx.fault_result = fault_result
    ctx.alert_service = alert_service
    ctx.visibility = visibility
    ctx.operation_service = operation_service
    ctx.recovery_service = recovery_service
    return ctx


@pytest.fixture
def client():
    topology = make_healthy_cluster_topology()
    ctx = build_management_context(topology)
    app = create_app()
    app.dependency_overrides[deps.get_management_context] = lambda: ctx
    return TestClient(app), ctx


