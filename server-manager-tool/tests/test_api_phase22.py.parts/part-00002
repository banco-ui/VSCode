# ── Mutation Safety ──────────────────────────────────────────────────

class TestMutationSafety:
    def test_no_subprocess_in_management_routes(self):
        from server_manager.api import management_routes
        source = inspect.getsource(management_routes)
        assert "subprocess" not in source.lower()
        assert "kubectl" not in source.lower()
        assert "os.system" not in source

    def test_no_execute_calls_in_management_routes(self):
        from server_manager.api import management_routes
        source = inspect.getsource(management_routes)
        assert ".execute(" not in source
        assert "svc.preview(" in source

    def test_no_mutation_in_management_schemas(self):
        from server_manager.api import management_schemas
        source = inspect.getsource(management_schemas)
        assert "subprocess" not in source.lower()
        assert "kubectl" not in source.lower()

    def test_management_context_no_mutation(self):
        source = inspect.getsource(ManagementContext)
        assert "subprocess" not in source.lower()
        assert "kubectl" not in source.lower()
        # Check that no actual execution CALLS are made (method calls with .)
        # but allow method definitions in no-op executors (def execute)
        assert ".execute(" not in source
        assert "svc.execute" not in source

    def test_all_endpoints_are_read_only_or_preview(self):
        from server_manager.api import management_routes
        source = inspect.getsource(management_routes)
        assert "@router.put" not in source
        assert "@router.delete" not in source
        assert "@router.patch" not in source
        post_lines = [l for l in source.split('\n') if '@router.post' in l]
        for line in post_lines:
            # POST endpoints are either preview-only or discovery run (read-only exploration)
            assert 'preview' in line.lower() or 'discovery' in line.lower()


