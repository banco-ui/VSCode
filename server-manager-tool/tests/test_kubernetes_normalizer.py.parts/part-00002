    def test_malformed_node_skipped(self):
        """Malformed Node (not a dict) is skipped, not crash."""
        fixture = {"cluster": {"name": "c", "version": "1.0"},
                   "nodes": ["not-a-dict", 42, None]}
        result = collect_and_normalize(fixture)
        assert len(result.nodes) == 0

    def test_malformed_pod_skipped(self):
        fixture = {"cluster": {"name": "c", "version": "1.0"},
                   "pods": ["bad", None, 123]}
        result = collect_and_normalize(fixture)
        pods = [ee for ee in result.execution_environments
                if ee.ee_type == ExecutionEnvironmentType.POD]
        assert len(pods) == 0

    def test_pod_without_name_skipped(self):
        """Pod without metadata.name is skipped."""
        fixture = {"cluster": {"name": "c", "version": "1.0"},
                   "pods": [{"metadata": {"uid": "x"}, "spec": {}}]}
        result = collect_and_normalize(fixture)
        pods = [ee for ee in result.execution_environments
                if ee.ee_type == ExecutionEnvironmentType.POD]
        # Pod has uid but no name → provider_id = uid → still created
        # Actually pod_pid = uid or name, so uid is used
        # Let me check: pod_name="" but pod_pid = uid → EE created with name=""
        # This is valid, not skipped. The test should verify it's created.
        assert len(pods) == 1
        assert pods[0].name == ""

    def test_pod_without_uid_uses_name(self):
        """Pod without uid falls back to name as provider_id."""
        fixture = {"cluster": {"name": "c", "version": "1.0"},
                   "pods": [{"metadata": {"name": "no-uid-pod"}, "spec": {}}]}
        result = collect_and_normalize(fixture)
        pods = [ee for ee in result.execution_environments
                if ee.ee_type == ExecutionEnvironmentType.POD]
        assert len(pods) == 1
        assert pods[0].provider_id == "no-uid-pod"

    def test_pod_without_uid_and_name_skipped(self):
        """Pod without uid AND name is skipped."""
        fixture = {"cluster": {"name": "c", "version": "1.0"},
                   "pods": [{"metadata": {}, "spec": {}}]}
        result = collect_and_normalize(fixture)
        pods = [ee for ee in result.execution_environments
                if ee.ee_type == ExecutionEnvironmentType.POD]
        assert len(pods) == 0

    def test_container_without_name_skipped(self):
        """Container without name is skipped."""
        fixture = {"cluster": {"name": "c", "version": "1.0"},
                   "pods": [{"metadata": {"name": "p", "uid": "u"},
                             "spec": {"containers": [{"image": "nginx"}]}}]}
        result = collect_and_normalize(fixture)
        containers = [ee for ee in result.execution_environments
                      if ee.ee_type == ExecutionEnvironmentType.CONTAINER]
        assert len(containers) == 0

    def test_node_without_name_skipped(self):
        """Node without metadata.name is skipped."""
        fixture = {"cluster": {"name": "c", "version": "1.0"},
                   "nodes": [{"metadata": {"uid": "x"}}]}
        result = collect_and_normalize(fixture)
        assert len(result.nodes) == 0

    def test_empty_cluster_success(self, fx_empty):
        """Empty cluster with no resources normalizes successfully."""
        result = collect_and_normalize(fx_empty)
        assert result.status == OrchestrationStatus.SUCCESS
        assert result.entity_count == 2  # platform + cluster

    def test_no_heuristic_relationship_inference(self, fx_combined):
        """No relationships created from name/label similarity."""
        result = collect_and_normalize(fx_combined)
        # Only DIRECT and DERIVED evidence from explicit K8s fields
        for e in result.relationship_evidence:
            assert e.evidence_type in (
                RelationshipEvidenceType.DIRECT,
                RelationshipEvidenceType.DERIVED,
            )

    def test_no_kubernetes_fields_on_canonical_entity(self, fx_node):
        """K8s-specific fields must not leak into canonical entity fields."""
        result = collect_and_normalize(fx_node)
        n = result.nodes[0]
        # Node canonical fields: name, cluster_ref, physical_ref, execution_environment_refs
        # K8s data should be in metadata, not in canonical fields
        assert "kubernetes" in n.metadata
        assert not hasattr(n, "labels")
        assert not hasattr(n, "node_info")
        assert not hasattr(n, "capacity")

    def test_normalize_safe_on_exception(self):
        """normalize_safe catches exceptions and returns FAILED result."""
        class FailingNormalizer(KubernetesProviderNormalizer):
            def normalize(self, snapshot):
                raise RuntimeError("Internal error")
        normalizer = FailingNormalizer()
        snap = RawProviderSnapshot(
            snapshot_id="snap-bad",
            provider_type=ProviderType.KUBERNETES,
            payload={},
        )
        result = normalizer.normalize_safe(snap)
        assert isinstance(result, NormalizationResult)
        assert result.status == OrchestrationStatus.FAILED
