class TestCombinedTopology:
    """K-15: Combined multi-layer topology."""

    def test_all_entity_types_created(self, fx_combined):
        result = collect_and_normalize(fx_combined)
        assert len(result.platforms) == 1
        assert len(result.clusters) == 1
        assert len(result.nodes) == 3
        # 2 pods + 3 containers = 5 EEs
        assert len(result.execution_environments) == 5
        assert len(result.networks) == 2
        assert len(result.storages) == 2
        # No workloads, physicals, OS, accelerators
        assert len(result.workloads) == 0
        assert len(result.physicals) == 0

    def test_combined_status_success(self, fx_combined):
        result = collect_and_normalize(fx_combined)
        assert result.status == OrchestrationStatus.SUCCESS

    def test_combined_entity_count(self, fx_combined):
        result = collect_and_normalize(fx_combined)
        # 1 platform + 1 cluster + 3 nodes + 5 EEs + 2 networks + 2 storages = 14
        assert result.entity_count == 14

    def test_combined_all_refs_resolved(self, fx_combined):
        """All refs resolved to canonical_ids (not raw provider_ids)."""
        result = collect_and_normalize(fx_combined)
        for n in result.nodes:
            assert n.cluster_ref is not None
            assert n.cluster_ref.startswith("canon-")
        pods = [ee for ee in result.execution_environments
                if ee.ee_type == ExecutionEnvironmentType.POD]
        for p in pods:
            if p.node_ref is not None:
                assert p.node_ref.startswith("canon-")

    def test_combined_all_identity_separated(self, fx_combined):
        """Every entity has canonical_id != provider_id."""
        result = collect_and_normalize(fx_combined)
        all_entities = (
            result.platforms + result.clusters + result.nodes +
            result.execution_environments + result.networks + result.storages
        )
        for e in all_entities:
            assert e.canonical_id != e.provider_id


