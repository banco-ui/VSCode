def make_node(name, uid=None):
    return {"apiVersion": "v1", "kind": "Node",
            "metadata": {"name": name, "uid": uid or f"uid-node-{name}"},
            "spec": {}, "status": {}}


def make_container(name, image="nginx:1.21"):
    return {"name": name, "image": image, "resources": {}}


def make_pod(name, uid=None, namespace="default", node_name=None, containers=None):
    spec = {}
    if node_name:
        spec["nodeName"] = node_name
    spec["containers"] = containers or [make_container("main")]
    return {"apiVersion": "v1", "kind": "Pod",
            "metadata": {"name": name, "uid": uid or f"uid-pod-{name}",
                         "namespace": namespace},
            "spec": spec, "status": {"phase": "Running"}}


def make_service(name, uid=None, svc_type="ClusterIP"):
    return {"apiVersion": "v1", "kind": "Service",
            "metadata": {"name": name, "uid": uid or f"uid-svc-{name}",
                         "namespace": "default"},
            "spec": {"type": svc_type, "clusterIP": "10.96.0.1"}}


def make_pv(name, uid=None):
    return {"apiVersion": "v1", "kind": "PersistentVolume",
            "metadata": {"name": name, "uid": uid or f"uid-pv-{name}"},
            "spec": {"capacity": {"storage": "10Gi"}}}


def make_pvc(name, uid=None):
    return {"apiVersion": "v1", "kind": "PersistentVolumeClaim",
            "metadata": {"name": name, "uid": uid or f"uid-pvc-{name}",
                         "namespace": "default"},
            "spec": {"resources": {"requests": {"storage": "5Gi"}}}}


def make_deployment(name):
    return {"apiVersion": "apps/v1", "kind": "Deployment",
            "metadata": {"name": name, "uid": f"uid-deploy-{name}"}}


def collect_and_normalize(fixture: dict[str, Any]) -> NormalizationResult:
    """Helper: collect from fixture then normalize."""
    adapter = KubernetesProviderAdapter(fixture=fixture)
    snap = adapter.collect()
    normalizer = KubernetesProviderNormalizer()
    return normalizer.normalize(snap)


