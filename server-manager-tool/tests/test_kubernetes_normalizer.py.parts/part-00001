class TestPodToExecutionEnvironment:
    """G4-09: Pod → ExecutionEnvironment(POD)."""

    def test_pod_creates_ee(self, fx_pod):
        result = collect_and_normalize(fx_pod)
        pods = [ee for ee in result.execution_environments
                if ee.ee_type == ExecutionEnvironmentType.POD]
        assert len(pods) == 1

    def test_pod_ee_type_pod(self, fx_pod):
        result = collect_and_normalize(fx_pod)
        pods = [ee for ee in result.execution_environments
                if ee.ee_type == ExecutionEnvironmentType.POD]
        assert pods[0].ee_type == ExecutionEnvironmentType.POD

    def test_pod_ee_name_preserved(self, fx_pod):
        result = collect_and_normalize(fx_pod)
        pods = [ee for ee in result.execution_environments
                if ee.ee_type == ExecutionEnvironmentType.POD]
        assert pods[0].name == "nginx"

    def test_pod_ee_node_ref_resolved(self, fx_pod):
        """Pod's node_ref resolved to Node's canonical_id."""
        result = collect_and_normalize(fx_pod)
        pods = [ee for ee in result.execution_environments
                if ee.ee_type == ExecutionEnvironmentType.POD]
        nodes = result.nodes
        assert pods[0].node_ref == nodes[0].canonical_id

    def test_pod_ee_identity_separation(self, fx_pod):
        result = collect_and_normalize(fx_pod)
        pods = [ee for ee in result.execution_environments
                if ee.ee_type == ExecutionEnvironmentType.POD]
        assert pods[0].canonical_id != pods[0].provider_id

    def test_pod_without_node_no_node_ref(self, fx_pod_no_node):
        """Pod without nodeName has node_ref=None."""
        result = collect_and_normalize(fx_pod_no_node)
        pods = [ee for ee in result.execution_environments
                if ee.ee_type == ExecutionEnvironmentType.POD]
        assert len(pods) == 1
        assert pods[0].node_ref is None


