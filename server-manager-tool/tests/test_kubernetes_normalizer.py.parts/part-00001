class TestNormalizerStructure:
    """G4-03: Existing abstractions reused. G4-04: No duplicate framework."""

    def test_inherits_generic_provider_normalizer(self):
        assert issubclass(KubernetesProviderNormalizer, GenericProviderNormalizer)

    def test_inherits_provider_normalizer(self):
        assert issubclass(KubernetesProviderNormalizer, ProviderNormalizer)

    def test_provider_type_kubernetes(self):
        n = KubernetesProviderNormalizer()
        assert n.provider_type == ProviderType.KUBERNETES

    def test_normalize_returns_normalization_result(self, fx_cluster_only):
        result = collect_and_normalize(fx_cluster_only)
        assert isinstance(result, NormalizationResult)


