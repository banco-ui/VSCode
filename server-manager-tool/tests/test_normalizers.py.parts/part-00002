    def test_drive_volume_capacity_semantics(self):
        """P1-RF.18: Drive/Volume capacity follows the same rules — real 0 kept,
        valid converted, parse failure None."""
        raw = self._minimal_raw()
        raw["storage"] = [{
            "controllers": [],
            "drives": [
                {"Name": "D0", "CapacityBytes": 0},           # real zero
                {"Name": "D1", "CapacityBytes": 1000000000},  # valid
                {"Name": "D2", "CapacityBytes": "bad"},       # parse failure
            ],
            "volumes": [{"Name": "V0", "CapacityBytes": 2000000000}],
        }]
        norm = RedfishNormalizer()
        inv = norm.normalize(raw)
        assert inv.hardware.storage.physical_disks[0].capacity_gb == 0.0
        assert inv.hardware.storage.physical_disks[1].capacity_gb == round(1000000000 / (1024 ** 3), 2)
        assert inv.hardware.storage.physical_disks[2].capacity_gb is None
        assert inv.hardware.storage.virtual_disks[0].capacity_gb == round(2000000000 / (1024 ** 3), 2)
