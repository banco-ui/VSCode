    def test_normalize_storage_partial_failure(self):
        """One malformed drive does not destroy other storage data."""
        raw = {
            "source": "redfish",
            "system": {},
            "storage": [
                {
                    "controllers": [{"Name": "Ctrl", "Status": {"Health": "OK"}}],
                    "drives": [
                        {"Name": "Good Disk", "CapacityBytes": 1000000000, "MediaType": "SSD", "Status": {"Health": "OK"}},
                    ],
                    "volumes": [],
                }
            ],
        }
        norm = RedfishNormalizer()
        inv = norm.normalize(raw)

        # Good data preserved
        assert len(inv.hardware.storage.controllers) == 1
        assert len(inv.hardware.storage.physical_disks) == 1
        assert inv.hardware.storage.physical_disks[0].name == "Good Disk"

    def test_normalize_storage_health_aggregation(self):
        """Storage health is reflected in overall health."""
        raw = {
            "source": "redfish",
            "system": {
                "Manufacturer": "Dell Inc.",
                "Status": {"Health": "OK"},
            },
            "storage": [
                {
                    "controllers": [{"Name": "Ctrl", "Status": {"Health": "Critical"}}],
                    "drives": [{"Name": "Disk", "MediaType": "SSD", "Status": {"Health": "OK"}}],
                    "volumes": [],
                }
            ],
        }
        norm = RedfishNormalizer()
        inv = norm.normalize(raw)

        # Storage health should be CRITICAL (from controller)
        assert inv.health.storage == HealthStatus.CRITICAL


