class TestBaseNormalizer:
    def test_safe_int(self):
        assert BaseNormalizer.safe_int("42") == 42
        assert BaseNormalizer.safe_int("abc") == 0
        assert BaseNormalizer.safe_int(None) == 0
        assert BaseNormalizer.safe_int("42", default=99) == 42

    def test_safe_float(self):
        assert BaseNormalizer.safe_float("3.14") == 3.14
        assert BaseNormalizer.safe_float("abc") == 0.0
        assert BaseNormalizer.safe_float(None) == 0.0

    def test_safe_str(self):
        assert BaseNormalizer.safe_str("hello") == "hello"
        assert BaseNormalizer.safe_str(None) == ""
        assert BaseNormalizer.safe_str(123) == "123"

    def test_parse_bool(self):
        assert BaseNormalizer.parse_bool("yes") is True
        assert BaseNormalizer.parse_bool("true") is True
        assert BaseNormalizer.parse_bool("1") is True
        assert BaseNormalizer.parse_bool("no") is False
        assert BaseNormalizer.parse_bool(True) is True
        assert BaseNormalizer.parse_bool(0) is False


