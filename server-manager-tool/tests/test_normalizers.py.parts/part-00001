class TestRedfishHealthHelpers:
    """P1-RF.7: Unit tests for Redfish health mapping helpers."""

    def test_health_from_str_none_is_unknown(self):
        """Missing status must map to UNKNOWN, never OK."""
        from server_manager.normalizers.redfish_normalizer import _health_from_str
        assert _health_from_str(None) == HealthStatus.UNKNOWN

    def test_health_from_str_empty_is_unknown(self):
        from server_manager.normalizers.redfish_normalizer import _health_from_str
        assert _health_from_str("") == HealthStatus.UNKNOWN

    def test_health_from_str_ok_case_insensitive(self):
        from server_manager.normalizers.redfish_normalizer import _health_from_str
        assert _health_from_str("OK") == HealthStatus.OK
        assert _health_from_str("ok") == HealthStatus.OK

    def test_health_from_str_warning_case_insensitive(self):
        from server_manager.normalizers.redfish_normalizer import _health_from_str
        assert _health_from_str("Warning") == HealthStatus.WARNING
        assert _health_from_str("WARNING") == HealthStatus.WARNING

    def test_health_from_str_critical_and_error(self):
        from server_manager.normalizers.redfish_normalizer import _health_from_str
        assert _health_from_str("Critical") == HealthStatus.CRITICAL
        assert _health_from_str("error") == HealthStatus.CRITICAL

    def test_health_from_str_unrecognized_string_is_unknown(self):
        """Unrecognized strings must not be promoted to OK."""
        from server_manager.normalizers.redfish_normalizer import _health_from_str
        assert _health_from_str("degraded") == HealthStatus.UNKNOWN
        assert _health_from_str("healthy-ish") == HealthStatus.UNKNOWN

    def test_max_health_worst_wins(self):
        from server_manager.normalizers.redfish_normalizer import _max_health
        assert _max_health(HealthStatus.OK, HealthStatus.WARNING) == HealthStatus.WARNING
        assert _max_health(HealthStatus.WARNING, HealthStatus.CRITICAL) == HealthStatus.CRITICAL
        assert _max_health(HealthStatus.OK) == HealthStatus.OK

    def test_max_health_unknown_is_lowest_priority(self):
        """UNKNOWN must never mask a real status, and alone stays UNKNOWN."""
        from server_manager.normalizers.redfish_normalizer import _max_health
        assert _max_health(HealthStatus.UNKNOWN) == HealthStatus.UNKNOWN
        assert _max_health(HealthStatus.UNKNOWN, HealthStatus.OK) == HealthStatus.OK
        assert _max_health(HealthStatus.UNKNOWN, HealthStatus.CRITICAL) == HealthStatus.CRITICAL

    def test_media_type_from_str(self):
        from server_manager.models.enums import MediaType
        from server_manager.normalizers.redfish_normalizer import _media_type_from_str
        assert _media_type_from_str(None) == MediaType.Unknown
        assert _media_type_from_str("") == MediaType.Unknown
        assert _media_type_from_str("SSD") == MediaType.SSD
        assert _media_type_from_str("HDD") == MediaType.HDD
        assert _media_type_from_str("NVMe") == MediaType.NVMe
        assert _media_type_from_str("SATA HDD") == MediaType.HDD
        assert _media_type_from_str("Tape") == MediaType.Unknown

    def test_controller_supports_raid_bool(self):
        from server_manager.normalizers.redfish_normalizer import _controller_supports_raid
        assert _controller_supports_raid({"ControllerCapabilities": {"RAIDSupport": True}}) is True
        assert _controller_supports_raid({"ControllerCapabilities": {"RAIDSupport": False}}) is False

    def test_controller_supports_raid_string(self):
        from server_manager.normalizers.redfish_normalizer import _controller_supports_raid
        assert _controller_supports_raid({"ControllerCapabilities": {"RAIDSupport": "true"}}) is True
        assert _controller_supports_raid({"ControllerCapabilities": {"RAIDSupport": "false"}}) is False

    def test_controller_supports_raid_name_fallback(self):
        from server_manager.normalizers.redfish_normalizer import _controller_supports_raid
        assert _controller_supports_raid({"Name": "RAID Controller"}) is True
        assert _controller_supports_raid({"Model": "PERC H755 Front"}) is True
        assert _controller_supports_raid({"Name": "SAS Controller"}) is False

    def test_controller_supports_raid_missing_or_invalid_caps(self):
        from server_manager.normalizers.redfish_normalizer import _controller_supports_raid
        assert _controller_supports_raid({}) is False
        assert _controller_supports_raid({"ControllerCapabilities": "not-a-dict"}) is False


class TestRedfishNormalizerHealthPolicy:
    """P1-RF.7: Missing status must stay UNKNOWN — never promoted to OK."""

    def _minimal_raw(self, system_overrides=None):
        system = {
            "Manufacturer": "Dell Inc.",
            "Model": "PowerEdge R750",
            "SerialNumber": "SN12345",
        }
        if system_overrides is not None:
            system.update(system_overrides)
        return {
            "source": "redfish",
            "endpoint": "https://10.0.0.1:443",
            "system": system,
        }

    def test_missing_system_status_is_unknown(self):
        norm = RedfishNormalizer()
        inv = norm.normalize(self._minimal_raw())
        assert inv.health.system == HealthStatus.UNKNOWN

    def test_explicit_ok_differs_from_missing_status(self):
        norm = RedfishNormalizer()
        inv_ok = norm.normalize(self._minimal_raw({"Status": {"Health": "OK"}}))
        inv_missing = norm.normalize(self._minimal_raw())
        assert inv_ok.health.system == HealthStatus.OK
        assert inv_missing.health.system == HealthStatus.UNKNOWN
        assert inv_ok.health.system != inv_missing.health.system

    def test_missing_processor_status_is_unknown(self):
        raw = self._minimal_raw()
        raw["processors"] = [{"Model": "Intel Xeon", "TotalCores": 24}]
        norm = RedfishNormalizer()
        inv = norm.normalize(raw)
        assert inv.hardware.cpu.processors[0].health == HealthStatus.UNKNOWN
        assert inv.health.cpu == HealthStatus.UNKNOWN

    def test_missing_memory_status_is_unknown(self):
        raw = self._minimal_raw()
        raw["memory"] = [{"DeviceLocator": "A1", "CapacityMiB": 16384}]
        norm = RedfishNormalizer()
        inv = norm.normal