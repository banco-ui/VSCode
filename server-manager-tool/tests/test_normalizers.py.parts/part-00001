    def test_normalize_storage_missing_fields(self):
        """Normalization succeeds even with missing fields."""
        raw = {
            "source": "redfish",
            "system": {},
            "storage": [
                {
                    "controllers": [{"Name": "Ctrl"}],  # No Status, no Model
                    "drives": [{"Name": "Disk"}],  # No CapacityBytes, no MediaType, no Status
                    "volumes": [{"Name": "VD"}],  # No RAIDType, no CapacityBytes, no Status
                }
            ],
        }
        norm = RedfishNormalizer()
        inv = norm.normalize(raw)

        assert len(inv.hardware.storage.controllers) == 1
        assert inv.hardware.storage.controllers[0].health == HealthStatus.UNKNOWN
        assert inv.hardware.storage.controllers[0].model == ""
        assert inv.hardware.storage.controllers[0].raid_support is False

        assert len(inv.hardware.storage.physical_disks) == 1
        # P1-RF.18: missing capacity is None (not reinterpreted as 0.0)
        assert inv.hardware.storage.physical_disks[0].capacity_gb is None
        assert inv.hardware.storage.physical_disks[0].media_type.value == "Unknown"
        assert inv.hardware.storage.physical_disks[0].protocol is None
        assert inv.hardware.storage.physical_disks[0].health == HealthStatus.UNKNOWN

        assert len(inv.hardware.storage.virtual_disks) == 1
        assert inv.hardware.storage.virtual_disks[0].raid_type is None
        assert inv.hardware.storage.virtual_disks[0].capacity_gb is None
        assert inv.hardware.storage.virtual_disks[0].health == HealthStatus.UNKNOWN

