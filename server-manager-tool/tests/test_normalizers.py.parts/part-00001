    def test_normalize_storage(self):
        """Storage normalization from Redfish storage data."""
        raw = {
            "source": "redfish",
            "endpoint": "https://10.0.0.1:443",
            "redfish_version": "1.14.0",
            "system": {
                "Manufacturer": "Dell Inc.",
                "Model": "PowerEdge R750",
                "SerialNumber": "SN12345",
                "Status": {"Health": "OK"},
            },
            "storage": [
                {
                    "controllers": [
                        {
                            "Name": "PERC H755 Front",
                            "Model": "PERC H755 Front",
                            "Status": {"Health": "OK"},
                            "ControllerCapabilities": {"RAIDSupport": True},
                        }
                    ],
                    "drives": [
                        {
                            "Name": "Physical Disk 0:1:0",
                            "Id": "0:1:0",
                            "Model": "Dell Ent NVMe PM1730a 1.92TB",
                            "CapacityBytes": 1920380912640,
                            "MediaType": "SSD",
                            "Protocol": "NVMe",
                            "Status": {"Health": "OK"},
                        },
                        {
                            "Name": "Physical Disk 0:1:1",
                            "Id": "0:1:1",
                            "Model": "ST600MP0006",
                            "CapacityBytes": 600127266816,
                            "MediaType": "HDD",
                            "Protocol": "SAS",
                            "Status": {"Health": "Warning"},
                        },
                    ],
                    "volumes": [
                        {
                            "Name": "Virtual Disk 0",
                            "Id": "VD0",
                            "RAIDType": "RAID1",
                            "CapacityBytes": 600127266816,
                            "Status": {"Health": "OK"},
                        }
                    ],
                }
            ],
        }
        norm = RedfishNormalizer()
        inv = norm.normalize(raw)

        # Controllers
        assert len(inv.hardware.storage.controllers) == 1
        ctrl = inv.hardware.storage.controllers[0]
        assert ctrl.name == "PERC H755 Front"
        assert ctrl.model == "PERC H755 Front"
        assert ctrl.health == HealthStatus.OK
        assert ctrl.raid_support is True

        # Physical disks
        assert len(inv.hardware.storage.physical_disks) == 2
        disk0 = inv.hardware.storage.physical_disks[0]
        assert disk0.name == "Physical Disk 0:1:0"
        assert disk0.model == "Dell Ent NVMe PM1730a 1.92TB"
        assert disk0.capacity_gb == round(1920380912640 / (1024**3), 2)
        assert disk0.media_type.value == "SSD"
        assert disk0.protocol == "NVMe"
        assert disk0.health == HealthStatus.OK

        disk1 = inv.hardware.storage.physical_disks[1]
        assert disk1.name == "Physical Disk 0:1:1"
        assert disk1.capacity_gb == round(600127266816 / (1024**3), 2)
        assert disk1.media_type.value == "HDD"
        assert disk1.protocol == "SAS"
        assert disk1.health == HealthStatus.WARNING

        # Virtual disks
        assert len(inv.hardware.storage.virtual_disks) == 1
        vd = inv.hardware.storage.virtual_disks[0]
        assert vd.name == "Virtual Disk 0"
        assert vd.raid_type == "RAID1"
        assert vd.capacity_gb == round(600127266816 / (1024**3), 2)
        assert vd.health == HealthStatus.OK

        # No hardware RAID flag
        assert inv.hardware.storage.no_hardware_raid is False

