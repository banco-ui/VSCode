class TestKubernetesAdapterCollectionStatus:
    """G4-21: Partial collection. G4-22: Permission error."""

    def test_success_when_all_resources_succeed(self, fixture_k02):
        adapter = KubernetesProviderAdapter(fixture=fixture_k02)
        snap = adapter.collect()
        assert snap.collection_status == OrchestrationStatus.SUCCESS

    def test_partial_when_some_fail(self, fixture_k11):
        adapter = KubernetesProviderAdapter(fixture=fixture_k11)
        snap = adapter.collect()
        assert snap.collection_status == OrchestrationStatus.PARTIAL

    def test_permission_denied_is_not_empty(self, fixture_k12):
        """403 Forbidden must NOT be treated as empty list."""
        adapter = KubernetesProviderAdapter(fixture=fixture_k12)
        snap = adapter.collect()
        ee_caps = [cr for cr in snap.capability_results
                   if cr.capability == AdapterCapability.EXECUTION_ENVIRONMENT]
        assert len(ee_caps) == 1
        assert ee_caps[0].status == OrchestrationStatus.FAILED
        assert ee_caps[0].error_category == ErrorCategory.AUTHENTICATION_ERROR
        assert len(ee_caps[0].errors) > 0

    def test_permission_error_in_snapshot_errors(self, fixture_k12):
        adapter = KubernetesProviderAdapter(fixture=fixture_k12)
        snap = adapter.collect()
        assert len(snap.errors) > 0
        assert any("forbidden" in e.lower() for e in snap.errors)

    def test_empty_list_is_success(self, fixture_k14):
        adapter = KubernetesProviderAdapter(fixture=fixture_k14)
        snap = adapter.collect()
        assert snap.collection_status == OrchestrationStatus.SUCCESS

    def test_partial_has_both_success_and_failure(self, fixture_k11):
        adapter = KubernetesProviderAdapter(fixture=fixture_k11)
        snap = adapter.collect()
        statuses = {cr.status for cr in snap.capability_results}
        assert OrchestrationStatus.SUCCESS in statuses
        assert OrchestrationStatus.FAILED in statuses


class TestKubernetesAdapterRelationshipEvidence:
    """G4-18: Relationship evidence (DIRECT/DERIVED only)."""

    def test_pod_to_node_direct_evidence(self, fixture_k03):
        adapter = KubernetesProviderAdapter(fixture=fixture_k03)
        snap = adapter.collect()
        runs_on = [e for e in snap.relationship_evidence
                   if e.relationship_type == "runs_on"]
        assert len(runs_on) == 1
        assert runs_on[0].evidence_type == RelationshipEvidenceType.DIRECT

    def test_pod_to_container_derived_evidence(self, fixture_k04):
        adapter = KubernetesProviderAdapter(fixture=fixture_k04)
        snap = adapter.collect()
        contains = [e for e in snap.relationship_evidence
                    if e.relationship_type == "contains"]
        assert len(contains) == 2
        for e in contains:
            assert e.evidence_type == RelationshipEvidenceType.DERIVED

    def test_no_inferred_evidence(self, fixture_k15):
        adapter = KubernetesProviderAdapter(fixture=fixture_k15)
        snap = adapter.collect()
        for e in snap.relationship_evidence:
            assert e.evidence_type in (
                RelationshipEvidenceType.DIRECT,
                RelationshipEvidenceType.DERIVED,
            )

    def test_pod_without_node_no_runs_on(self):
        fixture = {"cluster": {"name": "c", "version": "1.0"},
                   "pods": [make_pod("pending-pod", node_name=None)]}
        adapter = KubernetesProviderAdapter(fixture=fixture)
        snap = adapter.collect()
        runs_on = [e for e in snap.relationship_evidence
                   if e.relationship_type == "runs_on"]
        assert len(runs_on) == 0

    def test_combined_evidence_count(self, fixture_k15):
        adapter = KubernetesProviderAdapter(fixture=fixture_k15)
        snap = adapter.collect()
        runs_on = [e for e in snap.relationship_evidence
                   if e.relationship_type == "runs_on"]
        contains = [e for e in snap.relationship_evidence
                    if e.relationship_type == "contains"]
        assert len(runs_on) == 2
        assert len(contains) == 3


class TestKubernetesAdapterCollectSafe:
    """collect_safe() handles exceptions gracefully."""

    def test_collect_safe_on_success(self, fixture_k01):
        adapter = KubernetesProviderAdapter(fixture=fixture_k01)
        snap = adapter.collect_safe()
        assert snap.collection_status == OrchestrationStatus.SUCCESS

    def test_collect_safe_on_exception(self):
        class FailingAdapter(KubernetesProviderAdapter):
            def collect(self, **kwargs):
                raise ConnectionError("K8s API unavailable")
        adapter = FailingAdapter()
        snap = adapter.collect_safe()
        assert snap.collection_status == OrchestrationStatus.FAILED
        assert len(snap.errors) > 0


class TestNoLiveConnection:
    """G4-24: No unauthorized live connection."""

    def test_kubernetes_client_is_conditional_import(self):
        """Phase 13G-8: kubernetes client is conditionally imported.

        The adapter works without the kubernetes client for fixture mode.
        The import is wrapped in try/except so it's optional.
        """
        import server_manager.providers.kubernetes as k8s_mod
        source = open(k8s_mod.__file__, encoding="utf-8").read()
        # The import must be conditional (try/except ImportError)
        assert "try:" in source
        assert "except ImportError" in source
        assert "from kubernetes.client import ApiClient" in source
        # The module must define a fallback when kubernetes is not available
        assert "_K8S_CLIENT_AVAILABLE" in source
        # No unconditional kubernetes import
        lines = source.split("\n")
        for line in lines:
            stripped = line.strip()
            if stripped.startswith("from kubernetes") or stripped.startswith("import kubernetes"):
                # Must be inside a try block (indented)
                assert line.startswith(" ") or line.startswith("\t"), (
                    f"Unconditional kubernetes import: {stripped}"
                )

    def test_fixture_based_only(self, fixture_k01):
        adapter = KubernetesProviderAdapter(fixture=fixture_k01)
        snap = adapter.collect()
        assert isinstance(snap, RawProviderSnapshot)
