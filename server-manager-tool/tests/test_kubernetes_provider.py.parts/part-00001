def make_node(name: str, uid: str | None = None) -> dict:
    return {"apiVersion": "v1", "kind": "Node",
            "metadata": {"name": name, "uid": uid or f"uid-node-{name}"},
            "spec": {}, "status": {"nodeInfo": {"kubeletVersion": "v1.28.0"}}}


def make_container(name: str, image: str = "nginx:1.21") -> dict:
    return {"name": name, "image": image, "resources": {}}


def make_pod(name: str, uid: str | None = None, namespace: str = "default",
             node_name: str | None = None, containers: list[dict] | None = None) -> dict:
    spec: dict[str, Any] = {}
    if node_name:
        spec["nodeName"] = node_name
    spec["containers"] = containers or [make_container("main")]
    return {"apiVersion": "v1", "kind": "Pod",
            "metadata": {"name": name, "uid": uid or f"uid-pod-{name}", "namespace": namespace},
            "spec": spec, "status": {"phase": "Running"}}


def make_service(name: str, uid: str | None = None, svc_type: str = "ClusterIP") -> dict:
    return {"apiVersion": "v1", "kind": "Service",
            "metadata": {"name": name, "uid": uid or f"uid-svc-{name}", "namespace": "default"},
            "spec": {"type": svc_type, "clusterIP": "10.96.0.1"}}


def make_pv(name: str, uid: str | None = None) -> dict:
    return {"apiVersion": "v1", "kind": "PersistentVolume",
            "metadata": {"name": name, "uid": uid or f"uid-pv-{name}"},
            "spec": {"capacity": {"storage": "10Gi"}}}


def make_pvc(name: str, uid: str | None = None) -> dict:
    return {"apiVersion": "v1", "kind": "PersistentVolumeClaim",
            "metadata": {"name": name, "uid": uid or f"uid-pvc-{name}", "namespace": "default"},
            "spec": {"resources": {"requests": {"storage": "5Gi"}}}}


def make_deployment(name: str) -> dict:
    return {"apiVersion": "apps/v1", "kind": "Deployment",
            "metadata": {"name": name, "uid": f"uid-deploy-{name}"}}


def make_namespace(name: str) -> dict:
    return {"apiVersion": "v1", "kind": "Namespace",
            "metadata": {"name": name, "uid": f"uid-ns-{name}"}}


