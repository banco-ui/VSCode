class TestKubernetesAlert:
    """Kubernetes path: Fault → Alert → Operational Summary."""

    def test_k8s_fault_to_alert(self):
        svc = AlertService()
        fault = make_fault(
            fault_id="k8s:fault-01",
            entity_id="canon-k8s-node-01",
            provider=ProviderType.KUBERNETES,
        )
        result = svc.create_alert(fault)
        assert result.created
        assert result.alert.provider_type == ProviderType.KUBERNETES

    def test_k8s_alert_lifecycle(self):
        svc = AlertService()
        fault = make_fault(
            fault_id="k8s:fault-lc-01",
            provider=ProviderType.KUBERNETES,
        )
        r = svc.create_alert(fault)
        assert r.alert.status == AlertStatus.OPEN
        svc.acknowledge(r.alert.alert_id, acknowledged_by="sre")
        svc.resolve(r.alert.alert_id)
        svc.close(r.alert.alert_id)
        final = svc.get_alert(r.alert.alert_id)
        assert final.status == AlertStatus.CLOSED

    def test_k8s_operational_summary(self):
        alert_svc = AlertService()
        vis = OperationalVisibilityService(alert_service=alert_svc)
        fault = make_fault(
            fault_id="k8s:fault-vis-01",
            provider=ProviderType.KUBERNETES,
        )
        alert_svc.create_alert(fault)
        summary = vis.get_summary()
        assert summary.alerts.total_alerts == 1
        assert summary.alerts.open == 1

    def test_k8s_provenance_preserved(self):
        svc = AlertService()
        src = make_source(provider=ProviderType.KUBERNETES)
        fault = make_fault(fault_id="k8s:prov-01")
        fault.source = src
        result = svc.create_alert(fault)
        assert result.created
        assert result.alert.source is not None
        assert result.alert.source.provider_type == ProviderType.KUBERNETES

    def test_k8s_identity_stability(self):
        svc = AlertService()
        fault = make_fault(fault_id="k8s:stable-01")
        r = svc.create_alert(fault)
        original_id = r.alert.alert_id
        svc.acknowledge(original_id)
        svc.resolve(original_id)
        svc.close(original_id)
        alert = svc.get_alert(original_id)
        assert alert.alert_id == original_id

