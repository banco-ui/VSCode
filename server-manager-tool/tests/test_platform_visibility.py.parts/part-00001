class TestOperationalSummary:
    """Operational summary from existing models."""

    def test_empty_summary(self):
        vis = OperationalVisibilityService()
        summary = vis.get_summary()
        assert summary.infrastructure.total_entities == 0
        assert summary.health.total_assessed == 0
        assert summary.faults.total_faults == 0
        assert summary.alerts.total_alerts == 0

    def test_infrastructure_counts(self):
        from server_manager.discovery.models import CanonicalInventory
        inv = CanonicalInventory(
            provider_type=ProviderType.KUBERNETES,
            snapshot_id="snap-01",
            platforms=[],
            clusters=[],
            nodes=[],
        )
        vis = OperationalVisibilityService()
        vis.set_inventory(inv)
        summary = vis.get_summary()
        assert summary.infrastructure.total_entities == 0

    def test_health_counts(self):
        results = [
            make_health_result(
                entity_id="e1", status=HealthStatus.HEALTHY
            ),
            make_health_result(
                entity_id="e2", status=HealthStatus.DEGRADED
            ),
            make_health_result(
                entity_id="e3", status=HealthStatus.UNHEALTHY
            ),
            make_health_result(
                entity_id="e4", status=HealthStatus.UNKNOWN
            ),
        ]
        report = make_health_report(results=results)
        vis = OperationalVisibilityService()
        vis.set_health_report(report)
        summary = vis.get_summary()
        assert summary.health.total_assessed == 4
        assert summary.health.healthy == 1
        assert summary.health.degraded == 1
        assert summary.health.unhealthy == 1
        assert summary.health.unknown == 1

    def test_fault_counts(self):
        faults = [
            make_fault(fault_id="f1", entity_id="e1"),
            make_fault(fault_id="f2", entity_id="e2"),
        ]
        fr = make_fault_result(faults=faults)
        vis = OperationalVisibilityService()
        vis.set_fault_result(fr)
        summary = vis.get_summary()
        assert summary.faults.total_faults == 2
        assert summary.faults.detected == 2

    def test_alert_counts(self):
        alert_svc = AlertService()
        vis = OperationalVisibilityService(alert_service=alert_svc)
        for i in range(3):
            fault = make_fault(fault_id=f"f-count-{i}")
            alert_svc.create_alert(fault)
        alert_svc.acknowledge("alert:f-count-0")
        alert_svc.resolve("alert:f-count-1")
        alert_svc.close("alert:f-count-1")
        summary = vis.get_summary()
        assert summary.alerts.total_alerts == 3
        assert summary.alerts.open == 1
        assert summary.alerts.acknowledged == 1
        assert summary.alerts.resolved == 0
        assert summary.alerts.closed == 1

    def test_resource_summary(self):
        from server_manager.health.models import ResourceStatus, ResourceType
        rs = [ResourceStatus(resource_type=ResourceType.CPU, utilization="80%")]
        results = [
            make_health_result(entity_id="e1"),
        ]
        results[0].resource_statuses = rs
        report = make_health_report(results=results)
        vis = OperationalVisibilityService()
        vis.set_health_report(report)
        summary = vis.get_summary()
        assert summary.resources.entities_with_resources == 1
        assert summary.resources.total_resource_statuses == 1

    def test_operation_summary_empty(self):
        vis = OperationalVisibilityService()
        summary = vis.get_summary()
        assert summary.operations.total_recovery_candidates == 0
        assert summary.operations.total_operation_results == 0


