class TestFaultToAlert:
    """Fault → Alert conversion rules."""

    def test_detected_fault_creates_open_alert(self):
        """DETECTED → OPEN."""
        svc = AlertService()
        fault = make_fault(
            fault_id="fault-detect-01", status=FaultStatus.DETECTED
        )
        result = svc.create_alert(fault)
        assert result.created
        assert result.alert.status == AlertStatus.OPEN

    def test_ongoing_fault_retains_existing_alert(self):
        """ONGOING → existing alert retained (no duplicate)."""
        svc = AlertService()
        fault = make_fault(
            fault_id="fault-ongoing-01", status=FaultStatus.DETECTED
        )
        r1 = svc.create_alert(fault)
        assert r1.created

        # Same fault observed again as ONGOING
        fault.status = FaultStatus.ONGOING
        r2 = svc.create_alert(fault)
        assert not r2.created
        assert "Duplicate" in r2.reason

    def test_resolved_fault_resolves_alert(self):
        """RESOLVED → alert resolved."""
        svc = AlertService()
        fault = make_fault(fault_id="fault-res-01")
        svc.create_alert(fault)

        # Fault becomes resolved
        resolved = svc.on_fault_resolved("fault-res-01")
        assert resolved is not None
        assert resolved.status == AlertStatus.RESOLVED

    def test_duplicate_fault_no_duplicate_alert(self):
        """Same fault observed again does not create duplicate active alert."""
        svc = AlertService()
        fault = make_fault(fault_id="fault-dup-01")
        r1 = svc.create_alert(fault)
        r2 = svc.create_alert(fault)
        assert r1.created
        assert not r2.created
        assert svc.alert_count == 1

    def test_unknown_fault_no_alert(self):
        """UNKNOWN provider fault still creates alert if it has evidence.

        Per spec: 'UNKNOWN fault state must not become a valid alert.'
        A fault with UNKNOWN provider_type but valid evidence and severity
        is still a detected fault. The 'UNKNOWN fault state' refers to a
        fault whose status would be UNKNOWN — but FaultStatus has no UNKNOWN.
        The spec means: if we can't determine the fault (no evidence), no alert.

        Missing evidence → no alert (tested separately).
        Here we verify that a fault from UNKNOWN provider still gets an alert
        if it has proper evidence — provider neutrality.
        """
        svc = AlertService()
        fault = make_fault(
            fault_id="fault-unk-prov-01",
            provider=ProviderType.UNKNOWN,
            evidence={"condition": "unreachable", "source": "manual"},
        )
        result = svc.create_alert(fault)
        assert result.created
        assert result.alert.provider_type == ProviderType.UNKNOWN

    def test_missing_evidence_no_alert(self):
        """Missing evidence does not create an alert."""
        svc = AlertService()
        fault = make_fault(
            fault_id="fault-noev-01", evidence={}
        )
        result = svc.create_alert(fault)
        assert not result.created
        assert "evidence" in result.reason.lower()

    def test_fault_traceability(self):
        """Fault identity remains traceable from alert."""
        svc = AlertService()
        fault = make_fault(
            fault_id="fault-trace-01",
            entity_id="canon-trace-entity",
            fault_type=FaultType.AVAILABILITY_FAILURE,
            severity=Severity.CRITICAL,
        )
        result = svc.create_alert(fault)
        alert = result.alert
        assert alert.fault_id == fault.fault_id
        assert alert.entity_id == fault.entity_id
        assert alert.fault_type == fault.fault_type


