class TestAlertLifecycle:
    """Alert lifecycle transitions."""

    def _make_alert(self, svc=None):
        svc = svc or AlertService()
        fault = make_fault(fault_id="fault-lifecycle-01")
        result = svc.create_alert(fault)
        return svc, result.alert

    def test_open_to_acknowledged(self):
        svc, alert = self._make_alert()
        updated = svc.acknowledge(alert.alert_id, acknowledged_by="ops")
        assert updated.status == AlertStatus.ACKNOWLEDGED
        assert updated.acknowledged_by == "ops"

    def test_open_to_resolved(self):
        svc, alert = self._make_alert()
        updated = svc.resolve(alert.alert_id, note="fixed")
        assert updated.status == AlertStatus.RESOLVED
        assert updated.resolved_at is not None

    def test_acknowledged_to_resolved(self):
        svc, alert = self._make_alert()
        svc.acknowledge(alert.alert_id)
        updated = svc.resolve(alert.alert_id)
        assert updated.status == AlertStatus.RESOLVED

    def test_resolved_to_closed(self):
        svc, alert = self._make_alert()
        svc.resolve(alert.alert_id)
        updated = svc.close(alert.alert_id)
        assert updated.status == AlertStatus.CLOSED

    def test_closed_to_acknowledged_rejected(self):
        svc, alert = self._make_alert()
        svc.resolve(alert.alert_id)
        svc.close(alert.alert_id)
        with pytest.raises(AlertTransitionError):
            svc.acknowledge(alert.alert_id)

    def test_resolved_to_open_rejected(self):
        svc, alert = self._make_alert()
        svc.resolve(alert.alert_id)
        with pytest.raises(AlertTransitionError):
            svc.acknowledge(alert.alert_id)

    def test_closed_to_open_rejected(self):
        svc, alert = self._make_alert()
        svc.resolve(alert.alert_id)
        svc.close(alert.alert_id)
        with pytest.raises(AlertTransitionError):
            svc.resolve(alert.alert_id)

    def test_acknowledged_to_open_rejected(self):
        svc, alert = self._make_alert()
        svc.acknowledge(alert.alert_id)
        with pytest.raises(AlertTransitionError):
            svc.acknowledge(alert.alert_id)

    def test_closed_to_closed_rejected(self):
        svc, alert = self._make_alert()
        svc.resolve(alert.alert_id)
        svc.close(alert.alert_id)
        with pytest.raises(AlertTransitionError):
            svc.close(alert.alert_id)

    def test_acknowledge_nonexistent_raises(self):
        svc = AlertService()
        with pytest.raises(AlertNotFoundError):
            svc.acknowledge("alert:nonexistent")

    def test_close_nonexistent_raises(self):
        svc = AlertService()
        with pytest.raises(AlertNotFoundError):
            svc.close("alert:nonexistent")


