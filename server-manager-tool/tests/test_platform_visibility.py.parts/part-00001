class TestAlertModel:
    """Alert model construction and validation."""

    def test_valid_alert(self):
        alert = Alert(
            alert_id="alert:fault-001",
            fault_id="fault-001",
            entity_id="canon-node-01",
            fault_type=FaultType.HEALTH_FAILURE,
            severity=Severity.CRITICAL,
        )
        assert alert.alert_id == "alert:fault-001"
        assert alert.status == AlertStatus.OPEN
        assert alert.is_active

    def test_alert_empty_id_rejected(self):
        with pytest.raises(Exception):
            Alert(
                alert_id="",
                fault_id="fault-001",
                entity_id="canon-node-01",
                fault_type=FaultType.HEALTH_FAILURE,
                severity=Severity.CRITICAL,
            )

    def test_deterministic_alert_id(self):
        """Same fault_id → same alert_id (via AlertService)."""
        svc = AlertService()
        fault = make_fault(fault_id="fault-det-01")
        r1 = svc.create_alert(fault)
        r2 = svc.create_alert(fault)
        assert r1.alert is not None
        # Second call should be duplicate (not created)
        assert r2.created is False
        # Same alert_id both times
        assert r1.alert.alert_id == "alert:fault-det-01"

    def test_fault_id_preserved(self):
        svc = AlertService()
        fault = make_fault(fault_id="fault-preserve-01")
        result = svc.create_alert(fault)
        assert result.created
        assert result.alert.fault_id == "fault-preserve-01"

    def test_evidence_preserved(self):
        svc = AlertService()
        ev = {"condition": "Ready=False", "source": "k8s_node"}
        fault = make_fault(fault_id="fault-ev-01", evidence=ev)
        result = svc.create_alert(fault)
        assert result.created
        assert result.alert.evidence == ev

    def test_severity_preserved(self):
        svc = AlertService()
        fault = make_fault(
            fault_id="fault-sev-01", severity=Severity.WARNING
        )
        result = svc.create_alert(fault)
        assert result.created
        assert result.alert.severity == Severity.WARNING

    def test_no_extra_fields_allowed(self):
        """Alert model rejects extra fields (extra=forbid)."""
        with pytest.raises(Exception):
            Alert(
                alert_id="alert:fault-01",
                fault_id="fault-01",
                entity_id="canon-node-01",
                fault_type=FaultType.HEALTH_FAILURE,
                severity=Severity.CRITICAL,
                bogus_field="not allowed",
            )


