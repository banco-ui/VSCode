class TestReadOnlyVisibility:
    """Verify operational visibility does NOT mutate anything."""

    def test_get_summary_does_not_execute_recovery(self):
        vis = OperationalVisibilityService()
        source = inspect.getsource(OperationalVisibilityService.get_summary)
        assert "RecoveryExecutor" not in source
        assert ".execute(" not in source

    def test_get_summary_does_not_execute_operations(self):
        vis = OperationalVisibilityService()
        source = inspect.getsource(OperationalVisibilityService.get_summary)
        assert "OperationService" not in source

    def test_visibility_no_subprocess(self):
        """No subprocess/shell/kubectl in visibility module."""
        import server_manager.visibility.service as svc_mod
        source = _strip_docstrings(inspect.getsource(svc_mod))
        assert "subprocess" not in source
        assert "os.system" not in source
        assert "kubectl" not in source
        assert "shell=True" not in source

    def test_visibility_no_provider_mutation(self):
        import server_manager.visibility.service as svc_mod
        source = inspect.getsource(svc_mod)
        # Should not call any provider mutation methods
        assert ".delete_pod" not in source
        assert ".create_pod" not in source
        assert ".delete_deployment" not in source
        assert ".scale" not in source

    def test_visibility_does_not_modify_graph(self):
        """get_summary does not add/remove graph nodes or edges."""
        from server_manager.graph.models import GraphReport
        vis = OperationalVisibilityService()
        # Setting a graph query should not mutate it
        report = GraphReport(nodes=[], relationships=[])
        gq = GraphQuery(report)
        vis.set_graph_query(gq)
        # get_summary should work without errors
        summary = vis.get_summary()
        assert summary is not None
        # Graph should remain unchanged
        assert gq.node_count == 0

    def test_visibility_does_not_modify_inventory(self):
        from server_manager.discovery.models import CanonicalInventory
        inv = CanonicalInventory(
            provider_type=ProviderType.KUBERNETES,
            snapshot_id="snap-01",
        )
        vis = OperationalVisibilityService()
        vis.set_inventory(inv)
        vis.get_summary()
        assert inv.entity_count == 0  # unchanged

    def test_visibility_does_not_modify_health(self):
        report = make_health_report(results=[
            make_health_result(entity_id="e1"),
        ])
        orig