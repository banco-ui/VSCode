def make_source(provider=ProviderType.KUBERNETES):
    return SourceEvidence(provider_type=provider, confidence=Confidence.HIGH)


def make_fault(
    fault_id="fault-001",
    entity_id="canon-k8s-node-01",
    fault_type=FaultType.HEALTH_FAILURE,
    severity=Severity.CRITICAL,
    evidence=None,
    status=FaultStatus.DETECTED,
    provider=ProviderType.KUBERNETES,
):
    return Fault(
        fault_id=fault_id,
        entity_id=entity_id,
        fault_type=fault_type,
        severity=severity,
        status=status,
        evidence=evidence if evidence is not None else {
            "condition": "Ready=False",
            "source": "kubernetes_node_condition",
        },
        source=make_source(provider),
    )


def make_fault_result(faults=None, resolved_ids=None):
    return FaultResult(
        faults=faults or [],
        newly_detected=faults or [],
        ongoing=[],
        resolved_fault_ids=resolved_ids or [],
    )


def make_health_report(results=None):
    return HealthReport(
        provider_type=ProviderType.KUBERNETES,
        health_status=OrchestrationStatus.PARTIAL,
        results=results or [],
    )


def make_health_result(
    entity_id="canon-k8s-node-01",
    entity_type="NODE",
    status=HealthStatus.UNHEALTHY,
    availability=AvailabilityStatus.UNAVAILABLE,
):
    return HealthResult(
        entity_id=entity_id,
        entity_type=entity_type,
        status=status,
        availability=availability,
    )


def _strip_docstrings(source: str) -> str:
    """Remove triple-quoted docstrings from source text for code-only inspection."""
    return re.sub(r'"""[\s\S]*?"""', '', source)


