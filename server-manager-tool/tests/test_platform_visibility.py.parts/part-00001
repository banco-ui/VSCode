class TestAlertDeduplication:
    """Active alert deduplication."""

    def test_same_fault_no_duplicate_active(self):
        svc = AlertService()
        fault = make_fault(fault_id="fault-dedup-01")
        r1 = svc.create_alert(fault)
        r2 = svc.create_alert(fault)
        r3 = svc.create_alert(fault)
        assert r1.created
        assert not r2.created
        assert not r3.created
        assert svc.alert_count == 1

    def test_resolved_allows_reuse_for_same_fault(self):
        """After resolution, re-observing the fault reuses same alert_id."""
        svc = AlertService()
        fault = make_fault(fault_id="fault-redet-01")
        r1 = svc.create_alert(fault)
        assert r1.created
        original_id = r1.alert.alert_id
        svc.resolve(original_id)
        r2 = svc.create_alert(fault)
        assert r2.created
        assert r2.alert.alert_id == original_id
        assert r2.alert.status == AlertStatus.OPEN

    def test_different_faults_create_different_alerts(self):
        svc = AlertService()
        f1 = make_fault(fault_id="fault-a-01")
        f2 = make_fault(fault_id="fault-b-02")
        r1 = svc.create_alert(f1)
        r2 = svc.create_alert(f2)
        assert r1.created
        assert r2.created
        assert r1.alert.alert_id != r2.alert.alert_id
        assert svc.alert_count == 2


