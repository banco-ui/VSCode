class TestRecoveryLifecycle:
    """Recovery candidate lifecycle transitions."""

    def test_proposed_to_executed(self):
        svc = RecoveryService(
            executor=MockRecoveryExecutor(),
            execution_enabled=True,
            supported_actions={RecoveryActionType.RESTART_EXECUTION_ENVIRONMENT},
            authorization=AuthorizationLevel.EXECUTE,
        )
        fault = make_fault()
        cand = svc.propose_candidate(fault)
        assert cand.status == RecoveryCandidateStatus.PROPOSED
        result = svc.execute(cand)
        assert result.status == RecoveryExecutionStatus.EXECUTED
        assert cand.status == RecoveryCandidateStatus.EXECUTED

    def test_executed_to_verified(self):
        svc = RecoveryService(
            executor=MockRecoveryExecutor(),
            execution_enabled=True,
            supported_actions={RecoveryActionType.RESTART_EXECUTION_ENVIRONMENT},
            authorization=AuthorizationLevel.EXECUTE,
        )
        fault = make_fault()
        cand = svc.propose_candidate(fault)
        svc.execute(cand)
        healthy = make_health_result(
            entity_id=fault.entity_id, status=HealthStatus.HEALTHY,
        )
        result = svc.verify(cand, post_health=healthy)
        assert result.status == RecoveryExecutionStatus.VERIFIED
        assert cand.status == RecoveryCandidateStatus.VERIFIED

    def test_executed_to_verification_failed(self):
        svc = RecoveryService(
            executor=MockRecoveryExecutor(),
            execution_enabled=True,
            supported_actions={RecoveryActionType.RESTART_EXECUTION_ENVIRONMENT},
            authorization=AuthorizationLevel.EXECUTE,
        )
        fault = make_fault()
        cand = svc.propose_candidate(fault)
        svc.execute(cand)
        unhealthy = make_health_result(
            entity_id=fault.entity_id, status=HealthStatus.UNHEALTHY,
        )
        result = svc.verify(cand, post_health=unhealthy)
        assert result.status == RecoveryExecutionStatus.VERIFICATION_FAILED
        assert cand.status == RecoveryCandidateStatus.FAILED

    def test_proposed_to_blocked(self):
        svc = RecoveryService(
            executor=MockRecoveryExecutor(),
            execution_enabled=False,
        )
        fault = make_fault()
        cand = svc.propose_candidate(fault)
        result = svc.execute(cand)
        assert result.status == RecoveryExecutionStatus.BLOCKED
        assert cand.status == RecoveryCandidateStatus.BLOCKED

    def test_no_auto_resolution(self):
        """Recovery execution does NOT auto-resolve fault."""
        svc = RecoveryService(
            executor=MockRecoveryExecutor(),
            execution_enabled=True,
            supported_actions={Recovery