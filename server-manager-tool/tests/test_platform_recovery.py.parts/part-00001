class TestEvidencePolicy:
    """Evidence-first policy: no evidence → no recovery."""

    def test_unknown_fault_no_candidate(self):
        """RESOURCE_THRESHOLD fault (not in actionable set) → no candidate."""
        svc = RecoveryService(executor=MockRecoveryExecutor())
        fault = make_fault(fault_type=FaultType.RESOURCE_THRESHOLD)
        cand = svc.propose_candidate(fault)
        assert cand is None

    def test_state_change_no_candidate(self):
        """STATE_CHANGE fault → no candidate (no auto recovery)."""
        svc = RecoveryService(executor=MockRecoveryExecutor())
        fault = make_fault(fault_type=FaultType.STATE_CHANGE)
        cand = svc.propose_candidate(fault)
        assert cand is None

    def test_missing_evidence_no_candidate(self):
        svc = RecoveryService(executor=MockRecoveryExecutor())
        fault = make_fault(evidence={})
        cand = svc.propose_candidate(fault)
        assert cand is None

    def test_safety_gate_missing_evidence_blocked(self):
        gate = RecoverySafetyGate(execution_enabled=True)
        fault = make_fault(evidence={})
        action = make_action()
        supported = {RecoveryActionType.RESTART_WORKLOAD}
        result = gate.evaluate(
            action=action, fault=fault,
            supported_actions=supported,
            authorization=AuthorizationLevel.EXECUTE,
        )
        assert result.result == SafetyResult.BLOCKED
        assert result.reason == SafetyBlockReason.MISSING_FAULT_EVIDENCE

    def test_safety_gate_fault_not_actionable(self):
        """Non-actionable fault type → BLOCKED."""
        gate = RecoverySafetyGate(execution_enabled=True)
        fault = make_fault(fault_type=FaultType.STATE_CHANGE)
        action = make_action()
        supported = {RecoveryActionType.RESTART_WORKLOAD}
        result = gate.evaluate(
            action=action, fault=fault,
            supported_actions=supported,
            authorization=AuthorizationLevel.EXECUTE,
        )
        assert result.result == SafetyResult.BLOCKED
        assert result.reason == SafetyBlockReason.FAULT_NOT_ACTIONABLE




class TestNoInferencePolicy:
    """No-inference policy tests.

    Graph relationships do NOT imply recovery causality.
    Pod unavailable → NO Node fault/recovery inference.
    """

    def test_graph_relationship_no_causality(self):
        """Graph neighbors do NOT expand recovery targets."""
        from server_manager.discovery.models import CanonicalInventory
        from server_manager.models.canonical import (
            Cluster, Node, ExecutionEnvironment, Workload,
        )

        source = make_source()
        cluster = Cluster(
            canonical_id="canon-cluster-01",
            provider_type=ProviderType.KUBERNETES,
            source_evidence=source,
        )
        node = Node(
            canonical_id="canon-k8s-node-01",
            provider_type=ProviderType.KUBERNETES,
            source_evidence=source,
            cluster_ref="canon-cluster-01",
        )
        ee = ExecutionEnvironment(
            canonical_id="canon-k8s-ee-01",
            provider_type=ProviderType.KUBERNETES,
            source_evidence=source,
            node_ref="canon-k8s-node-01",
        )
        wl = Workload(
            canonical_id="canon-k8s-wl-01",
            provider_type=ProviderType.KUBERNETES,
            source_evidence=source,
            execution_environment_refs=["canon-k8s-ee-01"],
        )

        inventory = CanonicalInventory(
            provider_type=ProviderType.KUBERNETES,
            snapshot_id="snap-01",
            nodes=[node],
            execution_environments=[ee],
            workloads=[wl],
            clusters=[cluster],
        )
        report = GraphBuilder().build_from_inventory(inventory)
        query = GraphQuery(report)

        ctx = RecoveryGraphContext(query)
        neighbors = ctx.get_related_entities("canon-k8s-wl-01")
        assert "canon-k8s-ee-01" in neighbors

    def test_pod_not_workload(self):
        """Pod != Workload: ExecutionEnvironment is NOT a Workload."""
        action = make_action(
            action_type=RecoveryActionType.RESTART_WORKLOAD,
            target="canon-k8s-wl-01",
        )
        assert "wl" in action.target_entity_id
        assert "ee" not in action.target_entity_id

    def test_no_node_fault_from_pod(self):
        """Pod unavailable → NO Node fault inference, NO Node recovery."""
        fault = make_fault(
            fault_id="fault-pod-01",
            entity_id="canon-k8s-ee-01",
            fault_type=FaultType.AVAILABILITY_FAILURE,
        )
        svc = RecoveryService(
            executor=MockRecoveryExecutor(),
            execution_enabled=True,
            supported_actions={RecoveryActionType.RESTART_EXECUTION_ENVIRONMENT},
            authorization=AuthorizationLevel.EXECUTE,
        )
        cand = svc.propose_candidate(fault)
        assert cand is not None
        assert cand.action.target_entity_id == "canon-k8s-ee-01"
        assert "node" not in cand.action.target_entity_id.lower()

    def test_no_graph_inference_for_recovery_target(self):
        """Recovery target stays on fault entity — graph doesn't expand it."""
        fault = make_fault(
            entity_id="canon-k8s-wl-01",
            fault_type=FaultType.HEALTH_FAILURE,
        )
        svc = RecoveryService(
            executor=MockRecoveryExecutor(),
            execution_enabled=True,
            supported_actions={RecoveryActionType.RESTART_WORKLOAD},
            authorization=AuthorizationLevel.EXECUTE,
        )
        cand = svc.propose_candidate(fault)
        assert cand is not None
        assert cand.action.target_entity_id == "canon-k8s-wl-01"


