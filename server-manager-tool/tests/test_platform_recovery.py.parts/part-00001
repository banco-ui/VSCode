class TestIdempotency:
    """Idempotency / duplicate recovery prevention."""

    def test_same_fault_action_no_duplicate(self):
        svc = RecoveryService(
            executor=MockRecoveryExecutor(),
            execution_enabled=True,
            supported_actions={RecoveryActionType.RESTART_EXECUTION_ENVIRONMENT},
            authorization=AuthorizationLevel.EXECUTE,
        )
        fault = make_fault()
        c1 = svc.propose_candidate(fault)
        c2 = svc.propose_candidate(fault)
        assert c1 is c2  # same candidate returned

    def test_ongoing_action_tracked(self):
        """Executing same candidate twice: candidate status tracked."""
        svc = RecoveryService(
            executor=MockRecoveryExecutor(),
            execution_enabled=True,
            supported_actions={RecoveryActionType.RESTART_EXECUTION_ENVIRONMENT},
            authorization=AuthorizationLevel.EXECUTE,
        )
        fault = make_fault()
        cand = svc.propose_candidate(fault)
        result1 = svc.execute(cand)
        assert result1.status == RecoveryExecutionStatus.EXECUTED
        assert cand.status == RecoveryCandidateStatus.EXECUTED

    def test_failed_action_no_auto_retry(self):
        """Failed action does not auto-retry."""
        executor = MockRecoveryExecutor(simulate_failure=True)
        svc = RecoveryService(
            executor=executor,
            execution_enabled=True,
            supported_actions={RecoveryActionType.RESTART_EXECUTION_ENVIRONMENT},
            authorization=AuthorizationLevel.EXECUTE,
        )
        fault = make_fault()
        cand = svc.propose_candidate(fault)
        result = svc.execute(cand)
        assert result.status == RecoveryExecutionStatus.FAILED
        assert cand.status == RecoveryCandidateStatus.FAILED

    def test_different_fault_different_candidate(self):
        svc = RecoveryService(
            executor=MockRecoveryExecutor(),
            execution_enabled=True,
        )
        f1 = make_fault(fault_id="fault-001", entity_id="canon-node-01")
        f2 = make_fault(fault_id="fault-002", entity_id="canon-node-02")
        c1 = svc.propose_candidate(f1)
        c2 = svc.propose_candidate(f2)
        assert c1 is not c2
        assert c1.action.identity_key != c2.action.identity_key


