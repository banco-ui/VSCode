class TestPreview:
    """Preview / dry-run tests — no mutation."""

    def test_preview_creation(self):
        executor = MockRecoveryExecutor()
        action = make_action()
        preview = executor.preview(action)
        assert preview.action.action_id == "recovery-001"
        assert preview.expected_effect != ""
        assert preview.supported is True

    def test_preview_no_mutation(self):
        """Preview does not change executor state."""
        executor = MockRecoveryExecutor()
        action = make_action()
        executor.preview(action)
        assert len(executor._executed_actions) == 0

    def test_preview_deterministic(self):
        """Same action → same preview (deterministic)."""
        executor = MockRecoveryExecutor()
        action = make_action()
        p1 = executor.preview(action)
        p2 = executor.preview(action)
        assert p1.expected_effect == p2.expected_effect
        assert p1.safety_result == p2.safety_result

    def test_preview_safety_blocked(self):
        """Preview reflects safety gate result when blocked."""
        svc = RecoveryService(
            executor=MockRecoveryExecutor(),
            execution_enabled=False,
        )
        fault = make_fault()
        cand = svc.propose_candidate(fault)
        assert cand is not None
        preview = svc.preview(cand)
        assert preview.safety_result == SafetyResult.BLOCKED

    def test_preview_safety_pass(self):
        svc = RecoveryService(
            executor=MockRecoveryExecutor(),
            execution_enabled=True,
            supported_actions={RecoveryActionType.RESTART_EXECUTION_ENVIRONMENT},
            authorization=AuthorizationLevel.EXECUTE,
        )
        fault = make_fault()
        cand = svc.propose_candidate(fault)
        assert cand is not None
        preview = svc.preview(cand)
        assert preview.safety_result == SafetyResult.PASS



