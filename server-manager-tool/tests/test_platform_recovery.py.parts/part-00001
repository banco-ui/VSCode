class TestMockExecution:
    """Mock executor tests — simulated execution."""

    def test_supported_action_executes(self):
        svc = RecoveryService(
            executor=MockRecoveryExecutor(),
            execution_enabled=True,
            supported_actions={RecoveryActionType.RESTART_EXECUTION_ENVIRONMENT},
            authorization=AuthorizationLevel.EXECUTE,
        )
        fault = make_fault()
        cand = svc.propose_candidate(fault)
        assert cand is not None
        result = svc.execute(cand)
        assert result.status == RecoveryExecutionStatus.EXECUTED
        assert result.was_executed

    def test_unsupported_action_blocked(self):
        svc = RecoveryService(
            executor=MockRecoveryExecutor(),
            execution_enabled=True,
            supported_actions={RecoveryActionType.RESTART},
            authorization=AuthorizationLevel.EXECUTE,
        )
        fault = make_fault()
        cand = svc.propose_candidate(fault)
        assert cand is not None
        result = svc.execute(cand)
        assert result.status == RecoveryExecutionStatus.BLOCKED

    def test_execution_success(self):
        executor = MockRecoveryExecutor(simulate_failure=False)
        action = make_action()
        result = executor.execute(action)
        assert result.status == RecoveryExecutionStatus.EXECUTED

    def test_execution_failure(self):
        executor = MockRecoveryExecutor(simulate_failure=True)
        action = make_action()
        result = executor.execute(action)
        assert result.status == RecoveryExecutionStatus.FAILED
        assert result.error is not None

    def test_execution_timeout(self):
        executor = MockRecoveryExecutor(simulate_timeout=True)
        action = make_action()
        result = executor.execute(action)
        assert result.status == RecoveryExecutionStatus.FAILED
        assert "timeout" in result.error.lower()

    def test_verification_success(self):
        executor = MockRecoveryExecutor()
        action = make_action()
        healthy = make_health_result(status=HealthStatus.HEALTHY)
        result = executor.verify(action, post_health=healthy)
        assert result.status == RecoveryExecutionStatus.VERIFIED

    def test_verification_failure_no_health(self):
        executor = MockRecoveryExecutor()
        action = make_action()
        result = executor.verify(action, post_health=None)
        assert result.status == RecoveryExecutionStatus.VERIFICATION_FAILED

    def test_verification_failure_unhealthy(self):
        executor = MockRecoveryExecutor()
        action = make_action()
        unhealthy = make_health_result(
            entity_id="canon-k8s-wl-01",
            status=HealthStatus.UNHEALTHY,
        )
        result = executor.verify(action, post_health=unhealthy)
        assert result.status == RecoveryExecutionStatus.VERIFICATION_FAILED


