"""Recovery / Remediation Tests — Phase 18.

Tests the recovery pipeline:

    Fault (Phase 17)
        ↓
    RecoveryCandidate (proposed)
        ↓
    Safety Gate (PASS / BLOCKED)
        ↓
    Authorization (EXECUTE required for mutation)
        ↓
    Preview (dry-run, no mutation)
        ↓
    Execution (if execution_enabled=True)
        ↓
    Post-Action Verification
        ↓
    RecoveryExecutionResult

All fixtures are synthetic/in-memory. No live Kubernetes connection.
No real provider mutation. Mock executor only.
"""
from __future__ import annotations

import inspect
import pytest

from server_manager.fault.models import Fault, FaultStatus, FaultType, Severity
from server_manager.graph import GraphBuilder, GraphQuery
from server_manager.health.models import (
    AvailabilityStatus, HealthResult, HealthStatus,
)
from server_manager.models.canonical import ProviderType, SourceEvidence
from server_manager.models.enums import Confidence
from server_manager.recovery import (
    AuthorizationLevel,
    MockRecoveryExecutor,
    RecoveryAction,
    RecoveryActionParameters,
    RecoveryActionType,
    RecoveryCandidate,
    RecoveryCandidateStatus,
    RecoveryExecutionResult,
    RecoveryExecutionStatus,
    RecoveryGraphContext,
    RecoveryPreview,
    RecoverySafetyGate,
    RecoveryService,
    SafetyBlockReason,
    SafetyResult,
)


def make_source(provider=ProviderType.KUBERNETES):
    return SourceEvidence(provider_type=provider, confidence=Confidence.HIGH)


def make_fault(
    fault_id="fault-001",
    entity_id="canon-k8s-node-01",
    fault_type=FaultType.HEALTH_FAILURE,
    severity=Severity.CRITICAL,
    evidence=None,
):
    return Fault(
        fault_id=fault_id,
        entity_id=entity_id,
        fault_type=fault_type,
        severity=severity,
        status=FaultStatus.DETECTED,
        evidence=evidence if evidence is not None else {
            "condition": "Ready=False",
            "source": "kubernetes_node_condition",
        },
        source=make_source(),
    )


def make_action(
    action_id="recovery-001",
    action_type=RecoveryActionType.RESTART_WORKLOAD,
    target="canon-k8s-wl-01",
    provider=ProviderType.KUBERNETES,
    fault_id="fault-001",
):
    return RecoveryAction(
        action_id=action_id,
        action_type=action_type,
        target_entity_id=target,
        provider_type=provider,
        fault_id=fault_id,
        reason="Test recovery action",
    )


def make_health_result(
    entity_id="canon-k8s-node-01",
    status=HealthStatus.HEALTHY,
):
    return HealthResult(
        entity_id=entity_id,
        entity_type="NODE",
        status=status,
        availability=AvailabilityStatus.AVAILABLE,
        source_evidence=make_source(),
    )

