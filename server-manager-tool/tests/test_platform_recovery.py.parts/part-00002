        forbidden = [
            "CoreV1Api", "AppsV1Api", "kubernetes.client",
            "requests.post", "requests.put", "requests.delete",
            "requests.patch",
        ]
        for pattern in forbidden:
            assert pattern not in source, (
                f"Provider API call '{pattern}' found in recovery service"
            )

    def test_no_kubernetes_import(self):
        """Recovery service should not import Kubernetes client."""
        import server_manager.recovery.service as s
        source = inspect.getsource(s)


