class TestMutationSafety:
    """Inspect-based mutation safety: no mutation operations in code."""

    FORBIDDEN_PATTERNS = [
        "create_pod", "delete_pod", "update_pod", "patch_pod",
        "scale_deployment", "restart_node", "rollout_restart",
        "kubectl", "apply_manifest", "replace_resource", "exec_command",
    ]

    def test_no_mutation_patterns_in_recovery_models(self):
        import server_manager.recovery.models as m
        source = inspect.getsource(m)
        for pattern in self.FORBIDDEN_PATTERNS:
            assert pattern not in source, (
                f"Forbidden pattern '{pattern}' found in recovery models"
            )

    def test_no_mutation_patterns_in_recovery_service(self):
        import server_manager.recovery.service as s
        source = inspect.getsource(s)
        for pattern in self.FORBIDDEN_PATTERNS:
            assert pattern not in source, (
                f"Forbidden pattern '{pattern}' found in recovery service"
            )

    def test_no_auto_recovery_methods(self):
        """No auto_restart, auto_redeploy, auto_scale, etc."""
        import server_manager.recovery.service as s
        source = inspect.getsource(s)
        for pattern in ["auto_restart", "auto_redeploy", "auto_scale",
                        "auto_delete", "auto_recovery", "auto_remediate"]:
            assert pattern not in source, (
                f"Forbidden auto method '{pattern}' in service"
            )

