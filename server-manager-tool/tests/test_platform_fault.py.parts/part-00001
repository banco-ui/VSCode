class TestFaultLifecycle:
    """Fault lifecycle: DETECTED -> ONGOING -> RESOLVED."""

    def test_fault_detected_on_first_occurrence(self):
        obs = make_obs(health=HealthStatus.UNHEALTHY)
        service = FaultDetectionService()
        result = service.detect([obs])
        assert len(result.newly_detected) == 1
        assert result.newly_detected[0].status == FaultStatus.DETECTED

    def test_fault_ongoing_on_second_occurrence(self):
        obs = make_obs(health=HealthStatus.UNHEALTHY)
        service = FaultDetectionService()
        service.detect([obs])
        result = service.detect([obs])
        assert len(result.newly_detected) == 0
        assert len(result.ongoing) >= 1
        ongoing_faults = [f for f in result.ongoing if f.fault_type == FaultType.HEALTH_FAILURE]
        assert len(ongoing_faults) == 1
        assert ongoing_faults[0].status == FaultStatus.ONGOING

    def test_fault_resolved_when_state_recovers(self):
        service = FaultDetectionService()
        # First: unhealthy
        service.detect([make_obs(health=HealthStatus.UNHEALTHY)])
        # Second: still unhealthy (ongoing)
        service.detect([make_obs(health=HealthStatus.UNHEALTHY)])
        # Third: healthy (resolved)
        result = service.detect([make_obs(health=HealthStatus.HEALTHY)])
        assert len(result.resolved_fault_ids) >= 1
        assert any("HEALTH_FAILURE" in fid for fid in result.resolved_fault_ids)

    def test_fault_not_recreated_after_resolution(self):
        """Resolved fault should not be recreated if issue returns in a new cycle."""
        service = FaultDetectionService()
        # Unhealthy -> detected
        service.detect([make_obs(health=HealthStatus.UNHEALTHY)])
        # Healthy -> resolved
        service.detect([make_obs(health=HealthStatus.HEALTHY)])
        # Unhealthy again -> newly detected (new cycle)
        result = service.detect([make_obs(health=HealthStatus.UNHEALTHY)])
        assert len(result.newly_detected) >= 1


