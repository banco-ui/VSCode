"""Fault Detection Tests — Phase 17.

Tests the fault detection pipeline:

    Monitoring Observations + State Changes
        -> FaultDetectionService.detect()
        -> FaultResult (Faults with lifecycle)

    Graph Context:
        Fault + GraphQuery
        -> FaultGraphContext (read-only lookup)

All fixtures are synthetic/in-memory. No live Kubernetes connection.
"""
from __future__ import annotations

import pytest

from server_manager.discovery import PlatformDiscovery
from server_manager.fault import (
    Fault, FaultDetectionService, FaultGraphContext, FaultStatus,
    FaultType, Severity, ThresholdPolicy,
)
from server_manager.graph import GraphBuilder, GraphQuery
from server_manager.health import (
    AvailabilityStatus, HealthReport, HealthResult, HealthService,
    HealthStatus, ResourceType, ResourceStatus,
)
from server_manager.models.canonical import ProviderType, SourceEvidence
from server_manager.models.enums import Confidence
from server_manager.monitoring import MonitoringService, Observation, StateChange
from server_manager.normalizers.kubernetes_normalizer import KubernetesProviderNormalizer
from server_manager.orchestrator.models import OrchestrationStatus
from server_manager.providers import KubernetesProviderAdapter, RawProviderSnapshot


def make_source(provider=ProviderType.KUBERNETES):
    return SourceEvidence(provider_type=provider, confidence=Confidence.HIGH)


def make_obs(
    entity_id="canon-node-01",
    entity_type="NODE",
    health=HealthStatus.HEALTHY,
    availability=AvailabilityStatus.AVAILABLE,
    resource_statuses=None,
):
    return Observation(
        observation_id=f"obs-{entity_id}",
        entity_id=entity_id,
        entity_type=entity_type,
        source=make_source(),
        health_status=health,
        availability_status=availability,
        resource_statuses=resource_statuses or [],
    )


def make_change(
    entity_id="canon-node-01",
    prev_health=HealthStatus.HEALTHY,
    curr_health=HealthStatus.UNHEALTHY,
    prev_avail=AvailabilityStatus.AVAILABLE,
    curr_avail=AvailabilityStatus.AVAILABLE,
):
    return StateChange(
        entity_id=entity_id,
        previous_health=prev_health,
        current_health=curr_health,
        previous_availability=prev_avail,
        current_availability=curr_avail,
    )



class TestFaultDetection:
    """Fault detection from observations."""

    def test_unhealthy_detection(self):
        obs = make_obs(health=HealthStatus.UNHEALTHY)
        service = FaultDetectionService()
        result = service.detect([obs])
        assert result.has_faults
        faults = [f for f in result.faults if f.fault_type == FaultType.HEALTH_FAILURE]
        assert len(faults) == 1
        assert faults[0].severity == Severity.CRITICAL

