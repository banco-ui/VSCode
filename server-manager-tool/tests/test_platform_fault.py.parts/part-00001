class TestKubernetesMonitoring:
    """K8s fixture-based monitoring and fault detection integration."""

    def _make_k8s_fixture(self, node_ready="True", pod_phase="Running",
                          pod_ready="True", pv_phase="Bound"):
        return {
            "cluster": {"name": "c1", "uid": "uid-c1", "version": "1.28.0"},
            "nodes": [
                {"apiVersion": "v1", "kind": "Node",
                 "metadata": {"name": "n1", "uid": "uid-n1",
                              "labels": {"kubernetes.io/hostname": "n1"}},
                 "spec": {},
                 "status": {"nodeInfo": {"kubeletVersion": "v1.28.0"},
                    "conditions": [
                        {"type": "Ready", "status": node_ready},
                        {"type": "MemoryPressure", "status": "False"},
                        {"type": "DiskPressure", "status": "False"},
                        {"type": "PIDPressure", "status": "False"},
                        {"type": "NetworkUnavailable", "status": "False"}],
                    "capacity": {"cpu": "4", "memory": "16Gi", "pods": "110"},
                    "allocatable": {"cpu": "3500m", "memory": "15Gi", "pods": "110"}}},
            ],
            "pods": [
                {"apiVersion": "v1", "kind": "Pod",
                 "metadata": {"name": "p1", "uid": "uid-p1", "namespace": "default"},
                 "spec": {"nodeName": "n1",
                          "containers": [{"name": "c", "image": "nginx:1.21", "resources": {}}]},
                 "status": {"phase": pod_phase,
                    "conditions": [{"type": "Ready", "status": pod_ready},
                                   {"type": "Initialized", "status": "True"},
                                   {"type": "PodScheduled", "status": "True"}]}},
            ],
            "namespaces": [], "deployments": [],
            "statefulsets": [], "daemonsets": [],
            "services": [],
            "persistent_volumes": [
                {"apiVersion": "v1", "kind": "PersistentVolume",
                 "metadata": {"name": "pv1", "uid": "uid-pv1"},
                 "spec": {"capacity": {"storage": "10Gi"}},
                 "status": {"phase": pv_phase}},
            ],
            "persistent_volume_claims": [],
        }

    def _full_pipeline(self, fixture):
        adapter = KubernetesProviderAdapter(fixture=fixture)
        normalizer = KubernetesProviderNormalizer()
        discovery = PlatformDiscovery().discover(adapter, normalizer)
        health_report = HealthService().assess(discovery)
        mon_service = MonitoringService()
        mon_report = mon_service.monitor(health_report)
        fault_service = FaultDetectionService()
        fault_result = fault_service.detect(
            mon_report.observations, mon_report.state_changes
        )
        graph_report = GraphBuilder().build(discovery)
        graph_query = GraphQuery(graph_report)
        return discovery, health_report, mon_report, fault_result, graph_query

    def test_k8s_node_health_monitoring(self):
        fixture = self._make_k8s_fixture(node_ready="True")
        _, _, mon_report, fault_result, _ = self._full_pipeline(fixture)
        node_obs = [o for o in mon_report.observations if o.entity_type == "NODE"]
        assert len(node_obs) == 1
        assert node_obs[0].health_status == HealthStatus.HEALTHY
        assert not fault_result.has_faults

    def test_k8s_node_not_ready_fault_detection(self):
        fixture = self._make_k8s_fixture(node_ready="False")
        _, _, mon_report, fault_result, _ = self._full_pipeline(fixture)
        node_obs = [o for o in mon_report.observations if o.entity_type == "NODE"]
        assert node_obs[0].health_status == HealthStatus.UNHEALTHY
        health_faults = [f for f in fault_result.faults if f.fault_type == FaultType.HEALTH_FAILURE]
        assert len(health_faults) >= 1
        assert health_faults[0].severity == Severity.CRITICAL

    def test_k8s_pod_failed_fault_detection(self):
        fixture = self._make_k8s_fixture(pod_phase="Failed", pod_ready="False")
        _, _, mon_report, fault_result, _ = self._full_pipeline(fixture)
        ee_obs = [o for o in mon_report.observations if o.entity_type == "EXECUTION_ENVIRONMENT"]
        unhealthy_ees = [o for o in ee_obs if o.health_status == HealthStatus.UNHEALTHY]
        assert len(unhealthy_ees) >= 1
        assert fault_result.has_faults

    def test_k8s_pv_failed_fault_detection(self):
        fixture = self._make_k8s_fixture(pv_phase="Failed")
        _, _, mon_report, fault_result, _ = self._full_pipeline(fixture)
        storage_obs = [o for o in mon_report.observations if o.entity_type == "STORAGE"]
        unhealthy_storage = [o for o in storage_obs if o.health_status == HealthStatus.UNHEALTHY]
        assert len(unhealthy_storage) >= 1
        assert fault_result.has_faults

    def test_k8s_resource_observation(self):
        fixture = self._make_k8s_fixture()
        _, _, mon_report, _, _ = self._full_pipeline(fixture)
        node_obs = [o for o in mon_report.observations if o.entity_type == "NODE"]
        assert len(node_obs) == 1
        assert len(node_obs[0].capacity_infos) > 0

    def test_k8s_graph_context_lookup(self):
        fixture = self._make_k8s_fixture(node_ready="False")
        _, _, mon_report, fault_result, graph_query = self._full_pipeline(fixture)
        node_ids = set(graph_query.node_ids)
        node_fault = None
        for f in fault_result.faults:
            if f.entity_id in node_ids:
                node_fault = f
                break
        assert node_fault is not None
        ctx = FaultGraphContext(graph_query)
        assert ctx.has_graph_context(node_fault)
        node = ctx.get_entity_node(node_fault)
        assert node is not None
        related = ctx.get_related_entities(node_fault)
        assert len(related) >= 1

    def test_k8s_pod_unavailable_no_node_inference(self):
        fixture = self._make_k8s_fixture(
            pod_phase="Failed", pod_ready="False", node_ready="True"
        )
        _, _, mon_report, fault_result, _ = self._full_pipeline(fixture)
        node_obs = [o for o in mon_report.observations if o.entity_type == "NODE"]
        assert node_obs[0].health_status == HealthStatus.HEALTHY
        node_entity_ids = {o.entity_id for o in node_obs}
        node_faults = [
            f for f in fault_result.faults
            if f.fault_type == FaultType.HEALTH_FAILURE
            and f.entity_id in node_entity_ids
        ]
        assert len(node_faults) == 0


class TestMutationSafety:
    """Verify no mutation operations in monitoring/fault source code."""

    MUTATION_PATTERNS = [
        "create", "update", "patch", "delete", "scale", "restart",
        "rollout", "exec", "apply", "replace",
    ]

    def _read_source(self, path):
        with open(path, encoding="utf-8") as f:
            return f.read()

    def test_monitoring_models_no_mutation(self):
        import os
        base = "src/server_manager/monitoring"
        for fname in os.listdir(base):
            if not fname.endswith(".py"):
                continue
            content = self._read_source(os.path.join(base, fname))
            for pattern in self.MUTATION_PATTERNS:
                # Check for mutation method calls (not in comments/docstrings)
                lines = content.split("\n")
                for i, line in enumerate(lines):
                    stripped = line.strip()
                    if stripped.startswith("#") or stripped.startswith('"""') or stripped.startswith("'"):
                        continue
                    if f".{pattern}(" in stripped.lower():
                        # Check it's not a comment
                        if not stripped.startswith("#"):
                            pytest.fail(
                                f"Mutation pattern '{pattern}' found in "
                                f"{fname}:{i+1}: {stripped}"
                            )

    def test_fault_models_no_mutation(self):
        import os
        base = "src/server_manager/fault"
        for fname in os.listdir(base):
            if not fname.endswith(".py"):
                continue
            content = self._read_source(os.path.join(base, fname))
            for pattern in self.MUTATION_PATTERNS:
                lines = content.split("\n")
                for i, line in enumerate(lines):
                    stripped = line.strip()
                    if stripped.startswith("#") or stripped.startswith('"""'):
                        continue
                    if f".{pattern}(" in stripped.lower():
                        pytest.fail(
                            f"Mutation pattern '{pattern}' found in "
                            f"{fname}:{i+1}: {stripped}"
                        )

    def test_no_provider_api_imports(self):
        """No direct provider API imports in monitoring/fault."""
        import os
        for pkg in ["monitoring", "fault"]:
            base = f"src/server_manager/{pkg}"
            for fname in os.listdir(base):
                if not fname.endswith(".py"):
                    continue
                content = self._read_source(os.path.join(base, fname))
                # Should NOT import from providers directly (except through graph/health)
                if "from server_manager.providers" in content:
                    # Check if it's a type import only
                    if "KubernetesProviderAdapter" in content or "RawProviderSnapshot" in content:
                        pytest.fail(
                            f"Direct provider import in {pkg}/{fname}"
                        )

    def test_fault_detection_read_only(self):
        """FaultDetectionService has no write/mutation methods."""
        service = FaultDetectionService()
        # Ensure no methods that could mutate infrastructure
        mutation_methods = [m for m in dir(service) if m in self.MUTATION_PATTERNS]
        assert len(mutation_methods) == 0

    def test_monitoring_service_read_only(self):
        """MonitoringService has no write/mutation methods."""
        service = MonitoringService()
        mutation_methods = [m for m in dir(service) if m in self.MUTATION_PATTERNS]
        assert len(mutation_methods) == 0
