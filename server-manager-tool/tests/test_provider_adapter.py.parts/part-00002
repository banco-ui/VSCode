class TestNoCanonicalLeakage:
    """Test that canonical entities do not leak into the provider layer."""

    def test_snapshot_has_no_canonical_entities(self):
        adapter = FakeProviderAdapter()
        snap = adapter.collect()
        for attr in ["physical", "os", "platform", "cluster", "node",
                      "execution_environment", "workload", "network",
                      "storage", "accelerator"]:
            assert not hasattr(snap, attr), (
                f"Snapshot must not have canonical entity: {attr}"
            )

    def test_adapter_does_not_import_canonical_entities(self):
        """ProviderAdapter module does NOT import canonical entity classes."""
        from server_manager.providers import base as provider_base
        from server_manager.models.canonical import (
            Physical, Platform, Cluster, Node, OS,
            ExecutionEnvironment, Workload, Network,
            Storage, Accelerator,
        )
        forbidden = [
            "Physical", "Platform", "Cluster", "Node", "OS",
            "ExecutionEnvironment", "Workload", "Network",
            "Storage", "Accelerator",
        ]
        for name in forbidden:
            assert not hasattr(provider_base, name), (
                f"Provider module must not import canonical entity: {name}"
            )

    def test_snapshot_does_not_create_canonical(self):
        snap = RawProviderSnapshot(
            snapshot_id="snap-001",
            provider_type=ProviderType.KUBERNETES,
            payload={"nodes": [{"name": "node-1"}]},
        )
        assert isinstance(snap.payload, dict)


