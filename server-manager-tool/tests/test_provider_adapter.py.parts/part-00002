        assert not hasattr(RelationshipEvidenceType, "INFERRED")

    def test_relationship_evidence_type_has_no_unknown(self):
        assert not hasattr(RelationshipEvidenceType, "UNKNOWN")

    def test_only_direct_and_derived(self):
        values = {e.value for e in RelationshipEvidenceType}
        assert values == {"DIRECT", "DERIVED"}

    def test_inferred_string_rejected(self):
        with pytest.raises(ValidationError):
            RawRelationshipEvidence(
                source_entity_ref="a", target_entity_ref="b",
                relationship_type="inferred", evidence_type="INFERRED",
            )

    def test_unknown_string_rejected(self):
        with pytest.raises(ValidationError):
            RawRelationshipEvidence(
                source_entity_ref="a", target_entity_ref="b",
                relationship_type="unknown", evidence_type="UNKNOWN",
            )


