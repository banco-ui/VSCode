:
        evidence = RawRelationshipEvidence(
            source_entity_ref="pod-1",
            target_entity_ref="node-1",
            relationship_type="pod_to_node",
            evidence_type=RelationshipEvidenceType.DIRECT,
        )
        assert evidence.evidence_type == RelationshipEvidenceType.DIRECT

    def test_derived_evidence(self):
        evidence = RawRelationshipEvidence(
            source_entity_ref="pod-1",
            target_entity_ref="pod-2",
            relationship_type="same_node",
            evidence_type=RelationshipEvidenceType.DERIVED,
        )
        assert evidence.evidence_type == RelationshipEvidenceType.DERIVED

    def test_relationship_evidence_in_snapshot(self):
        adapter = FakeProviderAdapter()
        snap = adapter.collect()
        assert len(snap.relationship_evidence) > 0
        ev = snap.relationship_evidence[0]
        assert ev.source_entity_ref == "pod-default/nginx-deployment-abc"
        assert ev.target_entity_ref == "node-1"
        assert ev.evidence_type == RelationshipEvidenceType.DIRECT

    def test_relationship_refs_are_provider_side(self):
        """Relationship refs are provider-side, NOT canonical_id."""
        evidence = RawRelationshipEvidence(
            source_entity_ref="pod-1",
            target_entity_ref="node-1",
