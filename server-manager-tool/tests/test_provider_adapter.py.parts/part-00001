class TestErrorRepresentation:
    """Test error semantics with ErrorCategory (reused)."""

    @pytest.mark.parametrize("error_cat", [
        ErrorCategory.CONNECTION_ERROR,
        ErrorCategory.AUTHENTICATION_ERROR,
        ErrorCategory.TIMEOUT,
        ErrorCategory.PROTOCOL_ERROR,
        ErrorCategory.UNSUPPORTED,
        ErrorCategory.PARSING_ERROR,
        ErrorCategory.UNKNOWN_ERROR,
    ])
    def test_error_categories_in_capability_result(self, error_cat):
        cr = CapabilityResult(
            capability=AdapterCapability.NODE,
            status=OrchestrationStatus.FAILED,
            error_category=error_cat,
            errors=[f"Failed: {error_cat.value}"],
        )
        assert cr.error_category == error_cat

    def test_error_category_is_orchestrator_enum(self):
        from server_manager.orchestrator.models import ErrorCategory as EC
        assert ErrorCategory is EC

    def test_snapshot_errors_list(self):
        snap = RawProviderSnapshot(
            snapshot_id="snap-001",
            provider_type=ProviderType.KUBERNETES,
            errors=["Connection refused", "Timeout"],
        )
        assert len(snap.errors) == 2

    def test_capability_result_errors_list(self):
        cr = CapabilityResult(
            capability=AdapterCapability.NETWORK,
            status=OrchestrationStatus.FAILED,
            errors=["CNI plugin unavailable"],
        )
        assert len(cr.errors) == 1

    def test_error_category_from_exception(self):
        assert (
            ErrorCategory.from_exception(ConnectionError("refused"))
            == ErrorCategory.CONNECTION_ERROR
        )
        assert (
            ErrorCategory.from_exception(TimeoutError("timed out"))
            == ErrorCategory.TIMEOUT
        )


