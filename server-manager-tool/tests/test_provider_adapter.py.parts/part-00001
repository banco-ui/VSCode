class TestCapabilityDeclaration:
    """Test AdapterCapability enum and capability declaration."""

    def test_capability_count(self):
        """AdapterCapability has 14 values (10 canonical + 4 cross-cutting)."""
        assert len(AdapterCapability) == 14

    def test_canonical_domain_capabilities_present(self):
        """First 10 capabilities mirror canonical entity domains."""
        expected = {
            AdapterCapability.PHYSICAL, AdapterCapability.OS,
            AdapterCapability.PLATFORM, AdapterCapability.CLUSTER,
            AdapterCapability.NODE, AdapterCapability.EXECUTION_ENVIRONMENT,
            AdapterCapability.WORKLOAD, AdapterCapability.NETWORK,
            AdapterCapability.STORAGE, AdapterCapability.ACCELERATOR,
        }
        assert expected.issubset(set(AdapterCapability))

    def test_cross_cutting_capabilities_present(self):
        """Additional cross-cutting capabilities exist."""
        assert AdapterCapability.RELATIONSHIP_DISCOVERY
        assert AdapterCapability.METRICS
        assert AdapterCapability.EVENTS
        assert AdapterCapability.HEALTH

    def test_fake_adapter_capabilities(self):
        """FakeProviderAdapter declares capabilities correctly."""
        adapter = FakeProviderAdapter()
        caps = adapter.capabilities()
        assert AdapterCapability.CLUSTER in caps
        assert AdapterCapability.NODE in caps
        assert len(caps) == 5

    def test_capability_declaration_not_collection(self):
        """Declaring a capability does NOT mean data was collected."""
        adapter = FakeProviderAdapter()
        caps = adapter.capabilities()
        assert isinstance(caps, list)
        assert AdapterCapability.WORKLOAD in caps  # declared, not collected


