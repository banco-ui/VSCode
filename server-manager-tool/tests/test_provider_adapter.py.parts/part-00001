"""Provider Adapter + Raw Snapshot Contract Tests — Phase 13G-2.

Tests for the provider adapter contract, capability model, raw snapshot,
identity separation, provenance, partial/error semantics, and relationship
evidence boundary.

IMPORTANT:
    - No provider connections are made (no Kubernetes, no WRCP, no live API).
    - A FakeProviderAdapter is used for contract verification only.
    - Existing tests are NOT modified.
    - The ProviderAdapter does NOT create canonical entities.
"""
from __future__ import annotations

import pytest
from pydantic import ValidationError

from server_manager.models.canonical import (
    ProviderType,
    RelationshipEvidenceType,
    SourceEvidence,
)
from server_manager.models.enums import Confidence
from server_manager.orchestrator.models import ErrorCategory, OrchestrationStatus
from server_manager.providers import (
    AdapterCapability,
