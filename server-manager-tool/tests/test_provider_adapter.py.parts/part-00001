#  1. PROVIDER ADAPTER CONTRACT INSTANTIATION
# ════════════════════════════════════════════════════════════════════════


class TestProviderAdapterContract:
    """Test ProviderAdapter ABC contract."""

    def test_cannot_instantiate_abc_directly(self):
        """ProviderAdapter is abstract — cannot instantiate directly."""
        with pytest.raises(TypeError):
            ProviderAdapter(ProviderType.KUBERNETES)

    def test_fake_adapter_instantiation(self):
        """FakeProviderAdapter can be instantiated."""
        adapter = FakeProviderAdapter()
        assert adapter is not None

    def test_provider_type_property(self):
        """provider_type property returns the configured type."""
        adapter = FakeProviderAdapter(provider_type=ProviderType.WRCP)
        assert adapter.provider_type == ProviderType.WRCP

    def test_provider_id_property(self):
        """provider_id property returns the configured ID."""
        adapter = FakeProviderAdapter(provider_id="cluster-xyz")
        assert adapter.provider_id == "cluster-xyz"

    def test_provider_id_optional(self):
        """provider_id can be None."""
        adapter = FakeProviderAdapter(provider_id=None)
        assert adapter.provider_id is None

    def test_abstract_methods_present(self):
        """ProviderAdapter must have abstract methods capabilities and collect."""
        assert "capabilities" in ProviderAdapter.__abstractmethods__
        assert "collect" in ProviderAdapter.__abstractmethods__


