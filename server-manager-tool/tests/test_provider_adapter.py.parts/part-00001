# ════════════════════════════════════════════════════════════════════════
#  FAKE PROVIDER ADAPTER (test-only, no real provider connection)
# ════════════════════════════════════════════════════════════════════════


class FakeProviderAdapter(ProviderAdapter):
    """Test-only provider adapter for contract verification.

    Does NOT connect to any real provider. Returns canned data.
    """

    def __init__(
        self,
        provider_type: ProviderType = ProviderType.KUBERNETES,
        provider_id: str = "test-cluster-1",
        fail: bool = False,
    ) -> None:
        super().__init__(provider_type, provider_id)
        self._fail = fail

    def capabilities(self) -> list[AdapterCapability]:
        return [
            AdapterCapability.CLUSTER,
            AdapterCapability.NODE,
            AdapterCapability.EXECUTION_ENVIRONMENT,
            AdapterCapability.WORKLOAD,
            AdapterCapability.NETWORK,
        ]

    def collect(self, **kwargs) -> RawProviderSnapshot:
        if self._fail:
            raise ConnectionError("Fake connection failure")

        return RawProviderSnapshot(
            snapshot_id="snap-test-001",
            provider_type=self._provider_type,
            provider_id=self._provider_id,
            collection_status=OrchestrationStatus.SUCCESS,
            declared_capabilities=self.capabilities(),
            capability_results=[
                CapabilityResult(
                    capability=AdapterCapability.CLUSTER,
                    status=OrchestrationStatus.SUCCESS,
                    item_count=1,
                ),
                CapabilityResult(
                    capability=AdapterCapability.NODE,
                    status=OrchestrationStatus.SUCCESS,
                    item_count=3,
                ),
                CapabilityResult(
                    capability=AdapterCapability.EXECUTION_ENVIRONMENT,
                    status=OrchestrationStatus.PARTIAL,
                    errors=["Some pods failed to list"],
                    item_count=10,
                ),
                CapabilityResult(
                    capability=AdapterCapability.WORKLOAD,
                    status=OrchestrationStatus.SUCCESS,
                    item_count=5,
                ),
                CapabilityResult(
                    capability=AdapterCapability.NETWORK,
                    status=OrchestrationStatus.FAILED,
                    errors=["CNI plugin unavailable"],
                    error_category=ErrorCategory.CONNECTION_ERROR,
                    item_count=0,
                ),
            ],
            payload={
                "cluster": {"name": "test-cluster"},
                "nodes": [{"name": "node-1"}, {"name": "node-2"}],
            },
            relationship_evidence=[
                RawRelationshipEvidence(
                    source_entity_ref="pod-default/nginx-deployment-abc",
                    target_entity_ref="node-1",
                    relationship_type="pod_to_node",
                    evidence_type=RelationshipEvidenceType.DIRECT,
                ),
            ],
            source_evidence=SourceEvidence(
                provider_type=self._provider_type,
                provider_id=self._provider_id,
                confidence=Confidence.HIGH,
            ),
        )


