class TestPartialResult:
    """Test partial collection representation."""

    def test_partial_capabilities_in_snapshot(self):
        adapter = FakeProviderAdapter()
        snap = adapter.collect()
        assert len(snap.successful_capabilities) > 0
        assert len(snap.partial_capabilities) > 0
        assert len(snap.failed_capabilities) > 0

    def test_is_partial_true(self):
        adapter = FakeProviderAdapter()
        snap = adapter.collect()
        assert snap.is_partial is True

    def test_is_partial_false_all_success(self):
        snap = RawProviderSnapshot(
            snapshot_id="snap-001",
            provider_type=ProviderType.KUBERNETES,
            collection_status=OrchestrationStatus.SUCCESS,
            capability_results=[
                CapabilityResult(
                    capability=AdapterCapability.NODE,
                    status=OrchestrationStatus.SUCCESS,
                ),
            ],
        )
        assert snap.is_partial is False

    def test_partial_not_empty(self):
        """Partial capability has errors but still collected items."""
        adapter = FakeProviderAdapter()
        snap = adapter.collect()
        partial_cr = next(
            cr for cr in snap.capability_results
            if cr.status == OrchestrationStatus.PARTIAL
        )
        assert partial_cr.item_count > 0
        assert len(partial_cr.errors) > 0

    def test_failed_capability_has_error_category(self):
        adapter = FakeProviderAdapter()
        snap = adapter.collect()
        failed_cr = next(
            cr for cr in snap.capability_results
            if cr.status == OrchestrationStatus.FAILED
        )
        assert failed_cr.error_category == ErrorCategory.CONNECTION_ERROR


