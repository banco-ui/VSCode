class TestRawPayloadPreservation:
    """Test raw payload boundary — provider data preserved as-is."""

    def test_payload_preserves_provider_structure(self):
        raw_k8s_data = {
            "apiVersion": "v1",
            "kind": "PodList",
            "items": [
                {"metadata": {"name": "nginx"}, "spec": {"nodeName": "node-1"}},
            ],
        }
        snap = RawProviderSnapshot(
            snapshot_id="snap-001",
            provider_type=ProviderType.KUBERNETES,
            payload=raw_k8s_data,
        )
        assert snap.payload == raw_k8s_data
        assert snap.payload["apiVersion"] == "v1"

    def test_payload_default_empty_dict(self):
        snap = RawProviderSnapshot(
            snapshot_id="snap-001",
            provider_type=ProviderType.KUBERNETES,
        )
        assert snap.payload == {}

    def test_payload_no_canonical_entities(self):
        """Payload contains raw provider data, NOT canonical entities."""
        snap = RawProviderSnapshot(
            snapshot_id="snap-001",
            provider_type=ProviderType.KUBERNETES,
            payload={"pods": [{"name": "nginx"}]},
        )
        # Payload should NOT contain canonical entity instances
        for v in snap.payload.values():
            assert not hasattr(v, "canonical_id")


