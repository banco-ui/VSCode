        assert len(result.physicals) == 3
        assert result.is_success

    def test_multiple_physicals_unique_canonical_ids(self):
        payload = {"physicals": [
            {"provider_id": "srv-01"},
            {"provider_id": "srv-02"},
        ]}
        result = GenericProviderNormalizer(ProviderType.KUBERNETES).normalize(
            make_snapshot(payload))
        ids = [p.canonical_id for p in result.physicals]
        assert len(set(ids)) == 2

