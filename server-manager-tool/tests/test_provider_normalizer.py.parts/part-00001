class TestStrictInt:
    def test_valid_int(self):
        assert strict_int(42) == (42, None)

    def test_valid_str_int(self):
        assert strict_int("42") == (42, None)

    def test_none_returns_none(self):
        assert strict_int(None) == (None, None)

    def test_invalid_str(self):
        val, err = strict_int("abc")
        assert val is None
        assert err is not None

    def test_bool_rejected(self):
        val, err = strict_int(True)
        assert val is None
        assert err is not None


