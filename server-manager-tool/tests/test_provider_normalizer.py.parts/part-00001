def make_snapshot(
    payload: dict[str, Any] | None = None,
    provider_type: ProviderType = ProviderType.KUBERNETES,
    provider_id: str = "test-provider-01",
    snapshot_id: str = "snap-test-001",
    relationship_evidence: list[RawRelationshipEvidence] | None = None,
) -> RawProviderSnapshot:
    """Create a RawProviderSnapshot with synthetic data."""
    return RawProviderSnapshot(
        provider_type=provider_type,
        provider_id=provider_id,
        snapshot_id=snapshot_id,
        collected_at=NOW,
        payload=payload or {},
        relationship_evidence=relationship_evidence or [],
    )

