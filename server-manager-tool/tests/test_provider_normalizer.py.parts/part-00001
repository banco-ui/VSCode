class TestNormalizationResult:
    """Tests for NormalizationResult model contract."""

    def test_default_result_is_empty_success(self):
        r = NormalizationResult(
            snapshot_id="snap-01", provider_type=ProviderType.KUBERNETES)
        assert r.is_empty
        assert r.is_success
        assert r.entity_count == 0
        assert r.status == OrchestrationStatus.SUCCESS

    def test_entity_count_sums_all_types(self):
        r = NormalizationResult(
            snapshot_id="snap-01", provider_type=ProviderType.KUBERNETES)
        assert r.entity_count == 0

    def test_result_has_normalized_at(self):
        r = NormalizationResult(
            snapshot_id="snap-01", provider_type=ProviderType.KUBERNETES)
        assert r.normalized_at is not None
        assert len(r.normalized_at) > 0

    def test_result_has_errors_and_warnings_lists(self):
        r = NormalizationResult(
            snapshot_id="snap-01", provider_type=ProviderType.KUBERNETES)
        assert r.errors == []
        assert r.warnings == []

    def test_result_has_relationship_evidence_list(self):
        r = NormalizationResult(
            snapshot_id="snap-01", provider_type=ProviderType.KUBERNETES)
        assert r.relationship_evidence == []

    def test_result_extra_forbid(self):
        with pytest.raises(Exception):
            NormalizationResult(
                snapshot_id="snap-01", provider_type=ProviderType.KUBERNETES,
                unknown_field="bad")


class TestNormalizationError:
    """Tests for NormalizationError model."""

    def test_minimal_error(self):
        e = NormalizationError(entity_type="Physical", message="bad")
        assert e.entity_type == "Physical"
        assert e.error_category == ErrorCategory.NORMALIZATION_ERROR
        assert e.provider_ref is None
        assert e.field is None

    def test_full_error(self):
        e = NormalizationError(
            entity_type="OS", provider_ref="os-01",
            error_category=ErrorCategory.PARSING_ERROR,
            message="bad payload", field="os_type")
        assert e.provider_ref == "os-01"
        assert e.error_category == ErrorCategory.PARSING_ERROR
        assert e.field == "os_type"

    def test_extra_forbid(self):
        with pytest.raises(Exception):
            NormalizationError(entity_type="OS", message="bad", extra="bad")


