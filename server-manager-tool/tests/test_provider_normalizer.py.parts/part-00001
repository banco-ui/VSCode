class TestCanonicalIdentityGenerator:
    """Tests for deterministic canonical ID generation."""

    def test_format_includes_provider_type_and_kind(self):
        cid = CanonicalIdentityGenerator.generate(
            ProviderType.KUBERNETES, "physical", "srv-01")
        assert cid == "canon-kubernetes-physical-srv-01"

    def test_canonical_id_not_equal_provider_id(self):
        pid = "srv-01"
        cid = CanonicalIdentityGenerator.generate(
            ProviderType.KUBERNETES, "physical", pid)
        assert cid != pid

    def test_deterministic_same_input_same_output(self):
        cid1 = CanonicalIdentityGenerator.generate(
            ProviderType.KUBERNETES, "node", "n-1")
        cid2 = CanonicalIdentityGenerator.generate(
            ProviderType.KUBERNETES, "node", "n-1")
        assert cid1 == cid2

    def test_different_provider_types_different_ids(self):
        cid_k8s = CanonicalIdentityGenerator.generate(
            ProviderType.KUBERNETES, "node", "n-1")
        cid_wrcp = CanonicalIdentityGenerator.generate(
            ProviderType.WRCP, "node", "n-1")
        assert cid_k8s != cid_wrcp

    def test_different_kinds_different_ids(self):
        cid_phys = CanonicalIdentityGenerator.generate(
            ProviderType.KUBERNETES, "physical", "x-1")
        cid_os = CanonicalIdentityGenerator.generate(
            ProviderType.KUBERNETES, "os", "x-1")
        assert cid_phys != cid_os

    def test_none_provider_ref_uses_index(self):
        cid = CanonicalIdentityGenerator.generate(
            ProviderType.KUBERNETES, "physical", None, index=0)
        assert "idx-0" in cid

    def test_empty_provider_ref_uses_index(self):
        cid = CanonicalIdentityGenerator.generate(
            ProviderType.KUBERNETES, "physical", "", index=5)
        assert "idx-5" in cid

    def test_none_no_index_uses_unidentified(self):
        cid = CanonicalIdentityGenerator.generate(
            ProviderType.KUBERNETES, "physical", None)
        assert "unidentified" in cid

    def test_strips_whitespace(self):
        cid = CanonicalIdentityGenerator.generate(
            ProviderType.KUBERNETES, "physical", "  srv-01  ")
        assert cid == "canon-kubernetes-physical-srv-01"


