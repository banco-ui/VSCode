class TestProviderNormalizerABC:
    """Tests for ProviderNormalizer abstract base class."""

    def test_cannot_instantiate_abc_directly(self):
        with pytest.raises(TypeError):
            ProviderNormalizer(ProviderType.KUBERNETES)

    def test_subclass_must_implement_normalize(self):
        class BadNorm(ProviderNormalizer):
            pass
        with pytest.raises(TypeError):
            BadNorm(ProviderType.KUBERNETES)

    def test_concrete_subclass_works(self):
        norm = GenericProviderNormalizer(ProviderType.KUBERNETES)
        assert norm.provider_type == ProviderType.KUBERNETES

    def test_normalize_returns_normalization_result(self):
        norm = GenericProviderNormalizer(ProviderType.KUBERNETES)
        snap = make_snapshot({"physicals": [{"provider_id": "srv-01"}]})
        result = norm.normalize(snap)
        assert isinstance(result, NormalizationResult)

    def test_normalize_safe_never_raises(self):
        norm = GenericProviderNormalizer(ProviderType.KUBERNETES)
        snap = make_snapshot({})
        result = norm.normalize_safe(snap)
        assert isinstance(result, NormalizationResult)

    def test_normalize_safe_catches_exception(self):
        class ExplodingNormalizer(ProviderNormalizer):
            def normalize(self, snapshot):
                raise RuntimeError("boom")
        norm = ExplodingNormalizer(ProviderType.KUBERNETES)
        snap = make_snapshot({})
        result = norm.normalize_safe(snap)
        assert result.status == OrchestrationStatus.FAILED
        assert len(result.errors) == 1
        assert "boom" in result.errors[0].message


