class TestSnapshotDiff:
    def test_diff_no_changes(self, store):
        inv = make_inventory()
        snap1 = make_snapshot("R750-001", "run-001", inv)
        snap2 = make_snapshot("R750-001", "run-002", inv)
        store.register_server(ServerRegistryEntry(
            server_id="R750-001", display_name="S1", vendor=Vendor.Dell,
        ))
        store.save_snapshot(snap1)
        store.save_snapshot(snap2)
        svc = DashboardQueryService(store)
        diff = svc.get_snapshot_diff("snap-run-001", "snap-run-002")
        assert diff is not None
        assert diff.has_changes is False

    def test_diff_with_changes(self, store):
        inv1 = make_inventory(cores=48)
        inv2 = make_inventory(cores=24)
        snap1 = make_snapshot("R750-001", "run-001", inv1)
        snap2 = make_snapshot("R750-001", "run-002", inv2)
        store.register_server(ServerRegistryEntry(
            server_id="R750-001", display_name="S1", vendor=Vendor.Dell,
        ))
        store.save_snapshot(snap1)
        store.save_snapshot(snap2)
        svc = DashboardQueryService(store)
        diff = svc.get_snapshot_diff("snap-run-001", "snap-run-002")
        assert diff is not None
        assert diff.has_changes is True

    def test_diff_nonexistent_snapshot(self, store):
        svc = DashboardQueryService(store)
        diff = svc.get_snapshot_diff("nonexistent-a", "nonexistent-b")
        assert diff is None

    def test_compute_diff_direct(self):
        inv1 = make_inventory(cores=48)
        inv2 = make_inventory(cores=24)
        diff = compute_snapshot_diff("snap-a", "snap-b", inv1, inv2)
        assert diff.snapshot_a_id == "snap-a"
        assert diff.snapshot_b_id == "snap-b"
        assert diff.has_changes is True

    def test_diff_added_field(self):
        """When a field changes from empty/default to populated, it should be detected as changed."""
        inv1 = ServerInventory()
        inv2 = make_inventory()
        diff = compute_snapshot_diff("a", "b", inv1, inv2)
        assert diff.has_changes is True
        # With model_dump(), default values exist on both sides, so they're "changed" not "added"
        assert len(diff.changed_fields) > 0

    def test_diff_removed_field(self):
        """When a field changes from populated to empty/default, it should be detected as changed."""
        inv1 = make_inventory()
        inv2 = ServerInventory()
        diff = compute_snapshot_diff("a", "b", inv1, inv2)
        assert diff.has_changes is True
        assert len(diff.changed_fields) > 0


