class TestExcludedUserWorkload:
    """P1: EXCLUDED_USER_WORKLOAD must not be a compute candidate."""

    def test_excluded_user_workload_not_candidate(self, store):
        """P1: Server with EXCLUDED_USER_WORKLOAD eligibility must not
        appear in weekend compute candidates.
        """
        entry = ServerRegistryEntry(
            server_id="E910T-001",
            display_name="e910t Server",
            vendor=Vendor.HPE,
            model="e910t",
            lifecycle_state=ServerLifecycle.ACTIVE,
        )
        store.register_server(entry)

        inv = make_inventory(
            server_id="E910T-001",
            eligibility=ComputeEligibility.EXCLUDED_USER_WORKLOAD,
        )
        snap = make_snapshot(server_id="E910T-001", run_id="run-001", inv=inv)
        store.save_snapshot(snap)

        svc = DashboardQueryService(store)
        candidates = svc.get_weekend_compute_candidates()

        candidate_ids = [c.server_id for c in candidates]
        assert "E910T-001" not in candidate_ids

    def test_candidate_is_included(self, store):
        """P1: Server with CANDIDATE eligibility IS a compute candidate.

        This is the positive counterpart to the exclusion test above,
        verifying the filter works correctly in both directions.
        """
        entry = ServerRegistryEntry(
            server_id="R750-001",
            display_name="R750 Server",
            vendor=Vendor.Dell,
            model="PowerEdge R750",
            lifecycle_state=ServerLifecycle.ACTIVE,
        )
        store.register_server(entry)

        inv = make_inventory(
            server_id="R750-001",
            eligibility=ComputeEligibility.CANDIDATE,
        )
        snap = make_snapshot(server_id="R750-001", run_id="run-001", inv=inv)
        store.save_snapshot(snap)

        svc = DashboardQueryService(store)
        candidates = svc.get_weekend_compute_candidates()

        candidate_ids = [c.server_id for c in candidates]
        assert "R750-001" in candidate_ids


class TestStoreToDashboardEndToEnd:
    """P1: Verify data flows correctly from Store to DashboardQueryService."""

    def test_store_to_dashboard_end_to_end(self, store):
        """P1: End-to-end: register → save snapshot → query detail.

        Verifies that data saved through the Store public API is
        correctly read back through DashboardQueryService.
        """
        # 1. Register server
        entry = ServerRegistryEntry(
            server_id="R750-001",
            display_name="R750 Server 1",
            vendor=Vendor.Dell,
            model="PowerEdge R750",
            lifecycle_state=ServerLifecycle.ACTIVE,
        )
        store.register_server(entry)

        # 2. Save snapshot with real inventory
        inv = make_inventory(
            server_id="R750-001",
            cores=48,
            health=HealthStatus.OK,
            eligibility=ComputeEligibility.CANDIDATE,
        )
        snap = make_snapshot(server_id="R750-001", run_id="run-001", inv=inv)
        store.save_snapshot(snap)

        # 3. Query through DashboardQueryService
        svc = DashboardQueryService(store)
        detail = svc.get_server_detail("R750-001")

        # 4. Verify data integrity
        assert detail is not None
        assert detail.server_id == "R750-001"
        assert detail.vendor == Vendor.Dell
        assert detail.model == "PowerEdge R750"
        assert detail.cpu_cores == 48
        assert detail.memory_gb == 256.0
        assert detail.health == HealthStatus.OK
        assert detail.compute_eligibility == ComputeEligibility.CANDIDATE
        assert detail.snapshot_count == 1
        assert detail.current_snapshot_id == "snap-run-001"

    def test_store_to_dashboard_server_list(self, store):
        """P1: End-to-end: register → save snapshot → query server list.

        Verifies server list query reflects stored snapshot data.
        """
        entry = ServerRegistryEntry(
            server_id="R750-001",
            display_name="R750 Server 1",
            vendor=Vendor.Dell,
            model="PowerEdge R750",
            lifecycle_state=ServerLifecycle.ACTIVE,
        )
        store.register_server(entry)

        inv = make_inventory(
            server_id="R750-001",
            cores=48,
            health=HealthStatus.OK,
            eligibility=ComputeEligibility.CANDIDATE,
        )
        snap = make_snapshot(server_id="R750-001", run_id="run-001", inv=inv)
        store.save_snapshot(snap)

        svc = DashboardQueryService(store)
        result = svc.get_server_list()

        assert len(result.servers) == 1
        summary = result.servers[0]
        assert summary.server_id == "R750-001"
        assert summary.cpu_cores == 48
        assert summary.memory_gb == 256.0
        assert summary.health == HealthStatus.OK
        assert summary.compute_eligibility == ComputeEligibility.CANDIDATE


