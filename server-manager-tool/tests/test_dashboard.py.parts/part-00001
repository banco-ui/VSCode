def make_inventory(
    server_id="R750-001",
    cores=48,
    health=HealthStatus.OK,
    eligibility=ComputeEligibility.CANDIDATE,
):
    return ServerInventory(
        identity=Identity(server_id=server_id, vendor=Vendor.Dell, model="PowerEdge R750"),
        hardware=Hardware(
            cpu=CPU(count=2, total_cores=cores, total_threads=cores * 2),
            memory=Memory(total_gb=256.0),
        ),
        os=OS(distribution="Ubuntu", kernel="5.15.0", hostname="srv-1"),
        health=Health(system=health, cpu=health, memory=health),
        compute=Compute(potential=ComputePotential.HIGH, eligibility=eligibility),
    )


def make_snapshot(server_id="R750-001", run_id="run-001", inv=None):
    return InventorySnapshot(
        snapshot_id=f"snap-{run_id}",
        server_id=server_id,
        orchestration_run_id=run_id,
        collected_at=f"2026-01-0{run_id[-1]}T00:00:00+00:00",
        inventory=inv or make_inventory(server_id),
    )


