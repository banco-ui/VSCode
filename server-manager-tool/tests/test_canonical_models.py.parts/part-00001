class TestProvenance:
    """G1-09: SourceEvidence/provenance boundary preserved."""

    def test_source_evidence_attached(self):
        ev = SourceEvidence(
            provider_type=ProviderType.KUBERNETES,
            provider_id="k8s-cluster-1",
            collected_at="2025-01-01T00:00:00Z",
            confidence=Confidence.HIGH,
            discovery_method=RelationshipEvidenceType.DIRECT,
        )
        wl = Workload(canonical_id="wl1", provider_type=ProviderType.KUBERNETES, source_evidence=ev)
        assert wl.source_evidence.provider_type == ProviderType.KUBERNETES
        assert wl.source_evidence.confidence == Confidence.HIGH

    def test_inferred_not_valid_evidence(self):
        """INFERRED and UNKNOWN are not valid RelationshipEvidenceType values."""
        evidence_values = {e.value for e in RelationshipEvidenceType}
        assert "INFERRED" not in evidence_values
        assert "UNKNOWN" not in evidence_values
        assert "DIRECT" in evidence_values
        assert "DERIVED" in evidence_values

    def test_source_evidence_extra_forbid(self):
        with pytest.raises(ValidationError):
            SourceEvidence(
                provider_type=ProviderType.KUBERNETES,
                llm_generated=True,
            )


