class TestEEWorkloadCardinality:
    """EE → Workload = 0:1 (Optional[str]); Workload → EE = 1:N (list[str])."""

    def test_ee_workload_ref_zero_to_one_none(self):
        ee = ExecutionEnvironment(canonical_id="ee1", provider_type=ProviderType.KUBERNETES, source_evidence=_evidence())
        assert ee.workload_ref is None  # 0:1 — None allowed

    def test_ee_workload_ref_zero_to_one_set(self):
        ee = ExecutionEnvironment(canonical_id="ee1", provider_type=ProviderType.KUBERNETES, source_evidence=_evidence())
        ee.workload_ref = "wl-1"
        assert ee.workload_ref == "wl-1"

    def test_workload_ee_refs_is_list(self):
        """Workload → EE = 1:N — must be list[str], NOT Optional[str]."""
        wl = Workload(canonical_id="wl1", provider_type=ProviderType.KUBERNETES, source_evidence=_evidence())
        assert isinstance(wl.execution_environment_refs, list)

    def test_workload_ee_refs_can_be_empty_at_construction(self):
        """Construction timing: list may be empty during incremental build.

        Domain semantic: a complete Workload MUST have >= 1 EE.
        But at construction time, empty list is allowed.
        Validation of 1:N constraint is deferred to verification layer.
        """
        wl = Workload(canonical_id="wl1", provider_type=ProviderType.KUBERNETES, source_evidence=_evidence())
        assert wl.execution_environment_refs == []

    def test_workload_ee_refs_one_to_n(self):
        wl = Workload(canonical_id="wl1", provider_type=ProviderType.KUBERNETES, source_evidence=_evidence())
        wl.execution_environment_refs = ["ee-1"]
        assert len(wl.execution_environment_refs) == 1
        wl.execution_environment_refs = ["ee-1", "ee-2", "ee-3"]
        assert len(wl.execution_environment_refs) == 3

    def test_ee_workload_ref_is_optional_not_list(self):
        """EE → Workload = 0:1 — must be Optional[str], NOT list[str]."""
        ee = ExecutionEnvironment(canonical_id="ee1", provider_type=ProviderType.KUBERNETES, source_evidence=_evidence())
        # Type annotation should be Optional[str], not list
        field_info = ExecutionEnvironment.model_fields["workload_ref"]
        assert "Optional" in str(field_info.annotation) or "str" in str(field_info.annotation)


