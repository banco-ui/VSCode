class TestPodContainerIsEE:
    """Pod and Container are ExecutionEnvironments, NOT Workloads."""

    def test_pod_is_execution_environment(self):
        pod = ExecutionEnvironment(
            canonical_id="pod-1",
            provider_type=ProviderType.KUBERNETES,
            source_evidence=_evidence(),
            ee_type=ExecutionEnvironmentType.POD,
        )
        assert pod.ee_type == ExecutionEnvironmentType.POD
        assert isinstance(pod, ExecutionEnvironment)

    def test_container_is_execution_environment(self):
        container = ExecutionEnvironment(
            canonical_id="container-1",
            provider_type=ProviderType.KUBERNETES,
            source_evidence=_evidence(),
            ee_type=ExecutionEnvironmentType.CONTAINER,
        )
        assert container.ee_type == ExecutionEnvironmentType.CONTAINER
        assert isinstance(container, ExecutionEnvironment)

    def test_pod_is_not_workload_type(self):
        """ExecutionEnvironmentType.POD must not be a WorkloadType."""
        wl_types = {wt.value for wt in WorkloadType}
        assert "POD" not in wl_types
        assert "CONTAINER" not in wl_types


