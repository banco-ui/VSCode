class TestPhysicalRelationships:
    """Physical → OS/Node/EE/Network/Storage/Accelerator = 0:N."""

    def test_physical_os_refs_zero_to_n(self):
        p = Physical(canonical_id="p1", provider_type=ProviderType.REDFISH, source_evidence=_evidence(ProviderType.REDFISH))
        assert p.os_refs == []  # 0:N — empty allowed
        p.os_refs = ["os-1", "os-2"]
        assert len(p.os_refs) == 2

    def test_physical_node_refs_zero_to_n(self):
        p = Physical(canonical_id="p1", provider_type=ProviderType.REDFISH, source_evidence=_evidence(ProviderType.REDFISH))
        p.node_refs = ["node-1"]
        assert len(p.node_refs) == 1

    def test_physical_ee_refs_zero_to_n(self):
        p = Physical(canonical_id="p1", provider_type=ProviderType.REDFISH, source_evidence=_evidence(ProviderType.REDFISH))
        p.execution_environment_refs = ["ee-1", "ee-2", "ee-3"]
        assert len(p.execution_environment_refs) == 3


