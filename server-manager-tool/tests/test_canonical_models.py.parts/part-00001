class TestProviderNeutrality:
    """G1-08: Provider-specific fields must be rejected by extra='forbid'."""

    def test_workload_rejects_pod_name(self):
        with pytest.raises(ValidationError):
            Workload(
                canonical_id="wl1",
                provider_type=ProviderType.KUBERNETES,
                source_evidence=_evidence(),
                pod_name="my-pod",
            )

    def test_workload_rejects_deployment_name(self):
        with pytest.raises(ValidationError):
            Workload(
                canonical_id="wl1",
                provider_type=ProviderType.KUBERNETES,
                source_evidence=_evidence(),
                deployment_name="my-deploy",
            )

    def test_workload_rejects_kubernetes_namespace(self):
        with pytest.raises(ValidationError):
            Workload(
                canonical_id="wl1",
                provider_type=ProviderType.KUBERNETES,
                source_evidence=_evidence(),
                kubernetes_namespace="default",
            )

    def test_workload_rejects_replica_set(self):
        with pytest.raises(ValidationError):
            Workload(
                canonical_id="wl1",
                provider_type=ProviderType.KUBERNETES,
                source_evidence=_evidence(),
                replica_set=3,
            )

    def test_network_rejects_kubernetes_specific_field(self):
        with pytest.raises(ValidationError):
            Network(
                canonical_id="net1",
                provider_type=ProviderType.KUBERNETES,
                source_evidence=_evidence(),
                cni_plugin="calico",
            )

    def test_metadata_kubernetes_extension_allowed(self):
        """Provider-specific data goes in metadata, not direct fields."""
        wl = Workload(
            canonical_id="wl1",
            provider_type=ProviderType.KUBERNETES,
            source_evidence=_evidence(),
            metadata={"kubernetes": {"namespace": "default", "pod_name": "my-pod"}},
        )
        assert wl.metadata["kubernetes"]["namespace"] == "default"

    def test_workload_nf_type_in_metadata(self):
        """NF type is stored in metadata, not as a separate entity."""
        wl = Workload(
            canonical_id="wl1",
            provider_type=ProviderType.KUBERNETES,
            source_evidence=_evidence(),
            workload_type=WorkloadType.CNF,
            metadata={"nf_type": "DU", "technology": "5G"},
        )
        assert wl.metadata["nf_type"] == "DU"
        assert wl.metadata["technology"] == "5G"


