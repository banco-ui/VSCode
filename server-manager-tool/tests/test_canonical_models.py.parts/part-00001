class TestIdentityValidation:
    """G1-05: canonical_id validation and identity separation."""

    def test_canonical_id_empty_rejected(self):
        with pytest.raises(ValidationError):
            Physical(canonical_id="", provider_type=ProviderType.REDFISH, source_evidence=_evidence(ProviderType.REDFISH))

    def test_canonical_id_whitespace_rejected(self):
        with pytest.raises(ValidationError):
            Physical(canonical_id="   ", provider_type=ProviderType.REDFISH, source_evidence=_evidence(ProviderType.REDFISH))

    def test_canonical_id_not_equal_provider_id(self):
        """canonical_id != provider_id — always."""
        e = Physical(
            canonical_id="canonical-uuid-12345",
            provider_id="provider-serial-abc",
            provider_type=ProviderType.REDFISH,
            source_evidence=_evidence(ProviderType.REDFISH),
        )
        assert e.canonical_id != e.provider_id
        assert e.canonical_id == "canonical-uuid-12345"
        assert e.provider_id == "provider-serial-abc"

    def test_provider_id_optional(self):
        """provider_id can be None — not all entities have a provider ID."""
        e = Physical(
            canonical_id="phys-1",
            provider_type=ProviderType.UNKNOWN,
            source_evidence=SourceEvidence(provider_type=ProviderType.UNKNOWN),
        )
        assert e.provider_id is None


