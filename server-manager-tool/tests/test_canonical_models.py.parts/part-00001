class TestWorkloadIdentitySeparation:
    """G1-04: inventory.Workload != canonical.Workload."""

    def test_import_paths_are_different(self):
        from server_manager.models.inventory import Workload as InventoryWorkload
        from server_manager.models.canonical import Workload as CanonicalWorkload

        assert InventoryWorkload is not CanonicalWorkload

    def test_inventory_workload_is_utilization(self):
        from server_manager.models.inventory import Workload as InventoryWorkload

        iw = InventoryWorkload(cpu_utilization=75.5, memory_utilization=60.0)
        assert iw.cpu_utilization == 75.5
        assert iw.memory_utilization == 60.0
        assert not hasattr(iw, "workload_type")
        assert not hasattr(iw, "execution_environment_refs")

    def test_canonical_workload_is_deployment_unit(self):
        from server_manager.models.canonical import Workload as CanonicalWorkload

        cw = CanonicalWorkload(
            canonical_id="wl1",
            provider_type=ProviderType.KUBERNETES,
            source_evidence=_evidence(),
            workload_type=WorkloadType.CNF,
        )
        assert cw.workload_type == WorkloadType.CNF
        assert not hasattr(cw, "cpu_utilization")
        assert not hasattr(cw, "memory_utilization")

    def test_class_names_same_but_modules_different(self):
        from server_manager.models.inventory import Workload as InventoryWorkload
        from server_manager.models.canonical import Workload as CanonicalWorkload

        assert InventoryWorkload.__name__ == "Workload"
        assert CanonicalWorkload.__name__ == "Workload"
        assert InventoryWorkload.__module__ != CanonicalWorkload.__module__


