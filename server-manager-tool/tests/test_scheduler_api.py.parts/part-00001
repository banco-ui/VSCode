@pytest.fixture
def scheduler_store():
    """Create an in-memory SchedulerStore with check_same_thread=False for tests.
    
    This mirrors the Phase 8.5 fix for SQLite thread safety in TestClient.
    """
    import sqlite3
    conn = sqlite3.connect(":memory:", check_same_thread=False)
    conn.row_factory = sqlite3.Row
    
    # Create a wrapper that uses the shared connection
    class TestSchedulerStore(SchedulerStore):
        def __init__(self, conn):
            self._conn = conn
            self.db_path = ":memory:"
            self._lock_retry_count = 3
            self._lock_retry_backoff = 0.1
            self._init_schema()
        
        def _init_schema(self):
            """Initialize schema on shared connection."""
            self._conn.executescript("""
            CREATE TABLE IF NOT EXISTS schedule_definitions (
                schedule_id        TEXT PRIMARY KEY,
                name               TEXT NOT NULL,
                server_ids_json    TEXT NOT NULL DEFAULT '[]',
                enabled            INTEGER NOT NULL DEFAULT 1,
                cron_expression    TEXT,
                interval_seconds   INTEGER,
                last_run_at        TEXT,
                next_run_at        TEXT,
                created_at         TEXT NOT NULL,
                updated_at         TEXT NOT NULL,
                metadata_json      TEXT NOT NULL DEFAULT '{}'
            );
            CREATE TABLE IF NOT EXISTS schedule_executions (
                execution_id       TEXT PRIMARY KEY,
                schedule_id        TEXT NOT NULL,
                server_id          TEXT NOT NULL,
                run_id             TEXT,
                status             TEXT NOT NULL DEFAULT 'PENDING',
                claimed_at         TEXT NOT NULL,
                started_at         TEXT,
                completed_at       TEXT,
                error_message      TEXT,
                FOREIGN KEY (schedule_id) REFERENCES schedule_definitions(schedule_id)
            );
            CREATE INDEX IF NOT EXISTS idx_schedules_enabled ON schedule_definitions(enabled);
            CREATE INDEX IF NOT EXISTS idx_schedules_next_run ON schedule_definitions(next_run_at);
            CREATE INDEX IF NOT EXISTS idx_executions_schedule ON schedule_executions(schedule_id);
            CREATE INDEX IF NOT EXISTS idx_executions_status ON schedule_executions(status);
            """)
            self._conn.commit()
        
        @property
        def conn(self):
            return self._conn
        
        def close(self):
            if self._conn:
                self._conn.close()
                self._conn = None
    
    store = TestSchedulerStore(conn)
    yield store
    store.close()


