        list_response = client.get("/api/v1/schedules")
        assert list_response.status_code == 200
        schedules = list_response.json()["schedules"]
        assert any(s["schedule_id"] == schedule_id for s in schedules)
        
        # Request 3: Get schedule detail (separate request)
        get_response = client.get(f"/api/v1/schedules/{schedule_id}")
        assert get_response.status_code == 200
        assert get_response.json()["schedule_id"] == schedule_id
    
