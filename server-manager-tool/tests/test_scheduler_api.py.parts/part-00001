        # List with limit
        response = client.get("/api/v1/schedules?limit=2&offset=0")
        
        assert response.status_code == 200
        data = response.json()
        assert len(data["schedules"]) == 2
        assert data["total"] == 5
    
    def test_list_schedules_enabled_filter(self, client):
        """Filter schedules by enabled state."""
        # Create enabled and disabled
        client.post("/api/v1/schedules", json={
            "name": "Enabled",
            "server_ids": ["test-server-001"],
            "enabled": True,
            "interval_seconds": 3600,
        })
        client.post("/api/v1/schedules", json={
            "name": "Disabled",
            "server_ids": ["test-server-001"],
            "enabled": False,
            "interval_seconds": 3600,
        })
        
        # Filter enabled
        response = client.get("/api/v1/schedules?enabled=true")
        data = response.json()
        assert len(data["schedules"]) == 1
        assert data["schedules"][0]["name"] == "Enabled"
        
        # Filter disabled
        response = client.get("/api/v1/schedules?enabled=false")
        data = response.json()
        assert len(data["schedules"]) == 1
        assert data["schedules"][0]["name"] == "Disabled"


