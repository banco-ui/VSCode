class TestScheduleDefinition:
    def test_create_schedule(self):
        schedule = ScheduleDefinition(
            schedule_id="test-schedule",
            name="Test Schedule",
            server_ids=["server-001"],
            enabled=True,
            interval_seconds=3600,
        )
        
        assert schedule.schedule_id == "test-schedule"
        assert schedule.name == "Test Schedule"
        assert schedule.server_ids == ["server-001"]
        assert schedule.enabled is True
        assert schedule.interval_seconds == 3600
    
    def test_is_due_enabled(self):
        schedule = ScheduleDefinition(
            schedule_id="test",
            name="Test",
            server_ids=[],
            enabled=True,
            next_run_at=None,
        )
        
        assert schedule.is_due() is True
    
    def test_is_due_disabled(self):
        schedule = ScheduleDefinition(
            schedule_id="test",
            name="Test",
            server_ids=[],
            enabled=False,
        )
        
        assert schedule.is_due() is False
    
    def test_is_due_future(self):
        future = (datetime.now(timezone.utc) + timedelta(hours=1)).isoformat()
        schedule = ScheduleDefinition(
            schedule_id="test",
            name="Test",
            server_ids=[],
            enabled=True,
            next_run_at=future,
        )
        
        assert schedule.is_due() is False
    
    def test_is_due_past(self):
        past = (datetime.now(timezone.utc) - timedelta(hours=1)).isoformat()
        schedule = ScheduleDefinition(
            schedule_id="test",
            name="Test",
            server_ids=[],
            enabled=True,
            next_run_at=past,
        )
        
        assert schedule.is_due() is True
    
    def test_calculate_next_run_interval(self):
        schedule = ScheduleDefinition(
            schedule_id="test",
            name="Test",
            server_ids=[],
            interval_seconds=3600,
        )
        
        now = datetime.now(timezone.utc)
        next_run = schedule.calculate_next_run(now)
        
        assert next_run > now
        assert (next_run - now).total_seconds() == 3600
    
    def test_calculate_next_run_default(self):
        schedule = ScheduleDefinition(
            schedule_id="test",
            name="Test",
            server_ids=[],
        )
        
        now = datetime.now(timezone.utc)
        next_run = schedule.calculate_next_run(now)
        
        # Default is 6 hours
        assert (next_run - now).total_seconds() == 6 * 3600


