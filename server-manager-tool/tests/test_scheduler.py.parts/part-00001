                name=f"Schedule {i}",
                server_ids=[],
            )
            store.save_schedule(schedule)
        
        all_schedules = store.get_all_schedules()
        assert len(all_schedules) == 3
    
    def test_get_due_schedules(self, store):
        # Enabled and due (no next_run_at)
        schedule1 = ScheduleDefinition(
            schedule_id="due-1",
            name="Due Schedule 1",
            server_ids=[],
            enabled=True,
        )
        
        # Enabled but not due (future)
        future = (datetime.now(timezone.utc) + timedelta(hours=1)).isoformat()
        schedule2 = ScheduleDefinition(
            schedule_id="future-1",
            name="Future Schedule",
            server_ids=[],
            enabled=True,
            next_run_at=future,
        )
        
        # Disabled and due
        schedule3 = ScheduleDefinition(
            schedule_id="disabled-1",
            name="Disabled Schedule",
            server_ids=[],
            enabled=False,
        )
        
        store.save_schedule(schedule1)
        store.save_schedule(schedule2)
        store.save_schedule(schedule3)
        
        due = store.get_due_schedules()
        
        assert len(due) == 1
        assert due[0].schedule_id == "due-1"
    
    def test_update_schedule_after_execution(self, store):
        schedule = ScheduleDefinition(
            schedule_id="test",
            name="Test",
            server_ids=[],
        )
        store.save_schedule(schedule)
        
        next_run = (datetime.now(timezone.utc) + timedelta(hours=6)).isoformat()
        store.update_schedule_after_execution("test", success=True, next_run_at=next_run)
        
        updated = store.get_schedule("test")
        assert updated is not None
        assert updated.last_run_at is not None
        assert updated.next_run_at == next_run
    
    def test_claim_execution_atomic(self, store):
        schedule = ScheduleDefinition(
            schedule_id="test",
            name="Test",
            server_ids=["server-001"],
        )
        store.save_schedule(schedule)
        
        # Each claim creates a unique execution (unique execution_id)
        execution1 = store.claim_execution(schedule, "server-001")
        assert execution1 is not None
        assert execution1.status == "CLAIMED"
        
        # Second claim also succeeds (new unique execution_id)
        # Duplicate prevention is handled at scheduler level, not DB level
        execution2 = store.claim_execution(schedule, "server-001")
        assert execution2 is not None
        assert execution2.execution_id != execution1.execution_id
    
    def test_start_execution(self, store):
        schedule = ScheduleDefinition(
            schedule_id="test",
            name="Test",
            server_ids=["server-001"],
        )
        store.save_schedule(schedule)
        
        execution = store.claim_execution(schedule, "server-001")
        assert execution is not None
        
        run_id = "run-test123"
        store.start_execution(execution, run_id)
        
        retrieved = store.get_execution(execution.execution_id)
        assert retrieved is not None
        assert retrieved.run_id == run_id
        assert retrieved.status == "RUNNING"
    
    def test_complete_execution_success(self, store):
        schedule = ScheduleDefinition(
            schedule_id="test",
            name="Test",
            server_ids=["server-001"],
        )
        store.save_schedule(schedule)
        
        execution = store.claim_execution(schedule, "server-001")
        store.start_execution(execution, "run-test")
        store.complete_execution(execution.execution_id, success=True)
        
        retrieved = store.get_execution(execution.execution_id)
        assert retrieved is not None
        assert retrieved.status == "SUCCESS"
        assert retrieved.completed_at is not None
    
    def test_complete_execution_failure(self, store):
        schedule = ScheduleDefinition(
            schedule_id="test",
            name="Test",
            server_ids=["server-001"],
        )
        store.save_schedule(schedule)
        
        execution = store.claim_execution(schedule, "server-001")
        store.start_execution(execution, "run-test")
        store.complete_execution(execution.execution_id, success=False, error_message="Test error")
        
        retrieved = store.get_execution(execution.execution_id)
        assert retrieved is not None
        assert retrieved.status == "FAILED"
        assert retrieved.error_message == "Test error"


