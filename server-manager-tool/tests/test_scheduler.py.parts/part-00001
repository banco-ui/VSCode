            execution = store.claim_execution(schedule, server_id)
            assert execution is not None
            execution_ids.append(execution.execution_id)
            
            store.conn.execute(
                "UPDATE schedule_executions SET status = 'RUNNING', started_at = ? WHERE execution_id = ?",
