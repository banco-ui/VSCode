    def test_get_all_schedules(self, scheduler):
        for i in range(3):
            schedule = ScheduleDefinition(
                schedule_id=f"schedule-{i}",
                name=f"Schedule {i}",
                server_ids=[],
            )
            scheduler.add_schedule(schedule)
        
        all_schedules = scheduler.get_schedules()
        assert len(all_schedules) == 3
    
    def test_worker_limit_enforcement(self, orchestrator_factory):
        """Test that worker limit is enforced."""
        inv_store = InventoryStore(":memory:")
        
        def store_factory():
            return inv_store
        
        config = SchedulerConfig(
            poll_interval=60,
            worker_limit=2,
            enabled=False,
        )
        scheduler = Scheduler(config, orchestrator_factory, store_factory)
        
        # Acquire all worker slots
        assert scheduler._acquire_worker_slot() is True
        assert scheduler._acquire_worker_slot() is True
        assert scheduler._acquire_worker_slot() is False  # Limit reached
        
        # Release one
        scheduler._release_worker_slot()
        assert scheduler._acquire_worker_slot() is True
        
        scheduler._release_worker_slot()
        scheduler._release_worker_slot()
    
    def test_duplicate_claim_prevention(self, scheduler, orchestrator_factory, store_factory):
        """Test that duplicate claims create unique executions (each has unique execution_id).
        
        Note: Duplicate prevention at the scheduler level is about not running
        the same schedule twice simultaneously, not about DB-level uniqueness.
        Each claim creates a new execution record with a unique ID.
        """
        schedule = ScheduleDefinition(
            schedule_id="test-schedule",
            name="Test Schedule",
            server_ids=["test-server-001"],
        )
        scheduler.add_schedule(schedule)
        
        # Each claim creates a unique execution
        execution1 = scheduler.store.claim_execution(schedule, "test-server-001")
        assert execution1 is not None
        
        execution2 = scheduler.store.claim_execution(schedule, "test-server-001")
        assert execution2 is not None
        assert execution1.execution_id != execution2.execution_id
    
    def test_scheduler_start_stop(self, scheduler):
        """Test scheduler start and stop."""
        # Start
        scheduler.config.enabled = True
        scheduler.start()
        
        # Give it time to start
        time.sleep(0.1)
        
        assert scheduler._loop_thread is not None
        assert scheduler._loop_thread.is_alive()
        
        # Stop
        scheduler.stop()
        
        # Give it time to stop
        time.sleep(0.1)
        
        assert scheduler._loop_thread is None


