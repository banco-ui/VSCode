    def test_recovery_running_execution_on_restart(self, store):
        """Test 2: RUNNING execution detected as stale on restart."""
        from datetime import datetime, timezone, timedelta
        
        schedule = ScheduleDefinition(
            schedule_id="test-schedule",
            name="Test Schedule",
            server_ids=["server-001"],
        )
        store.save_schedule(schedule)
        
        execution = store.claim_execution(schedule, "server-001")
        assert execution is not None
        
        old_time = (datetime.now(timezone.utc) - timedelta(minutes=10)).isoformat()
        store.conn.execute(
            "UPDATE schedule_executions SET status = 'RUNNING', started_at = ? WHERE execution_id = ?",
            (old_time, execution.execution_id),
        )
        store.conn.commit()
        
        stale = store.get_stale_executions(stale_timeout_seconds=300)
        assert len(stale) == 1
        assert stale[0].execution_id == execution.execution_id
    
