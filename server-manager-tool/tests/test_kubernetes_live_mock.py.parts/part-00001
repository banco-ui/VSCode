class MockK8sObject:
    """Minimal mock of a kubernetes.client model object.

    Real K8s API objects have openapi attributes and are converted by
    ApiClient.sanitize_for_serialization() to dicts. Our mock provides
    a to_dict() method that mimics that conversion, and also works
    with the adapter's fallback serializer.
    """

    def __init__(self, data: dict[str, Any]) -> None:
        self._data = data

    def to_dict(self) -> dict[str, Any]:
        return self._data

    def __getattr__(self, name: str) -> Any:
        if name.startswith("_"):
            raise AttributeError(name)
        return self._data.get(name)


class MockK8sListResponse:
    """Mock of K8s list response (V1NodeList, V1PodList, etc.).

    Real K8s list responses have an `items` attribute.
    """

    def __init__(self, items: list[MockK8sObject]) -> None:
        self.items = items

    def to_dict(self) -> dict[str, Any]:
        return {"items": [item.to_dict() for item in self.items]}


class MockVersionResponse:
    """Mock of K8s VersionApi response (VersionInfo)."""

    def __init__(self, git_version: str = "v1.28.0") -> None:
        self.git_version = git_version

    def to_dict(self) -> dict[str, Any]:
        return {"gitVersion": self.git_version}


