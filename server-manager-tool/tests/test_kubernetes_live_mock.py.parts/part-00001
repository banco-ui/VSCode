def make_full_mock_topology() -> MockCoreV1Api:
    """Build a mock client with a full multi-layer topology.

    Topology:
        Cluster (mock-cluster)
          └── Node (node-01)
               └── Pod (dmp-pod)
                    ├── Container (dmp)
                    └── Container (sidecar)
          └── Service (dmp-service)
          └── PV (dmp-pv)
          └── PVC (dmp-pvc)
          └── Namespace (ran)
    """
    return MockCoreV1Api(
        nodes=[make_mock_node("node-01")],
        pods=[make_mock_pod(
            name="dmp-pod", uid="uid-pod-dmp", namespace="ran",
            node_name="node-01",
            containers=[
                {"name": "dmp", "image": "dmp:1.0"},
                {"name": "sidecar", "image": "busybox:1.35"},
            ],
        )],
        namespaces=[make_mock_namespace("ran")],
        services=[make_mock_service("dmp-service")],
        persistent_volumes=[make_mock_pv("dmp-pv")],
        persistent_volume_claims=[make_mock_pvc("dmp-pvc")],
        version="v1.28.0",
    )


