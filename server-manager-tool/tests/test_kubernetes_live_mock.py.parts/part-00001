        mock = make_full_mock_topology()
        adapter = KubernetesProviderAdapter(client=mock)
        snapshot = adapter.collect()
        result = KubernetesProviderNormalizer().normalize(snapshot)
        assert isinstance(result, NormalizationResult)

    def test_mock_e2e_produces_expected_entities(self):
        mock = make_full_mock_topology()
        adapter = KubernetesProviderAdapter(client=mock)
        snapshot = adapter.collect()
        result = KubernetesProviderNormalizer().normalize(snapshot)
        assert len(result.platforms) == 1
        assert result.platforms[0].platform_type == PlatformType.KUBERNETES
        assert len(result.clusters) == 1
        assert len(result.nodes) == 1
        assert result.nodes[0].name == "node-01"
        # 1 Pod + 2 Containers = 3 EEs
        assert len(result.execution_environments) == 3
        assert len(result.networks) == 1
        assert result.networks[0].network_type == NetworkType.VIRTUAL
        assert len(result.storages) == 2

    def test_mock_e2e_no_physical_os_workload_accelerator(self):
        mock = make_full_mock_topology()
        adapter = KubernetesProviderAdapter(client=mock)
        snapshot = adapter.collect()
        result = KubernetesProviderNormalizer().normalize(snapshot)
        assert len(result.physicals) == 0
        assert len(result.os_entities) == 0
        assert len(result.workloads) == 0
        assert len(result.accelerators) == 0

    def test_mock_e2e_no_manual_translation(self):
        """Snapshot from mock goes directly to normalizer — no conversion."""
        mock = make_full_mock_topology()
        adapter = KubernetesProviderAdapter(client=mock)
        snapshot = adapter.collect()
        # Direct pass to normalizer — no intermediate manipulation
        result = KubernetesProviderNormalizer().normalize(snapshot)
        assert result.snapshot_id == snapshot.snapshot_id
        assert result.provider_type == snapshot.provider_type


