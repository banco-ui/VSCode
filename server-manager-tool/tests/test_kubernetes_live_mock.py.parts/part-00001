class MockCoreV1Api:
    """Mock CoreV1Api-compatible client for adapter injection.

    Implements only read-only list methods. No create/update/delete.
    Returns MockK8sListResponse objects with items.
    """

    def __init__(
        self,
        nodes: list[MockK8sObject] | None = None,
        pods: list[MockK8sObject] | None = None,
        namespaces: list[MockK8sObject] | None = None,
        services: list[MockK8sObject] | None = None,
        persistent_volumes: list[MockK8sObject] | None = None,
        persistent_volume_claims: list[MockK8sObject] | None = None,
        version: str = "v1.28.0",
    ) -> None:
        self._nodes = nodes or []
        self._pods = pods or []
        self._namespaces = namespaces or []
        self._services = services or []
        self._pvs = persistent_volumes or []
        self._pvcs = persistent_volume_claims or []
        self._version = version

    def get_api_version(self) -> MockVersionResponse:
        return MockVersionResponse(self._version)

    def list_namespace(self) -> MockK8sListResponse:
        return MockK8sListResponse(self._namespaces)

    def list_node(self) -> MockK8sListResponse:
        return MockK8sListResponse(self._nodes)

    def list_pod_for_all_namespaces(self) -> MockK8sListResponse:
        return MockK8sListResponse(self._pods)

    def list_service_for_all_namespaces(self) -> MockK8sListResponse:
        return MockK8sListResponse(self._services)

    def list_persistent_volume(self) -> MockK8sListResponse:
        return MockK8sListResponse(self._pvs)

    def list_persistent_volume_claim_for_all_namespaces(self) -> MockK8sListResponse:
        return MockK8sListResponse(self._pvcs)


