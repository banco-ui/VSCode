class TestPhase1RF4_1_SecurityRegression:
    """Phase 1-RF.4.1: CA bundle security regression tests."""

    def test_ca_bundle_parameter_exists(self):
        """P1-RF.4.1: ca_bundle parameter should exist."""
        import inspect
        sig = inspect.signature(RedfishCollector.__init__)
        assert "ca_bundle" in sig.parameters

    def test_ca_bundle_default_is_none(self):
        """P1-RF.4.1: ca_bundle should default to None."""
        coll = RedfishCollector(host="10.0.0.1", username="root", password="pass")
        assert coll.ca_bundle is None

    def test_ca_bundle_file_not_found_raises(self, tmp_path):
        """P1-RF.4.1: Non-existent CA bundle should raise FileNotFoundError."""
        coll = RedfishCollector(
            host="10.0.0.1",
            username="root",
            password="pass",
            ca_bundle=str(tmp_path / "nonexistent.pem"),
        )
        try:
            coll._get_once("/test")
            assert False, "Expected FileNotFoundError"
        except FileNotFoundError as e:
            assert "CA bundle not found" in str(e)

