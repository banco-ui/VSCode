    # ── P1 Regression Tests ──────────────────────────────────────────

    def test_credential_not_in_collector_output(self):
        """P1: Actual password value must not appear in collector output.

        Uses safe_collect() which is the public API for error-safe
        collection. The password should never be in the result's
        data, errors, or warnings.
        """
        secret = "SUPER_SECRET_TEST_PASSWORD_12345"
        coll = RedfishCollector(
            host="192.0.2.1",  # unreachable — will trigger error path
            port=443,
            username="admin",
            password=secret,
            timeout=1,
        )

        # safe_collect returns CollectionResult, never raises
        result = coll.safe_collect()

        # Password must not appear anywhere in the result
        all_result_strings = (
            " ".join(result.errors) + " " + " ".join(result.warnings)
        )
        assert secret not in all_result_strings
        assert secret not in str(result.data)
        assert secret not in repr(result)

    def test_credential_not_in_collector_attributes(self):
        """P1: Password must be stored as _password, not exposed."""
        secret = "SUPER_SECRET_TEST_PASSWORD_12345"
        coll = RedfishCollector(
            host="10.0.0.1",
            port=443,
            username="admin",
            password=secret,
        )

        # _password is the private attribute (acceptable)
        assert hasattr(coll, "_password")

        # But public attributes should not contain the raw password
        assert coll.username == "admin"
        # Verify no public attribute holds the raw secret
        for attr in dir(coll):
            if attr.startswith("_"):
                continue
            val = getattr(coll, attr, None)
            if isinstance(val, str) and val == secret:
                raise AssertionError(
                    f"Raw password found in public attribute: {attr}"
                )


