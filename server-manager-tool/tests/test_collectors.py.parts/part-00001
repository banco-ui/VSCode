        """P1-RF.4.1: Directory path should raise ValueError."""
        ca_dir = tmp_path / "ca_dir"
        ca_dir.mkdir()
        coll = RedfishCollector(
            host="10.0.0.1",
            username="root",
            password="pass",
            ca_bundle=str(ca_dir),
        )
        try:
            coll._get_once("/test")
            assert False, "Expected ValueError"
        except ValueError as e:
            assert "not a file" in str(e)

