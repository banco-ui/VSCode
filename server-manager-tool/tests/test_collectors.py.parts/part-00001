class TestPhase02_RetryLogic:
    """Phase 0.2: Limited retry on transient errors tests."""

    def test_retry_constants_defined(self):
        """P0.2: Retry constants should be defined."""
        from server_manager.collectors.redfish import (
            MAX_RETRIES,
            RETRY_BACKOFF_BASE,
            RETRY_BACKOFF_MAX,
            RETRYABLE_STATUS_CODES,
        )
        assert MAX_RETRIES == 3
        assert RETRY_BACKOFF_BASE == 1.0
        assert RETRY_BACKOFF_MAX == 10.0
        assert 500 in RETRYABLE_STATUS_CODES
        assert 503 in RETRYABLE_STATUS_CODES

    def test_get_with_retry_method_exists(self):
        """P0.2: _get_with_retry method should exist."""
        coll = RedfishCollector(host="10.0.0.1", username="root", password="pass")
        assert hasattr(coll, "_get_with_retry")
        assert callable(getattr(coll, "_get_with_retry"))

    def test_get_once_method_exists(self):
        """P0.2: _get_once method should exist for single attempt."""
        coll = RedfishCollector(host="10.0.0.1", username="root", password="pass")
        assert hasattr(coll, "_get_once")
        assert callable(getattr(coll, "_get_once"))

    def test_401_not_retried(self, monkeypatch):
        """P0.2: 401 authentication errors should not be retried."""
        import urllib.error
        call_count = [0]

        def mock_get_once(path):
            call_count[0] += 1
            raise urllib.error.HTTPError(
                url=f"http://test{path}",
                code=401,
                msg="Unauthorized",
                hdrs={},
                fp=None,
            )

        coll = RedfishCollector(host="10.0.0.1", username="root", password="pass")
        monkeypatch.setattr(coll, "_get_once", mock_get_once)
        result = coll._get_with_retry("/test")

        # Should only be called once (no retry)
        assert call_count[0] == 1
        assert result is None

    def test_503_is_retried(self, monkeypatch):
        """P0.2: 503 server errors should be retried."""
        import urllib.error
        call_count = [0]

        def mock_get_once(path):
            call_count[0] += 1
            if call_count[0] < 2:
                raise urllib.error.HTTPError(
                    url=f"http://test{path}",
                    code=503,
                    msg="Service Unavailable",
                    hdrs={},
                    fp=None,
                )
            return {"success": True}

        coll = RedfishCollector(host="10.0.0.1", username="root", password="pass")
        monkeypatch.setattr(coll, "_get_once", mock_get_once)
        result = coll._get_with_retry("/test")

        # Should be called twice (retry once)
        assert call_count[0] == 2
        assert result == {"success": True}


