    def _install_mock(self, coll, routes, call_log=None):
        """Install a route-based _get_once mock; unknown paths fail fast (404, no retry)."""
        import urllib.error

        def mock_get_once(path):
            if call_log is not None:
                call_log.append(path)
            if path in routes:
                resp = routes[path]
                if isinstance(resp, Exception):
                    raise resp
                return resp
            raise urllib.error.HTTPError(
                url=path, code=404, msg="Not Found", hdrs={}, fp=None
            )

        coll._get_once = mock_get_once

