class TestMutationSafety:
    """No mutation operations in health pipeline."""

    @staticmethod
    def _source_lines():
        import inspect
        from server_manager.health import service as health_mod
        return inspect.getsource(health_mod).split("\n")

    def test_no_create(self):
        for line in self._source_lines():
            s = line.strip()
            if s.startswith("#"): continue
            assert ".create_" not in s, f"create_ found: {s}"

    def test_no_update(self):
        for line in self._source_lines():
            s = line.strip()
            