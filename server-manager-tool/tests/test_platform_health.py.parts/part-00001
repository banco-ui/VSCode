        report = HealthService().assess(discovery)
        node_results = report.results_for_type("NODE")
        assert node_results[0].status == HealthStatus.UNHEALTHY

    def test_unknown_status(self):
        """Node with no conditions -> UNKNOWN."""
        fixture = make_full_fixture()
        fixture["nodes"] = [{"apiVersion": "v1", "kind": "Node",
            "metadata": {"name": "node-01", "uid": "uid-node-01"},
