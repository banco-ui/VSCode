    def test_kubernetes_pod_health(self):
        """K8s Pod health from status.phase."""
        discovery = discover_full()
        report = HealthService().assess(discovery)
        ee_results = report.results_for_type("EXECUTION_ENVIRONMENT")
        # At least one Pod (POD type)
        assert len(ee_results) >= 1
        # The pod with phase=Running and Ready=True -> HEALTHY
        healthy_ees = [r for r in ee_results if r.status == HealthStatus.HEALTHY]
        assert len(healthy_ees) >= 1

    def test_kubernetes_storage_health(self):
        """K8s PV/PVC health from status.phase."""
        discovery = discover_full()
        report = HealthService().assess(discovery)
        storage_results = report.results_for_type("STORAGE")
        assert len(storage_results) == 2  # PV + PVC
        # PV with phase=Bound -> HEALTHY
        healthy_storage = [r for r in storage_results
                           if r.status == HealthStatus.HEALTHY]
        assert len(healthy_storage) == 2

    def test_kubernetes_resource_mapping(self):
        """K8s resources are mapped to canonical entity health results."""
        discovery = discover_full()
        report = HealthService().assess(discovery)
        # Check all entity types are present
        entity_types = {r.entity_type for r in report.results}
        assert "NODE" in entity_types
        assert "EXECUTION_ENVIRONMENT" in entity_types
        assert "STORAGE" in entity_types
        assert "NETWORK" in entity_types
        assert "PLATFORM" in entity_types
        assert "CLUSTER" in entity_types


