def make_node(name, uid=None, ready="True", mem_pressure="False",
              disk_pressure="False", pid_pressure="False",
              net_unavailable="False", cpu_capacity="4",
              cpu_allocatable="3500m", mem_capacity="16777216Ki",
              mem_allocatable="15700000Ki"):
    return {"apiVersion": "v1", "kind": "Node",
            "metadata": {"name": name, "uid": uid or f"uid-node-{name}",
                         "labels": {"kubernetes.io/hostname": name}},
            "spec": {},
            "status": {"nodeInfo": {"kubeletVersion": "v1.28.0"},
                "conditions": [
                    {"type": "Ready", "status": ready},
                    {"type": "MemoryPressure", "status": mem_pressure},
                    {"type": "DiskPressure", "status": disk_pressure},
                    {"type": "PIDPressure", "status": pid_pressure},
                    {"type": "NetworkUnavailable", "status": net_unavailable}],
                "capacity": {"cpu": cpu_capacity, "memory": mem_capacity,
                             "pods": "110"},
                "allocatable": {"cpu": cpu_allocatable,
                                "memory": mem_allocatable, "pods": "110"}}}

def make_pod(name, uid=None, namespace="default", node_name=None,
             phase="Running", ready="True", containers=None):
    spec = {}
    if node_name: spec["nodeName"] = node_name
    spec["containers"] = containers or [{"name": "main", "image": "nginx:1.21",
                                          "resources": {}}]
    return {"apiVersion": "v1", "kind": "Pod",
            "metadata": {"name": name, "uid": uid or f"uid-pod-{name}",
                         "namespace": namespace},
            "spec": spec,
            "status": {"phase": phase,
                "conditions": [{"type": "Ready", "status": ready},
                    {"type": "Initialized", "status": "True"},
                    {"type": "PodScheduled", "status": "True"}]}}

def make_pv(name, uid=None, phase="Bound", capacity="10Gi"):
    return {"apiVersion": "v1", "kind": "PersistentVolume",
            "metadata": {"name": name, "uid": uid or f"uid-pv-{name}"},
            "spec": {"capacity": {"storage": capacity}},
            "status": {"phase": phase}}

def make_pvc(name, uid=None, phase="Bound"):
    return {"apiVersion": "v1", "kind": "PersistentVolumeClaim",
            "metadata": {"name": name, "uid": uid or f"uid-pvc-{name}",
                         "namespace": "default"},
            "spec": {"resources": {"requests": {"storage": "5Gi"}}},
            "status": {"phase": phase}}

def make_service(name, uid=None):
    return {"apiVersion": "v1", "kind": "Service",
            "metadata": {"name": name, "uid": uid or f"uid-svc-{name}",
                         "namespace": "default"},
            "spec": {"type": "ClusterIP", "clusterIP": "10.96.0.1"}}

def make_full_fixture():
    return {"cluster": {"name": "cluster-01", "uid": "uid-cluster-01",
                        "version": "1.28.0"},
            "nodes": [make_node("node-01")],
            "namespaces": [],
            "pods": [make_pod(name="uadpf-dmp-xxxxx", uid="uid-pod-uadpf-dmp",
                             namespace="ran", node_name="node-01",
                             containers=[{"name": "dmp", "image": "dmp:1.0",
                                          "resources": {}},
                                         {"name": "sidecar", "image": "busybox:1.35",
                                          "resources": {}}])],
            "deployments": [], "statefulsets": [], "daemonsets": [],
            "services": [make_service("uadpf-service")],
            "persistent_volumes": [make_pv("uadpf-pv")],
            "persistent_volume_claims": [make_pvc("uadpf-pvc")]}

def discover_full():
    adapter = KubernetesProviderAdapter(fixture=make_full_fixture())
    normalizer = KubernetesProviderNormalizer()
    return PlatformDiscovery().discover(adapter, normalizer)


