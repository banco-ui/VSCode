class TestCapacity:
    """Capacity extraction and preservation."""

    def test_capacity_preserved(self):
        """Capacity values preserve source units (no conversion)."""
        discovery = discover_full()
        report = HealthService().assess(discovery)
        node_results = report.results_for_type("NODE")
        cpu_caps = [c for c in node_results[0].capacity_infos
                    if c.resource_type == ResourceType.CPU]
        assert len(cpu_caps) == 1
        assert cpu_caps[0].capacity == "4"
        assert cpu_caps[0].allocatable == "3500m"
        assert cpu_caps[0].unit == "cores"

    def test_missing_capacity_is_unknown(self):
        """Node with no capacity -> no capacity info."""
        fixture = make_full_fixture()
        fixture["nodes"] = [{"apiVersion": "v1", "kind": "Node",
            "metadata": {"name": "node-01", "uid": "uid-node-01"},
            "spec": {}, "status": {"nodeInfo": {"kubeletVersion": "v1.28.0"},
                "conditions": [{"type": "Ready", "status": "True"}]}}]
        adapter = KubernetesProviderAdapter(fixture=fixture)
        normalizer = KubernetesProviderNormalizer()
        discovery = PlatformDiscovery().discover(adapter, normalizer)
        report = HealthService().assess(discovery)
        node_results = report.results_for_type("NODE")
        assert len(node_results[0].capacity_infos) == 0

    def test_no_fake_capacity(self):
        """No derived capacity (CPU threads != capacity, GPU != 100%)."""
        discovery = discover_full()
        report = HealthService().assess(discovery)
        for result in report.results:
            for cap in result.capacity_infos:
                # Capacity must come from source evidence, not inference
                assert cap.source_evidence is not None
                # Capacity values are strings from source, not computed
                assert isinstance(cap.capacity, (str, type(None)))
                assert isinstance(cap.allocatable, (str, type(None)))


