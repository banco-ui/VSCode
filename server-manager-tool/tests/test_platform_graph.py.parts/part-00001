class TestIdentity:
    """Graph node identity = canonical_id."""

    def test_graph_node_uses_canonical_id(self):
        """GraphNode.canonical_id matches entity canonical_id."""
        report = build_full_graph()
        discovery = discover_full()
        inventory = discovery.inventory
        entity_ids: set[str] = set()
        for el in [inventory.physicals, inventory.os_entities,
                   inventory.platforms, inventory.clusters,
                   inventory.nodes, inventory.execution_environments,
                   inventory.workloads, inventory.networks,
                   inventory.storages, inventory.accelerators]:
            for entity in el:
                entity_ids.add(entity.canonical_id)
        graph_ids = {n.canonical_id for n in report.nodes}
        assert graph_ids == entity_ids

    def test_graph_identity_stability(self):
        """Building the graph twice produces identical node and edge sets."""
        report1 = build_full_graph()
        report2 = build_full_graph()
        ids1 = {n.canonical_id for n in report1.nodes}
        ids2 = {n.canonical_id for n in report2.nodes}
        assert ids1 == ids2
        edges1 = {e.edge_key for e in report1.relationships}
        edges2 = {e.edge_key for e in report2.relationships}
        assert edges1 == edges2


