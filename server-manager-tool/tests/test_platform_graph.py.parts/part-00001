class TestRelationshipValidation:
    """Edge validation: missing endpoints, dedup, evidence types."""

    def test_missing_source_does_not_create_edge(self):
        """Edge with missing source node triggers validation error."""
        report = build_full_graph()
        bad_edge = GraphRelationship(
            source_id="nonexistent-source",
            target_id=report.nodes[0].canonical_id,
            relationship_type=RelationshipType.RUNS_ON,
        )
        report.relationships.append(bad_edge)
        GraphBuilder._validate(report, report.node_ids)
        assert any("nonexistent-source" in e for e in report.validation_errors)

    def test_missing_target_does_not_create_edge(self):
        """Edge with missing target node triggers validation error."""
        report = build_full_graph()
        bad_edge = GraphRelationship(
            source_id=report.nodes[0].canonical_id,
            target_id="nonexistent-target",
            relationship_type=RelationshipType.RUNS_ON,
        )
        report.relationships.append(bad_edge)
        GraphBuilder._validate(report, report.node_ids)
        assert any("nonexistent-target" in e for e in report.validation_errors)

    def test_duplicate_edge_is_deduplicated(self):
        """Same (source, target, type) appears once; DIRECT preferred."""
        edge1 = GraphRelationship(
            source_id="a", target_id="b",
            relationship_type=RelationshipType.RUNS_ON,
            evidence_type=RelationshipEvidenceType.DERIVED,
        )
        edge2 = GraphRelationship(
            source_id="a", target_id="b",
            relationship_type=RelationshipType.RUNS_ON,
            evidence_type=RelationshipEvidenceType.DIRECT,
        )
        result = GraphBuilder._deduplicate_edges([edge1, edge2])
        assert len(result) == 1
        assert result[0].evidence_type == RelationshipEvidenceType.DIRECT

    def test_inferred_relationship_rejected(self):
        """INFERRED evidence type does not exist in enum."""
        valid_types = {RelationshipEvidenceType.DIRECT, RelationshipEvidenceType.DERIVED}
        assert not hasattr(RelationshipEvidenceType, "INFERRED")
        report = build_full_graph()
        for edge in report.relationships:
            assert edge.evidence_type in valid_types

    def test_unknown_relationship_rejected(self):
        """UNKNOWN evidence type does not exist in enum."""
        assert not hasattr(RelationshipEvidenceType, "UNKNOWN")
        report = build_full_graph()
        for edge in report.relationships:
            assert isinstance(edge.relationship_type, RelationshipType)



