def make_empty_fixture():
    """Cluster only, no resources."""
    return {"cluster": {"name": "empty-cluster", "uid": "uid-empty", "version": "1.27.0"}}


def discover_full():
    adapter = KubernetesProviderAdapter(fixture=make_full_fixture())
    normalizer = KubernetesProviderNormalizer()
    return PlatformDiscovery().discover(adapter, normalizer)


def discover_empty():
    adapter = KubernetesProviderAdapter(fixture=make_empty_fixture())
    normalizer = KubernetesProviderNormalizer()
    return PlatformDiscovery().discover(adapter, normalizer)


def build_full_graph():
    return GraphBuilder().build(discover_full())


