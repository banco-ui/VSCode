class TestTraversal:
    """Read-only graph traversal/query."""

    def test_get_node(self):
        """get_node returns the correct GraphNode."""
        report = build_full_graph()
        query = GraphQuery(report)
        node = report.nodes[0]
        result = query.get_node(node.canonical_id)
        assert result is not None
        assert result.canonical_id == node.canonical_id
        assert result.entity_type == node.entity_type

    def test_get_node_not_found(self):
        """get_node returns None for non-existent ID."""
        report = build_full_graph()
        query = GraphQuery(report)
        assert query.get_node("does-not-exist") is None

    def test_get_relationships(self):
        """get_relationships returns edges in both directions."""
        report = build_full_graph()
        query = GraphQuery(report)
        # Node should have MEMBER_OF relationship to Cluster
        nodes = [n for n in report.nodes if n.entity_type == EntityType.NODE]
        node_id = nodes[0].canonical_id
        rels = query.get_relationships(node_id)
        assert len(rels) > 0
        # At least one MEMBER_OF edge
        member_of_rels = [r for r in rels if r.relationship_type == RelationshipType.MEMBER_OF]
        assert len(member_of_rels) > 0

    def test_get_neighbors(self):
        """get_neighbors returns connected node IDs."""
        report = build_full_graph()
        query = GraphQuery(report)
        nodes = [n for n in report.nodes if n.entity_type == EntityType.NODE]
        node_id = nodes[0].canonical_id
        neighbors = query.get_neighbors(node_id)
        # Node should be connected to Cluster (MEMBER_OF)
        clusters = [n for n in report.nodes if n.entity_type == EntityType.CLUSTER]
        assert clusters[0].canonical_id in neighbors

    def test_reverse_neighbor_lookup(self):
        """Reverse traversal: find Pod from Node (Pod → Node stored edge)."""
        report = build_full_graph()
        query = GraphQuery(report)
        # Find the Node
        nodes = [n for n in report.nodes if n.entity_type == EntityType.NODE]
        node_id = nodes[0].canonical_id
        # Find the Pod EE from inventory
        discovery = discover_full()
        pod_ees = [
            ee for ee in discovery.inventory.execution_environments
            if ee.ee_type.value == "POD"
        ]
        assert len(pod_ees) == 1
        pod_id = pod_ees[0].canonical_id
        # Node should have Pod as a neighbor (reverse of Pod → Node RUNS_ON)
        neighbors = query.get_neighbors(node_id)
        assert pod_id in neighbors


