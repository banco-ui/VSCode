class TestKubernetesGraph:
    """Kubernetes-specific graph validation."""

    def test_kubernetes_cluster_node_graph(self):
        """Cluster → Node MEMBER_OF edge exists."""
        report = build_full_graph()
        query = GraphQuery(report)
        clusters = [n for n in report.nodes if n.entity_type == EntityType.CLUSTER]
        nodes = [n for n in report.nodes if n.entity_type == EntityType.NODE]
        assert len(clusters) == 1
        assert len(nodes) == 1
        # Node → Cluster (MEMBER_OF)
        rels = query.get_related_entities(nodes[0].canonical_id, RelationshipType.MEMBER_OF)
        assert clusters[0].canonical_id in rels

    def test_kubernetes_pod_node_direct_edge(self):
        """Pod → Node RUNS_ON edge with DIRECT evidence."""
        report = build_full_graph()
        query = GraphQuery(report)
        # Get Pod EE (ee_type=POD) from inventory
        discovery = discover_full()
        pod_ees = [
            ee for ee in discovery.inventory.execution_environments
            if ee.ee_type.value == "POD"
        ]
        assert len(pod_ees) == 1
        pod_id = pod_ees[0].canonical_id
        nodes = [n for n in report.nodes if n.entity_type == EntityType.NODE]
        assert len(nodes) == 1
        # Pod → Node (RUNS_ON)
        runs_on = query.get_related_entities(pod_id, RelationshipType.RUNS_ON)
        assert nodes[0].canonical_id in runs_on
        # Verify DIRECT evidence (from RawRelationshipEvidence)
        for edge in report.relationships:
            if (edge.source_id == pod_id
                    and edge.target_id == nodes[0].canonical_id
                    and edge.relationship_type == RelationshipType.RUNS_ON):
                assert edge.evidence_type == RelationshipEvidenceType.DIRECT
                return
        pytest.fail("No RUNS_ON DIRECT edge from Pod to Node")

    def test_kubernetes_pod_container_derived_edge(self):
        """Pod → Container CONTAINS edge with DERIVED evidence."""
        report = build_full_graph()
        query = GraphQuery(report)
        # Get Pod and Container EEs from inventory
        discovery = discover_full()
        pod_ees = [
            ee for ee in discovery.inventory.execution_environments
            if ee.ee_type.value == "POD"
        ]
        container_ees = [
            ee for ee in discovery.inventory.execution_environments
            if ee.ee_type.value == "CONTAINER"
        ]
        assert len(pod_ees) == 1
        assert len(container_ees) == 2
        pod_id = pod_ees[0].canonical_id
        # Pod → Container (CONTAINS)
        contains = query.get_related_entities(pod_id, RelationshipType.CONTAINS)
        for c in container_ees:
            assert c.canonical_id in contains
        # Verify DERIVED evidence
        for edge in report.relationships:
            if (edge.source_id == pod_id
                    and edge.relationship_type == RelationshipType.CONTAINS):
                assert edge.evidence_type == RelationshipEvidenceType.DERIVED

    def test_kubernetes_service_network_edge(self):
        """Service (Network entity) exists as node; no inferred edges."""
        report = build_full_graph()
        networks = [n for n in report.nodes if n.entity_type == EntityType.NETWORK]
        assert len(networks) == 1
        # Network should be an orphan node (no relationship evidence)
        # connecting it to other entities — no inference.
        query = GraphQuery(report)
        neighbors = query.get_neighbors(networks[0].canonical_id)
        # No inferred edges to Network
        assert len(neighbors) == 0

    def test_kubernetes_storage_edge(self):
        """PV/PVC (Storage entities) exist as nodes; no inferred edges."""
        report = build_full_graph()
        storages = [n for n in report.nodes if n.entity_type == EntityType.STORAGE]
        assert len(storages) == 2  # 1 PV + 1 PVC
        # Storage entities should be orphan nodes — no inference.
        query = GraphQuery(report)
        for s in storages:
            neighbors = query.get_neighbors(s.canonical_id)
            assert len(neighbors) == 0


