class TestGraphConstruction:
    """Graph building from CanonicalInventory."""

    def test_graph_build_empty(self):
        """Empty inventory (cluster only) produces nodes + structural edge."""
        report = GraphBuilder().build(discover_empty())
        assert report.is_valid
        # Cluster-only fixture: 1 Platform + 1 Cluster = 2 nodes
        assert report.node_count == 2
        # Cluster.platform_ref → MEMBER_OF Platform (1 structural edge)
        assert report.relationship_count == 1

    def test_graph_build_nodes(self):
        """Full fixture produces correct node count and types."""
        report = build_full_graph()
        assert report.is_valid
        # 1 Platform + 1 Cluster + 1 Node + 3 EE (1 Pod + 2 Container)
        # + 1 Network + 2 Storage = 9 nodes
        assert report.node_count == 9
        types = {n.entity_type for n in report.nodes}
        assert EntityType.PLATFORM in types
        assert EntityType.CLUSTER in types
        assert EntityType.NODE in types
        assert EntityType.EXECUTION_ENVIRONMENT in types
        assert EntityType.NETWORK in types
        assert EntityType.STORAGE in types

    def test_graph_build_relationships(self):
        """Full fixture produces edges with valid evidence types."""
        report = build_full_graph()
        assert report.is_valid
        assert report.relationship_count > 0
        for edge in report.relationships:
            assert edge.evidence_type in (
                RelationshipEvidenceType.DIRECT,
                RelationshipEvidenceType.DERIVED,
            )

    def test_graph_build_complete_inventory(self):
        """Full K8s fixture: Cluster → Node → Pod → Container chain."""
        report = build_full_graph()
        assert report.is_valid
        query = GraphQuery(report)

        platforms = [n for n in report.nodes if n.entity_type == EntityType.PLATFORM]
        assert len(platforms) == 1
        platform_id = platforms[0].canonical_id

        clusters = [n for n in report.nodes if n.entity_type == EntityType.CLUSTER]
        assert len(clusters) == 1
        cluster_id = clusters[0].canonical_id

        # Cluster → Platform (MEMBER_OF)
        platform_rels = query.get_related_entities(cluster_id, RelationshipType.MEMBER_OF)
        assert platform_id in platform_rels

        nodes = [n for n in report.nodes if n.entity_type == EntityType.NODE]
        assert len(nodes) == 1
        node_id = nodes[0].canonical_id

        # Node → Cluster (MEMBER_OF)
        cluster_rels = query.get_related_entities(node_id, RelationshipType.MEMBER_OF)
        assert cluster_id in cluster_rels



