def _make_orchestration_result(
    server_id: str = "r750-001",
    status: OrchestrationStatus = OrchestrationStatus.SUCCESS,
    with_inventory: bool = True,
    with_verification: bool = True,
) -> OrchestrationResult:
    """Create a mock OrchestrationResult."""
    now = datetime.now(timezone.utc).isoformat()

    source_results = [
        SourceResult(
            source="redfish",
            collection_success=True,
            normalization_success=True,
            duration_ms=3500,
        ),
        SourceResult(
            source="ssh",
            collection_success=True,
            normalization_success=True,
            duration_ms=1500,
        ),
    ]

    verification = None
    if with_verification:
        verification = VerificationResult(
            field_results=[],
            summary={"total_fields": 15, "verified": 13, "single_source": 2, "discrepancy": 0},
        )

    return OrchestrationResult(
        run_id="run-test1234",
        server_id=server_id,
        status=status,
        source_results=source_results,
        canonical_inventory=_make_inventory(server_id) if with_inventory else None,
        canonical_source="redfish" if with_inventory else None,
        verification=verification,
        verification_success=verification is not None,
        started_at=now,
        completed_at=now,
        total_duration_ms=5000,
        errors=[],
        warnings=[],
    )


@pytest.fixture
def app_and_store():
    """Create app with in-memory store and mock orchestrator.
    
    Uses check_same_thread=False for SQLite to work with FastAPI's thread pool.
    """
    import sqlite3
    
    # Create connection with check_same_thread=False
    conn = sqlite3.connect(":memory:", check_same_thread=False)
    conn.row_factory = sqlite3.Row
    
    # Create store and set connection directly
    store = InventoryStore.__new__(InventoryStore)
    store.db_path = ":memory:"
    store._conn = conn
    
    # Initialize schema
    from server_manager.store.store import SCHEMA_SQL
    conn.executescript(SCHEMA_SQL)
    conn.commit()

    # Register a test server
    entry = ServerRegistryEntry(
        server_id="r750-001",
        display_name="Server 001",
        vendor=Vendor.Dell,
        model="PowerEdge R750",
        lifecycle_state=ServerLifecycle.ACTIVE,
        registered_at=datetime.now(timezone.utc).isoformat(),
    )
    store.register_server(entry)

    # Mock orchestrator factory
    mock_result = _make_orchestration_result()

    class MockOrchestrator:
        def run(self, server_id, collectors=None, normalizers=None):
            if server_id == "r750-001":
                return mock_result
            raise ValueError(f"Unknown server: {server_id}")

    deps.configure(
        store=store,
        orchestrator_factory=lambda: MockOrchestrator(),
    )

    app = create_app()
    client = TestClient(app, raise_server_exceptions=False)

    yield client, store, mock_result

    conn.close()


# ── Application tests ─────────────────────────────────────────────────

class TestApp:
    def test_app_import(self):
        from server_manager.api.app import create_app
        app = create_app()
        assert app.title == "Server Manager REST API"

    def test_app_has_routes(self):
        from server_manager.api.app import create_app
        app = create_app()
        # Verify app has routes (FastAPI/Starlette structure)
        assert len(app.routes) > 0
        # Check OpenAPI routes exist (indirect proof that API is configured)
        paths = [getattr(r, 'path', '') for r in app.routes if hasattr(r, 'path')]
        assert '/docs' in paths  # Swagger UI
        assert '/redoc' in paths  # ReDoc
        assert '/openapi.json' in paths  # OpenAPI spec

    def test_openapi_docs_available(self, app_and_store):
        client, _, _ = app_and_store
        resp = client.get("/docs")
        assert resp.status_code == 200


# ── POST /api/v1/collect ──────────────────────────────────────────────

class TestCollect:
    def test_collect_success(self, app_and_store):
        client, _, mock_result = app_and_store
        resp = client.post("/api/v1/collect", json={"server_id": "r750-001"})
        assert resp.status_code == 200
        data = resp.json()
        assert data["run_id"] == "run-test1234"
        assert data["server_id"] == "r750-001"
        assert data["status"] == "SUCCESS"
        assert data["canonical_source"] == "redfish"
        assert data["snapshot_id"] == "snap-run-test1234"
        assert len(data["source_results"]) == 2
        assert data["source_results"][0]["source"] == "redfish"
        assert data["verification"]["performed"] is True
        assert data["verification"]["success"] is True

    def test_collect_unknown_server_404(self, app_and_store):
        client, _, _ = app_and_store
        resp = client.post("/api/v1/collect", json={"server_id": "unknown-001"})
        assert resp.status_code == 404
        data = resp.json()
        assert data["error"]["code"] == "NOT_FOUND"

    def test_collect_missing_server_id_422(self, app_and_store):
        client, _, _ = app_and_store
        resp = client.post("/api/v1/collect", json={})
        assert resp.status_code == 422

    def test_collect_credential_not_in_response(self, app_and_store):
        client, _, _ = app_and_store
        resp = client.post("/api/v1/collect", json={"server_id": "r750-001"})
        data = resp.json()
        # No credential fields should appear
        text = str(data)
        assert "password" not in text.lower()
        assert "api_key" not in text.lower()
        assert "private_key" not in text.lower()

    def test_collect_no_credential_accepted(self, app_and_store):
        """Ensure API does not accept credential fields in request."""
        client, _, _ = app_and_store
        resp = client.post("/api/v1/collect", json={
            "server_id": "r750-001",
            "password": "should_be_ignored",
        })
        # Pydantic should accept extra fields (or ignore them)
        # The key test: password is not used
        assert resp.status_code in (200, 422)


