        resp = client.get("/api/v1/compute/candidates")
        assert resp.status_code == 200
        data = resp.json()
        assert data["total"] == 0

    def test_get_candidates_excludes_non_active(self, app_and_store):
        """EXCLUDED_USER_WORKLOAD should not appear in candidates."""
        client, store, _ = app_and_store
        client.post("/api/v1/collect", json={"server_id": "r750-001"})

        resp = client.get("/api/v1/compute/candidates")
        data = resp.json()
        # r750-001 has COMPUTE_ELIGIBLE → should be in candidates
        candidate_ids = [c["server_id"] for c in data["candidates"]]
