#  G5-11 UNKNOWN ENUM POLICY
# ════════════════════════════════════════════════════════════════════════

class TestUnknownEnumPolicy:
    """G5-11: Unknown enum → None + WARNING (no semantic guess).

    Tests use GenericProviderNormalizer directly because the K8s normalizer
    transforms the K8s payload to generic format, hard-coding enum values
    (POD, CONTAINER, KUBERNETES). Unknown enum handling is a property of
    the generic normalizer's _map_enum method, inherited by K8s normalizer.
    """

    def test_unknown_ee_type_produces_warning_and_default(self):
        from server_manager.normalizers.provider_normalizer import GenericProviderNormalizer
        snap = RawProviderSnapshot(
            snapshot_id="snap-enum-test", provider_type=ProviderType.KUBERNETES,
            collection_status=OrchestrationStatus.SUCCESS,
            payload={"execution_environments": [
                {"provider_id": "ee-unknown-1", "ee_type": "FOO_PLATFORM", "name": "test-ee"}]})
        r = GenericProviderNormalizer(ProviderType.KUBERNETES).normalize(snap)
        assert len(r.warnings) > 0
        assert any("FOO_PLATFORM" in w or "ee_type" in w for w in r.warnings)
        assert len(r.execution_environments) == 1
        assert r.execution_environments[0].ee_type == ExecutionEnvironmentType.UNKNOWN

    def test_no_semantic_fallback_to_kubernetes(self):
        from server_manager.normalizers.provider_normalizer import GenericProviderNormalizer
        snap = RawProviderSnapshot(
            snapshot_id="snap-no-fallback", provider_type=ProviderType.KUBERNETES,
            collection_status=OrchestrationStatus.SUCCESS,
            payload={"platforms": [{"provider_id": "p-unknown", "platform_type": "foo-platform"}]})
        r = GenericProviderNormalizer(ProviderType.KUBERNETES).normalize(snap)
        assert r.platforms[0].platform_type != PlatformType.KUBERNETES
        assert r.platforms[0].platform_type == PlatformType.UNKNOWN


