class TestIdentityStability:
    """G5-08: Canonical IDs are deterministic across normalizations."""

    def test_same_fixture_same_canonical_ids(self):
        fixture = make_full_topology_fixture()
        r1 = KubernetesProviderNormalizer().normalize(KubernetesProviderAdapter(fixture=fixture).collect())
        r2 = KubernetesProviderNormalizer().normalize(KubernetesProviderAdapter(fixture=fixture).collect())
        ids1 = {n.canonical_id for n in r1.nodes}
        ids2 = {n.canonical_id for n in r2.nodes}
        assert ids1 == ids2
        ee_ids1 = {ee.canonical_id for ee in r1.execution_environments}
        ee_ids2 = {ee.canonical_id for ee in r2.execution_environments}
        assert ee_ids1 == ee_ids2

    def test_canonical_id_differs_from_provider_id(self):
        r = KubernetesProviderNormalizer().normalize(
            KubernetesProviderAdapter(fixture=make_full_topology_fixture()).collect())
        all_entities = r.platforms + r.clusters + r.nodes + r.execution_environments + r.networks + r.storages
        for entity in all_entities:
            if entity.provider_id:
                assert entity.canonical_id != entity.provider_id

    def test_canonical_id_format(self):
        r = KubernetesProviderNormalizer().normalize(
            KubernetesProviderAdapter(fixture=make_full_topology_fixture()).collect())
        for node in r.nodes:
            assert node.canonical_id.startswith("canon-kubernetes-node-")

    def test_entity_counts_stable_across_runs(self):
        fixture = make_full_topology_fixture()
        r1 = KubernetesProviderNormalizer().normalize(KubernetesProviderAdapter(fixture=fixture).collect())
        r2 = KubernetesProviderNormalizer().normalize(KubernetesProviderAdapter(fixture=fixture).collect())
      