def make_node(name, uid=None):
    return {"apiVersion": "v1", "kind": "Node",
            "metadata": {"name": name, "uid": uid or f"uid-node-{name}",
                         "labels": {"kubernetes.io/hostname": name}},
            "spec": {}, "status": {"nodeInfo": {"kubeletVersion": "v1.28.0"}}}

def make_container(name, image="nginx:1.21"):
    return {"name": name, "image": image, "resources": {}}

def make_pod(name, uid=None, namespace="default", node_name=None, containers=None):
    spec: dict[str, Any] = {}
    if node_name: spec["nodeName"] = node_name
    spec["containers"] = containers or [make_container("main")]
    return {"apiVersion": "v1", "kind": "Pod",
            "metadata": {"name": name, "uid": uid or f"uid-pod-{name}", "namespace": namespace},
            "spec": spec, "status": {"phase": "Running"}}

def make_service(name, uid=None, svc_type="ClusterIP"):
    return {"apiVersion": "v1", "kind": "Service",
            "metadata": {"name": name, "uid": uid or f"uid-svc-{name}", "namespace": "default"},
            "spec": {"type": svc_type, "clusterIP": "10.96.0.1"}}

def make_pv(name, uid=None):
    return {"apiVersion": "v1", "kind": "PersistentVolume",
            "metadata": {"name": name, "uid": uid or f"uid-pv-{name}"},
            "spec": {"capacity": {"storage": "10Gi"}}}

def make_pvc(name, uid=None):
    return {"apiVersion": "v1", "kind": "PersistentVolumeClaim",
            "metadata": {"name": name, "uid": uid or f"uid-pvc-{name}", "namespace": "default"},
            "spec": {"resources": {"requests": {"storage": "5Gi"}}}}

def make_namespace(name):
    return {"apiVersion": "v1", "kind": "Namespace",
            "metadata": {"name": name, "uid": f"uid-ns-{name}"}}

def make_deployment(name):
    return {"apiVersion": "apps/v1", "kind": "Deployment",
            "metadata": {"name": name, "uid": f"uid-deploy-{name}"},
            "spec": {"replicas": 3}}

def make_full_topology_fixture():
    """Cluster → Node → Pod(dmp+sidecar) + Service + PV + PVC + Namespace + Deployment."""
    return {
        "cluster": {"name": "cluster-01", "uid": "uid-cluster-01", "version": "1.28.0"},
        "nodes": [make_node("node-01")],
        "namespaces": [make_namespace("ran")],
        "pods": [make_pod(
            name="uadpf-dmp-xxxxx", uid="uid-pod-uadpf-dmp", namespace="ran",
            node_name="node-01",
            containers=[make_container("dmp", "dmp:1.0"), make_container("sidecar", "busybox:1.35")])],
        "deployments": [make_deployment("uadpf-deploy")],
        "statefulsets": [], "daemonsets": [],
        "services": [make_service("uadpf-service")],
        "persistent_volumes": [make_pv("uadpf-pv")],
        "persistent_volume_claims": [make_pvc("uadpf-pvc")],
    }

def make_partial_fixture():
    """Fixture with 403 on services — services list emptied (no data collected)."""
    f = make_full_topology_fixture()
    f["errors"] = {"services": "403 Forbidden: permission denied for services"}
