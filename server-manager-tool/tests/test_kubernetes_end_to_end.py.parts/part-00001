class TestEndToEnd:
    """G5-04: Full adapter → snapshot → normalizer path."""

    def test_full_e2e_produces_expected_entities(self):
        adapter = KubernetesProviderAdapter(provider_id="cluster-01", fixture=make_full_topology_fixture())
        result = KubernetesProviderNormalizer().normalize(adapter.collect())
        assert len(result.platforms) == 1
        assert result.platforms[0].platform_type == PlatformType.KUBERNETES
        assert len(result.clusters) == 1
        assert len(result.nodes) == 1 and result.nodes[0].name == "node-01"
        assert len(result.execution_environments) == 3
        ee_types = {ee.ee_type for ee in result.execution_environments}
        assert ExecutionEnvironmentType.POD in ee_types
        assert ExecutionEnvironmentType.CONTAINER in ee_types
        assert len(result.networks) == 1 and result.networks[0].network_type == NetworkType.VIRTUAL
        assert len(result.storages) == 2
        assert {s.storage_type for s in result.storages} == {StorageType.PV, StorageType.PVC}

    def test_full_e2e_no_physical_os_workload_accelerator(self):
        result = KubernetesProviderNormalizer().normalize(
            KubernetesProviderAdapter(fixture=make_full_topology_fixture()).collect())
        assert len(result.physicals) == 0
        assert len(result.os_entities) == 0
        assert len(result.workloads) == 0
        assert len(result.accelerators) == 0

    def test_full_e2e_status_is_success(self):
        result = KubernetesProviderNormalizer().normalize(
            KubernetesProviderAdapter(fixture=make_full_topology_fixture()).collect())
        assert result.status == OrchestrationStatus.SUCCESS
        assert len(result.errors) == 0


