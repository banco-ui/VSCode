class TestRepositoryAudit:
    """G5-01: Verify existing contracts are intact and reusable."""

    def test_kubernetes_adapter_exists(self):
        from server_manager.providers.base import ProviderAdapter
        assert issubclass(KubernetesProviderAdapter, ProviderAdapter)

    def test_kubernetes_normalizer_exists(self):
        from server_manager.normalizers.provider_normalizer import GenericProviderNormalizer
        assert issubclass(KubernetesProviderNormalizer, GenericProviderNormalizer)

    def test_raw_provider_snapshot_contract(self):
        snap = RawProviderSnapshot(snapshot_id="s", provider_type=ProviderType.KUBERNETES)
        assert snap.provider_type == ProviderType.KUBERNETES
        assert snap.collection_status == OrchestrationStatus.FAILED
        assert snap.payload == {} and snap.capability_results == []
        assert snap.relationship_evidence == [] and snap.errors == []

    def test_normalization_result_contract(self):
        r = NormalizationResult(snapshot_id="s", provider_type=ProviderType.KUBERNETES)
        assert r.physicals == [] and r.os_entities == [] and r.platforms == []
        assert r.clusters == [] and r.nodes == [] and r.execution_environments == []
        assert r.workloads == [] and r.networks == [] and r.storages == []
        assert r.accelerators == [] and r.relationship_evidence == []
        assert r.errors == [] and r.warnings == []

    def test_canonical_identity_generator_deterministic(self):
        id1 = CanonicalIdentityGenerator.generate(ProviderType.KUBERNETES, "node", "node-01")
        id2 = CanonicalIdentityGenerator.generate(ProviderType.KUBERNETES, "node", "node-01")
        assert id1 == id2 and id1 != "node-01"
        assert id1.startswith("canon-kubernetes-")


