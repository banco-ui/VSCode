class TestAdapterToSnapshot:
    """G5-02: KubernetesProviderAdapter produces a valid RawProviderSnapshot."""

    def test_collect_returns_raw_provider_snapshot(self):
        adapter = KubernetesProviderAdapter(
            provider_id="cluster-01", fixture=make_full_topology_fixture())
        snapshot = adapter.collect()
        assert isinstance(snapshot, RawProviderSnapshot)

    def test_snapshot_provider_type_is_kubernetes(self):
        adapter = KubernetesProviderAdapter(fixture=make_full_topology_fixture())
        snapshot = adapter.collect()
        assert snapshot.provider_type == ProviderType.KUBERNETES

    def test_snapshot_has_snapshot_id(self):
        adapter = KubernetesProviderAdapter(fixture=make_full_topology_fixture())
        snapshot = adapter.collect()
        assert snapshot.snapshot_id
        assert snapshot.snapshot_id.startswith("snap-k8s-")

    def test_snapshot_payload_preserves_raw_k8s_data(self):
        adapter = KubernetesProviderAdapter(fixture=make_full_topology_fixture())
        snapshot = adapter.collect()
        assert snapshot.payload["cluster"]["name"] == "cluster-01"
        assert len(snapshot.payload["nodes"]) == 1
        assert snapshot.payload["nodes"][0]["metadata"]["name"] == "node-01"
        assert len(snapshot.payload["pods"]) == 1
        assert snapshot.payload["pods"][0]["metadata"]["name"] == "uadpf-dmp-xxxxx"

    def test_snapshot_has_capability_results(self):
        adapter = KubernetesProviderAdapter(fixture=make_full_topology_fixture())
        snapshot = adapter.collect()
        assert len(snapshot.capability_results) > 0
        cap_types = {cr.capability for cr in snapshot.capability_results}
        assert AdapterCapability.PLATFORM in cap_types
        assert AdapterCapability.NODE in cap_types
        assert AdapterCapability.EXECUTION_ENVIRONMENT in cap_types

    def test_snapshot_collection_status_success(self):
        adapter = KubernetesProviderAdapter(fixture=make_full_topology_fixture())
        snapshot = adapter.collect()
        assert snapshot.collection_status == OrchestrationStatus.SUCCESS

    def test_snapshot_has_source_evidence(self):
        adapter = KubernetesProviderAdapter(
            provider_id="cluster-01", fixture=make_full_topology_fixture())
        snapshot = adapter.collect()
        assert snapshot.source_evidence is not None
        assert snapshot.source_evidence.provider_type == ProviderType.KUBERNETES
        assert snapshot.source_evidence.provider_id == "cluster-01"
        assert snapshot.source_evidence.raw_data_ref == snapshot.snapshot_id

    def test_snapshot_has_relationship_evidence(self):
        adapter = KubernetesProviderAdapter(fixture=make_full_topology_fixture())
        snapshot = adapter.collect()
        assert len(snapshot.relationship_evidence) > 0
        direct_ev = [e for e in snapshot.relationship_evidence
                     if e.evidence_type == RelationshipEvidenceType.DIRECT]
        derived_ev = [e for e in snapshot.relationship_evidence
                      if e.evidence_type == RelationshipEvidenceType.DERIVED]
        assert len(direct_ev) == 1
        assert direct_ev[0].relationship_type == "runs_on"
        assert direct_ev[0].target_entity_ref == "node-01"
        assert len(derived_ev) == 2
        assert all(e.relationship_type == "contains" for e in derived_ev)

    def test_capabilities_declared_match_implementation(self):
        adapter = KubernetesProviderAdapter(fixture={})
        caps = adapter.capabilities()
        for c in [AdapterCapability.PLATFORM, AdapterCapability.CLUSTER,
                  AdapterCapability.NODE, AdapterCapability.EXECUTION_ENVIRONMENT,
                  AdapterCapability.NETWORK, AdapterCapability.STORAGE]:
            assert c in caps
        for c in [AdapterCapability.ACCELERATOR, AdapterCapability.WORKLOAD,
                  AdapterCapability.RELATIONSHIP_DISCOVERY, AdapterCapability.METRICS]:
            assert c not in caps


