class TestRelationshipEvidence:
    """G5-06: Relationship evidence is preserved from snapshot to result."""

    def test_direct_evidence_preserved(self):
        r = KubernetesProviderNormalizer().normalize(
            KubernetesProviderAdapter(fixture=make_full_topology_fixture()).collect())
        direct = [e for e in r.relationship_evidence if e.evidence_type == RelationshipEvidenceType.DIRECT]
        assert len(direct) == 1 and direct[0].relationship_type == "runs_on"

    def test_derived_evidence_preserved(self):
        r = KubernetesProviderNormalizer().normalize(
            KubernetesProviderAdapter(fixture=make_full_topology_fixture()).collect())
        derived = [e for e in r.relationship_evidence if e.evidence_type == RelationshipEvidenceType.DERIVED]
        assert len(derived) == 2
        assert all(e.relationship_type == "contains" for e in derived)

    def test_no_inferred_evidence(self):
        r = KubernetesProviderNormalizer().normalize(
            KubernetesProviderAdapter(fixture=make_full_topology_fixture()).collect())
        for ev in r.relationship_evidence:
            assert ev.evidence_type != "INFERRED"
            assert ev.evidence_type != "UNKNOWN"

    def test_pod_without_node_name_has_no_direct_evidence(self):
        fixture = make_full_topology_fixture()
        fixture["pods"] = [make_pod(name="orphan-pod", uid="uid-pod-orphan", node_name=None,
                                    containers=[make_container("c1")])]
        snap = KubernetesProviderAdapter(fixture=fixture).collect()
        direct = [e for e in snap.relationship_evidence if e.evidence_type == RelationshipEvidenceType.DIRECT]
        assert len(direct) == 0
        derived = [e for e in snap.relationship_evidence if e.evidence_type == RelationshipEvidenceType.DERIVED]
        assert len(derived) == 1


