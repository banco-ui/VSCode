class TestDiscoverySuccess:
    """Discovery with full fixture → SUCCESS."""

    def test_discovery_success(self):
        adapter = KubernetesProviderAdapter(
            provider_id="cluster-01", fixture=make_full_fixture())
        normalizer = KubernetesProviderNormalizer()
        result = PlatformDiscovery().discover(adapter, normalizer)
        assert result.discovery_status == OrchestrationStatus.SUCCESS
        assert result.is_success
        assert result.provider_type == ProviderType.KUBERNETES
        assert result.inventory is not None
        assert result.entity_count > 0

    def test_discovery_returns_discovery_result(self):
        adapter = KubernetesProviderAdapter(fixture=make_full_fixture())
        normalizer = KubernetesProviderNormalizer()
        result = PlatformDiscovery().discover(adapter, normalizer)
        assert isinstance(result, DiscoveryResult)

    def test_discovery_snapshot_id_matches(self):
        adapter = KubernetesProviderAdapter(fixture=make_full_fixture())
        normalizer = KubernetesProviderNormalizer()
        result = PlatformDiscovery().discover(adapter, normalizer)
        assert result.snapshot_id


