    def test_no_kubernetes_mutation(self):
        """Adapter source contains no create/update/delete calls."""
        import inspect
        from server_manager.providers import kubernetes as k8s_mod
        source = inspect.getsource(k8s_mod)
        forbidden = ["create_", "update_", "delete_", "patch_",
                     "replace_", "scale", "rollout"]