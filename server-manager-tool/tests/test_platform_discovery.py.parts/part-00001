class TestDiscoveryFailed:
    """Discovery with connection failure → FAILED."""

    def test_discovery_failed_status(self):
        """All capabilities failed + no entities → FAILED."""
        # Use a mock snapshot with FAILED status and empty payload
        snapshot = RawProviderSnapshot(
            snapshot_id="snap-failed",
            provider_type=ProviderType.KUBERNETES,
            collection_status=OrchestrationStatus.FAILED,
            payload={},
        )
        adapter = KubernetesProviderAdapter(fixture={})
        adapter.collect = lambda **kw: snapshot
        normalizer = KubernetesProviderNormalizer()
        result = PlatformDiscovery().discover(adapter, normalizer)
        assert result.discovery_status == OrchestrationStatus.FAILED
        assert result.is_failed

    def test_failed_with_empty_inventory(self):
        """FAILED snapshot with no entities → empty inventory."""
        snapshot = RawProviderSnapshot(
            snapshot_id="snap-failed",
            provider_type=ProviderType.KUBERNETES,
            collection_status=OrchestrationStatus.FAILED,
            payload={},
        )
        adapter = KubernetesProviderAdapter(fixture={})
        adapter.collect = lambda **kw: snapshot
        normalizer = KubernetesProviderNormalizer()
        result = PlatformDiscovery().discover(adapter, normalizer)
        # Inventory may be non-None but empty, or None
        if result.inventory:
            assert result.inventory.entity_count == 0 or result.inventory.is_empty


class TestDiscoverySkipped:
    """Discovery when credentials unavailable → SKIPPED."""

    def test_skipped_status(self):
        """When snapshot status is SKIPPED, discovery returns SKIPPED."""
        snapshot = RawProviderSnapshot(
            snapshot_id="snap-skipped",
            provider_type=ProviderType.KUBERNETES,
            collection_status=OrchestrationStatus.SKIPPED,
        )
        adapter = KubernetesProviderAdapter(fixture={})
        # Override collect to return our skipped snapshot
        adapter.collect = lambda **kw: snapshot
        normalizer = KubernetesProviderNormalizer()
        result = PlatformDiscovery().discover(adapter, normalizer)
        assert result.discovery_status == OrchestrationStatus.SKIPPED
        assert result.is_skipped
        assert result.inventory is None

    def test_skipped_not_treated_as_success(self):
        """SKIPPED is never SUCCESS."""
        snapshot = RawProviderSnapshot(
            snapshot_id="snap-skipped",
            provider_type=ProviderType.KUBERNETES,
            collection_status=OrchestrationStatus.SKIPPED,
        )
        adapter = KubernetesProviderAdapter(fixture={})
        adapter.collect = lambda **kw: snapshot
        normalizer = KubernetesProviderNormalizer()
        result = PlatformDiscovery().discover(adapter, normalizer)
        assert not result.is_success


