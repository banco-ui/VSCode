class TestIdentityStability:
    """Same input → same canonical_id across repeated discovery."""

    def test_inventory_identity_stability(self):
        """Two discovery runs on identical fixture produce identical IDs."""
        fixture = make_full_fixture()
        adapter1 = KubernetesProviderAdapter(fixture=fixture)
        adapter2 = KubernetesProviderAdapter(fixture=fixture)
        normalizer = KubernetesProviderNormalizer()
        r1 = PlatformDiscovery().discover(adapter1, normalizer)
        r2 = PlatformDiscovery().discover(adapter2, normalizer)
        ids1 = {e.canonical_id for e in r1.inventory.nodes}
        ids2 = {e.canonical_id for e in r2.inventory.nodes}
        assert ids1 == ids2
        ee_ids1 = {e.canonical_id for e in r1.inventory.execution_environments}
        ee_ids2 = {e.canonical_id for e in r2.inventory.execution_environments}
        assert ee_ids1 == ee_ids2


