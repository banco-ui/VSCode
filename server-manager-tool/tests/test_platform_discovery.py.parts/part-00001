class TestProviderPath:
    """Fixture and mock paths produce valid discovery results."""

    def test_fixture_discovery_path(self):
        """Fixture path: adapter(fixture) → snapshot → normalizer → result."""
        adapter = KubernetesProviderAdapter(fixture=make_full_fixture())
        normalizer = KubernetesProviderNormalizer()
        result = PlatformDiscovery().discover(adapter, normalizer)
        assert result.is_success
        assert result.inventory.entity_count > 0

    def test_mock_discovery_path(self):
        """Mock path: adapter(client=mock) → snapshot → normalizer → result."""
        class MockK8sList:
            def __init__(self, items):
                self.items = items
            def to_dict(self):
                return {"items": [
                    item.to_dict() if hasattr(item, "to_dict") else item
                    for item in self.items
                ]}

        class MockNode:
            def __init__(self, name):
                self.name = name
                self.uid = f"uid-{name}"
            def to_dict(self):
                return {
                    "apiVersion": "v1", "kind": "Node",
                    "metadata": {"name": self.name, "uid": self.uid,
                                 "labels": {"kubernetes.io/hostname": self.name}},
                    "spec": {},
                    "status": {"nodeInfo": {"kubeletVersion": "v1.28.0"}},
                }

        class MockPod:
            def __init__(self, name, node_name="node-01"):
                self.name = name
                self.uid = f"uid-{name}"
                self.node_name = node_name
            def to_dict(self):
                return {
                    "apiVersion": "v1", "kind": "Pod",
                    "metadata": {"name": self.name, "uid": self.uid,
                                 "namespace": "default"},
                    "spec": {"nodeName": self.node_name,
                             "containers": [{"name": "main", "image": "nginx:1.21",
                                             "resources": {}}]},
                    "status": {"phase": "Running"},
                }

        class MockVersion:
            def to_dict(self):
                return {"gitVersion": "v1.28.0"}

        class MockClient:
            """Client with list methods directly on it (adapter calls client.list_*)."""
            def get_api_version(self, **kw):
                return MockVersion()
            def list_node(self, **kw):
                return MockK8sList([MockNode("node-01")])
            def list_pod_for_all_namespaces(self, **kw):
                return MockK8sList([MockPod("test-pod")])
            def list_namespace(self, **kw):
                return MockK8sList([])
            def list_service_for_all_namespaces(self, **kw):
                return MockK8sList([])
            def list_persistent_volume(self, **kw):
                return MockK8sList([])
            def list_persistent_volume_claim_for_all_namespaces(self, **kw):
                return MockK8sList([])

        adapter = KubernetesProviderAdapter(
            fixture={"cluster": {"name": "mock-cluster",
                                  "uid": "uid-mock", "version": "1.28.0"}},
            client=MockClient(),
        )
        normalizer = KubernetesProviderNormalizer()
        result = PlatformDiscovery().discover(adapter, normalizer)
        assert result.discovery_status == OrchestrationStatus.SUCCESS
        assert len(result.inventory.nodes) == 1
        assert len(result.inventory.execution_environments) >= 1


