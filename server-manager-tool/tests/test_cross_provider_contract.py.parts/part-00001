# === SECTION 1: EQUIVALENT ADAPTER CONTRACT BEHAVIOR ===


class TestAdapterContract:
    """Both providers must satisfy the same ProviderAdapter contract."""

    @pytest.mark.parametrize("provider_fn", _PROVIDERS, ids=_PROVIDER_IDS)
    def test_adapter_inherits_provider_adapter(self, provider_fn):
        adapter, _, _ = provider_fn()
        assert isinstance(adapter, ProviderAdapter)

    @pytest.mark.parametrize("provider_fn", _PROVIDERS, ids=_PROVIDER_IDS)
    def test_capabilities_returns_list(self, provider_fn):
        adapter, _, _ = provider_fn()
        caps = adapter.capabilities()
        assert isinstance(caps, list)
        assert len(caps) > 0
        for cap in caps:
            assert isinstance(cap, AdapterCapability)

    @pytest.mark.parametrize("provider_fn", _PROVIDERS, ids=_PROVIDER_IDS)
    def test_collect_returns_raw_snapshot(self, provider_fn):
        adapter, _, _ = provider_fn()
        snapshot = adapter.collect()
        assert isinstance(snapshot, RawProviderSnapshot)

    @pytest.mark.parametrize("provider_fn", _PROVIDERS, ids=_PROVIDER_IDS)
    def test_collect_safe_returns_snapshot(self, provider_fn):
        adapter, _, _ = provider_fn()
        snapshot = adapter.collect_safe()
        assert isinstance(snapshot, RawProviderSnapshot)

    @pytest.mark.parametrize("provider_fn", _PROVIDERS, ids=_PROVIDER_IDS)
    def test_snapshot_has_identity_fields(self, provider_fn):
        adapter, _, expected_type = provider_fn()
        snapshot = adapter.collect()
        assert snapshot.provider_type == expected_type
        assert snapshot.provider_id is not None
        assert snapshot.snapshot_id
        assert snapshot.collected_at
        assert snapshot.collection_status in (
            OrchestrationStatus.SUCCESS,
            OrchestrationStatus.PARTIAL,
        )

    @pytest.mark.parametrize("provider_fn", _PROVIDERS, ids=_PROVIDER_IDS)
    def test_declared_vs_capability_results(self, provider_fn):
        adapter, _, _ = provider_fn()
        snapshot = adapter.collect()
        declared = set(snapshot.declared_capabilities)
        result_caps = {cr.capability for cr in snapshot.capability_results}
        assert result_caps.issubset(declared)


# === SECTION 2: DETERMINISTIC CANONICAL IDS ===


class TestDeterministicIds:

    @pytest.mark.parametrize("provider_fn", _PROVIDERS, ids=_PROVIDER_IDS)
    def test_repeated_normalization_same_ids(self, provider_fn):
        adapter, normalizer, _ = provider_fn()
        snap1 = adapter.collect()
        snap2 = adapter.collect()
        r1 = normalizer.normalize(snap1)
        r2 = normalizer.normalize(snap2)
        ids1 = {e.canonical_id for e in r1.platforms + r1.nodes + r1.clusters}
        ids2 = {e.canonical_id for e in r2.platforms + r2.nodes + r2.clusters}
        assert ids1 == ids2

    @pytest.mark.parametrize("provider_fn", _PROVIDERS, ids=_PROVIDER_IDS)
    def test_canonical_id_differs_from_provider_id(self, provider_fn):
        adapter, normalizer, _ = provider_fn()
        snapshot = adapter.collect()
        result = normalizer.normalize(snapshot)
        all_entities = (
            result.platforms + result.clusters + result.nodes
            + result.execution_environments + result.networks + result.storages
        )
        for entity in all_entities:
            assert entity.canonical_id != entity.provider_id
            assert entity.canonical_id.startswith("canon-")

    def test_different_producers_different_ids(self):
        k8s_adapter = KubernetesProviderAdapter(
            fixture={"cluster": make_k8s_cluster_info(),
                     "nodes": [make_k8s_node("node-x", uid="uid-x")],
                     "pods": [], "services": [],
                     "persistent_volumes": [], "persistent_volume_claims": []},
            provider_id="p1")
        os_adapter = OpenStackProviderAdapter(
            fixture={"platform": {"name": "p1", "version": "X"},
                     "availability_zones": [],
                     "hypervisors": [make_os_hypervisor("node-x", hv_id=1)],
                     "servers": [], "networks": [], "volumes": []},
            provider_id="p1")
        k8s_snap = k8s_adapter.collect()
        os_snap = os_adapter.collect()
        k8s_result = KubernetesProviderNormalizer().normalize(k8s_snap)
        os_result = OpenStackProviderNormalizer().normalize(os_snap)
        k8s_ids = {n.canonical_id for n in k8s_result.nodes}
        os_ids = {n.canonical_id for n in os_result.nodes}
        assert k8s_ids != os_ids
        assert any("kubernetes" in nid for nid in k8s_ids)
        assert any("openstack" in nid for nid in os_ids)


