def make_k8s_node(name, uid=None, ready=True):
    conditions = [
        {"type": "Ready", "status": "True" if ready else "False"},
        {"type": "MemoryPressure", "status": "False"},
        {"type": "DiskPressure", "status": "False"},
        {"type": "PIDPressure", "status": "False"},
    ]
    return {
        "apiVersion": "v1", "kind": "Node",
        "metadata": {"name": name, "uid": uid or f"uid-node-{name}"},
        "spec": {},
        "status": {
            "capacity": {"cpu": "8", "memory": "16Gi", "pods": "110"},
            "allocatable": {"cpu": "7500m", "memory": "15Gi", "pods": "110"},
            "conditions": conditions,
        },
    }


def make_k8s_pod(name, uid=None, namespace="default", node_name=None,
                 containers=None, phase="Running"):
    spec = {}
    if node_name:
        spec["nodeName"] = node_name
    spec["containers"] = containers or [
        {"name": "main", "image": "nginx:1.21", "resources": {}}]
    return {
        "apiVersion": "v1", "kind": "Pod",
        "metadata": {
            "name": name, "uid": uid or f"uid-pod-{name}",
            "namespace": namespace},
        "spec": spec,
        "status": {"phase": phase,
                   "conditions": [{"type": "Ready", "status": "True"}]},
    }


