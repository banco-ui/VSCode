# === SECTION 7: FAILED DISCOVERY NO FAKE INVENTORY ===


class TestFailedDiscoveryNoFakeInventory:

    def test_k8s_collect_safe_with_exception(self):
        class FailingAdapter(KubernetesProviderAdapter):
            def collect(self, **kwargs):
                raise ConnectionError("cluster unreachable")
        adapter = FailingAdapter(provider_id="fail-k8s")
        snap = adapter.collect_safe()
        assert snap.collection_status == OrchestrationStatus.FAILED
        assert len(snap.errors) > 0

    def test_openstack_collect_safe_with_exception(self):
        class FailingAdapter(OpenStackProviderAdapter):
            def collect(self, **kwargs):
                raise ConnectionError("cloud unreachable")
        adapter = FailingAdapter(provider_id="fail-os")
        snap = adapter.collect_safe()
        assert snap.collection_status == OrchestrationStatus.FAILED
        assert len(snap.errors) > 0

    @pytest.mark.parametrize("provider_fn", _PROVIDERS, ids=_PROVIDER_IDS)
    def test_failed_discovery_no_inventory(self, provider_fn):
        class FailingAdapter(ProviderAdapter):
            def __init__(self, pt):
                super().__init__(pt, "failing")
            def capabilities(self):
                return [AdapterCapability.PLATFORM]
            def collect(self, **kwargs):
                return RawProviderSnapshot(
                    snapshot_id="snap-fail",
                    provider_type=self._provider_type,
                    provider_id="failing",
                    collection_status=OrchestrationStatus.FAILED,
                    errors=["connection refused"],
                )
        adapter, normalizer, pt = provider_fn()
        failing = FailingAdapter(pt)
        discovery = PlatformDiscovery().discover(failing, normalizer)
        assert discovery.is_failed
        assert discovery.inventory is None
        assert discovery.entity_count == 0

    @pytest.mark.parametrize("provider_fn", _PROVIDERS, ids=_PROVIDER_IDS)
    def test_failed_discovery_no_entities(self, provider_fn):
        class FailingAdapter(ProviderAdapter):
            def __init__(self, pt):
                super().__init__(pt, "failing")
            def capabilities(self):
                return [AdapterCapability.PLATFORM]
            def collect(self, **kwargs):
                return RawProviderSnapshot(
                    snapshot_id="snap-fail2",
                    provider_type=self._provider_type,
                    provider_id="failing",
                    collection_status=OrchestrationStatus.FAILED,
                    errors=["auth failed"],
                )
        adapter, normalizer, pt = provider_fn()
        failing = FailingAdapter(pt)
        discovery = PlatformDiscovery().discover(failing, normalizer)
        assert discovery.inventory is None


