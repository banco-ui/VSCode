def _build_client_with_provider(provider_fn):
    """Build a TestClient with the given provider's discovery result."""
    from fastapi.testclient import TestClient
    from server_manager.api.app import create_app
    from server_manager.api import dependencies as deps
    from server_manager.api.dependencies import ManagementContext

    adapter, normalizer, expected_type = provider_fn()
    ctx = ManagementContext()
    discovery = PlatformDiscovery().discover(adapter, normalizer)
    ctx._refresh_from_discovery(discovery)

    app = create_app()
    app.dependency_overrides[deps.get_management_context] = lambda: ctx
    client = TestClient(app)
    return client, discovery, expected_type


