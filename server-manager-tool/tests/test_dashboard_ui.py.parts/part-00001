class MockK8sObject:
    def __init__(self, data): self._data = data
    def to_dict(self): return self._data

class MockK8sListResponse:
    def __init__(self, items): self.items = items
    def to_dict(self):
        return {"items": [i.to_dict() if hasattr(i, "to_dict") else i for i in self.items]}

class MockCoreV1Api:
    def __init__(self, topology): self._topology = topology
    def get_api_version(self): return {"major": "1", "minor": "28"}
    def list_namespace(self):
        return MockK8sListResponse([MockK8sObject(ns) for ns in self._topology.get("namespaces", [])])
    def list_node(self):
        return MockK8sListResponse([MockK8sObject(n) for n in self._topology.get("nodes", [])])
    def list_pod_for_all_namespaces(self):
        return MockK8sListResponse([MockK8sObject(p) for p in self._topology.get("pods", [])])
    def list_service_for_all_namespaces(self):
        return MockK8sListResponse([MockK8sObject(s) for s in self._topology.get("services", [])])
    def list_persistent_volume(self):
        return MockK8sListResponse([MockK8sObject(pv) for pv in self._topology.get("persistent_volumes", [])])
    def list_persistent_volume_claim_for_all_namespaces(self):
        return MockK8sListResponse([MockK8sObject(pvc) for pvc in self._topology.get("persistent_volume_claims", [])])


def make_node(name, uid=None, ready=True, memory_pressure=False,
              cpu_capacity="8", cpu_allocatable="7500m",
              memory_capacity="16256396Ki", memory_allocatable="15256396Ki", pod_capacity="110"):
    conditions = [
        {"type": "Ready", "status": "True" if ready else "False"},
        {"type": "MemoryPressure", "status": "True" if memory_pressure else "False"},
        {"type": "DiskPressure", "status": "False"},
        {"type": "PIDPressure", "status": "False"},
    ]
    return {"apiVersion": "v1", "kind": "Node",
            "metadata": {"name": name, "uid": uid or "uid-node-" + name}, "spec": {},
            "status": {"capacity": {"cpu": cpu_capacity, "memory": memory_capacity, "pods": pod_capacity},
                       "allocatable": {"cpu": cpu_allocatable, "memory": memory_allocatable, "pods": pod_capacity},
                       "conditions": conditions}}


def make_pod(name, uid=None, namespace="default", node_name="node-01", phase="Running", ready=True):
    return {"apiVersion": "v1", "kind": "Pod",
            "metadata": {"name": name, "uid": uid or "uid-pod-" + name, "namespace": namespace},
            "spec": {"nodeName": node_name, "containers": [{"name": "main", "image": "nginx:1.25", "resources": {}}]},
            "status": {"phase": phase, "conditions": [{"type": "Ready", "status": "True" if ready else "False"}]}}

def make_service(name, uid=None, svc_type="ClusterIP"):
    return {"apiVersion": "v1", "kind": "Service",
            "metadata": {"name": name, "uid": uid or "uid-svc-" + name, "namespace": "default"},
            "spec": {"type": svc_type, "clusterIP": "10.96.0.1"}}

def make_pv(name, uid=None, phase="Bound"):
    return {"apiVersion": "v1", "kind": "PersistentVolume",
            "metadata": {"name": name, "uid": uid or "uid-pv-" + name},
            "spec": {"capacity": {"storage": "10Gi"}}, "status": {"phase": phase}}

def make_pvc(name, uid=None, phase="Bound"):
    return {"apiVersion": "v1", "kind": "PersistentVolumeClaim",
            "metadata": {"name": name, "uid": uid or "uid-pvc-" + name, "namespace": "default"},
            "spec": {"resources": {"requests": {"storage": "5Gi"}}}, "status": {"phase": phase}}

def make_namespace(name):
    return {"apiVersion": "v1", "kind": "Namespace", "metadata": {"name": name, "uid": "uid-ns-" + name}}


