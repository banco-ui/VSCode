class TestCollectionAllFailed:
    def test_all_failed_status(self, fixture_os05_all_fail):
        adapter = OpenStackProviderAdapter(fixture=fixture_os05_all_fail)
        snap = adapter.collect()
        # Platform always succeeds, so status is PARTIAL not FAILED
        assert snap.collection_status == OrchestrationStatus.PARTIAL

    def test_all_failed_has_errors(self, fixture_os05_all_fail):
        adapter = OpenStackProviderAdapter(fixture=fixture_os05_all_fail)
        snap = adapter.collect()
        assert len(snap.errors) >= 5

    def test_all_failed_no_successful(self, fixture_os05_all_fail):
        adapter = OpenStackProviderAdapter(fixture=fixture_os05_all_fail)
        snap = adapter.collect()
        # PLATFORM always succeeds
        assert AdapterCapability.NODE not in snap.successful_capabilities
        assert AdapterCapability.EXECUTION_ENVIRONMENT not in snap.successful_capabilities


