class TestCollectionSuccess:
    def test_collect_returns_snapshot(self, fixture_os01):
        adapter = OpenStackProviderAdapter(fixture=fixture_os01)
        snap = adapter.collect()
        assert isinstance(snap, RawProviderSnapshot)

    def test_collect_success_status(self, fixture_os03):
        adapter = OpenStackProviderAdapter(fixture=fixture_os03)
        snap = adapter.collect()
        assert snap.collection_status == OrchestrationStatus.SUCCESS

    def test_collect_provider_type(self, fixture_os01):
        adapter = OpenStackProviderAdapter(fixture=fixture_os01)
        snap = adapter.collect()
        assert snap.provider_type == ProviderType.OPENSTACK

    def test_collect_snapshot_id_format(self, fixture_os01):
        adapter = OpenStackProviderAdapter(fixture=fixture_os01)
        snap = adapter.collect()
        assert snap.snapshot_id.startswith("snap-os-")

    def test_collect_payload_preserved(self, fixture_os03):
        adapter = OpenStackProviderAdapter(fixture=fixture_os03)
        snap = adapter.collect()
        assert "hypervisors" in snap.payload
        assert len(snap.payload["hypervisors"]) == 1
        assert "servers" in snap.payload
        assert len(snap.payload["servers"]) == 1

    def test_collect_platform_info_preserved(self, fixture_os03):
        adapter = OpenStackProviderAdapter(fixture=fixture_os03)
        snap = adapter.collect()
        assert snap.payload["platform"]["name"] == "openstack-cloud"
        assert snap.payload["platform"]["version"] == "Yoga"

    def test_collect_source_evidence(self, fixture_os03):
        adapter = OpenStackProviderAdapter(fixture=fixture_os03)
        snap = adapter.collect()
        assert snap.source_evidence is not None
        assert snap.source_evidence.provider_type == ProviderType.OPENSTACK


