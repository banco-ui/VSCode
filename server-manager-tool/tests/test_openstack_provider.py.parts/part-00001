class TestProviderIdentity:
    def test_provider_type_is_openstack(self, fixture_os01):
        adapter = OpenStackProviderAdapter(fixture=fixture_os01)
        assert adapter.provider_type == ProviderType.OPENSTACK

    def test_default_provider_id(self, fixture_os01):
        adapter = OpenStackProviderAdapter(fixture=fixture_os01)
        assert adapter.provider_id == "openstack-cloud"

    def test_custom_provider_id(self, fixture_os01):
        adapter = OpenStackProviderAdapter(
            provider_id="prod-cloud", fixture=fixture_os01)
        assert adapter.provider_id == "prod-cloud"


