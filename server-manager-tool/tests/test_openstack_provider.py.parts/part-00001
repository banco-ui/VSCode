class TestRelationshipEvidence:
    def test_server_to_hypervisor_direct(self, fixture_os03):
        adapter = OpenStackProviderAdapter(fixture=fixture_os03)
        snap = adapter.collect()
        runs_on = [e for e in snap.relationship_evidence
                   if e.relationship_type == "runs_on"]
        assert len(runs_on) == 1
        assert runs_on[0].evidence_type == RelationshipEvidenceType.DIRECT
        assert runs_on[0].source_entity_ref == "srv-001"
        assert runs_on[0].target_entity_ref == "compute-01"

    def test_volume_to_server_direct(self, fixture_os03):
        adapter = OpenStackProviderAdapter(fixture=fixture_os03)
        snap = adapter.collect()
        attached = [e for e in snap.relationship_evidence
                    if e.relationship_type == "attached_to"]
        assert len(attached) == 1
        assert attached[0].evidence_type == RelationshipEvidenceType.DIRECT
        assert attached[0].source_entity_ref == "vol-001"
        assert attached[0].target_entity_ref == "srv-001"

    def test_no_hv_no_runs_on(self, fixture_os06_no_hv):
        adapter = OpenStackProviderAdapter(fixture=fixture_os06_no_hv)
        snap = adapter.collect()
        runs_on = [e for e in snap.relationship_evidence
                   if e.relationship_type == "runs_on"]
        assert len(runs_on) == 0

    def test_unattached_volume_no_evidence(self, fixture_os07_multi_vol):
        adapter = OpenStackProviderAdapter(fixture=fixture_os07_multi_vol)
        snap = adapter.collect()
        attached = [e for e in snap.relationship_evidence
                    if e.relationship_type == "attached_to"]
        # Only vol-001 has attachment to srv-001
        assert len(attached) == 1


