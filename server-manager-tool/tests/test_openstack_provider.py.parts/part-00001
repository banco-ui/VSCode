def make_hypervisor(
    hostname: str, hv_id: int = 1, state: str = "up",
    status: str = "enabled", vcpus: int = 32, memory_mb: int = 131072,
    local_gb: int = 500,
) -> dict:
    return {
        "hypervisor_hostname": hostname, "id": hv_id,
        "state": state, "status": status,
        "vcpus": vcpus, "memory_mb": memory_mb, "local_gb": local_gb,
        "vcpus_used": 10, "memory_mb_used": 40960, "local_gb_used": 120,
    }


def make_server(
    server_id: str, name: str = "vm-01", status: str = "ACTIVE",
    hypervisor: str | None = "compute-01",
) -> dict:
    srv: dict[str, Any] = {
        "id": server_id, "name": name, "status": status,
        "flavor": {"id": "flavor-001"},
        "addresses": {"public": [{"addr": "10.0.0.5"}]},
    }
    if hypervisor:
        srv["OS-EXT-SRV-ATTR:hypervisor_hostname"] = hypervisor
    return srv


def make_network(
    net_id: str, name: str = "public-net", status: str = "ACTIVE",
) -> dict:
    return {
        "id": net_id, "name": name, "status": status,
        "provider:network_type": "vlan",
    }


def make_volume(
    vol_id: str, name: str = "data-vol", status: str = "in-use",
    size: int = 100, attachments: list | None = None,
) -> dict:
    if attachments is None:
        attachments = [{"server_id": "srv-001"}]
    return {
        "id": vol_id, "name": name, "status": status, "size": size,
        "attachments": attachments,
    }


def make_az(zone_name: str, available: bool = True) -> dict:
    return {"zoneName": zone_name, "zoneState": {"available": available}}


def make_flavor(flavor_id: str, name: str = "m1.small") -> dict:
    return {"id": flavor_id, "name": name, "vcpus": 2, "ram": 2048, "disk": 20}


