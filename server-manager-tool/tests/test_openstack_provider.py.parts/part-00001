class TestNoLiveConnection:
    def test_fixture_based_only(self, fixture_os03):
        """Adapter with fixture does not attempt live connection."""
        adapter = OpenStackProviderAdapter(fixture=fixture_os03)
        assert adapter._client is None

    def test_no_client_attribute_access(self, fixture_os01):
        """No client attribute means no live connection path."""
        adapter = OpenStackProviderAdapter(fixture=fixture_os01)
        snap = adapter.collect()
        # Fixture path: payload has data from fixture, not from API calls
        assert snap.payload["platform"]["name"] == "openstack-cloud"
