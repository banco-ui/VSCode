class TestCollectionPartial:
    def test_partial_status(self, fixture_os04_partial):
        adapter = OpenStackProviderAdapter(fixture=fixture_os04_partial)
        snap = adapter.collect()
        assert snap.collection_status == OrchestrationStatus.PARTIAL

    def test_partial_has_errors(self, fixture_os04_partial):
        adapter = OpenStackProviderAdapter(fixture=fixture_os04_partial)
        snap = adapter.collect()
        assert len(snap.errors) > 0

    def test_partial_failed_capability_error_category(self, fixture_os04_partial):
        adapter = OpenStackProviderAdapter(fixture=fixture_os04_partial)
        snap = adapter.collect()
        failed = snap.failed_capabilities
        assert AdapterCapability.EXECUTION_ENVIRONMENT in failed
        ee_cr = next(
            cr for cr in snap.capability_results
            if cr.capability == AdapterCapability.EXECUTION_ENVIRONMENT
        )
        assert ee_cr.error_category == ErrorCategory.AUTHENTICATION_ERROR

    def test_partial_successful_capabilities_preserved(self, fixture_os04_partial):
        adapter = OpenStackProviderAdapter(fixture=fixture_os04_partial)
        snap = adapter.collect()
        assert AdapterCapability.NODE in snap.successful_capabilities


