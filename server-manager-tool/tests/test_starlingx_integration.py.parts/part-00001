class TestApiErrorHandling:
    """API errors, auth failure, timeout, partial collection
    must NOT be converted to empty results or HEALTHY."""

    def test_auth_error_not_healthy(self):
        fixture = _make_base_fixture()
        fixture["errors"] = {"fm_alarms": "Auth expired (401)"}
        adapter = StarlingXProviderAdapter(fixture=fixture)
        snapshot = adapter.collect()
        assert snapshot.collection_status == OrchestrationStatus.PARTIAL
        assert any("Auth" in e or "401" in e for e in snapshot.errors)

    def test_partial_collection_has_errors(self):
        fixture = _make_base_fixture()
        fixture["errors"] = {
            "fm_alarms": "Connection refused",
            "smapi_nodes": "Timeout",
        }
        adapter = StarlingXProviderAdapter(fixture=fixture)
        snapshot = adapter.collect()
        assert len(snapshot.errors) >= 2
        assert snapshot.collection_status == OrchestrationStatus.PARTIAL

    def test_all_endpoints_failed(self):
        fixture = {
            "sysinv_isystems": [], "sysinv_ihosts": [],
            "fm_alarms": [], "fm_event_log": [], "smapi_nodes": [],
            "errors": {
                "sysinv_isystems": "Connection refused",
                "sysinv_ihosts": "Connection refused",
                "fm_alarms": "Connection refused",
                "fm_event_log": "Connection refused",
                "smapi_nodes": "Connection refused",
            },
        }
        adapter = StarlingXProviderAdapter(fixture=fixture)
        snapshot = adapter.collect()
        assert snapshot.collection_status == OrchestrationStatus.FAILED

    def test_empty_inventory_no_entities(self):
        fixture = {
            "sysinv_isystems": [], "sysinv_ihosts": [],
            "fm_alarms": [], "fm_event_log": [], "smapi_nodes": [],
        }
        adapter = StarlingXProviderAdapter(fixture=fixture)
        snapshot = adapter.collect()
        result = StarlingXProviderNormalizer().normalize(snapshot)
        assert len(result.platforms) == 0
        assert len(result.nodes) == 0

    def test_timeout_error_in_errors(self):
        fixture = _make_base_fixture()
        fixture["errors"] = {"sysinv_isystems": "Timeout after 30s"}
        adapter = StarlingXProviderAdapter(fixture=fixture)
        snapshot = adapter.collect()
        assert any("Timeout" in e for e in snapshot.errors)

    def test_missing_fm_alarms_key(self):
        """Missing fm_alarms key -> empty list, not None."""
        fixture = _make_base_fixture()
        del fixture["fm_alarms"]
        adapter = StarlingXProviderAdapter(fixture=fixture)
        snapshot = adapter.collect()

