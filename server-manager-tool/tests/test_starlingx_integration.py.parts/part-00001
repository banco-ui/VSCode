class TestAlertLifecycle:
    """Alarm occurrence, update, resolution follow existing
    fault/alert lifecycle rules."""

    def test_fault_detected_on_first_cycle(self):
        fixture = _make_base_fixture(fm_alarms=[_critical_alarm()])
        _, _, fr = _run_pipeline(fixture)
        assert fr.has_faults
        assert len(fr.newly_detected) >= 1
        for f in fr.newly_detected:
            assert f.status == FaultStatus.DETECTED

    def test_fault_ongoing_on_second_cycle(self):
        fixture = _make_base_fixture(fm_alarms=[_critical_alarm()])
        adapter = StarlingXProviderAdapter(fixture=fixture)
        normalizer = StarlingXProviderNormalizer()
        discovery = PlatformDiscovery()
        dr = discovery.discover(adapter, normalizer)
        hp = HealthService().assess(dr)
        mon = MonitoringService().monitor(hp)
        svc = FaultDetectionService()
        r1 = svc.detect(mon.observations, mon.state_changes)
        r2 = svc.detect(mon.observations, mon.state_changes)
        assert len(r1.newly_detected) >= 1
        assert len(r2.ongoing) >= 1
        assert all(f.status == FaultStatus.ONGOING for f in r2.ongoing)

    def test_fault_resolved_when_alarm_cleared(self):
        fixture_alarm = _make_base_fixture(fm_alarms=[_critical_alarm()])
        adapter1 = StarlingXProviderAdapter(fixture=fixture_alarm)
        normalizer = StarlingXProviderNormalizer()
        discovery = PlatformDiscovery()
        dr1 = discovery.discover(adapter1, normalizer)
        hp1 = HealthService().assess(dr1)
        mon1 = MonitoringService().monitor(hp1)
        svc = FaultDetectionService()
        svc.detect(mon1.observations, mon1.state_changes)

        fixture_no = _make_base_fixture(
            fm_alarms=[], platform_memory_used=50.0)
        adapter2 = StarlingXProviderAdapter(fixture=fixture_no)
        dr2 = discovery.discover(adapter2, normalizer)
        hp2 = HealthService().assess(dr2)
        mon2 = MonitoringService().monitor(hp2)
        r2 = svc.detect(mon2.observations, mon2.state_changes)
        assert len(r2.resolved_fault_ids) >= 1

    def test_alert_open_from_fault(self):
        fixture = _make_base_fixture(fm_alarms=[_critical_alarm()])
        _, _, fr = _run_pipeline(fixture)
        svc = AlertService()
        for f in fr.faults:
            res = svc.create_alert(f)
            assert res.created
            assert res.alert.status == AlertStatus.OPEN

    def test_no_duplicate_alert_same_fault(self):
        fixture = _make_base_fixture(fm_alarms=[_critical_alarm()])
        _, _, fr = _run_pipeline(fixture)
        svc = AlertService()
        for f in fr.faults:
            svc.create_alert(f)
        for f in fr.faults:
            res = svc.create_alert(f)
            assert not res.created
        assert len(svc.get_alerts()) == len(fr.faults)

    def test_no_alert_for_unknown_health(self):
        fixture = _make_base_fixture(
            host_availability="unknown-state",
            platform_memory_used=None, fm_alarms=[])
        _, _, fr = _run_pipeline(fixture)
        assert not fr.has_faults

    def test_alert_acknowledge_and_resolve(self):
        fixture = _make_base_fixture(
            fm_alarms=[_critical_alarm()], host_availability="offline")
        _, _, fr = _run_pipeline(fixture)
        svc = AlertService()
        for f in fr.faults:
            svc.create_alert(f)
        alerts = svc.get_alerts()
        assert len(alerts) >= 1
        first = alerts[0]
        ack = svc.acknowledge(first.alert_id, "operator")
        assert ack.status == AlertStatus.ACKNOWLEDGED
        resolved = svc.resolve(first.alert_id, "issue fixed")
        assert resolved.status == AlertStatus.RESOLVED

