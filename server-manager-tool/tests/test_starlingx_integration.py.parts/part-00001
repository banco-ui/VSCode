class TestDuplicateHandling:
    """Same FM alarm from REST and CLI -> logical dedup,
    SourceEvidence preserved via _sources."""

    def test_rest_cli_merge_no_duplicate(self):
        rest = [_critical_alarm()]
        cli = {ALARM_UUID: {"alarm_state": "set", "alarm_type": "equipment"}}
        merged = StarlingXProviderAdapter._merge_alarm_data(rest, cli)
        assert len(merged) == 1

    def test_sources_preserved(self):
        rest = [_critical_alarm()]
        cli = {ALARM_UUID: {"alarm_state": "set"}}
        merged = StarlingXProviderAdapter._merge_alarm_data(rest, cli)
        assert merged[0]["_sources"] == ["rest", "cli"]

    def test_cli_fields_supplement_rest(self):
        rest = [{"uuid": ALARM_UUID, "alarm_id": "100.103",
                 "severity": "critical"}]
        cli = {ALARM_UUID: {"alarm_state": "set",
                            "probable_cause": "thresholdCrossed",
                            "severity": "warning"}}
        merged = StarlingXProviderAdapter._merge_alarm_data(rest, cli)
        assert merged[0]["severity"] == "critical"
        assert merged[0]["alarm_state"] == "set"

    def test_rest_only_sources(self):
        rest = [_critical_alarm()]
        merged = StarlingXProviderAdapter._merge_alarm_data(rest, {})
        assert merged[0]["_sources"] == ["rest"]

    def test_cli_only_alarm(self):
        cli = {"uuid-only-cli": {"alarm_state": "set"}}
        merged = StarlingXProviderAdapter._merge_alarm_data([], cli)
        assert len(merged) == 1
        assert merged[0]["_sources"] == ["cli"]
        assert merged[0]["uuid"] == "uuid-only-cli"

    def test_normalizer_preserves_alarms(self):
        fixture = _make_base_fixture(fm_alarms=[_critical_alarm()])
        adapter = StarlingXProviderAdapter(fixture=fixture)

