class TestFaultSeparation:
    """FM Alarm 100.103 and Redfish PDB/interconnect Critical remain
    separate fault/alert entities."""

    def test_fm_alarm_produces_health_failure_fault(self):
        fixture = _make_base_fixture(fm_alarms=[_critical_alarm()])
        _, _, fr = _run_pipeline(fixture)
        hf = [f for f in fr.faults
              if f.fault_type == FaultType.HEALTH_FAILURE]
        assert len(hf) >= 1
        assert all(f.severity == Severity.CRITICAL for f in hf)

    def test_multiple_fm_alarms_one_fault(self):
        """Multiple critical alarms on same node -> one HEALTH_FAILURE fault
        (deterministic dedup by entity_id + fault_type)."""
        fixture = _make_base_fixture(fm_alarms=[
            _critical_alarm(alarm_id="100.103", uuid="u1"),
            _critical_alarm(alarm_id="100.104", uuid="u2"),
        ])
        _, _, fr = _run_pipeline(fixture)
        hf = [f for f in fr.faults
              if f.fault_type == FaultType.HEALTH_FAILURE]
        assert len(hf) == 1

    def test_fm_and_availability_different_faults(self):
        """FM critical + offline -> separate faults."""
        fixture = _make_base_fixture(
            host_availability="offline", fm_alarms=[_critical_alarm()])
        _, _, fr = _run_pipeline(fixture)
        hf = [f for f in fr.faults
              if f.fault_type == FaultType.HEALTH_FAILURE]
        af = [f for f in fr.faults
              if f.fault_type == FaultType.AVAILABILITY_FAILURE]
        assert len(hf) >= 1
        assert len(af) >= 1
        assert {f.fault_id for f in hf}.isdisjoint({f.fault_id for f in af})

    def test_fm_fault_on_node_not_physical(self):
        """StarlingX fault entity_id is Node, never Physical."""
        fixture = _make_base_fixture(fm_alarms=[_critical_alarm()])
        _, _, fr = _run_pipeline(fixture)
        for fault in fr.faults:
            assert "physical" not in fault.entity_id.lower()

    def test_separate_alerts_for_different_faults(self):
        """FM critical + offline -> separate faults -> separate alerts."""
        fixture = _make_base_fixture(
            host_availability="offline", fm_alarms=[_critical_alarm()])
        _, _, fr = _run_pipeline(fixture)
        svc = AlertService()
        for f in fr.faults:
            svc.create_alert(f)
        alerts = svc.get_alerts()
        # Different fault_ids -> different alert_ids
        assert len({a.alert_id for a in alerts}) >= 2
        assert len({a.fault_id for a in alerts}) >= 2


