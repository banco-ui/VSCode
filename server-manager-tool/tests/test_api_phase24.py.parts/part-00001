# ── Failing adapter (simulates connection failure) ─────────────────────

class FailingAdapter(ProviderAdapter):
    """Adapter that always returns FAILED collection status."""
    def __init__(self):
        super().__init__(provider_type=ProviderType.KUBERNETES, provider_id="failing-cluster")
    def capabilities(self):
        return [AdapterCapability.PLATFORM, AdapterCapability.NODE]
    def collect(self, **kwargs):
        from datetime import datetime, timezone
        return RawProviderSnapshot(
            snapshot_id="snap-fail-001",
            provider_type=ProviderType.KUBERNETES,
            provider_id="failing-cluster",
            collected_at=datetime.now(timezone.utc).isoformat(),
            collection_status=OrchestrationStatus.FAILED,
            errors=["Connection refused: unable to reach Kubernetes API server"],
        )


class SkippedAdapter(ProviderAdapter):
    """Adapter that returns SKIPPED (no credentials)."""
    def __init__(self):
        super().__init__(provider_type=ProviderType.KUBERNETES, provider_id="no-creds-cluster")
    def capabilities(self):
        return [AdapterCapability.PLATFORM, AdapterCapability.NODE]
    def collect(self, **kwargs):
        from datetime import datetime, timezone
        return RawProviderSnapshot(
            snapshot_id="snap-skip-001",
            provider_type=ProviderType.KUBERNETES,
            provider_id="no-creds-cluster",
            collected_at=datetime.now(timezone.utc).isoformat(),
            collection_status=OrchestrationStatus.SKIPPED,
            errors=["No kubeconfig found: credentials not configured"],
        )


