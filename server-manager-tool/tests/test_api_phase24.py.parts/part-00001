# ── 8. Response Schema Validation ────────────────────────────────────

class TestResponseSchema:
    def test_response_has_all_fields(self, discovery_client):
        c, _ = discovery_client
        body = c.post("/api/v1/discovery/run").json()
        for field in ["discovery_status", "provider_type", "provider_id",
                       "snapshot_id", "collected_at", "identified_platform_type",
                       "entity_count", "capabilities_attempted",
                       "capabilities_succeeded", "capabilities_failed",
                       "errors", "warnings"]:
            assert field in body, f"Missing field: {field}"

    def test_status_valid_value(self, discovery_client):
        c, _ = discovery_client
        valid = {"SUCCESS", "PARTIAL", "FAILED", "SKIPPED"}
        assert c.post("/api/v1/discovery/run").json()["discovery_status"] in valid

    def test_capabilities_are_lists(self, discovery_client):
        c, _ = discovery_client
        body = c.post("/api/v1/discovery/run").json()
        assert isinstance(body["capabilities_attempted"], list)
        assert isinstance(body["capabilities_succeeded"], list)
        assert isinstance(body["capabilities_failed"], list)

    def test_errors_warnings_are_lists(self, discovery_client):
        c, _ = discovery_client
        body = c.post("/api/v1/discovery/run").json()
        assert isinstance(body["errors"], list)
        assert isinstance(body["warnings"], list)


