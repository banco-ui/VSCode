# ── 1. Discovery Run — Success ────────────────────────────────────────

class TestDiscoveryRunSuccess:
    def test_discovery_run_returns_200(self, discovery_client):
        c, _ = discovery_client
        r = c.post("/api/v1/discovery/run")
        assert r.status_code == 200

    def test_discovery_run_status_success(self, discovery_client):
        c, _ = discovery_client
        r = c.post("/api/v1/discovery/run")
        assert r.json()["discovery_status"] == "SUCCESS"

    def test_discovery_run_provider_type(self, discovery_client):
        c, _ = discovery_client
        assert c.post("/api/v1/discovery/run").json()["provider_type"] == "KUBERNETES"

    def test_discovery_run_has_snapshot_id(self, discovery_client):
        c, _ = discovery_client
        body = c.post("/api/v1/discovery/run").json()
        assert body["snapshot_id"].startswith("snap-")

    def test_discovery_run_entity_count_positive(self, discovery_client):
        c, _ = discovery_client
        assert c.post("/api/v1/discovery/run").json()["entity_count"] > 0

    def test_discovery_run_has_capabilities(self, discovery_client):
        c, _ = discovery_client
        body = c.post("/api/v1/discovery/run").json()
        assert len(body["capabilities_attempted"]) > 0
        assert len(body["capabilities_succeeded"]) > 0

    def test_discovery_run_no_errors_on_success(self, discovery_client):
        c, _ = discovery_client
        assert c.post("/api/v1/discovery/run").json()["errors"] == []


# ── 2. Inventory Refresh After Discovery ──────────────────────────────

class TestInventoryRefresh:
    def test_inventory_available_after_discovery(self, discovery_client):
        c, _ = discovery_client
        assert c.get("/api/v1/inventory").status_code == 503
        c.post("/api/v1/discovery/run")
        r = c.get("/api/v1/inventory")
        assert r.status_code == 200
        assert r.json()["provider_type"] == "KUBERNETES"
        assert r.json()["total_entities"] > 0

    def test_health_available_after_discovery(self, discovery_client):
        c, _ = discovery_client
        c.post("/api/v1/discovery/run")
        r = c.get("/api/v1/health")
        assert r.status_code == 200
        assert r.json()["health_status"] in ("SUCCESS", "PARTIAL", "FAILED", "SKIPPED")

    def test_graph_available_after_discovery(self, discovery_client):
        c, _ = discovery_client
        c.post("/api/v1/discovery/run")
        r = c.get("/api/v1/graph/summary")
        assert r.status_code == 200
        assert r.json()["node_count"] > 0

    def test_readiness_true_after_discovery(self, discovery_client):
        c, _ = discovery_client
        c.post("/api/v1/discovery/run")
        r = c.get("/api/v1/system/readiness")
        assert r.status_code == 200
        assert r.json()["ready"] is True

    def test_fresh_snapshot_id_after_rerun(self, discovery_client):
        c, _ = discovery_client
        r1 = c.post("/api/v1/discovery/run").json()
        r2 = c.post("/api/v1/discovery/run").json()
        assert r1["snapshot_id"] != r2["snapshot_id"]


# ── 3. Discovery Run — Failure / Partial / Skipped ────────────────────

class TestDiscoveryRunFailure:
    def test_failing_returns_failed_status(self, failing_discovery_client):
        c, _ = failing_discovery_client
        r = c.post("/api/v1/discovery/run")
        assert r.status_code == 200
        body = r.json()
        assert body["discovery_status"] == "FAILED"
        assert body["entity_count"] == 0
        assert len(body["errors"]) > 0

    def test_failing_has_no_inventory(self, failing_discovery_client):
        c, _ = failing_discovery_client
        c.post("/api/v1/discovery/run")
        assert c.get("/api/v1/inventory").status_code == 503

    def test_failing_clears_dependent_services(self, failing_discovery_client):
        c, ctx = failing_discovery_client
        c.post("/api/v1/discovery/run")
        assert ctx.health_report is None
        assert ctx.graph_query is None
        assert ctx.fault_result is None

    def test_skipped_returns_skipped_status(self, skipped_discovery_client):
        c, _ = skipped_discovery_client
        r = c.post("/api/v1/discovery/run")
        assert r.status_code == 200
        body = r.json()
        assert body["discovery_status"] == "SKIPPED"
        assert body["entity_count"] == 0

    def test_skipped_has_warning(self, skipped_discovery_client):
        c, _ = skipped_discovery_client
        body = c.post("/api/v1/discovery/run").json()
        assert len(body["warnings"]) > 0

    def test_skipped_no_credential_exposure(self, skipped_discovery_client):
        c, _ = skipped_discovery_client
        body = c.post("/api/v1/discovery/run").json()
        for w in body["warnings"]:
            assert "password" not in w.lower()
            assert "token" not in w.lower()

    def test_empty_topology_discovery(self, empty_discovery_client):
        c, _ = empty_discovery_client
        r = c.post("/api/v1/discovery/run")
        assert r.status_code == 200
        body = r.json()
        assert body["discovery_status"] in ("SUCCESS", "PARTIAL")
        # Empty topology may still have platform + cluster entities
        assert body["entity_count"] >= 0


# ── 4. Duplicate Run Protection ───────────────────────────────────────

class TestDuplicateRunProtection:
    def test_concurrent_returns_409(self, discovery_client):
        c, ctx = discovery_client
        ctx._discovery_running = True
        try:
            r = c.post("/api/v1/discovery/run")
            assert r.status_code == 409
            assert r.json()["detail"]["code"] == "DISCOVERY_ALREADY_RUNNING"
        finally:
            ctx._discovery_running = False

    def test_flag_resets_after_completion(self, discovery_client):
        c, ctx = discovery_client
        c.post("/api/v1/discovery/run")
        assert ctx._discovery_running is False
        r = c.post("/api/v1/discovery/run")
        assert r.status_code == 200


