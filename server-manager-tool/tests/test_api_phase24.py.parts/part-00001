        from server_manager.api import management_routes
        source = inspect.getsource(management_routes)
        assert "/operations/execute" not in source
        assert "/recovery/execute" not in source

    def test_no_put_delete_patch_routes(self):
        from server_manager.api import management_routes
        source = inspect.getsource(management_routes)
        assert "@router.put" not in source
        assert "@router.delete" not in source
        assert "@router.patch" not in source

    def test_no_provider_resource_modification(self, discovery_client):
        c, _ = discovery_client
        r = c.post("/api/v1/discovery/run")
