def _make_starlingx_fixture(
    *,
    host_availability: str = "available",
    host_operational: str = "enabled",
    fm_alarms: list[dict[str, Any]] | None = None,
    fm_event_log: list[dict[str, Any]] | None = None,
    platform_memory_used: float | None = 90.26,
    system_health: dict[str, Any] | None = None,
    bm_type: str = "none",
    bm_ip: str | None = None,
    bm_hostname: str | None = None,
    hostname: str = "controller-0",
) -> dict[str, Any]:
    """Build a StarlingX fixture with configurable health states."""
    if fm_alarms is None:
        fm_alarms = []
    if fm_event_log is None:
        fm_event_log = []
    if system_health is None:
        system_health = {"System Health": "OK"}

    mem_entry: dict[str, Any] = {
        "platform_reserved_mib": 10000,
        "platform_total_mib": 16384,
    }
    if platform_memory_used is not None:
        mem_entry["platform_used_percent"] = platform_memory_used

    host: dict[str, Any] = {
        "uuid": HOST_UUID,
        "hostname": hostname,
        "personality": "controller",
        "administrative": "unlocked",
        "operational": host_operational,
        "availability": host_availability,
        "subfunctions": "controller,worker,lowlatency",
        "uptime": 15244220,
        "reboot_needed": False,
        "bm_type": bm_type,
        "capabilities": {},
        "location": {"locn": "samsung"},
    }
    if bm_ip is not None:
        host["bm_ip"] = bm_ip
    if bm_hostname is not None:
        host["bm_hostname"] = bm_hostname

    return {
        "sysinv_isystems": [{
            "uuid": SYSTEM_UUID, "name": "wrcp-ctrlr",
            "sw_version": "24.09", "system_mode": "simplex",
            "system_type": "All-in-one", "timezone": "UTC",
        }],
        "sysinv_ihosts": [host],
        "sysinv_imemorys": {HOST_UUID: [mem_entry]},
        "fm_alarms": fm_alarms,
        "fm_event_log": fm_event_log,
        "smapi_nodes": [{
            "id": 1, "name": hostname,
            "administrative_state": "unlocked",
            "operational_state": "enabled",
            "availability_status": "available",
        }],
        "system_health": system_health,
        "software_list": [
            {"release": "wrcp-24.09.0", "state": "deployed"},
        ],
    }


def _critical_alarm(
    alarm_id: str = "100.103",
    uuid: str = ALARM_UUID,
    entity: str = "host=controller-0",
) -> dict[str, Any]:
    return {
        "uuid": uuid, "alarm_id": alarm_id, "severity": "critical",
        "entity_instance_id": entity,
        "reason_text": f"{alarm_id} threshold exceeded",
    }


def _starlingx_provider():
    return (
        StarlingXProviderAdapter(
            fixture=_make_starlingx_fixture(),
            provider_id="wrcp-test-01",
        ),
        StarlingXProviderNormalizer(),
        ProviderType.WRCP,
    )


