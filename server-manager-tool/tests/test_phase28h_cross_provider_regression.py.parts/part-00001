        adapter = StarlingXProviderAdapter(
            fixture={"sysinv_isystems": [], "sysinv_ihosts": []},
            provider_id="wrcp-minimal",
        )
        snapshot = adapter.collect()
        assert isinstance(snapshot, RawProviderSnapshot)


