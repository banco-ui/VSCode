class TestStarlingXFaultAlertLifecycle:

    def _setup_pipeline(self, fixture=None):
        from server_manager.fault import FaultDetectionService
        from server_manager.monitoring.service import MonitoringService
        from server_manager.visibility.service import AlertService
        if fixture is None:
            fixture = _make_starlingx_fixture(
                fm_alarms=[_critical_alarm()],
            )
        adapter = StarlingXProviderAdapter(fixture=fixture, provider_id="wrcp-lifecycle")
        normalizer = StarlingXProviderNormalizer()
        dr = PlatformDiscovery().discover(adapter, normalizer)
        hp = HealthService().assess(dr)
        mon = MonitoringService().monitor(hp)
        fr = FaultDetectionService().detect(
            mon.observations, mon.state_changes)
        alert_svc = AlertService()
        for fault in fr.faults:
            alert_svc.create_alert(fault)
        return dr, hp, fr, alert_svc

    def test_fm_critical_creates_fault(self):
        _, _, fr, _ = self._setup_pipeline()
        assert len(fr.faults) >= 1

    def test_fm_fault_has_correct_entity(self):
        dr, _, fr, _ = self._setup_pipeline()
        node = dr.inventory.nodes[0]
        assert any(node.canonical_id in f.entity_id for f in fr.faults)

    def test_fm_alert_has_open_status(self):
        _, _, _, alert_svc = self._setup_pipeline()
        alerts = alert_svc.get_alerts()
        assert len(alerts) >= 1
        for a in alerts:
            assert a.status.value == "OPEN"

    def test_no_duplicate_alerts_for_same_fault(self):
        _, _, fr, alert_svc = self._setup_pipeline()
        initial_count = len(alert_svc.get_alerts())
        for fault in fr.faults:
            result = alert_svc.create_alert(fault)
            assert not result.created
        assert len(alert_svc.get_alerts()) == initial_count

    def test_alert_can_be_resolved(self):
        _, _, _, alert_svc = self._setup_pipeline()
        alerts = alert_svc.get_alerts()
        for a in alerts:
            alert_svc.resolve(a.alert_id)
        for a in alert_svc.get_alerts():
            assert a.status.value == "RESOLVED"


    def test_bm_type_ipmi_still_no_physical(self):
        """Even with bm_type=ipmi, Physical must not be created from sysinv data."""
        fixture = _make_starlingx_fixture(
            bm_type="ipmi", bm_ip="10.254.174.17",
            bm_hostname="bmc-ctrl-0",
        )
        adapter = StarlingXProviderAdapter(fixture=fixture, provider_id="wrcp-ipmi")
        normalizer = StarlingXProviderNormalizer()
        dr = PlatformDiscovery().discover(adapter, normalizer)
        assert len(dr.inventory.physicals) == 0
        node = dr.inventory.nodes[0]
        assert node.physical_ref is None
        assert node.metadata["starlingx"]["bm_type"] == "ipmi"

    def test_node_canonical_id_is_node_not_physical(self):
        fixture = _make_starlingx_fixture()
        adapter = StarlingXProviderAdapter(fixture=fixture, provider_id="wrcp-id-test")
        normalizer = StarlingXProviderNormalizer()
        dr = PlatformDiscovery().discover(adapter, normalizer)
        node = dr.inventory.nodes[0]
        assert "node" in node.canonical_id
        assert "physical" not in node.canonical_id

