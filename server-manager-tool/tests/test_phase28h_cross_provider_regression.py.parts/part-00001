    def test_graph_node_count_matches_inventory(self):
        adapter, normalizer, _ = _starlingx_provider()
        dr = PlatformDiscovery().discover(adapter, normalizer)
        graph = GraphBuilder().build(dr)
        inv_count = (
            len(dr.inventory.platforms) + len(dr.inventory.clusters)
            + len(dr.inventory.nodes)
        )
        assert graph.node_count == inv_count


