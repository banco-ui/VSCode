#  B. DETERMINISTIC CANONICAL IDS
# ════════════════════════════════════════════════════════════════════════


class TestStarlingXDeterministicIds:

    def test_repeated_normalization_same_ids(self):
        adapter, normalizer, _ = _starlingx_provider()
        snap1 = adapter.collect()
        snap2 = adapter.collect()
        r1 = normalizer.normalize(snap1)
        r2 = normalizer.normalize(snap2)
        ids1 = {e.canonical_id for e in r1.platforms + r1.nodes + r1.clusters}
        ids2 = {e.canonical_id for e in r2.platforms + r2.nodes + r2.clusters}
        assert ids1 == ids2

    def test_canonical_id_differs_from_provider_id(self):
        adapter, normalizer, _ = _starlingx_provider()
        snapshot = adapter.collect()
        result = normalizer.normalize(snapshot)
        all_entities = result.platforms + result.clusters + result.nodes
        for entity in all_entities:
            assert entity.canonical_id != entity.provider_id
            assert entity.canonical_id.startswith("canon-")

    def test_starlingx_ids_contain_wrcp_namespace(self):
        adapter, normalizer, _ = _starlingx_provider()
        snapshot = adapter.collect()
        result = normalizer.normalize(snapshot)
        for entity in result.platforms + result.nodes + result.clusters:
            assert "wrcp" in entity.canonical_id

    def test_starlingx_ids_differ_from_k8s_and_openstack(self):
        from server_manager.normalizers.provider_normalizer import (
            CanonicalIdentityGenerator,
        )
        ref = "test-ref-001"
        sx_id = CanonicalIdentityGenerator.generate(ProviderType.WRCP, "node", ref)
        k8s_id = CanonicalIdentityGenerator.generate(ProviderType.KUBERNETES, "node", ref)
        os_id = CanonicalIdentityGenerator.generate(ProviderType.OPENSTACK, "node", ref)
        assert sx_id != k8s_id
        assert sx_id != os_id
        assert k8s_id != os_id
        assert "wrcp" in sx_id
        assert "kubernetes" in k8s_id
        assert "openstack" in os_id


