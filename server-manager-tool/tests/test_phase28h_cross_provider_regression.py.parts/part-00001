class TestStarlingXNoUnknownToHealthy:

    def test_unknown_availability_not_healthy(self):
        """UNKNOWN availability must NOT be converted to HEALTHY."""
        fixture = _make_starlingx_fixture(host_availability="unknown")
        adapter = StarlingXProviderAdapter(fixture=fixture, provider_id="wrcp-unk")
        normalizer = StarlingXProviderNormalizer()
        dr = PlatformDiscovery().discover(adapter, normalizer)
        hp = HealthService().assess(dr)
        for hr in hp.results:
            if hr.entity_id.startswith("canon-wrcp"):
                assert hr.status != HealthStatus.HEALTHY

    def test_empty_availability_not_healthy(self):
        """Empty availability must NOT be converted to HEALTHY."""
        fixture = _make_starlingx_fixture(host_availability="")
        adapter = StarlingXProviderAdapter(fixture=fixture, provider_id="wrcp-empty")
        normalizer = StarlingXProviderNormalizer()
        dr = PlatformDiscovery().discover(adapter, normalizer)
        hp = HealthService().assess(dr)
        for hr in hp.results:
            if hr.entity_id.startswith("canon-wrcp-node"):
                assert hr.status != HealthStatus.HEALTHY


