#  A. ADAPTER CONTRACT BEHAVIOR
# ════════════════════════════════════════════════════════════════════════


class TestStarlingXAdapterContract:

    def test_adapter_inherits_provider_adapter(self):
        adapter, _, _ = _starlingx_provider()
        assert isinstance(adapter, ProviderAdapter)

    def test_capabilities_returns_list(self):
        adapter, _, _ = _starlingx_provider()
        caps = adapter.capabilities
        assert isinstance(caps, list)
        assert len(caps) > 0
        for cap in caps:
            assert isinstance(cap, AdapterCapability)

    def test_collect_returns_raw_snapshot(self):
        adapter, _, _ = _starlingx_provider()
        snapshot = adapter.collect()
        assert isinstance(snapshot, RawProviderSnapshot)

    def test_collect_safe_returns_snapshot(self):
        adapter, _, _ = _starlingx_provider()
        snapshot = adapter.collect_safe()
        assert isinstance(snapshot, RawProviderSnapshot)

    def test_snapshot_has_identity_fields(self):
        adapter, _, expected_type = _starlingx_provider()
        snapshot = adapter.collect()
        assert snapshot.provider_type == expected_type
        assert snapshot.provider_id is not None
        assert snapshot.snapshot_id
        assert snapshot.collected_at
        assert snapshot.collection_status in (
            OrchestrationStatus.SUCCESS,
            OrchestrationStatus.PARTIAL,
        )

    def test_declared_vs_capability_results(self):
        adapter, _, _ = _starlingx_provider()
        snapshot = adapter.collect()
        declared = set(snapshot.declared_capabilities)
        result_caps = {cr.capability for cr in snapshot.capability_results}
        assert result_caps.issubset(declared)


