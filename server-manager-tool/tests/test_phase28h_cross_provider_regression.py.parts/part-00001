    def test_graph_no_unknown_edges(self):
        adapter, normalizer, _ = _starlingx_provider()
        dr = PlatformDiscovery().discover(adapter, normalizer)
        graph = GraphBuilder().build(dr)
        for rel in graph.relationships:
            assert rel.evidence_type.value != "INFERRED"

    def test_graph_is_valid(self):
        adapter, normalizer, _ = _starlingx_provider()
        dr = PlatformDiscovery().discover(adapter, normalizer)
        graph = GraphBuilder().build(dr)
        assert graph.is_valid
