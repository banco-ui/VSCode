# TEST: RECOVERY CONTRACT

class TestRecoveryContract:
    def _make_service(self, execution_enabled=False, auth=AuthorizationLevel.READ_ONLY):
        from server_manager.recovery.models import RecoveryExecutionResult, RecoveryExecutionStatus
        from server_manager.recovery.service import RecoveryExecutor

        class MockExecutor(RecoveryExecutor):
            def preview(self, action):
                from server_manager.recovery.models import RecoveryPreview
                return RecoveryPreview(action=action, expected_effect="test")
            def execute(self, action):
                return RecoveryExecutionResult(action_id=action.action_id,
                    status=RecoveryExecutionStatus.EXECUTED, provider=action.provider_type,
                    target=action.target_entity_id)
            def verify(self, action, post_health=None):
                return RecoveryExecutionResult(action_id=action.action_id,
                    status=RecoveryExecutionStatus.VERIFIED, provider=action.provider_type,
                    target=action.target_entity_id)

        return RecoveryService(executor=MockExecutor(), execution_enabled=execution_enabled,
                                authorization=auth)

    def test_recovery_service_blocks_by_default(self):
        fault = Fault(fault_id="tf01", entity_id="te01", fault_type=FaultType.HEALTH_FAILURE,
                      severity=Severity.CRITICAL, detected_at=datetime.now(timezone.utc).isoformat(),
                      evidence={"health": "UNHEALTHY"})
        service = self._make_service()
        candidate = service.propose_candidate(fault)
        assert service.preview(candidate).safety_result == SafetyResult.BLOCKED

    def test_recovery_execute_blocked_without_auth(self):
        fault = Fault(fault_id="tf02", entity_id="te02", fault_type=FaultType.HEALTH_FAILURE,
                      severity=Severity.CRITICAL, detected_at=datetime.now(timezone.utc).isoformat(),
                      evidence={"health": "UNHEALTHY"})
        service = self._make_service()
        candidate = service.propose_candidate(fault)
        assert service.execute(candidate).status.value == "BLOCKED"

    def test_recovery_service_does_not_mutate_kubernetes(self):
        assert "subprocess" not in inspect.getsource(RecoveryService).lower()
        assert "kubectl" not in inspect.getsource(RecoveryService).lower()

