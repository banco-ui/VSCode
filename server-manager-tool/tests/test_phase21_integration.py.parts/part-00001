# TEST: IDENTITY STABILITY

class TestIdentityStability:
    def test_same_topology_same_canonical_ids(self):
        topology = make_healthy_cluster_topology()
        r1 = KubernetesProviderNormalizer().normalize(
            KubernetesProviderAdapter(provider_id="tc", client=MockCoreV1Api(topology)).collect())
        r2 = KubernetesProviderNormalizer().normalize(
            KubernetesProviderAdapter(provider_id="tc", client=MockCoreV1Api(topology)).collect())
        assert sorted(n.canonical_id for n in r1.nodes) == sorted(n.canonical_id for n in r2.nodes)
        assert sorted(ee.canonical_id for ee in r1.execution_environments) == sorted(ee.canonical_id for ee in r2.execution_environments)

    def test_canonical_id_differs_from_provider_id(self):
        topology = make_healthy_cluster_topology()
        result = KubernetesProviderNormalizer().normalize(
            KubernetesProviderAdapter(provider_id="tc", client=MockCoreV1Api(topology)).collect())
        for node in result.nodes:
            assert node.canonical_id != node.provider_id

    def test_no_timestamps_in_canonical_ids(self):
        topology = make_healthy_cluster_topology()
        result = KubernetesProviderNormalizer().normalize(
            KubernetesProviderAdapter(provider_id="tc", client=MockCoreV1Api(topology)).collect())
        for entity in (result.platforms + result.clusters + result.nodes
                        + result.execution_environments + result.networks + result.storages):
            assert "2026" not in entity.canonical_id

    def test_snapshot_id_changes_but_canonical_ids_stable(self):
        topology = make_healthy_cluster_topology()
        s1 = KubernetesProviderAdapter(client=MockCoreV1Api(topology)).collect()
        s2 = KubernetesProviderAdapter(client=MockCoreV1Api(topology)).collect()
        assert s1.snapshot_id != s2.snapshot_id
        r1 = KubernetesProviderNormalizer().normalize(s1)
        r2 = KubernetesProviderNormalizer().normalize(s2)
        assert sorted(n.canonical_id for n in r1.nodes) == sorted(n.canonical_id for n in r2.nodes)


