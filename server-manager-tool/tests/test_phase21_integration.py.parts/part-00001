class PipelineResult:
    def __init__(self, topology, provider_id="test-cluster"):
        self.topology = topology
        self.provider_id = provider_id
        mock_client = MockCoreV1Api(topology)
        self.adapter = KubernetesProviderAdapter(provider_id=provider_id, client=mock_client)
        self.snapshot = self.adapter.collect()
        self.normalizer = KubernetesProviderNormalizer()
        self.norm_result = self.normalizer.normalize(self.snapshot)
        self.discovery = PlatformDiscovery()
        self.adapter2 = KubernetesProviderAdapter(provider_id=provider_id, client=MockCoreV1Api(topology))
        self.discovery_result = self.discovery.discover(self.adapter2, self.normalizer)
        self.inventory = self.discovery_result.inventory
        self.health_service = HealthService()
        self.health_report = self.health_service.assess(self.discovery_result)
        self.graph_builder = GraphBuilder()
        self.graph_report = self.graph_builder.build(self.discovery_result)
        self.graph_query = GraphQuery(self.graph_report)
        self.monitoring_service = MonitoringService()
        self.monitoring_report = self.monitoring_service.monitor(self.health_report)
        self.fault_service = FaultDetectionService()
        self.fault_result = self.fault_service.detect(
            self.monitoring_report.observations, self.monitoring_report.state_changes)
        self.alert_service = AlertService()
        for fault in self.fault_result.faults:
            self.alert_service.create_alert(fault)
        self.visibility = OperationalVisibilityService(alert_service=self.alert_service)
        self.visibility.set_inventory(self.inventory)
        self.visibility.set_health_report(self.health_report)
        self.visibility.set_fault_result(self.fault_result)
        self.visibility.set_graph_query(self.graph_query)
        self.summary = self.visibility.get_summary()

