class MockK8sObject:
    def __init__(self, data):
        self._data = data
    def to_dict(self):
        return self._data
    def __getattr__(self, name):
        if name.startswith("_"):
            raise AttributeError(name)
        return self._data.get(name)

class MockK8sListResponse:
