# ── Build management context (same pattern as Phase 23/24) ─────────

class _NoOpOperationExecutor:
    """No-op executor that only supports preview, never execute."""
    def preview(self, request, target, capability):
        from server_manager.operations.models import OperationPreview
        from server_manager.recovery.models import SafetyResult
        return OperationPreview(request=request, resolved_target=target,
            capability_decision=capability, expected_effect="Query status preview",
            safety_result=SafetyResult.BLOCKED, execution_allowed=False)
    def execute(self, request, target): raise AssertionError("execute() should not be called")
    def verify(self, request, target, execution_result): raise AssertionError("verify() should not be called")

class _MockRecoveryExecutor:
    def preview(self, action):
        from server_manager.recovery.models import RecoveryPreview
        return RecoveryPreview(action=action, expected_effect="Restart preview")
    def execute(self, action): raise AssertionError("execute() should not be called")
    def verify(self, action, post_health=None): raise AssertionError("verify() should not be called")


def build_management_context(topology, provider_id="test-cluster"):
    from server_manager.fault.service import FaultDetectionService
    from server_manager.graph.service import GraphBuilder, GraphQuery
    from server_manager.health.service import HealthService
    from server_manager.monitoring.service import MonitoringService
    from server_manager.operations.models import OperationType
    from server_manager.operations.service import (
        CapabilityResolver, OperationExecutor, OperationGraphContext,
        OperationService, TargetResolver,
    )
    from server_manager.recovery.models import AuthorizationLevel
    from server_manager.recovery.service import RecoveryExecutor, RecoveryService
    from server_manager.visibility.service import AlertService, OperationalVisibilityService

    normalizer = KubernetesProviderNormalizer()
    discovery = PlatformDiscovery()
    adapter = KubernetesProviderAdapter(provider_id=provider_id, client=MockCoreV1Api(topology))
    discovery_result = discovery.discover(adapter, normalizer)
    health_report = HealthService().assess(discovery_result)
    graph_query = GraphQuery(GraphBuilder().build(discovery_result))
    monitoring_report = MonitoringService().monitor(health_report)
    fault_result = FaultDetectionService().detect(
        monitoring_report.observations, monitoring_report.state_changes)
    alert_service = AlertService()
    for fault in fault_result.faults: alert_service.create_alert(fault)
    visibility = OperationalVisibilityService(alert_service=alert_service)
    visibility.set_inventory(discovery_result.inventory)
    visibility.set_health_report(health_report)
    visibility.set_fault_result(fault_result)
    visibility.set_graph_query(graph_query)
    target_resolver = TargetResolver()
    for node in discovery_result.inventory.nodes:
        target_resolver.register_target(canonical_id=node.canonical_id,
            provider_type=ProviderType.KUBERNETES, provider_id=provider_id, entity_type="Node")
    cap_resolver = CapabilityResolver()
    cap_resolver.register(ProviderType.KUBERNETES, {OperationType.RESTART, OperationType.QUERY_STATUS})
    operation_service = OperationService(target_resolver=target_resolver, capability_resolver=cap_resolver,
        executor=_NoOpOperationExecutor(), graph_context=OperationGraphContext(graph_query))
    recovery_service = RecoveryService(executor=_MockRecoveryExecutor(), execution_enabled=False,
        authorization=AuthorizationLevel.READ_ONLY)
    ctx = ManagementContext()
    ctx.discovery_result = discovery_result
    ctx.health_report = health_report
    ctx.graph_query = graph_query
    ctx.monitoring_service = MonitoringService()
    ctx.monitoring_report = monitoring_report
    ctx.fault_result = fault_result
    ctx.alert_service = alert_service
    ctx.visibility = visibility
    ctx.operation_service = operation_service
    ctx.recovery_service = recovery_service
    return ctx


