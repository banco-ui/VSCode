class TestManualRefreshIntegration:
    def test_manual_refresh_returns_data(self, client):
        c, ctx = client
        r = c.get("/api/v1/visibility/summary")
        assert r.status_code == 200
        body = r.json()
        assert "generated_at" in body

    def test_refresh_all_endpoints_accessible(self, client):
        c, _ = client
        endpoints = [
            "/api/v1/system/health", "/api/v1/system/readiness",
            "/api/v1/inventory", "/api/v1/inventory/entities",
            "/api/v1/health", "/api/v1/faults",
            "/api/v1/visibility/summary", "/api/v1/visibility/alerts",
            "/api/v1/graph/summary",
        ]
        for ep in endpoints:
            r = c.get(ep)
            assert r.status_code == 200, f"{ep} returned {r.status_code}"

    def test_refresh_fails_gracefully_when_unconfigured(self, unconfigured_client):
        c, _ = unconfigured_client
        r = c.get("/api/v1/inventory")
        assert r.status_code == 503
        body = r.json()
        assert "detail" in body
        assert body["detail"]["code"] == "SERVICE_UNAVAILABLE"

    def test_system_health_always_ok(self, unconfigured_client):
        c, _ = unconfigured_client
        r = c.get("/api/v1/system/health")
        assert r.status_code == 200
        assert r.json()["status"] == "ok"


