# ── 1. Duplicate Request Prevention ───────────────────────────────

class TestDuplicateRequestPrevention:
    def test_loading_flag_in_app_state(self):
        content = _read_ui("js/app.js")
        assert "_loading" in content

    def test_refresh_guarded_by_loading(self):
        content = _read_ui("js/app.js")
        refresh_match = re.search(r'refresh:\s*function\s*\(\)\s*\{[^}]+\}', content)
        assert refresh_match, "refresh function not found"
        assert "_loading" in refresh_match.group(0)

    def test_set_loading_method_present(self):
        content = _read_ui("js/app.js")
        assert "_setLoading" in content
        assert "btn.disabled" in content

    def test_set_loading_disables_refresh_button(self):
        content = _read_ui("js/app.js")
        assert "btn.disabled = loading" in content

    def test_fetchall_sets_loading(self):
        content = _read_ui("js/app.js")
        fetchall_match = re.search(r'_fetchAll:\s*function.*?\}(?:\s*,|\s*\n\s*_)', content, re.DOTALL)
        assert fetchall_match, "_fetchAll method not found"
        fetchall_body = fetchall_match.group(0)
        assert "_setLoading(true)" in fetchall_body
        assert "_setLoading(false)" in fetchall_body

    def test_all_render_functions_use_fetchall(self):
        content = _read_ui("js/app.js")
        assert ".catch(function () { return null; })" not in content
        assert "self._updateLastRefresh(); self.hideError()" not in content


