// 메인 로직
// ============================================================================

async function main() {
  const args = process.argv.slice(2);

  if (args.length < 3) {
    console.error('사용법: node drm-ungroup.js <input_file> <doc_type> <mode> [output_folder]');
    console.error('  doc_type: word | excel | ppt | pdf');
    console.error('  mode: fast | capture | html');
    process.exit(1);
  }

  const inputFile = path.resolve(args[0]);
  const docType = args[1]; // word, excel, ppt, pdf
  const mode = args[2]; // fast, capture, html
  const outputFolder = args[3]
    ? path.resolve(args[3])
    : path.join(__dirname, '..', 'output', 'drm-ungrouped');

  const modeNames = {
    fast: '빠른 텍스트 추출',
    capture: '캡처 추출 (텍스트 + 그림/표)',
    html: 'HTML 저장 (DRM 제거)',
  };

  log(`=== DRM 문서 풀기 시작 ===`);
  log(`입력 파일: ${inputFile}`);
  log(`문서 종류: ${docType}`);
  log(`처리 방식: ${modeNames[mode] || mode}`);
  log(`출력 폴더: ${outputFolder}`);
  log('');

  // 입력 파일 존재 확인
  if (!fs.existsSync(inputFile)) {
    log(`오류: 입력 파일을 찾을 수 없습니다: ${inputFile}`, 'ERROR');
    process.exit(1);
  }

  // 출력 폴더 생성
  if (!fs.existsSync(outputFolder)) {
    fs.mkdirSync(outputFolder, { recursive: true });
  }

  const ext = path.extname(inputFile).toLowerCase();
  const baseName = path.basename(inputFile, ext);

  try {
    switch (docType) {
      case 'word':
        await processWord(inputFile, outputFolder, mode, baseName);
        break;
      case 'excel':
        await processExcel(inputFile, outputFolder, mode, baseName);
        break;
      case 'ppt':
        await processPowerPoint(inputFile, outputFolder, mode, baseName);
        break;
      case 'pdf':
        await processPdf(inputFile, outputFolder, mode, baseName);
        break;
      default:
        log(`지원하지 않는 문서 종류: ${docType}`, 'ERROR');
        log('지원 종류: word, excel, ppt, pdf', 'ERROR');
        process.exit(1);
    }

    log('');
    log('=== DRM 문서 풀기 완료! ===');
    log(`출력 폴더: ${outputFolder}`);

    // 출력 파일 목록 표시
    const outputFiles = fs.readdirSync(outputFolder).filter(f => f.startsWith(baseName));
    log(`출력 파일 수: ${outputFiles.length}`);
    outputFiles.forEach(f => log(`  - ${f}`));

  } catch (error) {
    log(`변환 오류: ${error.message}`, 'ERROR');
    process.exit(1);
  }
}

// 실행
main().catch((error) => {
  log(`치명적 오류: ${error.message}`, 'ERROR');
  process.exit(1);
});
