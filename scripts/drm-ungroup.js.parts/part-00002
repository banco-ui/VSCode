'\n'), 'utf-8');
        const htmlSize = fs.statSync(htmlPath).size;
        log(`HTML 파일 생성: ${Math.round(htmlSize / 1024)} KB`);
        log(`HTML 파일: ${htmlPath}`);
      } finally {
        try { fs.unlinkSync(tempPs1); } catch (e) {}
      }

    } else {
      // fast 모드
      const tempPs1 = path.join(os.tmpdir(), `ppt-com-${Date.now()}.ps1`);
      fs.writeFileSync(tempPs1, '\ufeff' + PS_PPT_EXTRACT);

      try {
        log('PowerPoint COM 으로 텍스트 추출 중...');

        const textOutputFile = path.join(outputFolder, `${baseName}_fast.txt`);

        execSync(`powershell -ExecutionPolicy Bypass -File "${tempPs1}"`, {
          env: { ...process.env, DOC_PATH: inputFile, OUTPUT_FILE: textOutputFile },
          timeout: 300000,
          encoding: 'utf-8',
          maxBuffer: 100 * 1024 * 1024,
        });

        let textLength = 0;
        if (fs.existsSync(textOutputFile)) {
          textLength = fs.readFileSync(textOutputFile, 'utf-8').length;
        }
        log(`텍스트 추출 완료 (${textLength} 자)`);
        log(`텍스트 파일 저장: ${textOutputFile}`);

        if (fs.existsSync(textOutputFile)) {
          const content = fs.readFileSync(textOutputFile, 'utf-8');
          const preview = content.substring(0, 200).replace(/\n/g, ' ');
          log(`미리보기: ${preview}...`);
        }
      } finally {
        try { fs.unlinkSync(tempPs1); } catch (e) {}
      }
    }

  } catch (error) {
    log(`오류: ${error.message}`, 'ERROR');
    if (error.message.includes('PowerPoint')) {
      log('MS PowerPoint 가 설치되어 있지 않거나 실행 중인지 확인하세요.', 'ERROR');
    }
    throw error;
  }
}

// ============================================================================
// PDF 문서 처리 (Python pypdf2)
// ============================================================================

const PY_EXTRACT_PDF = `
import sys
from pypdf import PdfReader

try:
    pdf_path = sys.argv[1]
    text_dir = sys.argv[2]
    
    print(f"PDF 파일 확인: {pdf_path}")
    
    reader = PdfReader(pdf_path)
    text = ""
    
    for page in reader.pages:
        page_text = page.extract_text()
        if page_text:
            text += page_text + "\\n\\n"
    
    import os
    base_name = os.path.splitext(os.path.basename(pdf_path))[0]
    text_file = os.path.join(text_dir, f"{base_name}-pdf.txt")
    
    with open(text_file, 'w', encoding='utf-8') as f:
        f.write(text)
    
    print(f"추출된 텍스트: {len(text)} 자")
    print(f"텍스트 저장: {text_file}")
    
except Exception as e:
    print(f"오류: {str(e)}", file=sys.stderr)
    sys.exit(1)
`;

async function processPdf(inputFile, outputFolder, mode, baseName) {
  log('PDF 문서 처리 시작 (Python pypdf2 사용)');

  const tempPy = path.join(os.tmpdir(), `pdf-extract-${Date.now()}.py`);
  fs.writeFileSync(tempPy, PY_EXTRACT_PDF);

  try {
    log('PDF 텍스트 추출 중...');

    const result = execSync(`python "${tempPy}" "${inputFile}" "${outputFolder}"`, {
      encoding: 'utf-8',
      maxBuffer: 100 * 1024 * 1024,
      timeout: 300000,
    });

    log(result.trim());

    const textFile = path.join(outputFolder, `${baseName}-pdf.txt`);
    if (fs.existsSync(textFile)) {
      const textLength = fs.statSync(textFile).size;
      log(`텍스트 파일 크기: ${textLength.toLocaleString()} bytes`);
    }
  } catch (error) {
    log(`오류: ${error.message}`, 'ERROR');
    log('Python pypdf2 가 설치되어 있는지 확인하세요: pip install pypdf', 'ERROR');
    // Python이 없는 경우 pdf-parse fallback
    log('pdf-parse 로 fallback 시도...');
    try {
      const pdfParse = require('pdf-parse');
      const pdfBuffer = fs.readFileSync(inputFile);
      const pdfData = await pdfParse(pdfBuffer);
      log(`텍스트 추출 완료 (${pdfData.text.length} 문자)`);
      log(`페이지 수: ${pdfData.numpages}`);
      const textOutputFile = path.join(outputFolder, `${baseName}_${mode}.txt`);
      fs.writeFileSync(textOutputFile, pdfData.text, 'utf-8');
      log(`텍스트 파일 저장: ${textOutputFile}`);
    } catch (fallbackErr) {
      log(`fallback 오류: ${fallbackErr.message}`, 'ERROR');
      throw fallbackErr;
    }
  } finally {
    try { fs.unlinkSync(tempPy); } catch (e) {}
  }
}

