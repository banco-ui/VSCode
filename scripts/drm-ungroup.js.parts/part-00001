#!/usr/bin/env node

/**
 * DRM 문서 풀기 스크립트 (원본 drm-unlocker 방식)
 * ================================
 * DRM 이 적용된 Office 문서(.docx, .xlsx, .pptx, .pdf)를 
 * PowerShell COM 객체를 사용하여 해독합니다.
 * 
 * 처리 방식:
 *   1. 빠른 텍스트 추출 (fast) - COM 객체로 텍스트만 추출
 *   2. 캡처 추출 (capture) - 텍스트 + 그림/표 화면 캡처 (Word만 지원)
 *   3. HTML 저장 (html) - Word/Excel/PPT 를 HTML 포맷으로 저장 (DRM 제거)
 * 
 * 사용법:
 *   node drm-ungroup.js <input_file> <doc_type> <mode> [output_folder]
 * 
 *   doc_type: word | excel | ppt | pdf
 *   mode: fast | capture | html
 */

const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');
const os = require('os');

// ============================================================================
// 유틸리티 함수
// ============================================================================

function log(message, level = 'INFO') {
  const timestamp = new Date().toISOString();
  const line = `[${timestamp}] [${level}] ${message}`;
  console.log(line);
}

// ============================================================================
// Word 문서 처리 (Word COM 객체)
// ============================================================================

const PS_WORD_EXTRACT = `
$ErrorActionPreference = "Stop"

try {
  $word = New-Object -ComObject Word.Application
  $word.Visible = $false
  $word.DisplayAlerts = 0
  
  $docPath = "$env:DOC_PATH"
  $outputFile = "$env:OUTPUT_FILE"
  Write-Host "문서 여는 중: $docPath"
  $doc = $word.Documents.Open($docPath, $false, $true)
  
  $text = $doc.Content.Text
  
  $doc.Close($false)
  $word.Quit()
  
  # UTF-8 BOM 으로 파일에 직접 저장 (stdout 인코딩 문제 회피)
  $utf8 = New-Object System.Text.UTF8Encoding($false)
  [System.IO.File]::WriteAllText($outputFile, $text, $utf8)
  Write-Host "저장 완료: $outputFile"
  
  [System.Runtime.Interopservices.Marshal]::ReleaseComObject($word) | Out-Null
  [GC]::Collect()
  [GC]::WaitForPendingFinalizers()
} catch {
  Write-Error "오류: $($_.Exception.Message)"
  if ($word) {
    try {
      $doc.Close($false)
      $word.Quit()
      [System.Runtime.Interopservices.Marshal]::ReleaseComObject($word) | Out-Null
    } catch {}
  }
  [GC]::Collect()
  [GC]::WaitForPendingFinalizers()
  exit 1
}
`;


// Word 캡처 추출: 텍스트 + 페이지별 화면 캡처
const PS_WORD_CAPTURE = `
$ErrorActionPreference = "Stop"
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8

try {
  $word = New-Object -ComObject Word.Application
  $word.Visible = $true
  $word.DisplayAlerts = 0
  $word.WindowState = 0

  $docPath = "$env:DOC_PATH"
  $outputDir = "$env:OUTPUT_DIR"
  Write-Host "문서 여는 중: $docPath"
  $doc = $word.Documents.Open($docPath, $false, $true)

  # 전체 텍스트 추출
  $text = $doc.Content.Text
  $textPath = Join-Path $outputDir "capture-text.txt"
  $utf8 = New-Object System.Text.UTF8Encoding($true)
  [System.IO.File]::WriteAllText($textPath, $text, $utf8)
  Write-Host "텍스트 추출 완료: $($text.Length) 자"

  # 페이지 수 확인
  $pageCount = $doc.ComputeStatistics(2)
  Write-Host "총 페이지 수: $pageCount"

  # 캡처 폴더 생성
  $captureDir = Join-Path $outputDir "screenshots"
  if (!(Test-Path $captureDir)) { New-Item -ItemType Directory -Path $captureDir | Out-Null }

  # Word 창 활성화
  $word.Activate()
  Start-Sleep -Milliseconds 1000

  Add-Type -AssemblyName System.Windows.Forms
  Add-Type -AssemblyName System.Drawing

  for ($i = 1; $i -le $pageCount; $i++) {
    Write-Host "페이지 $i/$pageCount 캡처 중..."

    $selection = $word.Selection
    $selection.GoTo(-1, 1, $i)
    Start-Sleep -Milliseconds 500

    $imagePath = Join-Path $captureDir ("page_{0:D3}.jpg" -f $i)

    $screen = [System.Windows.Forms.Screen]::PrimaryScreen
    $bitmap = New-Object System.Drawing.Bitmap $screen.Bounds.Width, $screen.Bounds.Height
    $graphics = [System.Drawing.Graphics]::FromImage($bitmap)
    $graphics.CopyFromScreen($screen.Bounds.X, $screen.Bounds.Y, 0, 0, $bitmap.Size)
    $bitmap.Save($imagePath, [System.Drawing.Imaging.ImageFormat]::Jpeg)
    $graphics.Dispose()
    $bitmap.Dispose()

    Write-Host "  저장: $imagePath"
  }

  $doc.Close($false)
  $word.Quit()

  Write-Output "완료"

  [System.Runtime.Interopservices.Marshal]::ReleaseComObject($word) | Out-Null
  [GC]::Collect()
  [GC]::WaitForPendingFinalizers()
} catch {
  Write-Error "오류: $($_.Exception.Message)"
  if ($word) {
    try {
      $doc.Close($false)
      $word.Quit()
      [System.Runtime.Interopservices.Marshal]::ReleaseComObject($word) | Out-Null
    } catch {}
  }
  [GC]::Collect()
  [GC]::WaitForPendingFinalizers()
  exit 1
}
`;

