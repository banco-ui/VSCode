async function processWord(inputFile, outputFolder, mode, baseName) {
  log('Word 문서 처리 시작 (Word COM 객체 사용)');

  try {
    if (mode === 'capture') {
      log('캡처 추출 모드: 텍스트 + 페이지별 화면 캡처');
      const captureOutputDir = path.join(outputFolder, `${baseName}_capture`);
      if (!fs.existsSync(captureOutputDir)) {
        fs.mkdirSync(captureOutputDir, { recursive: true });
      }

      const tempPs1 = path.join(os.tmpdir(), `word-capture-${Date.now()}.ps1`);
      fs.writeFileSync(tempPs1, '\ufeff' + PS_WORD_CAPTURE);

      try {
        execSync(`powershell -ExecutionPolicy Bypass -File "${tempPs1}"`, {
          env: { ...process.env, DOC_PATH: inputFile, OUTPUT_DIR: captureOutputDir },
          timeout: 600000,
          encoding: 'utf-8',
          maxBuffer: 100 * 1024 * 1024,
        });

        log('캡처 추출 완료!');
        log(`출력 폴더: ${captureOutputDir}`);

        // 텍스트 파일 확인
        const textFile = path.join(captureOutputDir, 'capture-text.txt');
        if (fs.existsSync(textFile)) {
          const textLength = fs.readFileSync(textFile, 'utf-8').length;
          log(`텍스트 파일: ${textLength} 자`);
        }

        // 캡처 이미지 확인
        const screenshotDir = path.join(captureOutputDir, 'screenshots');
        if (fs.existsSync(screenshotDir)) {
          const images = fs.readdirSync(screenshotDir).filter(f => f.endsWith('.jpg'));
          log(`캡처 이미지: ${images.length} 개`);
        }
      } finally {
        try { fs.unlinkSync(tempPs1); } catch (e) {}
      }

    } else if (mode === 'html') {
      log('HTML 저장 모드: Word SaveAs HTML (DRM 제거)');
      const htmlOutputDir = path.join(outputFolder, `${baseName}_html`);
      if (!fs.existsSync(htmlOutputDir)) {
        fs.mkdirSync(htmlOutputDir, { recursive: true });
      }

      const tempPs1 = path.join(os.tmpdir(), `word-html-${Date.now()}.ps1`);
      fs.writeFileSync(tempPs1, '\ufeff' + PS_WORD_HTML);

      try {
        execSync(`powershell -ExecutionPolicy Bypass -File "${tempPs1}"`, {
          env: { ...process.env, DOC_PATH: inputFile, OUTPUT_DIR: htmlOutputDir },
          timeout: 300000,
          encoding: 'utf-8',
          maxBuffer: 100 * 1024 * 1024,
        });

        log('HTML 저장 완료!');
        log(`출력 폴더: ${htmlOutputDir}`);

        // HTML 파일 확인
        const htmlFile = path.join(htmlOutputDir, 'document.html');
        if (fs.existsSync(htmlFile)) {
          const htmlSize = fs.statSync(htmlFile).size;
          log(`HTML 파일: ${Math.round(htmlSize / 1024)} KB`);
        }

        // 이미지 폴더 확인
        const filesDir = path.join(htmlOutputDir, 'document_files');
        if (fs.existsSync(filesDir)) {
          const images = fs.readdirSync(filesDir).filter(f => /\.(png|jpg|gif|emf|wmf)$/i.test(f));
          log(`추출된 이미지: ${images.length} 개`);
        }
      } finally {
        try { fs.unlinkSync(tempPs1); } catch (e) {}
      }

    } else {
      // fast 모드
      log('빠른 텍스트 추출 모드 (Word COM)');
      log('   (DRM 문서는 시간이 걸릴 수 있습니다)');

      const tempPs1 = path.join(os.tmpdir(), `word-com-${Date.now()}.ps1`);
      fs.writeFileSync(tempPs1, '\ufeff' + PS_WORD_EXTRACT);

      try {
        const textOutputFile = path.join(outputFolder, `${baseName}_fast.txt`);

        execSync(`powershell -ExecutionPolicy Bypass -File "${tempPs1}"`, {
          env: { ...process.env, DOC_PATH: inputFile, OUTPUT_FILE: textOutputFile },
          timeout: 300000,
          encoding: 'utf-8',
          maxBuffer: 100 * 1024 * 1024,
        });

        let textLength = 0;
        if (fs.existsSync(textOutputFile)) {
          textLength = fs.readFileSync(textOutputFile, 'utf-8').length;
        }
        log(`텍스트 추출 완료 (${textLength} 자)`);
        log(`텍스트 파일 저장: ${textOutputFile}`);

        if (fs.existsSync(textOutputFile)) {
          const content = fs.readFileSync(textOutputFile, 'utf-8');
          const preview = content.substring(0, 200).replace(/\n/g, ' ');
          log(`미리보기: ${preview}...`);
        }
      } finally {
        try { fs.unlinkSync(tempPs1); } catch (e) {}
      }
    }

  } catch (error) {
    log(`오류: ${error.message}`, 'ERROR');
    if (error.message.includes('timeout')) {
      log('문서가 크거나 DRM 으로 인해 시간이 더 걸릴 수 있습니다.', 'ERROR');
    } else if (error.message.includes('Word')) {
      log('MS Word 가 설치되어 있지 않거나 실행 중인지 확인하세요.', 'ERROR');
    }
    throw error;
  }
}

// ============================================================================
// Excel 문서 처리 (Excel COM 객체)
// ============================================================================

const PS_EXCEL_EXTRACT = `
$ErrorActionPreference = "Stop"

try {
  $excel = New-Object -ComObject Excel.Application
  $excel.Visible = $false
  $excel.DisplayAlerts = 0
  
  $docPath = "$env:DOC_PATH"
  $outputFile = "$env:OUTPUT_FILE"
  Write-Host "워크북 여는 중: $docPath"
  $workbook = $excel.Workbooks.Open($docPath, $false, $true)
  
  $allText = @()
  foreach ($sheet in $workbook.Sheets) {
    $sheetName = $sheet.Name
    $allText += "=== 시트: $sheetName ==="
    
    $usedRange = $sheet.UsedRange
    $rows = $usedRange.Rows.Count
    $cols = $usedRange.Columns.Count
    
    for ($r = 1; $r -le $rows; $r++) {
      $rowValues = @()
      for ($c = 1; $c -le $cols; $c++) {
        $cellValue = $sheet.Cells.Item($r, $c).Text
        $rowValues += $cellValue
      }
      $allText += ($rowValues -join [char]9)
    }
    $allText += ""
  }
  
  $workbook.Close($false)
  $excel.Quit()
  
  $text = $allText -join [Environment]::NewLine
  $utf8 = New-Object System.Text.UTF8Encoding($false)
  [System.IO.File]::WriteAllText($outputFile, $text, $utf8)
  Write-Host "저장 완료: $outputFile"
  
  [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
  [GC]::Collect()
  [GC]::WaitForPendingFinalizers()
} catch {
  Write-Error "오류: $($_.Exception.Message)"
  if ($excel) {
    try {
      $workbook.Close($false)
      $excel.Quit()
      [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
    } catch {}
  }
  [GC]::Collect()
  [GC]::WaitForPendingFinalizers()
  exit 1
}
`;

