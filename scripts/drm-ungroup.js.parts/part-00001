async function processExcel(inputFile, outputFolder, mode, baseName) {
  log('Excel 문서 처리 시작 (Excel COM 객체 사용)');

  try {
    if (mode === 'html') {
      log('HTML 저장 모드: Excel SaveAs HTML (DRM 제거)');
      const htmlOutputDir = path.join(outputFolder, `${baseName}_html`);
      if (!fs.existsSync(htmlOutputDir)) {
        fs.mkdirSync(htmlOutputDir, { recursive: true });
      }

      const tempPs1 = path.join(os.tmpdir(), `excel-html-${Date.now()}.ps1`);
      fs.writeFileSync(tempPs1, '\ufeff' + PS_EXCEL_HTML);

      try {
        execSync(`powershell -ExecutionPolicy Bypass -File "${tempPs1}"`, {
          env: { ...process.env, DOC_PATH: inputFile, OUTPUT_DIR: htmlOutputDir },
          timeout: 300000,
          encoding: 'utf-8',
          maxBuffer: 100 * 1024 * 1024,
        });

        log('HTML 저장 완료!');
        log(`출력 폴더: ${htmlOutputDir}`);

        const htmlFile = path.join(htmlOutputDir, 'document.html');
        if (fs.existsSync(htmlFile)) {
          const htmlSize = fs.statSync(htmlFile).size;
          log(`HTML 파일: ${Math.round(htmlSize / 1024)} KB`);
        }
      } finally {
        try { fs.unlinkSync(tempPs1); } catch (e) {}
      }

    } else {
      // fast 모드
      const tempPs1 = path.join(os.tmpdir(), `excel-com-${Date.now()}.ps1`);
      fs.writeFileSync(tempPs1, '\ufeff' + PS_EXCEL_EXTRACT);

      try {
        log('Excel COM 으로 텍스트 추출 중...');

        const textOutputFile = path.join(outputFolder, `${baseName}_fast.txt`);

        execSync(`powershell -ExecutionPolicy Bypass -File "${tempPs1}"`, {
          env: { ...process.env, DOC_PATH: inputFile, OUTPUT_FILE: textOutputFile },
          timeout: 300000,
          encoding: 'utf-8',
          maxBuffer: 100 * 1024 * 1024,
        });

        let textLength = 0;
        let content = '';
        if (fs.existsSync(textOutputFile)) {
          content = fs.readFileSync(textOutputFile, 'utf-8');
          textLength = content.length;
        }
        log(`텍스트 추출 완료 (${textLength} 자)`);
        log(`텍스트 파일 저장: ${textOutputFile}`);

        // CSV로도 저장 (탭 구분 → 쉼표 구분)
        const csvContent = content.replace(/\t/g, ',');
        const csvOutputFile = path.join(outputFolder, `${baseName}_fast.csv`);
        fs.writeFileSync(csvOutputFile, csvContent, 'utf-8');
        log(`CSV 파일 저장: ${csvOutputFile}`);

        const preview = content.substring(0, 200).replace(/\n/g, ' ');
        log(`미리보기: ${preview}...`);
      } finally {
        try { fs.unlinkSync(tempPs1); } catch (e) {}
      }
    }

  } catch (error) {
    log(`오류: ${error.message}`, 'ERROR');
    if (error.message.includes('Excel')) {
      log('MS Excel 이 설치되어 있지 않거나 실행 중인지 확인하세요.', 'ERROR');
    }
    throw error;
  }
}

// ============================================================================
// PowerPoint 문서 처리 (PowerPoint COM 객체)
// ============================================================================

const PS_PPT_EXTRACT = `
$ErrorActionPreference = "Stop"

try {
  $ppt = New-Object -ComObject PowerPoint.Application
  $ppt.Visible = [Microsoft.Office.Core.MsoTriState]::msoTrue
  
  $docPath = "$env:DOC_PATH"
  $outputFile = "$env:OUTPUT_FILE"
  Write-Host "프레젠테이션 여는 중: $docPath"
  $presentation = $ppt.Presentations.Open($docPath, $false, $false, $true)
  
  $allText = @()
  $slideNum = 1
  foreach ($slide in $presentation.Slides) {
    $allText += "=== 슬라이드 $slideNum ==="
    
    foreach ($shape in $slide.Shapes) {
      if ($shape.HasTextFrame) {
        if ($shape.TextFrame.HasText) {
          $allText += $shape.TextFrame.TextRange.Text
        }
      }
    }
    
    $allText += ""
    $slideNum++
  }
  
  $presentation.Close()
  $ppt.Quit()
  
  $text = $allText -join [Environment]::NewLine
  $utf8 = New-Object System.Text.UTF8Encoding($false)
  [System.IO.File]::WriteAllText($outputFile, $text, $utf8)
  Write-Host "저장 완료: $outputFile"
  
  [System.Runtime.Interopservices.Marshal]::ReleaseComObject($ppt) | Out-Null
  [GC]::Collect()
  [GC]::WaitForPendingFinalizers()
} catch {
  Write-Error "오류: $($_.Exception.Message)"
  if ($ppt) {
    try {
      $presentation.Close()
      $ppt.Quit()
      [System.Runtime.Interopservices.Marshal]::ReleaseComObject($ppt) | Out-Null
    } catch {}
  }
  [GC]::Collect()
  [GC]::WaitForPendingFinalizers()
  exit 1
}
`;

// PowerPoint HTML 저장: 클립보드 기반 PNG 추출 + 텍스트 추출 → HTML 생성 (DRM 제거)\r\n// 주의: $presentation.Export()는 DRM 래핑된 파일을 생성하므로 사용하지 않음\r\n// 대신 $slide.Copy() → 클립보드 → System.Drawing.Bitmap.Save()로 DRM-free PNG 생성\r\nconst PS_PPT_HTML = `\r\n\r\n$ErrorActionPreference = "Stop"\r\nAdd-Type -AssemblyName System.Windows.Forms\r\nAdd-Type -AssemblyName System.Drawing\r\n\r\ntry {\r\n  $ppt = New-Object -ComObject PowerPoint.Application\r\n  $ppt.Visible = [Microsoft.Office.Core.MsoTriState]::msoTrue\r\n\r\n  $docPath = "$env:DOC_PATH"\r\n  $outputDir = "$env:OUTPUT_DIR"\r\n  Write-Host "프레젠테이션 여는 중: $docPath"\r\n  $presentation = $ppt.Presentations.Open($docPath, $false, $false, $true)\r\n\r\n  # 슬라이드 이미지 저장 폴더\r\n  $imageDir = Join-Path $outputDir "slides"\r\n  if (!(Test-Path $imageDir)) {\r\n    New-Item -ItemType Directory -Path $imageDir | Out-Null\r\n  }\r\n\r\n  # 클립보드 기반 슬라이드 이미지 추출 (DRM-free)\r\n  $slideNum = 1\r\n  $allText = @()\r\n  foreach ($slide in $presentation.Slides) {\r\n    # 텍스트 추출\r\n    $allText += "=== 슬라이드 $slideNum ==="\r\n    foreach ($shape in $slide.Shapes) {\r\n      if ($shape.HasTextFrame) {\r\n        if ($shape.TextFrame.HasText) {\r\n          $allText += $shape.TextFrame.TextRange.Text\r\n        }\r\n      }\r\n    }\r\n    $allText += ""\r\n\r\n    # 클립보드로 슬라이드 복사 → PNG 저장\r\n    $slide.Copy()\r\n    Start-Sleep -Milliseconds 500\r\n    $img = [System.Windows.Forms.Clipboard]::GetImage()\r\n    if ($img) {\r\n      $imgPath = Join-Path $imageDir "slide_$slideNum.png"\r\n      $img.Save($imgPath, [System.Drawing.Imaging.ImageFormat]::Png)\r\n      $img.Dispose()\r\n      Write-Host "슬라이드 $slideNum 이미지 저장 완료"\r\n    } else {\r\n      Write-Host "슬라이드 $slideNum 이미지 추출 실패 (클립보드 비어있음)"\r\n    }\r\n    [System.Windows.Forms.Clipboard]::Clear()\r\n    $slideNum++\r\n  }\r\n\r\n  Write-Host "이미지 추출 완료: $imageDir"\r\n\r\n  $textPath = Join-Path $outputDir "slide-text.txt"\r\n  $text = $allText -join [Environment]::NewLine\r\n  $utf8 = New-Object System.Text.UTF8Encoding($false)\r\n  [System.IO.File]::WriteAllText($textPath, $text, $utf8)\r\n  Write-Host "텍스트 추출 완료: $($text.Length) 자"\r\n\r\n  # 슬라이드 수 출력\r\n  Write-Output "SLIDE_COUNT:$($slideNum - 1)"\r\n\r\n  $presentation.Close()\r\n  $ppt.Quit()\r\n\r\n  Write-Output "완료"\r\n\r\n  [System.Runtime.Interopservices.Marshal]::ReleaseComObject($ppt) | Out-Null\r\n  [GC]::Collect()\r\n  [GC]::WaitForPendingFinalizers()\r\n} catch {\r\n  Write-Error "오류: $($_.Exception.Message)"\r\n  if ($ppt) {\r\n    try {\r\n      $presentation.Close()\r\n      $ppt.Quit()\r\n      [System.Runtime.Interopservices.Marshal]::ReleaseComObject($ppt) | Out-Null\r\n    } catch {}\r\n  }\r\n  [GC]::Collect()\r\n  [GC]::WaitForPendingFinalizers()\r\n  exit 1\r\n}\r\n`;\r\n


