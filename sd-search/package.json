{
  "name": "sd-search",
  "version": "1.0.0",
  "description": "Samsung Doc Search - Mosaic, Confluence, AX HUB integrated search tool",
  "main": "electron/main.js",
  "scripts": {
    "search": "node index.js search",
    "detail": "node index.js detail",
    "gui": "node gui/server.js",
    "start": "electron .",
    "start:dev": "node gui/server.js",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "express": "^4.21.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "electron": "^43.7.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.samsung.sdsearch",
    "productName": "SDSearch",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "gui/**/*",
      "adapters/**/*",
      "core/**/*",
      "config/**/*",
      "package.json"
    ],
    "win": {

      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SDSearch"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*"
    ]
  }
}
