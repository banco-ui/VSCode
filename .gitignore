# 의존성
node_modules/

# 로그
logs/*
!logs/.gitkeep

# 실행 결과
output/screenshots/*
output/reports/*
!output/.gitkeep
!output/screenshots/.gitkeep
!output/reports/.gitkeep

# 크리덴셜 (절대 커밋 금지)
config/credentials.json
*.env

# 빌드 결과물
dist/
dist-electron/

# 임시 파일
*.bak
~$*

# Python 캐시/바이너리 (자동 생성 파일 - 커밋 대상 아님)
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 대용량 바이너리 파일 (GitHub 푸시 실패 방지)
*.blob
*.mht
*.rtf

# 대용량 압축/바이너리 파일
*.tar.gz
*.tar.xz
*.zip
*.exe
*.msi
*.nupkg

# PDF 문서
*.pdf

# 문서 파일 (사내문서, 대용량)
*.docx
*.xlsx
*.pptx
*.odt

# 이미지/스크린샷 파일 (대용량)
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.svg

# CSV 데이터 파일 (usm-automation 내 대용량 데이터만 제외, 템플릿은 포함)
usm-automation/[*[*.csv



# 디버그 로그
*-debug.log
mosaic-debug.log


