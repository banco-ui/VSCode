// GTC 파일 목록 조회 (하위 디렉토리 지원, 한글 인코딩 처리)
app.get('/api/gtc/files', (req, res) => {
  const dir = '/home/yaong/GTC_fileserver';
  const reqPath = req.query.path || '';
  const targetPath = reqPath ? path.join(dir, reqPath) : dir;
  
  // 보안: 디렉토리 탈출 방지
  if (!targetPath.startsWith(dir)) {
    return res.json({ ok: false, error: 'Invalid path', files: [] });
  }
  
  try {
    // Buffer 로 읽어서 UTF-8 로 명시적 디코딩 (한글 깨짐 방지)
    const items = fs.readdirSync(targetPath, { encoding: 'buffer' }).map(buf => {
      // 파일명 UTF-8 로 디코딩
      const name = Buffer.from(buf).toString('utf8');
      const full = path.join(targetPath, name);
      const stat = fs.statSync(full);
      const relPath = reqPath ? path.join(reqPath, name) : name;
      return {
        name,
        path: relPath.replace(/\\/g, '/'),
        isDirectory: stat.isDirectory(),
        size: stat.size,
        sizeMB: (stat.size / 1024 / 1024).toFixed(2),
        mtime: stat.mtime
      };
    });
    res.json({ ok: true, files: items, currentPath: reqPath });
  } catch (err) {
    res.json({ ok: false, error: err.message, files: [] });
  }
});



