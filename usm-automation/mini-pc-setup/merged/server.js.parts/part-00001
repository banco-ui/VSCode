// 원격 설치 (bootstrap.ps1 전송 후 실행)
app.post('/api/remote-install', async (req, res) => {
  const { ip } = req.body;
  if (!ip) return res.status(400).json({ error: 'IP 주소가 필요합니다.' });
  const device = devices.find((d) => d.ip === ip);
  if (!device) return res.status(400).json({ error: '장비를 찾을 수 없습니다.' });

  const username = device.username || config.miniPcCredentials.username;
  const password = device.password || config.miniPcCredentials.password;
  const port = device.sshPort || 22;

  // 설치 작업 등록
  installJobs.set(ip, { status: 'running', log: [], step: '시작', startedAt: new Date().toISOString() });

  res.json({ ok: true, message: '설치 시작됨' });

  // 비동기로 설치 진행
  (async () => {
    const job = installJobs.get(ip);
    const addLog = (msg) => {
      const ts = new Date().toLocaleString('ko-KR');
      job.log.push(`[${ts}] ${msg}`);
    };

    try {
      // 1. install-programs.ps1 업로드 (Step 2: 프로그램만 설치)
      addLog('install-programs.ps1 업로드 중...');
      job.step = '파일 업로드';
      const scriptPath = path.join(baseDir, 'install-programs.ps1');
      if (!fs.existsSync(scriptPath)) {
        throw new Error('install-programs.ps1 파일을 찾을 수 없습니다.');
      }
      const uploadResult = await sshUpload(ip, username, password, scriptPath, 'C:/mini-pc-setup/install-programs.ps1', port);
      if (!uploadResult.ok) throw new Error('파일 업로드 실패: ' + uploadResult.error);
      addLog('업로드 완료');

      // 2. PowerShell 관리자 권한으로 실행
      addLog('프로그램 설치 스크립트 실행 중...');
      addLog('⏳ PowerShell 시작 및 .NET Framework 로딩 대기 (1~3분 소요 가능)...');
      job.step = '설치 실행';
      const cmd = `powershell -ExecutionPolicy Bypass -File C:\\mini-pc-setup\\install-programs.ps1`;

      const result = await sshExec(ip, username, password, cmd, port);

      
      if (result.stdout) addLog(result.stdout);
      if (result.stderr) addLog('[STDERR] ' + result.stderr);
      
      if (result.ok) {
        addLog('✅ 설치 완료');
        job.status = 'done';
        // setupDone 표시
        const next = devices.map((d) => d.ip === ip ? { ...d, setupDone: true } : d);
        saveDevices(next);
      } else {
        addLog('❌ 설치 실패 (exit code: ' + result.exitCode + ')');
        job.status = 'failed';
      }
    } catch (err) {
      addLog('❌ 오류: ' + err.message);
      job.status = 'failed';
    }
  })();
});

