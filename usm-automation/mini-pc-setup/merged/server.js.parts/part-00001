/* ── 설정 로드 ── */
function loadConfig() {
  try {
    return JSON.parse(fs.readFileSync(configFile, 'utf8'));
  } catch {
    return {
      miniPcCredentials: { username: '1', password: '1' },
      sshPort: 22,
      rdpPort: 3389
    };
  }
}
const config = loadConfig();

/* ── 장비 정규화 ── */
function normalizeDevice(device) {
  if (!device || typeof device.name !== 'string' || typeof device.ip !== 'string') return null;
  const name = device.name.trim();
  const ip = device.ip.trim();
  if (!name || !ip) return null;
  return {
    id: typeof device.id === 'string' && device.id ? device.id : `${name}-${ip}`,
    name, ip,
    enabled: device.enabled !== false,
    setupDone: device.setupDone || false,
    group: device.group || '',
    sshPort: device.sshPort || config.sshPort || 22,
    rdpPort: device.rdpPort || config.rdpPort || 3389,
    username: device.username || config.miniPcCredentials.username,
    password: device.password || config.miniPcCredentials.password
  };
}

function loadDevices() {
  try {
    const data = JSON.parse(fs.readFileSync(devicesFile, 'utf8'));
    return Array.isArray(data) ? data.map(normalizeDevice).filter(Boolean) : [];
  } catch {
    return [];
  }
}

function saveDevices(next) {
  fs.writeFileSync(devicesFile, `${JSON.stringify(next, null, 2)}\n`, 'utf8');
  devices = next;
  for (const id of states.keys()) {
    if (!devices.some((d) => d.id === id)) states.delete(id);
  }
}

let devices = loadDevices();
const states = new Map();
const installJobs = new Map(); // ip -> { status, log, step, startedAt }

/* ── Ping ── */
function ping(ip) {
  return new Promise((resolve) => {
    const isWin = os.platform() === 'win32';
    const args = isWin ? ['-n', '1', '-w', '1500', ip] : ['-c', '1', '-W', '2', ip];
    execFile('ping', args, { timeout: 5000, encoding: 'utf8' }, (error, stdout, stderr) => {
      const output = (stdout || '') + (stderr || '');
      const ok = /ttl=/i.test(output) || /bytes from/i.test(output) || /의 응답:/i.test(output);
      const latencyMatch = output.match(/time[=<](\d+\.?\d*)\s*ms/i)
        || output.match(/시간[=<](\d+)\s*ms/i)
        || output.match(/(\d+\.?\d*)\s*ms/i);
      const latency = ok && latencyMatch ? Number(latencyMatch[1]) : null;
      resolve({ ok, latency });
    });
  });
}

/* ── 포트 체크 ── */
function checkPort(ip, port) {
  return new Promise((resolve) => {
    const net = require('net');
    const socket = new net.Socket();
    socket.setTimeout(3000);
    socket.on('connect', () => { socket.destroy(); resolve(true); });
    socket.on('timeout', () => { socket.destroy(); resolve(false); });
    socket.on('error', () => { resolve(false); });
    socket.connect(port, ip);
  });
}

/* ── 장비 상태 확인 ── */
async function checkDevice(device) {
  if (!device.enabled) return;
  const previous = states.get(device.id) || { failures: 0, status: 'unknown', events: [] };
  const result = await ping(device.ip);
  const now = new Date().toISOString();
  const failures = result.ok ? 0 : previous.failures + 1;
  const status = result.ok ? 'online' : (failures >= failuresBeforeOffline ? 'offline' : 'degraded');
  const events = previous.events || [];

  let sshOk = false, rdpOk = false;
  if (result.ok) {
    sshOk = await checkPort(device.ip, device.sshPort || 22);
    rdpOk = await checkPort(device.ip, device.rdpPort || 3389);
  }

  if (previous.status !== status && status !== 'degraded') {
    events.unshift({
      at: now,
      type: status,
      message: status === 'offline' ? '장애 감지' : '정상 복구'
    });
    events.splice(30);
  }

  states.set(device.id, {
    status, failures,
    latency: result.latency,
    checkedAt: now,
    lastOnlineAt: result.ok ? now : (previous.lastOnlineAt || null),
    sshOk, rdpOk,
    events
  });
}

async function checkAll() {
  await Promise.all(devices.filter((d) => d.enabled).map(checkDevice));
}

/* ── 상태 페이로드 ── */
function statusPayload() {
  const rows = devices.map((device) => {
    const state = states.get(device.id);
    return {
      ...device,
      status: device.enabled ? (state?.status || 'checking') : 'disabled',
      failures: state?.failures || 0,
      latency: state?.latency ?? null,
      checkedAt: state?.checkedAt || null,
      lastOnlineAt: state?.lastOnlineAt || null,
      sshOk: state?.sshOk || false,
      rdpOk: state?.rdpOk || false,
      events: state?.events || [],
      installStatus: installJobs.get(device.ip)?.status || null
    };
  });
  return {
    rows,
    checkedIntervalSeconds: intervalMs / 1000,
    failuresBeforeOffline,
    serverTime: new Date().toISOString()
  };
}

/* ── CP949(EUC-KR) → UTF-8 변환 ── */
function decodeKorean(buffer) {
  // Windows SSH는 기본적으로 CP949로 출력
  // Node.js의 Buffer는 UTF-8로 디코딩하므로 한글이 깨짐
  // iconv-lite가 있으면 사용, 없으면 latin1로 처리
  try {
    const iconv = require('iconv-lite');
    return iconv.decode(buffer, 'cp949');
  } catch {
    // iconv-lite가 없으면 latin1으로라도 처리 (한글은 깨지지만 영문은 정상)
    return buffer.toString('latin1');
  }
}

/* ── SSH 명령 실행 ── */
function sshExec(ip, username, password, command, port = 22) {
  return new Promise((resolve) => {
    const conn = new Client();
    let stdoutBuf = Buffer.alloc(0);
    let stderrBuf = Buffer.alloc(0);
    const timeout = setTimeout(() => {
      conn.end();
      resolve({ ok: false, error: 'SSH command timeout (600s)', stdout: decodeKorean(stdoutBuf), stderr: decodeKorean(stderrBuf) });
    }, 600000);


    conn.on('ready', () => {
      // Windows에서 chcp 65001 (UTF-8)로 코드페이지 변경 후 명령 실행
      const wrappedCmd = `chcp 65001 >nul 2>&1 & ${command}`;
      conn.exec(wrappedCmd, (err, stream) => {
        if (err) {
          clearTimeout(timeout);
          conn.end();
          resolve({ ok: false, error: err.message, stdout: '', stderr: '' });
          return;
        }
        stream.on('close', (code) => {
          clearTimeout(timeout);
          conn.end();
          // chcp 65001로 UTF-8 출력을 기대하지만, 일부 명령은 여전히 CP949로 출력
          // 먼저 UTF-8로 시도, 깨지면 CP949로 변환
          let stdout = stdoutBuf.toString('utf8');
          let stderr = stderrBuf.toString('utf8');
          // UTF-8 디코딩 실패 체크 (Replacement Character U+FFFD가 많으면)
          const replacementCount = (stdout.match(/\uFFFD/g) || []).length;
          if (replacementCount > 0) {
            // CP949로 재시도
            stdout = decodeKorean(stdoutBuf);
            stderr = decodeKorean(stderrBuf);
          }
          resolve({ ok: code === 0, exitCode: code, stdout, stderr });
        }).on('data', (data) => { stdoutBuf = Buffer.concat([stdoutBuf, data]); })
          .stderr.on('data', (data) => { stderrBuf = Buffer.concat([stderrBuf, data]); });
      });
    });

    conn.on('error', (err) => {
      clearTimeout(timeout);
      resolve({ ok: false, error: err.message, stdout: decodeKorean(stdoutBuf), stderr: decodeKorean(stderrBuf) });
    });

    conn.connect({ host: ip, port, username, password, readyTimeout: 10000 });
  });
}


/* ── SSH 파일 업로드 (SFTP) ── */
function sshUpload(ip, username, password, localPath, remotePath, port = 22) {
  return new Promise((resolve) => {
    const conn = new Client();
    const timeout = setTimeout(() => {
      conn.end();
      resolve({ ok: false, error: 'SFTP upload timeout' });
    }, 60000);

    conn.on('ready', () => {
      conn.sftp((err, sftp) => {
        if (err) {
          clearTimeout(timeout);
          conn.end();
          return resolve({ ok: false, error: err.message });
        }
        const writeStream = sftp.createWriteStream(remotePath);
        writeStream.on('close', () => {
          clearTimeout(timeout);
          conn.end();
          resolve({ ok: true, message: `업로드 완료: ${remotePath}` });
        });
        writeStream.on('error', (err) => {
          clearTimeout(timeout);
          conn.end();
          resolve({ ok: false, error: err.message });
        });
        const readStream = fs.createReadStream(localPath);
        readStream.pipe(writeStream);
      });
    });

    conn.on('error', (err) => {
      clearTimeout(timeout);
      resolve({ ok: false, error: err.message });
    });

    conn.connect({ host: ip, port, username, password, readyTimeout: 10000 });
  });
}

