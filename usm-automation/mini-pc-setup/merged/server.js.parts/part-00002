// 디렉토리 전체 다운로드 (ZIP - tar 사용)
app.get('/api/gtc/download-dir', (req, res) => {
  const dir = '/home/yaong/GTC_fileserver';
  const dirPath = req.query.path || '';
  const targetPath = dirPath ? path.join(dir, dirPath) : dir;
  
  if (!targetPath.startsWith(dir)) {
    return res.status(400).json({ error: 'Invalid path' });
  }
  
  const dirName = path.basename(dirPath) || 'GTC_fileserver';
  const zipPath = `/tmp/${dirName}-${Date.now()}.zip`;
  
  // zip 명령으로 압축 생성
  execFile('zip', ['-r', zipPath, targetPath], (err) => {
    if (err) return res.status(500).json({ error: err.message });
    
    res.download(zipPath, `${dirName}.zip`, () => {
      // 다운로드 후 임시 파일 삭제
      fs.unlinkSync(zipPath);
    });
  });
});


// 디렉토리 전체 삭제
app.delete('/api/gtc/delete-dir', (req, res) => {
  const dir = '/home/yaong/GTC_fileserver';
  const dirPath = req.query.path || '';
  const targetPath = dirPath ? path.join(dir, dirPath) : dir;
  
  if (!targetPath.startsWith(dir) || targetPath === dir) {
    return res.status(400).json({ ok: false, error: 'Cannot delete root directory' });
  }
  
  try {
    fs.rmSync(targetPath, { recursive: true, force: true });
    res.json({ ok: true, message: 'deleted' });
  } catch (err) {
    res.status(500).json({ ok: false, error: err.message });
  }
});

