// 일반 파일 업로드 (multipart/form-data - simple parser, no dependencies)
app.post('/api/gtc/upload', (req, res) => {
  const dir = '/home/yaong/GTC_fileserver';
  const contentType = req.headers['content-type'] || '';
  const boundaryMatch = contentType.match(/boundary=(?:"([^"]+)"|([^;]+))/i);
  
  if (!boundaryMatch) {
    return res.status(400).json({ ok: false, error: 'Invalid multipart content-type' });
  }
  
  const boundary = boundaryMatch[1] || boundaryMatch[2];
  const chunks = [];
  
  req.on('data', chunk => chunks.push(chunk));
  req.on('end', () => {
    const body = Buffer.concat(chunks);
    const boundaryStr = `--${boundary}`;
    const parts = body.toString('binary').split(boundaryStr).filter(p => p.trim() && p !== '--\r\n');
    
    let filename = '';
    let filepath = '';
    let fileData = null;
    
    parts.forEach(part => {
      if (part.includes('name="filename"')) {
        const match = part.match(/name="filename"\r\n\r\n(.+?)\r\n/);
        if (match) filename = match[1].trim();
      } else if (part.includes('name="filepath"')) {
        const match = part.match(/name="filepath"\r\n\r\n(.+?)\r\n/);
        if (match) filepath = match[1].trim();
      } else if (part.includes('name="file"')) {
        const lines = part.split('\r\n');
        const contentDisp = lines[1] || '';
        const fileMatch = contentDisp.match(/filename="([^"]+)"/);
        if (fileMatch && !filename) filename = fileMatch[1];
        
        const headerEnd = part.indexOf('\r\n\r\n') + 4;
        const rawData = part.slice(headerEnd);
        if (rawData.length > 2) {
          fileData = Buffer.from(rawData.slice(0, -2), 'binary');
        }
      }
    });
    
    if (!fileData || fileData.length === 0) {
      return res.status(400).json({ ok: false, error: 'No file data' });
    }
    
    // filepath 가 있으면 디렉토리 생성
    let destPath;
    if (filepath) {
      const subDir = path.join(dir, path.dirname(filepath));
      if (!fs.existsSync(subDir)) {
        fs.mkdirSync(subDir, { recursive: true });
      }
      destPath = path.join(dir, filepath);
    } else {
      destPath = path.join(dir, filename || crypto.randomUUID());
    }
    
    fs.writeFile(destPath, fileData, (err) => {
      if (err) return res.status(500).json({ ok: false, error: err.message });
      res.json({ ok: true, message: 'uploaded', filename: filepath || filename });
    });
  });
  
  req.on('error', (err) => {
    res.status(500).json({ ok: false, error: err.message });
  });
});




